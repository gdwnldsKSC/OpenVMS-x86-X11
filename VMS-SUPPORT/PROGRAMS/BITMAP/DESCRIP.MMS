! programs/bitmap/Imakefile's standalone ASCII-to-bitmap filter.
ATOBM_HEADERS = $(COMMON_HEADERS)
ATOBM_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                   [.VMS-SUPPORT]HEADERS.MMS, -
                   [.VMS-SUPPORT.PROGRAMS.BITMAP]DESCRIP.MMS
! Expose native RTL isascii; preserve upstream int argument/filespec and BUFSIZ counts.
ATOBM_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT/DEFINE=_XOPEN_SOURCE=600 -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)

ATOBM : $(OUT).PROGRAMS.BITMAP]ATOBM.EXE
	CONTINUE

$(OUT).PROGRAMS.BITMAP]ATOBM.OBJ : [.PROGRAMS.BITMAP]ATOBM.C, -
    $(ATOBM_HEADERS), $(ATOBM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.BITMAP]ATOBM "$(ATOBM_CFLAGS)"

$(OUT).PROGRAMS.BITMAP]ATOBM.EXE : $(OUT).PROGRAMS.BITMAP]ATOBM.OBJ, -
    [.VMS-SUPPORT.PROGRAMS.BITMAP]LINK_ATOBM.COM, -
    [.VMS-SUPPORT.PROGRAMS.BITMAP]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.BITMAP]LINK_ATOBM.COM
