! Native tools from config/util/Imakefile.
MAKESTRS_HEADERS = $(COMMON_HEADERS)
MAKESTRS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                     [.VMS-SUPPORT]HEADERS.MMS, -
                     [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
! Comment-tag pointer differences are bounded by the 1024-byte input buffer.
MAKESTRS_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)

MAKESTRS : $(OUT).CONFIG.UTIL]MAKESTRS.EXE
	CONTINUE

$(OUT).CONFIG.UTIL]MAKESTRS.OBJ : [.CONFIG.UTIL]MAKESTRS.C, -
    $(MAKESTRS_HEADERS), $(MAKESTRS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.UTIL]MAKESTRS "$(MAKESTRS_CFLAGS)"

$(OUT).CONFIG.UTIL]MAKESTRS.EXE : $(OUT).CONFIG.UTIL]MAKESTRS.OBJ, -
    [.VMS-SUPPORT.CONFIG.UTIL]LINK.COM, -
    [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
	@[.VMS-SUPPORT.CONFIG.UTIL]LINK.COM

LNDIR_HEADERS = $(COMMON_HEADERS)
LNDIR_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                   [.VMS-SUPPORT]HEADERS.MMS, -
                   [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
! Scalar standard-stat identities support the upstream directory comparisons.
LNDIR_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /DEFINE=(_XOPEN_SOURCE=600,_USE_STD_STAT)

LNDIR : $(OUT).CONFIG.UTIL]LNDIR.EXE
	CONTINUE

$(OUT).CONFIG.UTIL]LNDIR.OBJ : [.CONFIG.UTIL]LNDIR.C, -
    $(LNDIR_HEADERS), $(LNDIR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.UTIL]LNDIR "$(LNDIR_CFLAGS)"

$(OUT).CONFIG.UTIL]LNDIR.EXE : $(OUT).CONFIG.UTIL]LNDIR.OBJ, -
    [.VMS-SUPPORT.CONFIG.UTIL]LINK_LNDIR.COM, -
    [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
	@[.VMS-SUPPORT.CONFIG.UTIL]LINK_LNDIR.COM

REVPATH_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                     [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
REVPATH_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT

REVPATH : $(OUT).CONFIG.UTIL]REVPATH.EXE
	CONTINUE

$(OUT).CONFIG.UTIL]REVPATH.OBJ : [.CONFIG.UTIL]REVPATH.C, -
    $(REVPATH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.UTIL]REVPATH "$(REVPATH_CFLAGS)" RTL

$(OUT).CONFIG.UTIL]REVPATH.EXE : $(OUT).CONFIG.UTIL]REVPATH.OBJ, -
    [.VMS-SUPPORT.CONFIG.UTIL]LINK_REVPATH.COM, -
    [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
	@[.VMS-SUPPORT.CONFIG.UTIL]LINK_REVPATH.COM

RMAN_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE_RMAN.COM, -
                  [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
! Retain legacy comment placement and int offsets within MAXBUF-sized lines.
RMAN_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))

RMAN : $(OUT).CONFIG.UTIL]RMAN.EXE
	CONTINUE

$(OUT).CONFIG.UTIL]RMAN.OBJ : [.EXTRAS.RMAN]RMAN.C, -
    $(RMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_RMAN.COM $(MMS$SOURCE) $(OUT).CONFIG.UTIL]RMAN "$(RMAN_CFLAGS)"

$(OUT).CONFIG.UTIL]RMAN.EXE : $(OUT).CONFIG.UTIL]RMAN.OBJ, -
    [.VMS-SUPPORT.CONFIG.UTIL]LINK_RMAN.COM, -
    [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
	@[.VMS-SUPPORT.CONFIG.UTIL]LINK_RMAN.COM
