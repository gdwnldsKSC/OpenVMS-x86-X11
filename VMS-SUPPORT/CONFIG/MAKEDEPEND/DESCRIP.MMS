! Complete config/makedepend/Imakefile target, using the upstream if-expression parser.
MAKEDEPEND_HEADERS = $(COMMON_HEADERS)
MAKEDEPEND_PRIVATE_HEADERS = [.UTIL.MAKEDEPEND]DEF.H, -
                             [.UTIL.MAKEDEPEND]IFPARSER.H, -
                             [.UTIL.IMAKE]IMAKEMDEP.H
MAKEDEPEND_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                       [.VMS-SUPPORT]HEADERS.MMS, -
                       [.VMS-SUPPORT.CONFIG.MAKEDEPEND]DESCRIP.MMS
! Preserve the upstream default include tree; native callers may supply -Y/-I.
MAKEDEPEND_STDINCDIR = /usr/include
MAKEDEPEND_OBJSUFFIX = .obj
! Path pointer differences are bounded by native filename and BUFSIZ limits.
MAKEDEPEND_INCLUDE_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Preserve the upstream int-sized diagnostic column index.
MAKEDEPEND_CPPSETUP_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Preserve the upstream int-sized variable-token callback lengths.
MAKEDEPEND_IFPARSER_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Expose native RTL POSIX signal and file-descriptor declarations.
MAKEDEPEND_MAIN_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /DEFINE=(_XOPEN_SOURCE=600,INCLUDEDIR=""""""$(MAKEDEPEND_STDINCDIR)"""""",OBJSUFFIX=""""""$(MAKEDEPEND_OBJSUFFIX)"""""")
MAKEDEPEND_OBJECTS = $(OUT).CONFIG.MAKEDEPEND]INCLUDE.OBJ, -
                     $(OUT).CONFIG.MAKEDEPEND]MAIN.OBJ, -
                     $(OUT).CONFIG.MAKEDEPEND]PARSE.OBJ, -
                     $(OUT).CONFIG.MAKEDEPEND]PR.OBJ, -
                     $(OUT).CONFIG.MAKEDEPEND]CPPSETUP.OBJ, -
                     $(OUT).CONFIG.MAKEDEPEND]IFPARSER.OBJ

MAKEDEPEND : $(OUT).CONFIG.MAKEDEPEND]MAKEDEPEND.EXE
	CONTINUE

$(OUT).CONFIG.MAKEDEPEND]INCLUDE.OBJ : [.UTIL.MAKEDEPEND]INCLUDE.C, -
    $(MAKEDEPEND_HEADERS), $(MAKEDEPEND_PRIVATE_HEADERS), $(MAKEDEPEND_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.MAKEDEPEND]INCLUDE "$(MAKEDEPEND_INCLUDE_CFLAGS)" MAKEDEPEND
$(OUT).CONFIG.MAKEDEPEND]MAIN.OBJ : [.UTIL.MAKEDEPEND]MAIN.C, -
    $(MAKEDEPEND_HEADERS), $(MAKEDEPEND_PRIVATE_HEADERS), $(MAKEDEPEND_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.MAKEDEPEND]MAIN "$(MAKEDEPEND_MAIN_CFLAGS)" MAKEDEPEND
$(OUT).CONFIG.MAKEDEPEND]PARSE.OBJ : [.UTIL.MAKEDEPEND]PARSE.C, -
    $(MAKEDEPEND_HEADERS), $(MAKEDEPEND_PRIVATE_HEADERS), $(MAKEDEPEND_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.MAKEDEPEND]PARSE "$(CFLAGS)" MAKEDEPEND
$(OUT).CONFIG.MAKEDEPEND]PR.OBJ : [.UTIL.MAKEDEPEND]PR.C, -
    $(MAKEDEPEND_HEADERS), $(MAKEDEPEND_PRIVATE_HEADERS), $(MAKEDEPEND_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.MAKEDEPEND]PR "$(CFLAGS)" MAKEDEPEND
$(OUT).CONFIG.MAKEDEPEND]CPPSETUP.OBJ : [.UTIL.MAKEDEPEND]CPPSETUP.C, -
    $(MAKEDEPEND_HEADERS), $(MAKEDEPEND_PRIVATE_HEADERS), $(MAKEDEPEND_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.MAKEDEPEND]CPPSETUP "$(MAKEDEPEND_CPPSETUP_CFLAGS)" MAKEDEPEND
$(OUT).CONFIG.MAKEDEPEND]IFPARSER.OBJ : [.UTIL.MAKEDEPEND]IFPARSER.C, -
    $(MAKEDEPEND_HEADERS), $(MAKEDEPEND_PRIVATE_HEADERS), $(MAKEDEPEND_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).CONFIG.MAKEDEPEND]IFPARSER "$(MAKEDEPEND_IFPARSER_CFLAGS)" MAKEDEPEND

$(OUT).CONFIG.MAKEDEPEND]MAKEDEPEND.EXE : $(MAKEDEPEND_OBJECTS), -
    [.VMS-SUPPORT.CONFIG.MAKEDEPEND]LINK.COM, -
    [.VMS-SUPPORT.CONFIG.MAKEDEPEND]DESCRIP.MMS
	@[.VMS-SUPPORT.CONFIG.MAKEDEPEND]LINK.COM
