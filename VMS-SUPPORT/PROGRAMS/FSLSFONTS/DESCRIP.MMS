! programs/fslsfonts/Imakefile's font-server font listing tool.
FSLSFONTS_HEADERS = $(FS_HEADERS)
FSLSFONTS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, -
                      [.VMS-SUPPORT.PROGRAMS.FSLSFONTS]DESCRIP.MMS
FSLSFONTS_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT

FSLSFONTS : $(OUT).PROGRAMS.FSLSFONTS]FSLSFONTS.EXE
	CONTINUE

$(OUT).PROGRAMS.FSLSFONTS]FSLSFONTS.OBJ : [.PROGRAMS.FSLSFONTS]FSLSFONTS.C, -
    $(FSLSFONTS_HEADERS), $(FSLSFONTS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.FSLSFONTS]FSLSFONTS "$(FSLSFONTS_CFLAGS)"

$(OUT).PROGRAMS.FSLSFONTS]FSLSFONTS.EXE : $(OUT).PROGRAMS.FSLSFONTS]FSLSFONTS.OBJ, -
    $(OUT).LIB.FS]FS.OLB, [.VMS-SUPPORT.PROGRAMS.FSLSFONTS]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.FSLSFONTS]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.FSLSFONTS]LINK.COM
