! Complete ordinary static Xp library from lib/Xp/Imakefile.
XP_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11]XAUTH.H, $(OUT).INCLUDE.X11]XRESOURCE.H, -
    $(OUT).INCLUDE.X11]XLOCALE.H, $(OUT).INCLUDE.X11]XOS_R.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRINT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRINTSTR.H
XP_PRIVATE_HEADERS = [.LIB.XP]XPEXTUTIL.H
XP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XP]DESCRIP.MMS
XP_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XP_OBJECTS = $(OUT).LIB.XP]XPATTR.OBJ, -
    $(OUT).LIB.XP]XPCONTEXT.OBJ, -
    $(OUT).LIB.XP]XPDOC.OBJ, -
    $(OUT).LIB.XP]XPEXTUTIL.OBJ, -
    $(OUT).LIB.XP]XPEXTVER.OBJ, -
    $(OUT).LIB.XP]XPGETDATA.OBJ, -
    $(OUT).LIB.XP]XPINPUT.OBJ, -
    $(OUT).LIB.XP]XPJOB.OBJ, -
    $(OUT).LIB.XP]XPLOCALE.OBJ, -
    $(OUT).LIB.XP]XPPAGE.OBJ, -
    $(OUT).LIB.XP]XPNOTIFYPDM.OBJ, -
    $(OUT).LIB.XP]XPPRINTER.OBJ, -
    $(OUT).LIB.XP]XPPUTDATA.OBJ, -
    $(OUT).LIB.XP]XPSCREENS.OBJ, -
    $(OUT).LIB.XP]XPPAGEDIM.OBJ, -
    $(OUT).LIB.XP]XPIMAGERES.OBJ

XP : $(OUT).LIB.XP]XP.OLB
	CONTINUE

$(OUT).LIB.XP]XPATTR.OBJ : [.LIB.XP]XPATTR.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPATTR "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPCONTEXT.OBJ : [.LIB.XP]XPCONTEXT.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPCONTEXT "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPDOC.OBJ : [.LIB.XP]XPDOC.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPDOC "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPEXTUTIL.OBJ : [.LIB.XP]XPEXTUTIL.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPEXTUTIL "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPEXTVER.OBJ : [.LIB.XP]XPEXTVER.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPEXTVER "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPGETDATA.OBJ : [.LIB.XP]XPGETDATA.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPGETDATA "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPINPUT.OBJ : [.LIB.XP]XPINPUT.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPINPUT "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPJOB.OBJ : [.LIB.XP]XPJOB.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPJOB "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPLOCALE.OBJ : [.LIB.XP]XPLOCALE.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPLOCALE "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPPAGE.OBJ : [.LIB.XP]XPPAGE.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPPAGE "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPNOTIFYPDM.OBJ : [.LIB.XP]XPNOTIFYPDM.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPNOTIFYPDM "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPPRINTER.OBJ : [.LIB.XP]XPPRINTER.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPPRINTER "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPPUTDATA.OBJ : [.LIB.XP]XPPUTDATA.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPPUTDATA "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPSCREENS.OBJ : [.LIB.XP]XPSCREENS.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPSCREENS "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPPAGEDIM.OBJ : [.LIB.XP]XPPAGEDIM.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPPAGEDIM "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XPIMAGERES.OBJ : [.LIB.XP]XPIMAGERES.C, -
    $(XP_HEADERS), $(XP_PRIVATE_HEADERS), $(XP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XP]XPIMAGERES "$(XP_CFLAGS)" XP

$(OUT).LIB.XP]XP.OLB : $(XP_OBJECTS), $(XP_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPATTR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPCONTEXT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPDOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPEXTUTIL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPEXTVER.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPGETDATA.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPINPUT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPJOB.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPLOCALE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPPAGE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPNOTIFYPDM.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPPRINTER.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPPUTDATA.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPSCREENS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPPAGEDIM.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XP]XPIMAGERES.OBJ
	LIBRARY/LIST=$(OUT).LIB.XP]XP_LIBRARY.LIS $(MMS$TARGET)
