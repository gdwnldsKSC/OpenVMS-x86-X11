! Native video-only Xorg using the ordinary upstream loader and VMware driver.
! BUILD XORG selects P64_XORG, separate from standalone library/Xvfb objects.
XORG_NATIVE_SOURCE = [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.OPENVMS]
XORG_NATIVE_OUT = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.OPENVMS]
XORG_BUILD_SOURCE = [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OPENVMS]
XORG_RULES = $(XORG_BUILD_SOURCE)DESCRIP.MMS, $(XORG_BUILD_SOURCE)SERVER_PROFILE.H, -
    $(XORG_BUILD_SOURCE)DRIVER_PROFILE.H, $(XORG_BUILD_SOURCE)LINK_XORG.COM, -
    $(XORG_BUILD_SOURCE)XORG_LINK_OPTIONS.C, $(XORG_BUILD_SOURCE)XORG_OBJECTS.DAT
XORG_NATIVE_HEADERS = $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), -
    $(XORG_NATIVE_SOURCE)OPENVMS_DLOPEN.H, $(XORG_NATIVE_SOURCE)OPENVMS_LOADER.H
XORG_NATIVE_OBJECTS = $(XORG_NATIVE_OUT)OPENVMS_INIT.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_IO.OBJ, $(XORG_NATIVE_OUT)OPENVMS_DLOPEN.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_MAIN.OBJ

XORG : XSERVER_CORE, XF86CONFIG, COMMON, XF86MODES, DDC, I2C, RAMDAC, BUS, MISC, -
    STUB, XORGXKB, LOADER, PCIACCESS, REGEX, XCVT, VGAHW, SHADOWFB, XF86_VIDEO_VMWARE, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ, $(XORG_NATIVE_OBJECTS), $(XORG_RULES)
	@$(XORG_BUILD_SOURCE)LINK_XORG.COM "$(XORG_BUILD_SOURCE)XORG_OBJECTS.DAT" "$(OUT).LINK]"

! All selected loadable modules depend on the same core export/image identity.
XORG_MODULES : XORG
	CONTINUE

$(XORG_NATIVE_OUT)OPENVMS_INIT.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_INIT.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_INIT "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_IO.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_IO.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_IO "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_DLOPEN.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_DLOPEN.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_DLOPEN "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_MAIN.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_MAIN.C, -
    $(XORG_NATIVE_SOURCE)OPENVMS_DLOPEN.H, $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_MAIN "$(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT" RTL_LOCAL
