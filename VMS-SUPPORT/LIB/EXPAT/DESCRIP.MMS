! Expat 2.9.0: upstream library modules and the native system entropy backend.
EXPAT_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE]EXPAT.H, -
                $(OUT).INCLUDE]EXPAT_EXTERNAL.H, $(OUT).INCLUDE]EXPAT_CONFIG.H
EXPAT_PRIVATE_HEADERS = [.VMS-SUPPORT.LIB.EXPAT]EXPAT_CONFIG.H, -
                        [.EXTRAS.EXPAT.LIB]ASCII.H, -
                        [.EXTRAS.EXPAT.LIB]ASCIITAB.H, -
                        [.EXTRAS.EXPAT.LIB]IASCIITAB.H, -
                        [.EXTRAS.EXPAT.LIB]INTERNAL.H, -
                        [.EXTRAS.EXPAT.LIB]LATIN1TAB.H, -
                        [.EXTRAS.EXPAT.LIB]NAMETAB.H, -
                        [.EXTRAS.EXPAT.LIB]UTF8TAB.H, -
                        [.EXTRAS.EXPAT.LIB]XMLROLE.H, -
                        [.EXTRAS.EXPAT.LIB]XMLTOK.H, -
                        [.EXTRAS.EXPAT.LIB]XMLTOK_IMPL.H, -
                        [.EXTRAS.EXPAT.LIB]FALLTHROUGH.H, -
                        [.EXTRAS.EXPAT.LIB]HASH_TABLE.H, -
                        [.EXTRAS.EXPAT.LIB]MEMORY_SANITIZER.H, -
                        [.EXTRAS.EXPAT.LIB]RANDOM_GETENTROPY.H, -
                        [.EXTRAS.EXPAT.LIB]SIPHASH.H, [.EXTRAS.EXPAT.LIB]XCS.H
EXPAT_TEMPLATES = [.EXTRAS.EXPAT.LIB]XMLTOK_IMPL.C, [.EXTRAS.EXPAT.LIB]XMLTOK_NS.C
EXPAT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                   [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.EXPAT]DESCRIP.MMS
EXPAT_CFLAGS = $(CFLAGS)
! Preserve upstream int/size_t counts when narrowing P64 buffer offsets.
EXPAT_COUNT_CFLAGS = $(EXPAT_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
EXPAT_OBJECTS = $(OUT).LIB.EXPAT]XMLPARSE.OBJ, $(OUT).LIB.EXPAT]XMLTOK.OBJ, -
                $(OUT).LIB.EXPAT]XMLROLE.OBJ, $(OUT).LIB.EXPAT]XCS.OBJ, -
                $(OUT).LIB.EXPAT]RANDOM_VMS.OBJ

EXPAT : $(OUT).LIB.EXPAT]EXPAT.OLB
	CONTINUE

$(OUT).INCLUDE]EXPAT.H : [.EXTRAS.EXPAT.LIB]EXPAT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE]EXPAT_EXTERNAL.H : [.EXTRAS.EXPAT.LIB]EXPAT_EXTERNAL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE]EXPAT_CONFIG.H : [.VMS-SUPPORT.LIB.EXPAT]EXPAT_CONFIG.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.EXPAT]XMLPARSE.OBJ : [.EXTRAS.EXPAT.LIB]XMLPARSE.C, $(EXPAT_HEADERS), -
    $(EXPAT_PRIVATE_HEADERS), $(EXPAT_BUILD_RULES), $(RTL)
! VSI C optimization miscomputes the unsigned-64 amplification ratio at 8 MiB.
! Keep the upstream source and security limits intact; other objects optimize.
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.EXPAT]XMLPARSE "$(EXPAT_COUNT_CFLAGS)/NOOPTIMIZE" EXPAT
$(OUT).LIB.EXPAT]XMLTOK.OBJ : [.EXTRAS.EXPAT.LIB]XMLTOK.C, $(EXPAT_HEADERS), -
    $(EXPAT_PRIVATE_HEADERS), $(EXPAT_TEMPLATES), $(EXPAT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.EXPAT]XMLTOK "$(EXPAT_COUNT_CFLAGS)" EXPAT
$(OUT).LIB.EXPAT]XMLROLE.OBJ : [.EXTRAS.EXPAT.LIB]XMLROLE.C, $(EXPAT_HEADERS), -
    $(EXPAT_PRIVATE_HEADERS), $(EXPAT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.EXPAT]XMLROLE "$(EXPAT_CFLAGS)" EXPAT
$(OUT).LIB.EXPAT]XCS.OBJ : [.EXTRAS.EXPAT.LIB]XCS.C, $(EXPAT_HEADERS), -
    $(EXPAT_PRIVATE_HEADERS), $(EXPAT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.EXPAT]XCS "$(EXPAT_CFLAGS)" EXPAT
$(OUT).LIB.EXPAT]RANDOM_VMS.OBJ : [.VMS-SUPPORT.LIB.EXPAT]RANDOM_VMS.C, $(EXPAT_HEADERS), -
    $(EXPAT_PRIVATE_HEADERS), $(EXPAT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.EXPAT]RANDOM_VMS "$(EXPAT_CFLAGS)" EXPAT

$(OUT).LIB.EXPAT]EXPAT.OLB : $(EXPAT_OBJECTS), [.VMS-SUPPORT.LIB.EXPAT]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(EXPAT_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.EXPAT]EXPAT_LIBRARY.LIS $(MMS$TARGET)
