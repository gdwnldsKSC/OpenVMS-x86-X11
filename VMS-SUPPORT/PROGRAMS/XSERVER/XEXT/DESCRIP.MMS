! Static ext library from the upstream Xext Imakefile.
! Ten unconditional objects; ScreenSaver, FontCache, DPMS, XVideo/XvMC and XRes.
! Native P64 pointers and long32; remaining optional/loadable sections excluded.
EXT_HEADERS = $(RENDER_HEADERS), -
    $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPESTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MITMISC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MITMISCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTEST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTEXT1.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]BIGREQSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SAVER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SAVERPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XCMISCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRINT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRINTSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHEP.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMSSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMCPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRESPROTO.H
EXT_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.XEXT.EXTMOD]MODINIT.H, -
    [.PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.H, -
    [.PROGRAMS.XSERVER.XEXT]XTEST1DD.H, -
    [.PROGRAMS.XSERVER.XEXT]DPMSPROC.H, -
    [.PROGRAMS.XSERVER.XEXT]XVDIX.H, -
    [.PROGRAMS.XSERVER.XEXT]XVDISP.H, -
    [.PROGRAMS.XSERVER.XEXT]XVMCEXT.H, -
    [.PROGRAMS.XSERVER.XPRINT]DIPRINT.H, -
    [.PROGRAMS.XSERVER.XPRINT]ATTRIBUTES.H, -
    [.PROGRAMS.XSERVER.XPRINT]ATTRVALID.H, -
    [.PROGRAMS.XSERVER.XPRINT]OID.H, -
    [.PROGRAMS.XSERVER.XPRINT]OIDDEFS.H
EXT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XEXT]DESCRIP.MMS
EXT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Expose SDK timeval/gettimeofday and select Xos.h's matching two-argument call.
! Preserve the upstream mixed-case feature names through the quoted DCL argument.
EXT_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,SHAPE,MITMISC,XTEST,XTESTEXT1,XSYNC,BIGREQS,XCMISC,SCREENSAVER,FONTCACHE,""DPMSExtension"",XV,XVMC,""XvMCExtension"",RES,""XResExtension"",_XOPEN_SOURCE_EXTENDED=1,_XOPEN_UNIX=1,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

EXT_OBJECTS = $(OUT).PROGRAMS.XSERVER.XEXT]SHAPE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]MITMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XTEST.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]SYNC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]SAVER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XCMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XPRINT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]FONTCACHE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]DPMS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XRES.OBJ

EXT : $(OUT).PROGRAMS.XSERVER.XEXT]EXT.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.XEXT]SHAPE.OBJ : [.PROGRAMS.XSERVER.XEXT]SHAPE.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SHAPE "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]MITMISC.OBJ : [.PROGRAMS.XSERVER.XEXT]MITMISC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]MITMISC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XTEST.OBJ : [.PROGRAMS.XSERVER.XEXT]XTEST.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XTEST "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DI.OBJ : [.PROGRAMS.XSERVER.XEXT]XTEST1DI.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DI "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DD.OBJ : [.PROGRAMS.XSERVER.XEXT]XTEST1DD.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DD "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.OBJ : [.PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ.OBJ : [.PROGRAMS.XSERVER.XEXT]BIGREQ.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]SYNC.OBJ : [.PROGRAMS.XSERVER.XEXT]SYNC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SYNC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]SAVER.OBJ : [.PROGRAMS.XSERVER.XEXT]SAVER.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SAVER "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XCMISC.OBJ : [.PROGRAMS.XSERVER.XEXT]XCMISC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XCMISC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XPRINT.OBJ : [.PROGRAMS.XSERVER.XEXT]XPRINT.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XPRINT "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]FONTCACHE.OBJ : [.PROGRAMS.XSERVER.XEXT]FONTCACHE.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]FONTCACHE "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]DPMS.OBJ : [.PROGRAMS.XSERVER.XEXT]DPMS.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]DPMS "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ : [.PROGRAMS.XSERVER.XEXT]XVMAIN.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ : [.PROGRAMS.XSERVER.XEXT]XVDISP.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XVDISP "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ : [.PROGRAMS.XSERVER.XEXT]XVMC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XVMC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XRES.OBJ : [.PROGRAMS.XSERVER.XEXT]XRES.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XRES "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]EXT.OLB : $(EXT_OBJECTS), $(EXT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XEXT]SHAPE.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]MITMISC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XTEST.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DI.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XTEST1DD.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]SYNC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]SAVER.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XCMISC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XPRINT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XEXT]FONTCACHE.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]DPMS.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XRES.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XEXT]EXT_LIBRARY.LIS $(MMS$TARGET)
