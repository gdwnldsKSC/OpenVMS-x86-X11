! Complete static Xdamage client library from lib/Xdamage/Imakefile.
XDAMAGE_HEADERS = $(XFIXESLIB_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XDAMAGE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DAMAGEWIRE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DAMAGEPROTO.H
XDAMAGE_PRIVATE_HEADERS = [.LIB.LIBXDAMAGE.SRC]XDAMAGEINT.H, [.LIB.LIBXDAMAGE.INCLUDE.X11.EXTENSIONS]XDAMAGE.H
XDAMAGE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XFIXES]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XDAMAGE]DESCRIP.MMS
XDAMAGE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XDAMAGE_OBJECTS = $(OUT).LIB.XDAMAGE]XDAMAGE.OBJ

XDAMAGE : $(OUT).LIB.XDAMAGE]XDAMAGE.OLB
	CONTINUE

$(OUT).LIB.XDAMAGE]XDAMAGE.OBJ : [.LIB.LIBXDAMAGE.SRC]XDAMAGE.C, -
    $(XDAMAGE_HEADERS), $(XDAMAGE_PRIVATE_HEADERS), $(XDAMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDAMAGE]XDAMAGE "$(XDAMAGE_CFLAGS)" XDAMAGE

$(OUT).LIB.XDAMAGE]XDAMAGE.OLB : $(XDAMAGE_OBJECTS), $(XDAMAGE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XDAMAGE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XDAMAGE]XDAMAGE_LIBRARY.LIS $(MMS$TARGET)
