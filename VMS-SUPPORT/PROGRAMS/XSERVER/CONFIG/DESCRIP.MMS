! Portable upstream libconfig.a profile; optional D-Bus/HAL/udev backends excluded.
CONFIG_HEADERS = $(DIX_HEADERS)
CONFIG_PRIVATE_HEADERS = $(DIX_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.INCLUDE]HOTPLUG.H, -
    [.XSERVER.XORG-SERVER.CONFIG]CONFIG-BACKENDS.H
CONFIG_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CONFIG]DESCRIP.MMS, -
    [.XSERVER.XORG-SERVER.CONFIG]MAKEFILE.AM
CONFIG_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
CONFIG_CPPFLAGS = /DEFINE=($(DIX_CPP_DEFINES),_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1)
CONFIG_OBJECTS = $(OUT).PROGRAMS.XSERVER.CONFIG]CONFIG.OBJ

CONFIG : $(OUT).PROGRAMS.XSERVER.CONFIG]CONFIG.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.CONFIG]CONFIG.OBJ : [.XSERVER.XORG-SERVER.CONFIG]CONFIG.C, -
    $(CONFIG_HEADERS), $(CONFIG_PRIVATE_HEADERS), $(CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.CONFIG]CONFIG "$(CONFIG_CFLAGS)" CONFIG "$(CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.CONFIG]CONFIG.OLB : $(CONFIG_OBJECTS), $(CONFIG_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(CONFIG_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.CONFIG]CONFIG_LIBRARY.LIS $(MMS$TARGET)
