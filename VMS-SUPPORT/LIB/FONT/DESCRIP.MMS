! lib/font/Imakefile normal library with bitmap, Speedo and FreeType renderers.
! Includes builtin-font and fontcache APIs; Type1/CID and fontencc excluded.
.INCLUDE [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.BITMAP]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.FONTFILE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.FC]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.BUILTINS]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.FONTCACHE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.FREETYPE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.SPEEDO]DESCRIP.MMS

XFONT_HEADERS = $(FONT_UTIL_HEADERS), $(FONT_BITMAP_HEADERS), -
                $(FONT_FONTFILE_HEADERS), $(FONT_FC_HEADERS), -
                $(FONT_BUILTINS_HEADERS), $(FONT_FONTCACHE_HEADERS), -
                $(FONT_FREETYPE_HEADERS), $(FONT_SPEEDO_HEADERS)
XFONT_OBJECTS = $(FONT_BITMAP_OBJECTS), $(FONT_FONTFILE_OBJECTS), -
                $(FONT_FC_OBJECTS), $(FONT_UTIL_OBJECTS), -
                $(FONT_BUILTINS_OBJECTS), $(FONT_FONTCACHE_OBJECTS), -
                $(FONT_FREETYPE_OBJECTS), $(FONT_SPEEDO_OBJECTS)
XFONT_BUILD_RULES = [.VMS-SUPPORT.LIB.FONT]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.BITMAP]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.FONTFILE]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.FC]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.BUILTINS]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.FONTCACHE]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.FREETYPE]DESCRIP.MMS, -
                    [.VMS-SUPPORT.LIB.FONT.SPEEDO]DESCRIP.MMS

XFONT : $(OUT).LIB.FONT]XFONT.OLB, $(OUT).LIB.ZLIB]Z.OLB, $(OUT).LIB.FREETYPE2]FREETYPE.OLB
	CONTINUE

$(OUT).LIB.FONT]XFONT.OLB : $(XFONT_OBJECTS), $(XFONT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FONT_BITMAP_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_FONTFILE_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_FC_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_UTIL_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_BUILTINS_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_FONTCACHE_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_FREETYPE_OBJECTS)
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(FONT_SPEEDO_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FONT]XFONT_LIBRARY.LIS $(MMS$TARGET)
