! Complete static xkb and generic xkbstubs from the upstream Makefile.am.
! Upstream linked sources are copied byte-for-byte into the module output.
! Generic DDX objects are used; optional XFree86 action variants are excluded.
XKB_HEADERS = $(DIX_HEADERS), $(XTRANS_HEADERS), $(OUT).INCLUDE.X11]KEYSYM.H, -
    $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11]XOS_R.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBGEOM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBSRV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBFILE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKMFORMAT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBRULES.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBCONFIG.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBBELLS.H
XKB_PRIVATE_HEADERS = $(DIX_PRIVATE_HEADERS), [.XSERVER.XORG-SERVER.XKB]XKB.H, -
    [.XSERVER.XORG-SERVER.XKB]XKBDFLTS.H, [.XSERVER.XORG-SERVER.INCLUDE]XKBSRV.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]XKBFILE.H
XKB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XKB]DESCRIP.MMS
XKB_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Same-buffer lengths and array indices retain upstream int-sized counts.
XKB_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XKB_PATH_DEFINES = XKB_BASE_DIRECTORY=""""""$(XKB_CONFIG_ROOT)"""""", -
    XKB_BIN_DIRECTORY=""""""$(XKB_BIN_DIRECTORY)"""""", -
    XKB_DFLT_RULES=""""""$(XKB_RULES)"""""",XKB_DFLT_MODEL=""""""$(XKB_MODEL)"""""", -
    XKB_DFLT_LAYOUT=""""""$(XKB_LAYOUT)"""""", -
    XKB_DFLT_VARIANT="""""""""""",XKB_DFLT_OPTIONS="""""""""""", -
    XKM_OUTPUT_DIR=""""""$(XKM_OUTPUT_DIR)"""""", -
    _PATH_VARTMP=""""""$(XKM_OUTPUT_DIR)""""""
XKB_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,XINPUT,XKB,XKB_IN_SERVER,NO_ALLOCA, -
    _XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,$(XKB_PATH_DEFINES)$(XKB_DDX_DEFINES))
XKB_INIT_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,XINPUT,XKB,XKB_IN_SERVER,NO_ALLOCA, -
    _XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1, -
    GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,$(XKB_PATH_DEFINES)$(XKB_DDX_DEFINES))

XKB_OBJECTS = $(OUT).PROGRAMS.XSERVER.XKB]XKB.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBUTILS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBEVENTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBACCESSX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBSWAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBLEDS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBACTIONS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBPRKEYEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKMREAD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]MAPRULES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBMALLOC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBALLOC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBGALLOC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXBEEP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXCTRLS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXFAKEMTN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXKILLSRV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXLEDS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXVT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXLOAD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXLIST.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXDEVBTN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]DDXPRIVATE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBOUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XKB]XKBTEXT.OBJ

XKB : $(OUT).PROGRAMS.XSERVER.XKB]XKB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.XKB]XKMREAD.C : [.XSERVER.XORG-SERVER.XKB]XKMREAD.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC.C : [.XSERVER.XORG-SERVER.XKB]XKBFMISC.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]MAPRULES.C : [.XSERVER.XORG-SERVER.XKB]MAPRULES.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKBMISC.C : [.XSERVER.XORG-SERVER.XKB]XKBMISC.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKBMALLOC.C : [.XSERVER.XORG-SERVER.XKB]XKBMALLOC.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKBALLOC.C : [.XSERVER.XORG-SERVER.XKB]XKBALLOC.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKBGALLOC.C : [.XSERVER.XORG-SERVER.XKB]XKBGALLOC.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKB.OBJ : [.XSERVER.XORG-SERVER.XKB]XKB.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKB "$(XKB_COUNT_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBUTILS.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBUTILS.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBUTILS "$(XKB_COUNT_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBEVENTS.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBEVENTS.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBEVENTS "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBACCESSX.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBACCESSX.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBACCESSX "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

