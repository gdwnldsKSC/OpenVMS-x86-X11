	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBGALLOC "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXBEEP.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXBEEP.C, -
