! Complete lib/font/bitmap/Imakefile section; consumers also link fontfile and util.
FONT_BITMAP_HEADERS = $(FONT_UTIL_HEADERS), -
                      $(OUT).INCLUDE.X11.FONTS]BDFINT.H, -
                      $(OUT).INCLUDE.X11.FONTS]PCF.H
FONT_BITMAP_PRIVATE_HEADERS = [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTMISC.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTUTIL.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTXLFD.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILST.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFIL.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BUFIO.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILIO.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BITMAP.H, -
                               [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BDFINT.H, [.LIB.LIBXFONT.INCLUDE.X11.FONTS]PCF.H, -
                               [.LIB.LIBXFONT.SRC.BITMAP]SNFSTR.H
FONT_BITMAP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                          [.VMS-SUPPORT]HEADERS.MMS, -
                          [.VMS-SUPPORT.LIB.FONT.BITMAP]DESCRIP.MMS
! Preserve upstream int-sized line/glyph counts and PCF indices with P64 pointers.
FONT_BITMAP_DEFINES = BDFFORMAT,PCFFORMAT,SNFFORMAT
FONT_BITMAP_CFLAGS = $(CFLAGS)/DEFINE=($(FONT_BITMAP_DEFINES))
FONT_BITMAP_GZIP_CFLAGS = $(CFLAGS)/DEFINE=($(FONT_BITMAP_DEFINES),X_GZIP_FONT_COMPRESSION)
FONT_BITMAP_COUNT_CFLAGS = $(FONT_BITMAP_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Scaled XLFD properties retain upstream int-sized substring lengths.
FONT_BITMAP_GZIP_COUNT_CFLAGS = $(FONT_BITMAP_GZIP_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONT_BITMAP_OBJECTS = $(OUT).LIB.FONT.BITMAP]BDFREAD.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BDFUTILS.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BITMAP.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BITMAPUTIL.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BITSCALE.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BITMAPFUNC.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]PCFREAD.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]PCFWRITE.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]SNFREAD.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]FONTINK.OBJ

$(OUT).INCLUDE.X11.FONTS]BDFINT.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BDFINT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]PCF.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]PCF.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)


$(OUT).LIB.FONT.BITMAP]BDFREAD.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]BDFREAD.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BDFREAD "$(FONT_BITMAP_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BDFUTILS.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]BDFUTILS.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BDFUTILS "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BITMAP.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]BITMAP.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BITMAP "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BITMAPUTIL.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]BITMAPUTIL.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BITMAPUTIL "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BITSCALE.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]BITSCALE.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BITSCALE "$(FONT_BITMAP_GZIP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BITMAPFUNC.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]BITMAPFUNC.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BITMAPFUNC "$(FONT_BITMAP_GZIP_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]PCFREAD.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]PCFREAD.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]PCFREAD "$(FONT_BITMAP_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]PCFWRITE.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]PCFWRITE.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]PCFWRITE "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]SNFREAD.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]SNFREAD.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]SNFREAD "$(FONT_BITMAP_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]FONTINK.OBJ : [.LIB.LIBXFONT.SRC.BITMAP]FONTINK.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]FONTINK "$(FONT_BITMAP_CFLAGS)" FONT_BITMAP
