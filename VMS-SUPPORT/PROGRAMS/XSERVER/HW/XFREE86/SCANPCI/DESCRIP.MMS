! Complete static libscanpci, including the full independently supplied PCI IDs.
! Do not link PCIDATA as well: upstream documents their duplicate namespace.
SCANPCI_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]GENERATE_IDS.COM
SCANPCI_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]XF86SCANPCI.OBJ

SCANPCI : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]SCANPCI.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]XF86PCIIDS.H : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SCANPCI]PCIID2C.PL, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SCANPCI]PCI.IDS, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SCANPCI]EXTRAPCI.IDS, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PCIINFO.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SCANPCI]MAKEFILE.AM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]GENERATE_IDS.COM
	@[.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]GENERATE_IDS.COM

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]XF86SCANPCI.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SCANPCI]XF86SCANPCI.C, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]XF86PCIIDS.H, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(SCANPCI_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]XF86SCANPCI "$(XF86COMMON_CFLAGS)" SCANPCI "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]SCANPCI.OLB : $(SCANPCI_OBJECTS), $(SCANPCI_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(SCANPCI_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SCANPCI]SCANPCI_LIBRARY.LIS $(MMS$TARGET)
