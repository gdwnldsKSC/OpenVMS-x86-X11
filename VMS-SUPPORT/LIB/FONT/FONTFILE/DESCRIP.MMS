! Complete lib/font/fontfile/Imakefile section with gzip; optional fontencc excluded.
FONT_FONTFILE_HEADERS = $(FONTUTIL_HEADERS), $(ZLIB_HEADERS), $(FONTENC_HEADERS), -
                        $(OUT).INCLUDE.X11]KEYSYM.H
FONT_FONTFILE_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
                                 [.LIB.FONT.INCLUDE]FONTXLFD.H, -
                                 [.LIB.FONT.INCLUDE]FNTFILST.H, -
                                 [.LIB.FONT.INCLUDE]FNTFIL.H, -
                                 [.LIB.FONT.INCLUDE]BITMAP.H, -
                                 [.LIB.FONT.INCLUDE]BUFIO.H, [.LIB.FONT.INCLUDE]FNTFILIO.H, -
                                 [.LIB.FONT.FONTFILE]FONTENCI.H
FONT_FONTFILE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                            [.VMS-SUPPORT]HEADERS.MMS, -
                            [.VMS-SUPPORT.LIB.FONT.FONTFILE]DESCRIP.MMS, -
                            [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS
! Use the same configurable full encoding-index filename as standalone fontenc.
FONT_FONTFILE_CFLAGS = $(CFLAGS) -
    /DEFINE=(FONTDIRATTRIB,X_GZIP_FONT_COMPRESSION,FONT_ENCODINGS_DIRECTORY=""""""$(FONTENC_INDEX)"""""")
! Buffer differences are bounded by BUFFILESIZE; preserve upstream int counts.
FONT_FONTFILE_COUNT_CFLAGS = $(FONT_FONTFILE_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Expose installed RTL declarations for upstream fileno/strcasecmp calls.
! Xfuncs replaces equivalent RTL bcopy/bzero macros in these three modules.
FONT_FONTFILE_POSIX_CFLAGS = $(FONT_FONTFILE_CFLAGS)/STANDARD=RELAXED_ANSI89/WARNINGS=(ENABLE=LEVEL4,DISABLE=MACROREDEF)
! Keep upstream directory/XLFD offset counts without changing pointer width.
FONT_FONTFILE_POSIX_COUNT_CFLAGS = $(FONT_FONTFILE_POSIX_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,MACROREDEF))
! BUFIO's private field encodes an int fd, not a dereferenceable pointer.
FONT_FONTFILE_BUF_CFLAGS = $(FONT_FONTFILE_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,POINTERINTCAST))
FONT_FONTFILE_OBJECTS = $(OUT).LIB.FONT.FONTFILE]DIRFILE.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FONTDIR.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FONTFILE.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FILEIO.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FONTSCALE.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]DEFAULTS.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]BITSOURCE.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]REGISTER.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]RENDERERS.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]BUFIO.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]DECOMPRESS.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FILEWR.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]PRINTERFONT.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FFCHECK.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]FONTENC.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]ENCPARSE.OBJ, -
                         $(OUT).LIB.FONT.FONTFILE]GUNZIP.OBJ

FONTFILE : $(OUT).LIB.FONT.FONTFILE]FONTFILE.OLB, $(OUT).LIB.FONTUTIL]FONTUTIL.OLB, -
           $(OUT).LIB.ZLIB]Z.OLB
	CONTINUE

$(OUT).LIB.FONT.FONTFILE]DIRFILE.OBJ : [.LIB.FONT.FONTFILE]DIRFILE.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]DIRFILE "$(FONT_FONTFILE_POSIX_COUNT_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FONTDIR.OBJ : [.LIB.FONT.FONTFILE]FONTDIR.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FONTDIR "$(FONT_FONTFILE_COUNT_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FONTFILE.OBJ : [.LIB.FONT.FONTFILE]FONTFILE.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FONTFILE "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FILEIO.OBJ : [.LIB.FONT.FONTFILE]FILEIO.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FILEIO "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FONTSCALE.OBJ : [.LIB.FONT.FONTFILE]FONTSCALE.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FONTSCALE "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]DEFAULTS.OBJ : [.LIB.FONT.FONTFILE]DEFAULTS.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]DEFAULTS "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]BITSOURCE.OBJ : [.LIB.FONT.FONTFILE]BITSOURCE.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]BITSOURCE "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]REGISTER.OBJ : [.LIB.FONT.FONTFILE]REGISTER.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]REGISTER "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]RENDERERS.OBJ : [.LIB.FONT.FONTFILE]RENDERERS.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]RENDERERS "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]BUFIO.OBJ : [.LIB.FONT.FONTFILE]BUFIO.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]BUFIO "$(FONT_FONTFILE_BUF_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]DECOMPRESS.OBJ : [.LIB.FONT.FONTFILE]DECOMPRESS.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]DECOMPRESS "$(FONT_FONTFILE_COUNT_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FILEWR.OBJ : [.LIB.FONT.FONTFILE]FILEWR.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FILEWR "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]PRINTERFONT.OBJ : [.LIB.FONT.FONTFILE]PRINTERFONT.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]PRINTERFONT "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FFCHECK.OBJ : [.LIB.FONT.FONTFILE]FFCHECK.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FFCHECK "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FONTENC.OBJ : [.LIB.FONT.FONTFILE]FONTENC.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]FONTENC "$(FONT_FONTFILE_POSIX_COUNT_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]ENCPARSE.OBJ : [.LIB.FONT.FONTFILE]ENCPARSE.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]ENCPARSE "$(FONT_FONTFILE_POSIX_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]GUNZIP.OBJ : [.LIB.FONT.FONTFILE]GUNZIP.C, -
    $(FONT_FONTFILE_HEADERS), $(FONT_FONTFILE_PRIVATE_HEADERS), $(FONT_FONTFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTFILE]GUNZIP "$(FONT_FONTFILE_CFLAGS)" FONT_FONTFILE

$(OUT).LIB.FONT.FONTFILE]FONTFILE.OLB : $(FONT_FONTFILE_OBJECTS), [.VMS-SUPPORT.LIB.FONT.FONTFILE]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FONT_FONTFILE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FONT.FONTFILE]FONTFILE_LIBRARY.LIS $(MMS$TARGET)
