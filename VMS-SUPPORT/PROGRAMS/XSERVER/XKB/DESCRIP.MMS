    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBSWAP "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBLEDS.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBLEDS.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBLEDS "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBINIT.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBINIT.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBINIT "$(XKB_CFLAGS)" XKB "$(XKB_INIT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBACTIONS.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBACTIONS.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBACTIONS "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBPRKEYEV.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBPRKEYEV.C, -
