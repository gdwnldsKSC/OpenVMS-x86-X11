! Mirrors all seven objects in lib/SM/Imakefile, using the ICE library.
SM_HEADERS = $(COMMON_HEADERS), $(XTRANS_HEADERS), $(OUT).INCLUDE.X11]XMD.H, -
             $(OUT).INCLUDE.X11]XOS_R.H, -
             $(OUT).INCLUDE.X11.ICE]ICE.H, -
             $(OUT).INCLUDE.X11.ICE]ICECONN.H, -
             $(OUT).INCLUDE.X11.ICE]ICEPROTO.H, -
             $(OUT).INCLUDE.X11.ICE]ICELIB.H, -
             $(OUT).INCLUDE.X11.ICE]ICEMSG.H, -
             $(OUT).INCLUDE.X11.SM]SM.H, -
             $(OUT).INCLUDE.X11.SM]SMPROTO.H, -
             $(OUT).INCLUDE.X11.SM]SMLIB.H
SM_PRIVATE_HEADERS = [.LIB.LIBSM.SRC]SMLIBINT.H, [.LIB.LIBSM.SRC]GLOBALS.H
SM_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                 [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.SM]DESCRIP.MMS
! Double quotes preserve the lowercase t through COMPILE.COM's argument string.
SM_CONN_CFLAGS = $(CFLAGS)/DEFINE=(""ICE_t"",TCPCONN)
! Relative pointer differences feed upstream's int address/message counts.
SM_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
SM_GENID_CFLAGS = $(SM_CONN_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
SM_OBJECTS = $(OUT).LIB.SM]SM_CLIENT.OBJ, -
             $(OUT).LIB.SM]SM_GENID.OBJ, -
             $(OUT).LIB.SM]SM_MANAGER.OBJ, -
             $(OUT).LIB.SM]SM_PROCESS.OBJ, -
             $(OUT).LIB.SM]SM_ERROR.OBJ, -
             $(OUT).LIB.SM]SM_MISC.OBJ, -
             $(OUT).LIB.SM]SM_AUTH.OBJ

SM : $(OUT).LIB.SM]SM.OLB, $(OUT).LIB.ICE]ICE.OLB
	CONTINUE

$(OUT).LIB.SM]SM_CLIENT.OBJ : [.LIB.LIBSM.SRC]SM_CLIENT.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_CLIENT "$(CFLAGS)" SM

$(OUT).LIB.SM]SM_GENID.OBJ : [.LIB.LIBSM.SRC]SM_GENID.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_GENID "$(SM_GENID_CFLAGS)" SM

$(OUT).LIB.SM]SM_MANAGER.OBJ : [.LIB.LIBSM.SRC]SM_MANAGER.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_MANAGER "$(SM_CONN_CFLAGS)" SM

$(OUT).LIB.SM]SM_PROCESS.OBJ : [.LIB.LIBSM.SRC]SM_PROCESS.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_PROCESS "$(SM_COUNT_CFLAGS)" SM

$(OUT).LIB.SM]SM_ERROR.OBJ : [.LIB.LIBSM.SRC]SM_ERROR.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_ERROR "$(CFLAGS)" SM

$(OUT).LIB.SM]SM_MISC.OBJ : [.LIB.LIBSM.SRC]SM_MISC.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_MISC "$(CFLAGS)" SM

$(OUT).LIB.SM]SM_AUTH.OBJ : [.LIB.LIBSM.SRC]SM_AUTH.C, -
    $(SM_HEADERS), $(SM_PRIVATE_HEADERS), $(SM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.SM]SM_AUTH "$(CFLAGS)" SM

$(OUT).LIB.SM]SM.OLB : $(SM_OBJECTS), [.VMS-SUPPORT.LIB.SM]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(SM_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.SM]SM_LIBRARY.LIS $(MMS$TARGET)

$(OUT).INCLUDE.X11.SM]SM.H : [.LIB.LIBSM.INCLUDE.X11.SM]SM.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.SM]SMPROTO.H : [.LIB.LIBSM.INCLUDE.X11.SM]SMPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.SM]SMLIB.H : [.LIB.LIBSM.INCLUDE.X11.SM]SMLIB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
