! Complete ordinary static xtrap library from the upstream Imakefile.
! Public server and protocol headers; loadable, PC and X Input hooks excluded.
XTRAP_HEADERS = $(DIX_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTRAPDI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTRAPDDMI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTRAPBITS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTRAPPROTO.H
XTRAP_PRIVATE_HEADERS = $(DIX_PRIVATE_HEADERS)
XTRAP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XTRAP]DESCRIP.MMS
XTRAP_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Only XTRAPDI decodes bounded client-index cookies, not memory addresses.
XTRAP_DI_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
XTRAP_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

XTRAP_OBJECTS = $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDDMI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDISWP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDITBL.OBJ

XTRAP : $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAP.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDDMI.OBJ : [.XSERVER.XORG-SERVER.XTRAP]XTRAPDDMI.C, -
    $(XTRAP_HEADERS), $(XTRAP_PRIVATE_HEADERS), $(XTRAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDDMI "$(XTRAP_CFLAGS)" XTRAP "$(XTRAP_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDI.OBJ : [.XSERVER.XORG-SERVER.XTRAP]XTRAPDI.C, -
    $(XTRAP_HEADERS), $(XTRAP_PRIVATE_HEADERS), $(XTRAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDI "$(XTRAP_DI_CFLAGS)" XTRAP "$(XTRAP_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDISWP.OBJ : [.XSERVER.XORG-SERVER.XTRAP]XTRAPDISWP.C, -
    $(XTRAP_HEADERS), $(XTRAP_PRIVATE_HEADERS), $(XTRAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDISWP "$(XTRAP_CFLAGS)" XTRAP "$(XTRAP_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDITBL.OBJ : [.XSERVER.XORG-SERVER.XTRAP]XTRAPDITBL.C, -
    $(XTRAP_HEADERS), $(XTRAP_PRIVATE_HEADERS), $(XTRAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDITBL "$(XTRAP_CFLAGS)" XTRAP "$(XTRAP_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XTRAP]XTRAP.OLB : $(XTRAP_OBJECTS), $(XTRAP_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDDMI.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDI.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDISWP.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XTRAP]XTRAPDITBL.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XTRAP]XTRAP_LIBRARY.LIS $(MMS$TARGET)
