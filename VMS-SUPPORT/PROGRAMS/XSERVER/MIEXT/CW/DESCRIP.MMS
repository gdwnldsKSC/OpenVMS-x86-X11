! Complete ordinary static Composite wrapper library from the upstream Imakefile.
! Native P64 pointers and long32; no XFree86 loadable module support is selected.
CW_HEADERS = $(COMPOSITE_HEADERS)
CW_PRIVATE_HEADERS = $(COMPOSITE_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.MIEXT.CW]CW.H
CW_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XFIXES]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.COMPOSITE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.CW]DESCRIP.MMS
CW_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! CW assertions use the upstream spelling for the C99 function-name identifier.
CW_CPPFLAGS = /DEFINE=(COMPOSITE,XFIXES,DAMAGE,PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,""__FUNC__=__func__"")

CW_OBJECTS = $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_OPS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_RENDER.OBJ

CW : $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW.OBJ : [.PROGRAMS.XSERVER.MIEXT.CW]CW.C, -
    $(CW_HEADERS), $(CW_PRIVATE_HEADERS), $(CW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW "$(CW_CFLAGS)" CW "$(CW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_OPS.OBJ : [.PROGRAMS.XSERVER.MIEXT.CW]CW_OPS.C, -
    $(CW_HEADERS), $(CW_PRIVATE_HEADERS), $(CW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_OPS "$(CW_CFLAGS)" CW "$(CW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_RENDER.OBJ : [.PROGRAMS.XSERVER.MIEXT.CW]CW_RENDER.C, -
    $(CW_HEADERS), $(CW_PRIVATE_HEADERS), $(CW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_RENDER "$(CW_CFLAGS)" CW "$(CW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW.OLB : $(CW_OBJECTS), $(CW_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_OPS.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_RENDER.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.CW]CW_LIBRARY.LIS $(MMS$TARGET)
