! Complete upstream parser/Makefile.am libxf86config.a membership.
! HAS_NO_UIDS selects current-process file I/O, without Unix saved-ID switching.
XF86CONFIG_HEADERS = $(COMMON_HEADERS)
XF86CONFIG_PRIVATE_HEADERS = [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]CONFIGINT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]CONFIGPROCS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86OPTREC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86PARSER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86TOKENS.H
XF86CONFIG_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.PARSER]DESCRIP.MMS
XF86CONFIG_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,_XOPEN_SOURCE=600,HAS_NO_UIDS)
XF86CONFIG_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]KEYBOARD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS.OBJ

XF86CONFIG : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XF86CONFIG.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]DEVICE.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]FILES.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]FLAGS.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]INPUT.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]KEYBOARD.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]KEYBOARD.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]KEYBOARD "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]LAYOUT.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]MODULE.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]VIDEO.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]MONITOR.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]POINTER.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]SCREEN.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]VENDOR.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]READ.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]SCAN.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]WRITE.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]DRI.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]EXTENSIONS.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS "$(CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XF86CONFIG.OLB : $(XF86CONFIG_OBJECTS), $(XF86CONFIG_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]KEYBOARD.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XF86CONFIG_LIBRARY.LIS $(MMS$TARGET)
