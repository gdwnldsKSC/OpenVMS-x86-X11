	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXCTRLS "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"


$(OUT).PROGRAMS.XSERVER.XKB]DDXFAKEMTN.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXFAKEMTN.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXFAKEMTN "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"



$(OUT).PROGRAMS.XSERVER.XKB]DDXKILLSRV.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXKILLSRV.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXKILLSRV "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXLEDS.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXLEDS.C, -
