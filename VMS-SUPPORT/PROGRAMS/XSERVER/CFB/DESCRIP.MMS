! Complete static upstream cfb library; PSZ=8, no optional platform/loadable hooks.
! Native P64 pointers with upstream CARD32 pixel groups and 32-bit long values.
CFB_HEADERS = $(MFB_HEADERS)
CFB_PRIVATE_HEADERS = $(MFB_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.CFB]CFB.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB16.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB24.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB32.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB8BIT.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBMAP.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBMSKBITS.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBRROP.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBTAB.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBUNMAP.H, -
    [.XSERVER.XORG-SERVER.CFB24]CFBRROP24.H, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB]VMS_CFB_NATIVE.H
CFB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MFB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB]DESCRIP.MMS
CFB_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Preserve upstream int-sized clipped-box/input counts and pixel-word indices with P64 pointers.
CFB_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
CFB_CPP_DEFINES = PIXPRIV,PSZ=8,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1
CFB_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES))

CFB_CFBSOLIDC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB_CFBSOLIDX_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB_CFBSOLIDG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXset"")
CFB_CFBTILEODDC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB_CFBTILEODDG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=0"")
CFB_CFBTILE32C_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB_CFBTILE32G_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=0"")
CFB_CFBZERARCC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB_CFBZERARCX_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB_CFBZERARCG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXset"")
CFB_CFBFILLARCC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB_CFBFILLARCG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXset"")
CFB_CFBSEG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""POLYSEGMENT"")
CFB_CFB8LINECO_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB_CFB8LINEX_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB_CFB8LINEG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXset"")
CFB_CFB8LINECP_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""PREVIOUS"")
CFB_CFB8SEGCS_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"", -
    ""WIDTH_SHIFT"")
CFB_CFB8SEGX_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXxor"", -
    ""POLYSEGMENT"")
CFB_CFB8SEGG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXset"", -
    ""POLYSEGMENT"")
CFB_CFB8SEGC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"")
CFB_CFBBLTC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB_CFBBLTX_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=Mxor"")
CFB_CFBBLTO_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=Mor"")
CFB_CFBBLTG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""MROP=0"")
CFB_CFBPLY1RCTC_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB_CFBPLY1RCTG_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""RROP=GXset"")
CFB_CFBGLROP8_CPPFLAGS = /DEFINE=($(CFB_CPP_DEFINES), -
    ""GLYPHROP"")

! Exact-byte aliases retain distinct native object module names for Unix variants.
$(OUT).PROGRAMS.XSERVER.CFB]CFBSOLIDC.C : [.XSERVER.XORG-SERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.CFB]CFBSOLIDX.C : [.XSERVER.XORG-SERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

