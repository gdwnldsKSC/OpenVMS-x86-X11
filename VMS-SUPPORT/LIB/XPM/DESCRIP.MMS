	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]WRFFRP "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]CRDATFRI.OBJ : [.EXTRAS.XPM.LIB]CRDATFRI.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRDATFRI "$(XPM_COUNT_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

