! Complete ordinary static Xevie library from lib/Xevie/Imakefile.
XEVIE_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEVIE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEVIESTR.H
XEVIE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XEVIE]DESCRIP.MMS
XEVIE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XEVIE_OBJECTS = $(OUT).LIB.XEVIE]XEVIE.OBJ

XEVIE : $(OUT).LIB.XEVIE]XEVIE.OLB
	CONTINUE

$(OUT).LIB.XEVIE]XEVIE.OBJ : [.LIB.XEVIE]XEVIE.C, -
    $(XEVIE_HEADERS), $(XEVIE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEVIE]XEVIE "$(XEVIE_CFLAGS)" XEVIE

$(OUT).LIB.XEVIE]XEVIE.OLB : $(XEVIE_OBJECTS), $(XEVIE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XEVIE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XEVIE]XEVIE_LIBRARY.LIS $(MMS$TARGET)
