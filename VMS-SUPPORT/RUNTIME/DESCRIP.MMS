! Native runtime payload from source-built public modules. No system install/start.
RUNTIME : FONTS_BDF, NLS, X11_DATA, XKBCOMP, SETXKBMAP, -
    XAUTH, XDPYINFO, XWININFO, XSET, XMODMAP, XEV, MKFONTSCALE, -
    [.VMS-SUPPORT.RUNTIME]STAGE.COM, [.VMS-SUPPORT.RUNTIME]RUN_SERVER.COM
	@[.VMS-SUPPORT.RUNTIME]STAGE.COM "$(RUNTIME_DEST)"
