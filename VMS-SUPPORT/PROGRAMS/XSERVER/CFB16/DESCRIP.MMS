! Complete static upstream cfb16 library; PSZ=16, no optional platform/loadable hooks.
! Native P64 pointers with upstream CARD32 pixel groups and 32-bit long values.
CFB16_HEADERS = $(MFB_HEADERS)
CFB16_PRIVATE_HEADERS = $(MFB_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.CFB]CFB.H, -
    [.PROGRAMS.XSERVER.CFB]CFB16.H, -
    [.PROGRAMS.XSERVER.CFB]CFB24.H, -
    [.PROGRAMS.XSERVER.CFB]CFB32.H, -
    [.PROGRAMS.XSERVER.CFB]CFB8BIT.H, -
    [.PROGRAMS.XSERVER.CFB]CFBMAP.H, -
    [.PROGRAMS.XSERVER.CFB]CFBMSKBITS.H, -
    [.PROGRAMS.XSERVER.CFB]CFBRROP.H, -
    [.PROGRAMS.XSERVER.CFB]CFBTAB.H, -
    [.PROGRAMS.XSERVER.CFB]CFBUNMAP.H, -
    [.PROGRAMS.XSERVER.CFB24]CFBRROP24.H, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB]VMS_CFB_NATIVE.H
CFB16_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MFB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB16]DESCRIP.MMS
CFB16_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Preserve upstream int-sized clipped-box/input counts and pixel-word indices with P64 pointers.
CFB16_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
CFB16_CPP_DEFINES = PIXPRIV,PSZ=16,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1
CFB16_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES))

CFB16_CFBSOLIDC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB16_CFBSOLIDX_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB16_CFBSOLIDG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXset"")
CFB16_CFBTILEODDC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB16_CFBTILEODDG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=0"")
CFB16_CFBTILE32C_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB16_CFBTILE32G_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=0"")
CFB16_CFBZERARCC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB16_CFBZERARCX_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB16_CFBZERARCG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXset"")
CFB16_CFBFILLARCC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB16_CFBFILLARCG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXset"")
CFB16_CFBSEG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""POLYSEGMENT"")
CFB16_CFB8LINECO_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB16_CFB8LINEX_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB16_CFB8LINEG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXset"")
CFB16_CFB8LINECP_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""PREVIOUS"")
CFB16_CFB8SEGCS_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"", -
    ""WIDTH_SHIFT"")
CFB16_CFB8SEGX_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXxor"", -
    ""POLYSEGMENT"")
CFB16_CFB8SEGG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXset"", -
    ""POLYSEGMENT"")
CFB16_CFB8SEGC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"")
CFB16_CFBBLTC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB16_CFBBLTX_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=Mxor"")
CFB16_CFBBLTO_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=Mor"")
CFB16_CFBBLTG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""MROP=0"")
CFB16_CFBPLY1RCTC_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB16_CFBPLY1RCTG_CPPFLAGS = /DEFINE=($(CFB16_CPP_DEFINES), -
    ""RROP=GXset"")

! Exact-byte aliases retain distinct native object module names for Unix variants.
$(OUT).PROGRAMS.XSERVER.CFB16]CFBSOLIDC.C : [.PROGRAMS.XSERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.CFB16]CFBSOLIDX.C : [.PROGRAMS.XSERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

