$ SET ON
$ ON WARNING THEN GOTO failed
$ IF F$TRNLNM("LNK$LIBRARY") .NES. "" THEN EXIT 2
$ n = 1
$ check_logicals:
$ IF F$TRNLNM("LNK$LIBRARY_"+F$STRING(n)) .NES. "" THEN EXIT 2
$ n = n + 1
$ IF n .LE. 999 THEN GOTO check_logicals
$ LINK/NOTRACEBACK/FULL/CROSS_REFERENCE -
    /MAP=[.VMS-SUPPORT._BUILD.P64.NLS]NLSFILTER.MAP -
    /EXE=[.VMS-SUPPORT._BUILD.P64.NLS]NLSFILTER.EXE -
    [.VMS-SUPPORT._BUILD.P64.NLS]NLSFILTER.OBJ
$ EXIT $STATUS
$ failed:
$ result = $STATUS
$ IF result .AND. 1 THEN result = 2
$ EXIT result
