! Complete static Xcomposite client library from lib/Xcomposite/Imakefile.
XCOMPOSITE_HEADERS = $(XFIXESLIB_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XCOMPOSITE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]COMPOSITE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]COMPOSITEPROTO.H
XCOMPOSITE_PRIVATE_HEADERS = [.LIB.XCOMPOSITE]XCOMPOSITEINT.H, -
    [.LIB.XCOMPOSITE]XCOMPOSITE.H
XCOMPOSITE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XFIXES]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XCOMPOSITE]DESCRIP.MMS
XCOMPOSITE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XCOMPOSITE_OBJECTS = $(OUT).LIB.XCOMPOSITE]XCOMPOSITE.OBJ

XCOMPOSITE : $(OUT).LIB.XCOMPOSITE]XCOMPOSITE.OLB
	CONTINUE

$(OUT).LIB.XCOMPOSITE]XCOMPOSITE.OBJ : [.LIB.XCOMPOSITE]XCOMPOSITE.C, -
    $(XCOMPOSITE_HEADERS), $(XCOMPOSITE_PRIVATE_HEADERS), $(XCOMPOSITE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCOMPOSITE]XCOMPOSITE "$(XCOMPOSITE_CFLAGS)" XCOMPOSITE

$(OUT).LIB.XCOMPOSITE]XCOMPOSITE.OLB : $(XCOMPOSITE_OBJECTS), $(XCOMPOSITE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XCOMPOSITE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XCOMPOSITE]XCOMPOSITE_LIBRARY.LIS $(MMS$TARGET)
