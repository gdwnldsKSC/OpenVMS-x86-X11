! Compile unchanged upstream xf86-video-fbdev 0.5.1 against the current SDK.
! P64/long32 object library only; fbdevhw, shadow and core services remain
! unresolved until a consumer supplies them. No hardware provider is built.
FBDEV_HEADERS = $(PCIACCESS_HEADERS), $(FB_HEADERS), $(RANDR_HEADERS), -
    $(OUT).INCLUDE]XORG-SERVER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVPROTO.H
FBDEV_PRIVATE_HEADERS = $(FB_PRIVATE_HEADERS), $(RANDR_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPTIONSTR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86CMAP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PRIVSTR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86XV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]DGAPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.FBDEVHW]FBDEVHW.H, -
    [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHADOW.H, -
    [.XSERVER.XORG-SERVER.XEXT]XVDIX.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]DISPLAYMODE.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]HOTPLUG.H
FBDEV_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RANDR]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OPENVMS]DRIVER_PROFILE.H, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OPENVMS]FBDEV_PROFILE.H, -
    [.VMS-SUPPORT.DRIVER.XF86-VIDEO-FBDEV]DESCRIP.MMS
! COMPILE's XF86_VIDEO_FBDEV profile includes FBDEV_PROFILE.H before source.
! It selects the shared driver ABI/features, module version and DGA policy.
! Upstream forwards read-only xf86FindOptionValue strings through the legacy
! char * fbdevhw device interface; neither probe nor init modifies the strings.
FBDEV_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,NOTCONSTQUAL))
FBDEV_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234, -
    XORG_VERSION_CURRENT=12101025,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1)
FBDEV_OBJECTS = $(OUT).DRIVER.XF86-VIDEO-FBDEV]FBDEV.OBJ

XF86_VIDEO_FBDEV : $(OUT).DRIVER.XF86-VIDEO-FBDEV]FBDEV.OLB
	CONTINUE

$(OUT).DRIVER.XF86-VIDEO-FBDEV]FBDEV.OBJ : [.DRIVER.XF86-VIDEO-FBDEV.SRC]FBDEV.C, -
    $(FBDEV_HEADERS), $(FBDEV_PRIVATE_HEADERS), $(FBDEV_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-FBDEV]FBDEV "$(FBDEV_CFLAGS)" XF86_VIDEO_FBDEV "$(FBDEV_CPPFLAGS)"

$(OUT).DRIVER.XF86-VIDEO-FBDEV]FBDEV.OLB : $(FBDEV_OBJECTS), $(FBDEV_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FBDEV_OBJECTS)
	LIBRARY/LIST=$(OUT).DRIVER.XF86-VIDEO-FBDEV]FBDEV_LIBRARY.LIS $(MMS$TARGET)
