! Complete ordinary static Xss library from lib/Xss/Imakefile.
XSS_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SAVER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SAVERPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SCRNSAVER.H
XSS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XSS]DESCRIP.MMS
XSS_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XSS_OBJECTS = $(OUT).LIB.XSS]XSCRNSAVER.OBJ

XSS : $(OUT).LIB.XSS]XSS.OLB
	CONTINUE

$(OUT).LIB.XSS]XSCRNSAVER.OBJ : [.LIB.LIBXSCRNSAVER.SRC]XSCRNSAVER.C, -
    $(XSS_HEADERS), $(XSS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XSS]XSCRNSAVER "$(XSS_CFLAGS)" XSS

$(OUT).LIB.XSS]XSS.OLB : $(XSS_OBJECTS), $(XSS_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XSS_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XSS]XSS_LIBRARY.LIS $(MMS$TARGET)
