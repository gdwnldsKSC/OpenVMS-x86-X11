! Complete ordinary static Render library from the upstream Imakefile.
! Native P64 pointers and long32; loadable and optional extension hooks are excluded.
RENDER_HEADERS = $(FB_HEADERS)
RENDER_PRIVATE_HEADERS = $(FB_PRIVATE_HEADERS)
RENDER_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS
RENDER_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Selected hash indices and protocol-buffer offsets retain upstream int32 limits.
RENDER_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
RENDER_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

RENDER_OBJECTS = $(OUT).PROGRAMS.XSERVER.RENDER]ANIMCUR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]FILTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]GLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]MIGLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]MIINDEX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]MIPICT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]MIRECT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]MITRAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]MITRI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]PICTURE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]RENDER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RENDER]RENDEREDGE.OBJ

RENDER : $(OUT).PROGRAMS.XSERVER.RENDER]RENDER.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.RENDER]ANIMCUR.OBJ : [.XSERVER.XORG-SERVER.RENDER]ANIMCUR.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]ANIMCUR "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]FILTER.OBJ : [.XSERVER.XORG-SERVER.RENDER]FILTER.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]FILTER "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]GLYPH.OBJ : [.XSERVER.XORG-SERVER.RENDER]GLYPH.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]GLYPH "$(RENDER_COUNT_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]MIGLYPH.OBJ : [.XSERVER.XORG-SERVER.RENDER]MIGLYPH.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]MIGLYPH "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]MIINDEX.OBJ : [.XSERVER.XORG-SERVER.RENDER]MIINDEX.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]MIINDEX "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]MIPICT.OBJ : [.XSERVER.XORG-SERVER.RENDER]MIPICT.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]MIPICT "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]MIRECT.OBJ : [.XSERVER.XORG-SERVER.RENDER]MIRECT.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]MIRECT "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]MITRAP.OBJ : [.XSERVER.XORG-SERVER.RENDER]MITRAP.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]MITRAP "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]MITRI.OBJ : [.XSERVER.XORG-SERVER.RENDER]MITRI.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]MITRI "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]PICTURE.OBJ : [.XSERVER.XORG-SERVER.RENDER]PICTURE.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]PICTURE "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]RENDER.OBJ : [.XSERVER.XORG-SERVER.RENDER]RENDER.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]RENDER "$(RENDER_COUNT_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]RENDEREDGE.OBJ : [.XSERVER.XORG-SERVER.RENDER]RENDEREDGE.C, -
    $(RENDER_HEADERS), $(RENDER_PRIVATE_HEADERS), $(RENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RENDER]RENDEREDGE "$(RENDER_CFLAGS)" RENDER "$(RENDER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RENDER]RENDER.OLB : $(RENDER_OBJECTS), $(RENDER_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.RENDER]ANIMCUR.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]FILTER.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]GLYPH.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]MIGLYPH.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]MIINDEX.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]MIPICT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.RENDER]MIRECT.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]MITRAP.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]MITRI.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]PICTURE.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]RENDER.OBJ,$(OUT).PROGRAMS.XSERVER.RENDER]RENDEREDGE.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.RENDER]RENDER_LIBRARY.LIS $(MMS$TARGET)
