! Complete ordinary static Xfontcache library from lib/Xfontcache/Imakefile.
XFONTCACHE_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHSTR.H
XFONTCACHE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XFONTCACHE]DESCRIP.MMS
XFONTCACHE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XFONTCACHE_OBJECTS = $(OUT).LIB.XFONTCACHE]FONTCACHE.OBJ

XFONTCACHE : $(OUT).LIB.XFONTCACHE]XFONTCACHE.OLB
	CONTINUE

$(OUT).LIB.XFONTCACHE]FONTCACHE.OBJ : [.LIB.LIBXFONTCACHE.SRC]FONTCACHE.C, -
    $(XFONTCACHE_HEADERS), $(XFONTCACHE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFONTCACHE]FONTCACHE "$(XFONTCACHE_CFLAGS)" XFONTCACHE

$(OUT).LIB.XFONTCACHE]XFONTCACHE.OLB : $(XFONTCACHE_OBJECTS), $(XFONTCACHE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XFONTCACHE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XFONTCACHE]XFONTCACHE_LIBRARY.LIS $(MMS$TARGET)
