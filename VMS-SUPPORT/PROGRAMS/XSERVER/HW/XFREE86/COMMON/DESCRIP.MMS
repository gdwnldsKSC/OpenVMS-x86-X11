! Upstream common/Makefile.am static libcommon, including xf86Init.
! P64/long32: XKB, X Input, Render; no loader, XV, SPARC bus or debug sources.
! Keyboard driver helpers reside in xf86-input-keyboard.
! OS services remain consumer inputs.
XF86COMMON_HEADERS = $(PCIACCESS_HEADERS), $(XKB_HEADERS), $(EXT_HEADERS), $(RANDR_HEADERS), -
    $(XDMCP_HEADERS), -
    $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XF86KEYSYM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86DGAPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86DGA1PROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86DGACONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86DGA1CONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86VMODE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86VM.H
XF86COMMON_PRIVATE_HEADERS = $(XKB_PRIVATE_HEADERS), $(EXT_PRIVATE_HEADERS), -
    $(RANDR_PRIVATE_HEADERS), -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86BUILD.H, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XORG-CONFIG.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VGAARBITER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VGAARBITERPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]VIDMODEPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]COMPILER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]FOURCC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]SCOASM.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86BUS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86CMAP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86CONFIG.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86FBMAN.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86INPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PCIBUS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PCIINFO.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PRIVSTR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86SBUSBUS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86XINPUT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86XV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86XVMC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86XVPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XISB.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XORGVERSION.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]EDID.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]XF86DDC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS.EXTMOD]DGAPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS.EXTMOD]MODINIT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS.EXTMOD]XF86DGAEXT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS.EXTMOD]XVMODPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]BT829.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]FI1236.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]I2C_DEF.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]MSP3430.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]TDA8425.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]TDA9850.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]TDA9885.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]UDA1380.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]XF86I2C.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.INT10]XF86INT10.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.INT10]XF86X86EMU.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]DLLOADER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]LOADER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]LOADERPROCS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]OS.C, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86CRTC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86MODES.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86RENAME.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86CURSOR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86SBUS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]INT10DEFINES.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSLIB.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86OSPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]CONFIGINT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]CONFIGPROCS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86OPTREC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86PARSER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86TOKENS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VBE]VBE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VBE]VBEMODES.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VGAHW]VGAHW.H, -
    [.XSERVER.XORG-SERVER.XI]EXGLOBALS.H
XF86COMMON_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.COMMON]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.COMMON]ARCHIVE.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.COMMON]VMS_COMMON_CONFIG.H
XF86COMMON_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Upstream list helpers keep same-structure member offsets in an int.
XF86COMMON_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
! XF86Config has same-string font-path differences stored as 32-bit lengths.
XF86COMMON_CONFIG_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XF86COMMON_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,RANDR,XKB,XINPUT,XKB_IN_SERVER,""XFreeXDGA""=1, -
    NO_INLINE,NO_ALLOCA,OPEN_MAX=256,XORGSERVER,_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1, -
    XORG_VERSION_CURRENT=10903000,XSERVER_LIBPCIACCESS=1,GLYPHPADBYTES=4, -
    GETLEFTBITS_ALIGNMENT=1)
XF86COMMON_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86CONFIGURE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86BUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86CONFIG.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86CURSOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86DGA.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86DPMS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86EVENTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86GLOBALS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86AUTOCONFIG.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86OPTION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86VIDMODE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86FBMAN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86CMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86HELPER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86PM.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86MODE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XORGHELPER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86PCIBUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86FBBUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86NOBUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86XINPUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XISB.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86RANDR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86DEFMODESET.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86SHOWOPTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86VGAARBITER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86INIT.OBJ

COMMON : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]COMMON.OLB
	CONTINUE


