! Generic libloader with platform-owned static discovery/loading.
! Dynamic image loading and Unix symbol-export tables are not selected.
LOADER_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.LOADER]DESCRIP.MMS
LOADER_CPPFLAGS = /DEFINE=($(XSERVER_CRTL_DEFINES),FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT,XKB_IN_SERVER, -
    NO_INLINE,NO_ALLOCA,OPEN_MAX=256,XORGSERVER,_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1, -
    XORG_VERSION_CURRENT=11202000,XSERVER_LIBPCIACCESS=1,GLYPHPADBYTES=4, -
    GETLEFTBITS_ALIGNMENT=1,IN_LOADER,XORG_STATIC_MODULES)
LOADER_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADMOD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADEXT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]OS.OBJ

LOADER : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADER.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADER.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]LOADER.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(LOADER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADER "$(XF86COMMON_CFLAGS)" LOADER "$(LOADER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADMOD.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]LOADMOD.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(LOADER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADMOD "$(XF86COMMON_CFLAGS)" LOADER "$(LOADER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADEXT.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]LOADEXT.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(LOADER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADEXT "$(XF86COMMON_CFLAGS)" LOADER "$(LOADER_CPPFLAGS)"


$(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]OS.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.LOADER]OS.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(LOADER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]OS "$(XF86COMMON_CFLAGS)" LOADER "$(LOADER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADER.OLB : $(LOADER_OBJECTS), $(LOADER_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(LOADER_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.LOADER]LOADER_LIBRARY.LIS $(MMS$TARGET)
