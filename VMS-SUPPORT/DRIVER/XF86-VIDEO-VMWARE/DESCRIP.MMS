! Complete upstream vmware driver; optional vmwgfx/DRM is not selected.
! P64/long32 with module metadata; the consumer supplies loader and port I/O services.
VMWARE_HEADERS = $(PCIACCESS_HEADERS), $(FB_HEADERS), $(RANDR_HEADERS), $(OUT).INCLUDE]XORG-SERVER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMSCONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PANORAMIXPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVPROTO.H
VMWARE_PRIVATE_HEADERS = $(FB_PRIVATE_HEADERS), $(RANDR_PRIVATE_HEADERS), -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]BITS2PIXELS.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]COMMON_COMPAT.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]COMPAT-API.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]GUEST_OS.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]INCLUDECHECK.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]SVGA_ESCAPE.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]SVGA_OVERLAY.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]SVGA_MODES.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]SVGA_LIMITS.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]SVGA_REG.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]SVGA_STRUCT.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VM_BASIC_TYPES.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VM_DEVICE_VERSION.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARE.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARECTRL.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARECTRLPROTO.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARE_BOOTSTRAP.H, -
    [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARE_COMMON.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]COMPILER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86CMAP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86FBMAN.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PCIINFO.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86XV.H, -
    [.XSERVER.XORG-SERVER.XEXT]XVDIX.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]FOURCC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]EDID.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]XF86DDC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]XF86I2C.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86MODES.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86PARSER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86OPTREC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86CURSOR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SHADOWFB]SHADOWFB.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VGAHW]VGAHW.H
VMWARE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.DRIVER.XF86-VIDEO-VMWARE]DESCRIP.MMS
VMWARE_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Same-buffer offsets retain upstream CARD32 hardware and int token interfaces.
VMWARE_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
VMWARE_CPPFLAGS = /DEFINE=(HAVE_STRCASECMP,HAVE_STRNCASECMP,FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,RANDR,XKB,XINPUT,XKB_IN_SERVER, -
    ""XFree86LOADER"",HAVE_XORG_SERVER_1_0_99_901=1,HAVE_XORG_SERVER_1_1_0=1, -
    HAVE_XORG_SERVER_1_2_0=1,HAVE_XORG_SERVER_1_5_0=1,HAVE_XORG_SERVER_1_7_0=1, -
    HAVE_XORG_SERVER_1_12_0=1, -
    PACKAGE_VERSION_MAJOR=13,PACKAGE_VERSION_MINOR=4,PACKAGE_VERSION_PATCHLEVEL=0, -
    XORG_VERSION_CURRENT=12101025,XSERVER_LIBPCIACCESS=1,GLYPHPADBYTES=4, -
    GETLEFTBITS_ALIGNMENT=1)
VMWARE_OBJECTS = $(OUT).DRIVER.XF86-VIDEO-VMWARE]BITS2PIXELS.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECURS.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECTRL.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREXINERAMA.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREVIDEO.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREMODES.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_BOOTSTRAP.OBJ, -
    $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_COMMON.OBJ

XF86_VIDEO_VMWARE : $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_DRV.OLB
	CONTINUE

$(OUT).DRIVER.XF86-VIDEO-VMWARE]BITS2PIXELS.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]BITS2PIXELS.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]BITS2PIXELS "$(VMWARE_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"



$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARE.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE "$(VMWARE_COUNT_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"

$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECURS.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARECURS.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECURS "$(VMWARE_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"



$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECTRL.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARECTRL.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECTRL "$(VMWARE_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"

$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_DRV.OLB : $(VMWARE_OBJECTS), $(VMWARE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).DRIVER.XF86-VIDEO-VMWARE]BITS2PIXELS.OBJ,$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE.OBJ,$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECURS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARECTRL.OBJ,$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREXINERAMA.OBJ,$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREVIDEO.OBJ,$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREMODES.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_BOOTSTRAP.OBJ,$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_COMMON.OBJ
	LIBRARY/LIST=$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_DRV_LIBRARY.LIS $(MMS$TARGET)

$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_BOOTSTRAP.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARE_BOOTSTRAP.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_BOOTSTRAP "$(VMWARE_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"

$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_COMMON.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWARE_COMMON.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWARE_COMMON "$(VMWARE_COUNT_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"

$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREMODES.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWAREMODES.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREMODES "$(VMWARE_COUNT_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"


$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREXINERAMA.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWAREXINERAMA.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREXINERAMA "$(VMWARE_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"

$(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREVIDEO.OBJ : [.DRIVER.XF86-VIDEO-VMWARE.SRC]VMWAREVIDEO.C, -
    $(VMWARE_HEADERS), $(VMWARE_PRIVATE_HEADERS), $(VMWARE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-VIDEO-VMWARE]VMWAREVIDEO "$(VMWARE_COUNT_CFLAGS)" XF86_VIDEO_VMWARE "$(VMWARE_CPPFLAGS)"
