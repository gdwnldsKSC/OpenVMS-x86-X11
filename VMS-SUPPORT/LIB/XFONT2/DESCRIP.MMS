! Native P64 libXfont2 2.0.9, matching the complete portable upstream library.
! Bitmap, builtin, FreeType, gzip and TCP font-server support; no bzip2.
XFONT2_HEADERS = $(COMMON_HEADERS), $(FONTENC_HEADERS), $(FREETYPE2_HEADERS), -
    $(ZLIB_HEADERS), $(XTRANS_HEADERS), -
    $(OUT).INCLUDE.X11]X.H, $(OUT).INCLUDE.X11]XMD.H, -
    $(OUT).INCLUDE.X11]XPROTO.H, $(OUT).INCLUDE.X11]XPROTOSTR.H, -
    $(OUT).INCLUDE.X11]XDEFS.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11]KEYSYM.H, -
    $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XOS_R.H, -
    $(OUT).INCLUDE.X11.FONTS]FS.H, $(OUT).INCLUDE.X11.FONTS]FSPROTO.H, -
    $(OUT).INCLUDE.X11.FONTS]FONT.H, $(OUT).INCLUDE.X11.FONTS]FONTSTRUCT.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTPROTO.H, $(OUT).INCLUDE.X11.FONTS]FSMASKS.H, -
    $(OUT).INCLUDE.X11.FONTS]LIBXFONT2.H
XFONT2_PRIVATE_HEADERS = [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]BDFINT.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]BITMAP.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]BUFIO.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FNTFIL.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FNTFILIO.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FNTFILST.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FONTMISC.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FONTSHOW.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FONTUTIL.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]FONTXLFD.H, -
    [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]PCF.H, -
    [.LIB.LIBXFONT2.INCLUDE]LIBXFONTINT.H, -
    [.LIB.LIBXFONT2.SRC.UTIL]REPLACE.H, -
    [.LIB.LIBXFONT2.SRC.FREETYPE]FT.H, -
    [.LIB.LIBXFONT2.SRC.FREETYPE]FTFUNCS.H, -
    [.LIB.LIBXFONT2.SRC.FREETYPE]XTTCAP.H, -
    [.LIB.LIBXFONT2.SRC.BITMAP]SNFSTR.H, -
    [.LIB.LIBXFONT2.SRC.BUILTINS]BUILTIN.H, -
    [.LIB.LIBXFONT2.SRC.FC]FSERVE.H, -
    [.LIB.LIBXFONT2.SRC.FC]FSERVESTR.H, -
    [.LIB.LIBXFONT2.SRC.FC]FSIO.H, -
    [.LIB.LIBXFONT2.SRC.FC]FSLIBOS.H
XFONT2_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XFONT2]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XFONT2]CONFIG.H
XFONT2_CFLAGS = $(CFLAGS)/UNDEFINE=__HIDE_FORBIDDEN_NAMES
! Upstream count fields and bounded buffer differences remain int-sized.
XFONT2_COUNT_CFLAGS = $(XFONT2_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! BUFIO stores an integer file descriptor in its private pointer field.
XFONT2_BUF_CFLAGS = $(XFONT2_COUNT_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,POINTERINTCAST))
! Native P64 socket iovec layouts agree; the installed SDK tag is distinct.
XFONT2_TRANS_CFLAGS = $(XFONT2_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(PTRMISMATCH,MACROREDEF))
XFONT2_CPPFLAGS = /DEFINE=(HAVE_CONFIG_H)

XFONT2_STUBS_OBJECTS = $(OUT).LIB.XFONT2]ATOM.OBJ, -
    $(OUT).LIB.XFONT2]LIBXFONTSTUBS.OBJ
XFONT2_UTIL_OBJECTS = $(OUT).LIB.XFONT2]FONTACCEL.OBJ, -
    $(OUT).LIB.XFONT2]FONTNAMES.OBJ, -
    $(OUT).LIB.XFONT2]FONTUTIL.OBJ, -
    $(OUT).LIB.XFONT2]FONTXLFD.OBJ, -
    $(OUT).LIB.XFONT2]FORMAT.OBJ, -
    $(OUT).LIB.XFONT2]MISCUTIL.OBJ, -
    $(OUT).LIB.XFONT2]PATCACHE.OBJ, -
    $(OUT).LIB.XFONT2]PRIVATE.OBJ, -
    $(OUT).LIB.XFONT2]UTILBITMAP.OBJ, -
    $(OUT).LIB.XFONT2]REALLOCARRAY.OBJ, -
    $(OUT).LIB.XFONT2]STRLCAT.OBJ, -
    $(OUT).LIB.XFONT2]STRLCPY.OBJ
XFONT2_FONTFILE_OBJECTS = $(OUT).LIB.XFONT2]BITSOURCE.OBJ, -
    $(OUT).LIB.XFONT2]BUFIO.OBJ, -
    $(OUT).LIB.XFONT2]DECOMPRESS.OBJ, -
    $(OUT).LIB.XFONT2]DEFAULTS.OBJ, -
    $(OUT).LIB.XFONT2]DIRFILE.OBJ, -
    $(OUT).LIB.XFONT2]FILEIO.OBJ, -
    $(OUT).LIB.XFONT2]FILEWR.OBJ, -
    $(OUT).LIB.XFONT2]FONTDIR.OBJ, -
    $(OUT).LIB.XFONT2]FONTFILE.OBJ, -
    $(OUT).LIB.XFONT2]FONTSCALE.OBJ, -
    $(OUT).LIB.XFONT2]GUNZIP.OBJ, -
    $(OUT).LIB.XFONT2]REGISTER.OBJ, -
    $(OUT).LIB.XFONT2]RENDERERS.OBJ, -
    $(OUT).LIB.XFONT2]CATALOGUE.OBJ
XFONT2_FREETYPE_OBJECTS = $(OUT).LIB.XFONT2]FTENC.OBJ, -
    $(OUT).LIB.XFONT2]FTFUNCS.OBJ, -
    $(OUT).LIB.XFONT2]FTTOOLS.OBJ, -
    $(OUT).LIB.XFONT2]XTTCAP.OBJ
XFONT2_BITMAP_OBJECTS = $(OUT).LIB.XFONT2]BITMAP.OBJ, -
    $(OUT).LIB.XFONT2]BITMAPFUNC.OBJ, -
    $(OUT).LIB.XFONT2]BITMAPUTIL.OBJ, -
    $(OUT).LIB.XFONT2]BITSCALE.OBJ, -
    $(OUT).LIB.XFONT2]FONTINK.OBJ, -
    $(OUT).LIB.XFONT2]BDFREAD.OBJ, -
    $(OUT).LIB.XFONT2]BDFUTILS.OBJ, -
    $(OUT).LIB.XFONT2]PCFREAD.OBJ, -
    $(OUT).LIB.XFONT2]PCFWRITE.OBJ, -
    $(OUT).LIB.XFONT2]SNFREAD.OBJ
XFONT2_BUILTINS_OBJECTS = $(OUT).LIB.XFONT2]DIR.OBJ, -
    $(OUT).LIB.XFONT2]FILE.OBJ, -
    $(OUT).LIB.XFONT2]FONTS.OBJ, -
    $(OUT).LIB.XFONT2]FPE.OBJ, -
    $(OUT).LIB.XFONT2]RENDER.OBJ
XFONT2_FC_OBJECTS = $(OUT).LIB.XFONT2]FSCONVERT.OBJ, -
    $(OUT).LIB.XFONT2]FSERVE.OBJ, -
    $(OUT).LIB.XFONT2]FSIO.OBJ, -
    $(OUT).LIB.XFONT2]FSTRANS.OBJ
XFONT2_OBJECTS = $(XFONT2_STUBS_OBJECTS), -
    $(XFONT2_UTIL_OBJECTS), -
    $(XFONT2_FONTFILE_OBJECTS), -
    $(XFONT2_FREETYPE_OBJECTS), -
    $(XFONT2_BITMAP_OBJECTS), -
    $(XFONT2_BUILTINS_OBJECTS), -
    $(XFONT2_FC_OBJECTS)

XFONT2 : $(OUT).LIB.XFONT2]XFONT2.OLB, $(OUT).LIB.FONTENC]FONTENC.OLB, -
    $(OUT).LIB.FREETYPE2]FREETYPE.OLB, $(OUT).LIB.ZLIB]Z.OLB
	CONTINUE

$(OUT).INCLUDE.X11.FONTS]LIBXFONT2.H : [.LIB.LIBXFONT2.INCLUDE.X11.FONTS]LIBXFONT2.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XFONT2]ATOM.OBJ : [.LIB.LIBXFONT2.SRC.STUBS]ATOM.C, -
    $(XFONT2_HEADERS), $(XFONT2_PRIVATE_HEADERS), $(XFONT2_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFONT2]ATOM "$(XFONT2_COUNT_CFLAGS)" XFONT2 "$(XFONT2_CPPFLAGS)"

$(OUT).LIB.XFONT2]LIBXFONTSTUBS.OBJ : [.LIB.LIBXFONT2.SRC.STUBS]LIBXFONTSTUBS.C, -
    $(XFONT2_HEADERS), $(XFONT2_PRIVATE_HEADERS), $(XFONT2_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFONT2]LIBXFONTSTUBS "$(XFONT2_COUNT_CFLAGS)" XFONT2 "$(XFONT2_CPPFLAGS)"

