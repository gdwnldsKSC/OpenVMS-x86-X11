all: all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ Makefile.am  $(top_srcdir)/configure.ac $(ACLOCAL_M4)
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --gnu  src/Makefile
Makefile: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.in  $(top_builddir)/config.status
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)
mga_drv_laLTLIBRARIES_INSTALL = $(INSTALL)
install-mga_drv_laLTLIBRARIES: $(mga_drv_la_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(mga_drv_ladir)
	@list='$(mga_drv_la_LTLIBRARIES)'; for p in $$list; do \
	  if test -f $$p; then \
	    f="`echo $$p | sed -e 's|^.*/||'`"; \
	    echo " $(LIBTOOL) --mode=install $(mga_drv_laLTLIBRARIES_INSTALL) $(INSTALL_STRIP_FLAG) $$p $(DESTDIR)$(mga_drv_ladir)/$$f"; \
	    $(LIBTOOL) --mode=install $(mga_drv_laLTLIBRARIES_INSTALL) $(INSTALL_STRIP_FLAG) $$p $(DESTDIR)$(mga_drv_ladir)/$$f; \
	  else :; fi; \
	done

uninstall-mga_drv_laLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(mga_drv_la_LTLIBRARIES)'; for p in $$list; do \
	    p="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " $(LIBTOOL) --mode=uninstall rm -f $(DESTDIR)$(mga_drv_ladir)/$$p"; \
	  $(LIBTOOL) --mode=uninstall rm -f $(DESTDIR)$(mga_drv_ladir)/$$p; \
	done

clean-mga_drv_laLTLIBRARIES:
	-test -z "$(mga_drv_la_LTLIBRARIES)" || rm -f $(mga_drv_la_LTLIBRARIES)
	@list='$(mga_drv_la_LTLIBRARIES)'; for p in $$list; do \
	  dir="`echo $$p | sed -e 's|/[^/]*$$||'`"; \
	  test "$$dir" = "$$p" && dir=.; \
	  echo "rm -f \"$${dir}/so_locations\""; \
	  rm -f "$${dir}/so_locations"; \
	done

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; for p in $$list; do \
	  dir="`echo $$p | sed -e 's|/[^/]*$$||'`"; \
	  test "$$dir" = "$$p" && dir=.; \
	  echo "rm -f \"$${dir}/so_locations\""; \
	  rm -f "$${dir}/so_locations"; \
	done
libmga_storm16.la: $(libmga_storm16_la_OBJECTS) $(libmga_storm16_la_DEPENDENCIES) 
	$(LINK)  $(libmga_storm16_la_LDFLAGS) $(libmga_storm16_la_OBJECTS) $(libmga_storm16_la_LIBADD) $(LIBS)
libmga_storm24.la: $(libmga_storm24_la_OBJECTS) $(libmga_storm24_la_DEPENDENCIES) 
	$(LINK)  $(libmga_storm24_la_LDFLAGS) $(libmga_storm24_la_OBJECTS) $(libmga_storm24_la_LIBADD) $(LIBS)
libmga_storm32.la: $(libmga_storm32_la_OBJECTS) $(libmga_storm32_la_DEPENDENCIES) 
	$(LINK)  $(libmga_storm32_la_LDFLAGS) $(libmga_storm32_la_OBJECTS) $(libmga_storm32_la_LIBADD) $(LIBS)
libmga_storm8.la: $(libmga_storm8_la_OBJECTS) $(libmga_storm8_la_DEPENDENCIES) 
	$(LINK)  $(libmga_storm8_la_LDFLAGS) $(libmga_storm8_la_OBJECTS) $(libmga_storm8_la_LIBADD) $(LIBS)
mga_drv.la: $(mga_drv_la_OBJECTS) $(mga_drv_la_DEPENDENCIES) 
	$(LINK) -rpath $(mga_drv_ladir) $(mga_drv_la_LDFLAGS) $(mga_drv_la_OBJECTS) $(mga_drv_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT) core *.core

distclean-compile:
