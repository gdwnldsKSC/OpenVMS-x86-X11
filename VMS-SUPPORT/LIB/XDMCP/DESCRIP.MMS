! Complete upstream libXdmcp/Makefile.am membership; HASXDMAUTH is not selected.
XDMCP_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]X.H, -
    $(OUT).INCLUDE.X11]XMD.H, $(OUT).INCLUDE.X11]XDMCP.H
XDMCP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XDMCP]DESCRIP.MMS
XDMCP_OBJECTS = $(OUT).LIB.XDMCP]ARRAY.OBJ, $(OUT).LIB.XDMCP]FILL.OBJ, -
    $(OUT).LIB.XDMCP]FLUSH.OBJ, $(OUT).LIB.XDMCP]KEY.OBJ, -
    $(OUT).LIB.XDMCP]READ.OBJ, $(OUT).LIB.XDMCP]UNWRAP.OBJ, -
    $(OUT).LIB.XDMCP]WRAP.OBJ, $(OUT).LIB.XDMCP]WRITE.OBJ

XDMCP : $(OUT).LIB.XDMCP]XDMCP.OLB
	CONTINUE

$(OUT).INCLUDE.X11]XDMCP.H : [.LIB.LIBXDMCP.INCLUDE.X11]XDMCP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XDMCP]ARRAY.OBJ : [.LIB.LIBXDMCP]ARRAY.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]ARRAY "$(CFLAGS)"
$(OUT).LIB.XDMCP]FILL.OBJ : [.LIB.LIBXDMCP]FILL.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]FILL "$(CFLAGS)"
$(OUT).LIB.XDMCP]FLUSH.OBJ : [.LIB.LIBXDMCP]FLUSH.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]FLUSH "$(CFLAGS)"
$(OUT).LIB.XDMCP]KEY.OBJ : [.LIB.LIBXDMCP]KEY.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]KEY "$(CFLAGS)/DEFINE=_XOPEN_SOURCE_EXTENDED=1"
$(OUT).LIB.XDMCP]READ.OBJ : [.LIB.LIBXDMCP]READ.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]READ "$(CFLAGS)"
$(OUT).LIB.XDMCP]UNWRAP.OBJ : [.LIB.LIBXDMCP]UNWRAP.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]UNWRAP "$(CFLAGS)"
$(OUT).LIB.XDMCP]WRAP.OBJ : [.LIB.LIBXDMCP]WRAP.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WRAP "$(CFLAGS)"
$(OUT).LIB.XDMCP]WRITE.OBJ : [.LIB.LIBXDMCP]WRITE.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WRITE "$(CFLAGS)"

$(OUT).LIB.XDMCP]XDMCP.OLB : $(XDMCP_OBJECTS), $(XDMCP_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XDMCP_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XDMCP]XDMCP_LIBRARY.LIS $(MMS$TARGET)
