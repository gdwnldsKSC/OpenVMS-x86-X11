    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBALLOC "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

