! programs/showfont/Imakefile's font-server glyph and metrics viewer.
SHOWFONT_HEADERS = $(FS_HEADERS)
SHOWFONT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, -
                      [.VMS-SUPPORT.PROGRAMS.SHOWFONT]DESCRIP.MMS
SHOWFONT_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT

SHOWFONT : $(OUT).PROGRAMS.SHOWFONT]SHOWFONT.EXE
	CONTINUE

$(OUT).PROGRAMS.SHOWFONT]SHOWFONT.OBJ : [.APP.SHOWFONT]SHOWFONT.C, -
    $(SHOWFONT_HEADERS), $(SHOWFONT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.SHOWFONT]SHOWFONT "$(SHOWFONT_CFLAGS)"

$(OUT).PROGRAMS.SHOWFONT]SHOWFONT.EXE : $(OUT).PROGRAMS.SHOWFONT]SHOWFONT.OBJ, -
    $(OUT).LIB.FS]FS.OLB, [.VMS-SUPPORT.PROGRAMS.SHOWFONT]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.SHOWFONT]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.SHOWFONT]LINK.COM
