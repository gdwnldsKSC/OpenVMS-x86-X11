X11_TRANSPORT_INPUTS = [.LIB.XTRANS]XTRANS.H, -
    [.LIB.XTRANS]XTRANSINT.H, -
    [.LIB.XTRANS]XTRANSSOCK.C, -
    [.LIB.XTRANS]XTRANS.C, -
    [.LIB.XTRANS]XTRANSUTIL.C
X11_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.X11]DESCRIP.MMS
X11_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Relative string, request-buffer and array differences remain 32-bit counts.
X11_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
! Xrm/XIM argument values carry scalar resource IDs and counts in XPointer.
X11_SCALAR_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
! As in FS/ICE, expose BSD transport declarations; native P64 iovec layouts agree.
! Xfuncs replaces equivalent RTL bcopy/bzero macros in relaxed mode.
X11_TRANSPORT_CFLAGS = $(CFLAGS)/STANDARD=RELAXED_ANSI89/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,PTRMISMATCH,MACROREDEF))
X11_DEFINES = HAS_SNPRINTF,LIBX11,_XOPEN_SOURCE_EXTENDED=1,_XOPEN_UNIX=1,OPEN_MAX=256
X11_TRANSPORT_DEFINES = HAS_SNPRINTF,LIBX11,OPEN_MAX=256,TCPCONN,TRANS_CLIENT
X11_TRANSPORT_CPPFLAGS = /DEFINE=($(X11_TRANSPORT_DEFINES),""X11_t"")
X11_XIM_TRANSPORT_CPPFLAGS = /DEFINE=($(X11_TRANSPORT_DEFINES),""XIM_t"")
X11_CPPFLAGS = /DEFINE=($(X11_DEFINES))
X11_TCP_CPPFLAGS = /DEFINE=($(X11_DEFINES),TCPCONN)
X11_XKB_CPPFLAGS = /DEFINE=($(X11_DEFINES),XKB)
X11_X11_CPPFLAGS = /DEFINE=($(X11_DEFINES),TCPCONN,""X11_t"",TRANS_CLIENT)
X11_OPEN_CPPFLAGS = /DEFINE=($(X11_DEFINES),""X11_t"",TRANS_CLIENT,XKB)
X11_XIM_CPPFLAGS = /DEFINE=($(X11_DEFINES),TCPCONN,""XIM_t"",TRANS_CLIENT)
X11_ERROR_CPPFLAGS = /DEFINE=($(X11_DEFINES),ERRORDB=""""""$(X11_LIBDIR)/XErrorDB"""""")
X11_KEYSYM_CPPFLAGS = /DEFINE=($(X11_DEFINES),KEYSYMDB=""""""$(X11_LIBDIR)/XKeysymDB"""""")
X11_CMS_CPPFLAGS = /DEFINE=($(X11_DEFINES),XCMSDB=""""""$(X11_LIBDIR)/Xcms.txt"""""")
X11_LOCALE_CPPFLAGS = /DEFINE=($(X11_DEFINES),XLOCALEDIR=""""""$(X11_LOCALEDIR)"""""")
