! Complete xkbcomp program from programs/xkbcomp/Imakefile.
XKBCOMP_HEADERS = $(XCLIENT_HEADERS), $(XKBFILE_HEADERS), $(OUT).INCLUDE.X11]XALLOCA.H
XKBCOMP_PRIVATE_HEADERS = [.APP.XKBCOMP]XKBCOMP.H, -
    [.APP.XKBCOMP]UTILS.H, -
    [.APP.XKBCOMP]TOKENS.H, -
    [.APP.XKBCOMP]EXPR.H, -
    [.APP.XKBCOMP]VMOD.H, -
    [.APP.XKBCOMP]INDICATORS.H, -
    [.APP.XKBCOMP]MISC.H, -
    [.APP.XKBCOMP]ALIAS.H, -
    [.APP.XKBCOMP]KEYCODES.H, -
    [.APP.XKBCOMP]COMPAT.H, -
    [.APP.XKBCOMP]ACTION.H, -
    [.APP.XKBCOMP]XKBPATH.H, -
    [.APP.XKBCOMP]PARSEUTILS.H
XKBCOMP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XKBCOMP]DESCRIP.MMS
XKBCOMP_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT/DEFINE=(_XOPEN_SOURCE=600)
XKBCOMP_COUNT_CFLAGS = $(XKBCOMP_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
XKBCOMP_MAIN_CFLAGS = $(XKBCOMP_COUNT_CFLAGS)/POINTER_SIZE=64=ARGV
! CONFIG.MMS shares the installed data path with the server and setxkbmap.
XKBCOMP_PATH_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT -
    /DEFINE=(_XOPEN_SOURCE=600,DFLT_XKB_CONFIG_ROOT=""""""$(XKBCOMP_CONFIG_ROOT)"""""")
XKBCOMP_OBJECTS = $(OUT).PROGRAMS.XKBCOMP]XKBCOMP.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]XKBSCAN.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]EXPR.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]VMOD.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]INDICATORS.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]MISC.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]ALIAS.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]KEYMAP.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]KEYCODES.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]KEYTYPES.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]COMPAT.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]ACTION.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]SYMBOLS.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]GEOMETRY.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]XKBPATH.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]LISTING.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]XKBPARSE.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]PARSEUTILS.OBJ, -
    $(OUT).PROGRAMS.XKBCOMP]UTILS.OBJ

XKBCOMP : $(OUT).PROGRAMS.XKBCOMP]XKBCOMP.EXE
	CONTINUE

$(OUT).PROGRAMS.XKBCOMP]XKBPARSE.C : [.APP.XKBCOMP]XKBPARSE.Y, -
    [.VMS-SUPPORT.PROGRAMS.XKBCOMP]GENERATE.COM, $(BISON_OUTPUTS)
	@[.VMS-SUPPORT.PROGRAMS.XKBCOMP]GENERATE.COM

$(OUT).PROGRAMS.XKBCOMP]XKBCOMP.OBJ : [.APP.XKBCOMP]XKBCOMP.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]XKBCOMP "$(XKBCOMP_MAIN_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]XKBSCAN.OBJ : [.APP.XKBCOMP]XKBSCAN.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]XKBSCAN "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]EXPR.OBJ : [.APP.XKBCOMP]EXPR.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]EXPR "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]VMOD.OBJ : [.APP.XKBCOMP]VMOD.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]VMOD "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]INDICATORS.OBJ : [.APP.XKBCOMP]INDICATORS.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]INDICATORS "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]MISC.OBJ : [.APP.XKBCOMP]MISC.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]MISC "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]ALIAS.OBJ : [.APP.XKBCOMP]ALIAS.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]ALIAS "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]KEYMAP.OBJ : [.APP.XKBCOMP]KEYMAP.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]KEYMAP "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]KEYCODES.OBJ : [.APP.XKBCOMP]KEYCODES.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]KEYCODES "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]KEYTYPES.OBJ : [.APP.XKBCOMP]KEYTYPES.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]KEYTYPES "$(XKBCOMP_COUNT_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]COMPAT.OBJ : [.APP.XKBCOMP]COMPAT.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]COMPAT "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]ACTION.OBJ : [.APP.XKBCOMP]ACTION.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]ACTION "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]SYMBOLS.OBJ : [.APP.XKBCOMP]SYMBOLS.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]SYMBOLS "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]GEOMETRY.OBJ : [.APP.XKBCOMP]GEOMETRY.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]GEOMETRY "$(XKBCOMP_COUNT_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]XKBPATH.OBJ : [.APP.XKBCOMP]XKBPATH.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]XKBPATH "$(XKBCOMP_PATH_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]LISTING.OBJ : [.APP.XKBCOMP]LISTING.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]LISTING "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]XKBPARSE.OBJ : $(OUT).PROGRAMS.XKBCOMP]XKBPARSE.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]XKBPARSE "$(XKBCOMP_COUNT_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]PARSEUTILS.OBJ : [.APP.XKBCOMP]PARSEUTILS.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]PARSEUTILS "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]UTILS.OBJ : [.APP.XKBCOMP]UTILS.C, -
    $(XKBCOMP_HEADERS), $(XKBCOMP_PRIVATE_HEADERS), $(XKBCOMP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XKBCOMP]UTILS "$(XKBCOMP_CFLAGS)" XKBCOMP

$(OUT).PROGRAMS.XKBCOMP]XKBCOMP.EXE : $(XKBCOMP_OBJECTS), -
    $(OUT).LIB.XKBFILE]XKBFILE.OLB, -
    $(OUT).LIB.X11]X11.OLB, [.VMS-SUPPORT.PROGRAMS.XKBCOMP]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XKBCOMP]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XKBCOMP]LINK.COM
