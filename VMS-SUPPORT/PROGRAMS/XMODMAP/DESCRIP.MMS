! Complete xmodmap program from programs/xmodmap/Imakefile.
XMODMAP_HEADERS = $(XCLIENT_HEADERS)
XMODMAP_PRIVATE_HEADERS = [.APP.XMODMAP]XMODMAP.H, [.APP.XMODMAP]WQ.H
XMODMAP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XMODMAP]DESCRIP.MMS
XMODMAP_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT
XMODMAP_COUNT_CFLAGS = $(XMODMAP_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
XMODMAP_MAIN_CFLAGS = $(XMODMAP_CFLAGS)/POINTER_SIZE=64=ARGV
XMODMAP_OBJECTS = $(OUT).PROGRAMS.XMODMAP]XMODMAP.OBJ, -
    $(OUT).PROGRAMS.XMODMAP]PF.OBJ, -
    $(OUT).PROGRAMS.XMODMAP]HANDLE.OBJ, -
    $(OUT).PROGRAMS.XMODMAP]EXEC.OBJ

XMODMAP : $(OUT).PROGRAMS.XMODMAP]XMODMAP.EXE
	CONTINUE

$(OUT).PROGRAMS.XMODMAP]XMODMAP.OBJ : [.APP.XMODMAP]XMODMAP.C, -
    $(XMODMAP_HEADERS), $(XMODMAP_PRIVATE_HEADERS), $(XMODMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XMODMAP]XMODMAP "$(XMODMAP_MAIN_CFLAGS)" XMODMAP

$(OUT).PROGRAMS.XMODMAP]PF.OBJ : [.APP.XMODMAP]PF.C, -
    $(XMODMAP_HEADERS), $(XMODMAP_PRIVATE_HEADERS), $(XMODMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XMODMAP]PF "$(XMODMAP_COUNT_CFLAGS)" XMODMAP

$(OUT).PROGRAMS.XMODMAP]HANDLE.OBJ : [.APP.XMODMAP]HANDLE.C, -
    $(XMODMAP_HEADERS), $(XMODMAP_PRIVATE_HEADERS), $(XMODMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XMODMAP]HANDLE "$(XMODMAP_CFLAGS)" XMODMAP

$(OUT).PROGRAMS.XMODMAP]EXEC.OBJ : [.APP.XMODMAP]EXEC.C, -
    $(XMODMAP_HEADERS), $(XMODMAP_PRIVATE_HEADERS), $(XMODMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XMODMAP]EXEC "$(XMODMAP_CFLAGS)" XMODMAP

$(OUT).PROGRAMS.XMODMAP]XMODMAP.EXE : $(XMODMAP_OBJECTS), -
    $(OUT).LIB.X11]X11.OLB, [.VMS-SUPPORT.PROGRAMS.XMODMAP]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XMODMAP]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XMODMAP]LINK.COM
