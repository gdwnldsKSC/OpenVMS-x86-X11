! programs/xfsinfo/Imakefile's font-server information tool.
XFSINFO_HEADERS = $(FS_HEADERS)
XFSINFO_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, -
                      [.VMS-SUPPORT.PROGRAMS.XFSINFO]DESCRIP.MMS
XFSINFO_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT

XFSINFO : $(OUT).PROGRAMS.XFSINFO]XFSINFO.EXE
	CONTINUE

$(OUT).PROGRAMS.XFSINFO]XFSINFO.OBJ : [.PROGRAMS.XFSINFO]XFSINFO.C, -
    $(XFSINFO_HEADERS), $(XFSINFO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XFSINFO]XFSINFO "$(XFSINFO_CFLAGS)"

$(OUT).PROGRAMS.XFSINFO]XFSINFO.EXE : $(OUT).PROGRAMS.XFSINFO]XFSINFO.OBJ, -
    $(OUT).LIB.FS]FS.OLB, [.VMS-SUPPORT.PROGRAMS.XFSINFO]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XFSINFO]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XFSINFO]LINK.COM
