$(OUT).PROGRAMS.XSERVER.XKB]XKB.OLB : $(XKB_OBJECTS), $(XKB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKB.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBUTILS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBEVENTS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBACCESSX.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBSWAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBLEDS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBINIT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBACTIONS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBPRKEYEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKMREAD.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBERRS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]MAPRULES.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBMISC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBMALLOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBALLOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBGALLOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBPROTHEREV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXBEEP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXCTRLS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXFAKEBTN.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXFAKEMTN.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXINIT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXKEYCLICK.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXKILLSRV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXLEDS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXVT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXLOAD.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXLIST.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXDEVBTN.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXPRIVATE.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XKB]XKB_LIBRARY.LIS $(MMS$TARGET)
