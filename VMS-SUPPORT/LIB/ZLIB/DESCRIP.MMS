! Bundled zlib 1.1.4: exactly the 14 modules in lib/zlib/Imakefile.
ZLIB_HEADERS = $(OUT).INCLUDE]ZLIB.H, $(OUT).INCLUDE]ZCONF.H
ZLIB_PRIVATE_HEADERS = [.EXTRAS.ZLIB]DEFLATE.H, -
                       [.EXTRAS.ZLIB]INFBLOCK.H, -
                       [.EXTRAS.ZLIB]INFCODES.H, -
                       [.EXTRAS.ZLIB]INFFAST.H, -
                       [.EXTRAS.ZLIB]INFFIXED.H, -
                       [.EXTRAS.ZLIB]INFTREES.H, -
                       [.EXTRAS.ZLIB]INFUTIL.H, -
                       [.EXTRAS.ZLIB]TREES.H, -
                       [.EXTRAS.ZLIB]ZUTIL.H
ZLIB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                   [.VMS-SUPPORT.LIB.ZLIB]DESCRIP.MMS
! Preserve upstream VMS detection and native RMS fopen extensions.
ZLIB_CFLAGS = $(CFLAGS)/STANDARD=RELAXED_ANSI89/DEFINE=(""HAS_vsnprintf=1"")
! These modules narrow bounded window/buffer offsets, not pointer addresses.
ZLIB_COUNT_CFLAGS = $(ZLIB_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
ZLIB_OBJECTS = $(OUT).LIB.ZLIB]ADLER32.OBJ, -
               $(OUT).LIB.ZLIB]COMPRESS.OBJ, -
               $(OUT).LIB.ZLIB]CRC32.OBJ, -
               $(OUT).LIB.ZLIB]GZIO.OBJ, -
               $(OUT).LIB.ZLIB]UNCOMPR.OBJ, -
               $(OUT).LIB.ZLIB]DEFLATE.OBJ, -
               $(OUT).LIB.ZLIB]TREES.OBJ, -
               $(OUT).LIB.ZLIB]ZUTIL.OBJ, -
               $(OUT).LIB.ZLIB]INFLATE.OBJ, -
               $(OUT).LIB.ZLIB]INFBLOCK.OBJ, -
               $(OUT).LIB.ZLIB]INFTREES.OBJ, -
               $(OUT).LIB.ZLIB]INFCODES.OBJ, -
               $(OUT).LIB.ZLIB]INFUTIL.OBJ, -
               $(OUT).LIB.ZLIB]INFFAST.OBJ

ZLIB : $(OUT).LIB.ZLIB]Z.OLB
	CONTINUE

$(OUT).INCLUDE]ZLIB.H : [.EXTRAS.ZLIB]ZLIB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE]ZCONF.H : [.EXTRAS.ZLIB]ZCONF.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.ZLIB]ADLER32.OBJ : [.EXTRAS.ZLIB]ADLER32.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]ADLER32 "$(ZLIB_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]COMPRESS.OBJ : [.EXTRAS.ZLIB]COMPRESS.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]COMPRESS "$(ZLIB_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]CRC32.OBJ : [.EXTRAS.ZLIB]CRC32.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]CRC32 "$(ZLIB_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]GZIO.OBJ : [.EXTRAS.ZLIB]GZIO.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]GZIO "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]UNCOMPR.OBJ : [.EXTRAS.ZLIB]UNCOMPR.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]UNCOMPR "$(ZLIB_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]DEFLATE.OBJ : [.EXTRAS.ZLIB]DEFLATE.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]DEFLATE "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]TREES.OBJ : [.EXTRAS.ZLIB]TREES.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]TREES "$(ZLIB_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]ZUTIL.OBJ : [.EXTRAS.ZLIB]ZUTIL.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]ZUTIL "$(ZLIB_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]INFLATE.OBJ : [.EXTRAS.ZLIB]INFLATE.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]INFLATE "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]INFBLOCK.OBJ : [.EXTRAS.ZLIB]INFBLOCK.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]INFBLOCK "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]INFTREES.OBJ : [.EXTRAS.ZLIB]INFTREES.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]INFTREES "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]INFCODES.OBJ : [.EXTRAS.ZLIB]INFCODES.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]INFCODES "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]INFUTIL.OBJ : [.EXTRAS.ZLIB]INFUTIL.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]INFUTIL "$(ZLIB_COUNT_CFLAGS)" ZLIB
$(OUT).LIB.ZLIB]INFFAST.OBJ : [.EXTRAS.ZLIB]INFFAST.C, $(ZLIB_HEADERS), -
    $(ZLIB_PRIVATE_HEADERS), $(ZLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ZLIB]INFFAST "$(ZLIB_COUNT_CFLAGS)" ZLIB

$(OUT).LIB.ZLIB]Z.OLB : $(ZLIB_OBJECTS), [.VMS-SUPPORT.LIB.ZLIB]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(ZLIB_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.ZLIB]ZLIB_LIBRARY.LIS $(MMS$TARGET)
