	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]ENTRY "$(DIX_ENTRY_CFLAGS)" RTL


$(OUT).PROGRAMS.XSERVER.DIX]DIX.OLB : $(DIX_OBJECTS), $(DIX_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]ATOM.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]COLORMAP.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]CURSOR.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DEVICES.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DISPATCH.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DIXUTILS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]EVENTS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]EXTENSION.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GC.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GETEVENTS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GLOBALS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GLYPHCURS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]GRABS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]MAIN.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PROPERTY.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]RESOURCE.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]SWAPREP.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]SWAPREQ.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]TABLES.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]WINDOW.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]INITATOMS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DIXFONTS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PRIVATES.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PIXMAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]ENTRY.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DEPRECATED.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]REGISTRY.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]SELECTION.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]ENTERLEAVE.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]EVENTCONVERT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]INPUTUTILS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PTRVELOC.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.DIX]DIX_LIBRARY.LIS $(MMS$TARGET)


$(OUT).PROGRAMS.XSERVER.DIX]DEPRECATED.OBJ : [.XSERVER.XORG-SERVER.DIX]DEPRECATED.C, -
