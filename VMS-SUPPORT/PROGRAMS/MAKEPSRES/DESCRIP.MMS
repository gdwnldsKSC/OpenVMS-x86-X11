! programs/makepsres/Imakefile's standalone PostScript resource-directory tool.
MAKEPSRES_HEADERS = $(COMMON_HEADERS)
MAKEPSRES_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                       [.VMS-SUPPORT]HEADERS.MMS, -
                       [.VMS-SUPPORT.PROGRAMS.MAKEPSRES]DESCRIP.MMS
! Preserve the upstream callback declaration's embedded parameter comment.
MAKEPSRES_CFLAGS = $(CFLAGS)/DEFINE=XENVIRONMENT/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)

MAKEPSRES : $(OUT).PROGRAMS.MAKEPSRES]MAKEPSRES.EXE
	CONTINUE

$(OUT).PROGRAMS.MAKEPSRES]MAKEPSRES.OBJ : [.PROGRAMS.MAKEPSRES]MAKEPSRES.C, -
    $(MAKEPSRES_HEADERS), $(MAKEPSRES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.MAKEPSRES]MAKEPSRES "$(MAKEPSRES_CFLAGS)" MAKEPSRES

$(OUT).PROGRAMS.MAKEPSRES]MAKEPSRES.EXE : $(OUT).PROGRAMS.MAKEPSRES]MAKEPSRES.OBJ, -
    [.VMS-SUPPORT.PROGRAMS.MAKEPSRES]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.MAKEPSRES]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.MAKEPSRES]LINK.COM
