! In-memory scalar and array codec subset of lib/Xdmcp/Imakefile; no transport.
XDMCP_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]X.H, -
                $(OUT).INCLUDE.X11]XMD.H, $(OUT).INCLUDE.X11]XDMCP.H
XDMCP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                   [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XDMCP]DESCRIP.MMS
XDMCP_SCALAR_OBJECTS = $(OUT).LIB.XDMCP]RC8.OBJ, $(OUT).LIB.XDMCP]RC16.OBJ, -
                      $(OUT).LIB.XDMCP]RC32.OBJ, $(OUT).LIB.XDMCP]WC8.OBJ, -
                      $(OUT).LIB.XDMCP]WC16.OBJ, $(OUT).LIB.XDMCP]WC32.OBJ, -
                      $(OUT).LIB.XDMCP]RHEAD.OBJ, $(OUT).LIB.XDMCP]RR.OBJ
XDMCP_ARRAY_OBJECTS = $(OUT).LIB.XDMCP]ALLOC.OBJ, $(OUT).LIB.XDMCP]A8EQ.OBJ, -
                       $(OUT).LIB.XDMCP]CA8.OBJ, $(OUT).LIB.XDMCP]AA8.OBJ, -
                       $(OUT).LIB.XDMCP]AA16.OBJ, $(OUT).LIB.XDMCP]AA32.OBJ, -
                       $(OUT).LIB.XDMCP]AOFA8.OBJ, $(OUT).LIB.XDMCP]DA8.OBJ, -
                       $(OUT).LIB.XDMCP]DA16.OBJ, $(OUT).LIB.XDMCP]DA32.OBJ, -
                       $(OUT).LIB.XDMCP]DAOFA8.OBJ, $(OUT).LIB.XDMCP]RA8.OBJ, -
                       $(OUT).LIB.XDMCP]RA16.OBJ, $(OUT).LIB.XDMCP]RA32.OBJ, -
                       $(OUT).LIB.XDMCP]RAOFA8.OBJ, $(OUT).LIB.XDMCP]RAA8.OBJ, -
                       $(OUT).LIB.XDMCP]RAA16.OBJ, $(OUT).LIB.XDMCP]RAA32.OBJ, -
                       $(OUT).LIB.XDMCP]RAAOA8.OBJ, $(OUT).LIB.XDMCP]WA8.OBJ, -
                       $(OUT).LIB.XDMCP]WA16.OBJ, $(OUT).LIB.XDMCP]WA32.OBJ, -
                       $(OUT).LIB.XDMCP]WAOFA8.OBJ
XDMCP_CODEC_OBJECTS = $(XDMCP_SCALAR_OBJECTS), $(XDMCP_ARRAY_OBJECTS)

XDMCP_CODEC : $(OUT).LIB.XDMCP]XDMCP_CODEC.OLB
	CONTINUE

$(OUT).INCLUDE.X11]XDMCP.H : [.LIB.XDMCP]XDMCP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XDMCP]RC8.OBJ : [.LIB.XDMCP]RC8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RC8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RC16.OBJ : [.LIB.XDMCP]RC16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RC16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RC32.OBJ : [.LIB.XDMCP]RC32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RC32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WC8.OBJ : [.LIB.XDMCP]WC8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WC8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WC16.OBJ : [.LIB.XDMCP]WC16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WC16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WC32.OBJ : [.LIB.XDMCP]WC32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WC32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RHEAD.OBJ : [.LIB.XDMCP]RHEAD.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RHEAD "$(CFLAGS)"
$(OUT).LIB.XDMCP]RR.OBJ : [.LIB.XDMCP]RR.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RR "$(CFLAGS)"

$(OUT).LIB.XDMCP]ALLOC.OBJ : [.LIB.XDMCP]ALLOC.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]ALLOC "$(CFLAGS)"
$(OUT).LIB.XDMCP]A8EQ.OBJ : [.LIB.XDMCP]A8EQ.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]A8EQ "$(CFLAGS)"
$(OUT).LIB.XDMCP]CA8.OBJ : [.LIB.XDMCP]CA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]CA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]AA8.OBJ : [.LIB.XDMCP]AA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]AA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]AA16.OBJ : [.LIB.XDMCP]AA16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]AA16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]AA32.OBJ : [.LIB.XDMCP]AA32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]AA32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]AOFA8.OBJ : [.LIB.XDMCP]AOFA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]AOFA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]DA8.OBJ : [.LIB.XDMCP]DA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]DA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]DA16.OBJ : [.LIB.XDMCP]DA16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]DA16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]DA32.OBJ : [.LIB.XDMCP]DA32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]DA32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]DAOFA8.OBJ : [.LIB.XDMCP]DAOFA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]DAOFA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RA8.OBJ : [.LIB.XDMCP]RA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RA16.OBJ : [.LIB.XDMCP]RA16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RA16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RA32.OBJ : [.LIB.XDMCP]RA32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RA32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RAOFA8.OBJ : [.LIB.XDMCP]RAOFA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RAOFA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RAA8.OBJ : [.LIB.XDMCP]RAA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RAA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RAA16.OBJ : [.LIB.XDMCP]RAA16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RAA16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RAA32.OBJ : [.LIB.XDMCP]RAA32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RAA32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]RAAOA8.OBJ : [.LIB.XDMCP]RAAOA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]RAAOA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WA8.OBJ : [.LIB.XDMCP]WA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WA8 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WA16.OBJ : [.LIB.XDMCP]WA16.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WA16 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WA32.OBJ : [.LIB.XDMCP]WA32.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WA32 "$(CFLAGS)"
$(OUT).LIB.XDMCP]WAOFA8.OBJ : [.LIB.XDMCP]WAOFA8.C, $(XDMCP_HEADERS), $(XDMCP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XDMCP]WAOFA8 "$(CFLAGS)"

$(OUT).LIB.XDMCP]XDMCP_CODEC.OLB : $(XDMCP_CODEC_OBJECTS), [.VMS-SUPPORT.LIB.XDMCP]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XDMCP_CODEC_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XDMCP]XDMCP_CODEC_LIBRARY.LIS $(MMS$TARGET)
