	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]GETEVENTS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

