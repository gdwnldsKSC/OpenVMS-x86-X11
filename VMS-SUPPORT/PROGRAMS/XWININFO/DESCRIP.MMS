! Complete xwininfo, including its unchanged shared xlsfonts helper.
XWININFO_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11]XLOCALE.H, $(OUT).INCLUDE.X11]CURSORFONT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H, -
    $(OUT).INCLUDE.X11.XMU]WINUTIL.H
XWININFO_PRIVATE_HEADERS = [.APP.XWININFO]DSIMPLE.H
XWININFO_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XWININFO]DESCRIP.MMS
XWININFO_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT
XWININFO_MAIN_CFLAGS = $(XWININFO_CFLAGS)/POINTER_SIZE=64=ARGV
! Preserve the distinction between upstream Malloc/Realloc and the C RTL.
XWININFO_CPPFLAGS = /DEFINE=(""Malloc""=XWININFO_MALLOC,""Realloc""=XWININFO_REALLOC)
XWININFO_OBJECTS = $(OUT).PROGRAMS.XWININFO]XWININFO.OBJ, -
    $(OUT).PROGRAMS.XWININFO]DSIMPLE.OBJ

XWININFO : $(OUT).PROGRAMS.XWININFO]XWININFO.EXE
	CONTINUE

$(OUT).PROGRAMS.XWININFO]XWININFO.OBJ : [.APP.XWININFO]XWININFO.C, -
    $(XWININFO_HEADERS), $(XWININFO_PRIVATE_HEADERS), $(XWININFO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XWININFO]XWININFO "$(XWININFO_MAIN_CFLAGS)" XWININFO "$(XWININFO_CPPFLAGS)"

$(OUT).PROGRAMS.XWININFO]DSIMPLE.OBJ : [.APP.XWININFO]DSIMPLE.C, -
    $(XWININFO_HEADERS), $(XWININFO_PRIVATE_HEADERS), $(XWININFO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XWININFO]DSIMPLE "$(XWININFO_CFLAGS)" XWININFO "$(XWININFO_CPPFLAGS)"

$(OUT).PROGRAMS.XWININFO]XWININFO.EXE : $(XWININFO_OBJECTS), -
    $(OUT).LIB.XMUU]XMUU.OLB, $(OUT).LIB.XEXT]XEXT.OLB, -
    $(OUT).LIB.X11]X11.OLB, [.VMS-SUPPORT.PROGRAMS.XWININFO]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XWININFO]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XWININFO]LINK.COM
