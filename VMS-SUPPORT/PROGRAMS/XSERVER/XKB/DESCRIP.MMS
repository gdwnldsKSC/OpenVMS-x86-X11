	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBMALLOC "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

