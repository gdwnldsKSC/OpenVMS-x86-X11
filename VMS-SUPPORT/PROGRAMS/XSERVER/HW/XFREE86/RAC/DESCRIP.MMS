! Complete static XFree86 RAC library; xf86RACmodule.c is loader-only metadata.
! P64/long32 with Render and the matching XFree86 screen/input layouts.
RAC_HEADERS = $(MI_HEADERS)
RAC_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]COMPILER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VERSION.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAC]XF86RAC.H, -
    [.XSERVER.XORG-SERVER.RENDER]GLYPHSTR.H, -
    [.XSERVER.XORG-SERVER.RENDER]MIPICT.H, -
    [.XSERVER.XORG-SERVER.RENDER]PICTURE.H, -
    [.XSERVER.XORG-SERVER.RENDER]PICTURESTR.H
RAC_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.RAC]DESCRIP.MMS
RAC_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
RAC_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT, -
    NO_INLINE,XORG_VERSION_CURRENT=70100000,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0, -
    IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)
RAC_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAC]XF86RAC.OBJ

RAC : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAC]RAC.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAC]XF86RAC.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAC]XF86RAC.C, -
    $(RAC_HEADERS), $(RAC_PRIVATE_HEADERS), $(RAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAC]XF86RAC "$(RAC_CFLAGS)" RAC "$(RAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAC]RAC.OLB : $(RAC_OBJECTS), $(RAC_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(RAC_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAC]RAC_LIBRARY.LIS $(MMS$TARGET)
