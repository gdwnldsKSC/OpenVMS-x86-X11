! Complete ordinary static Xv library from lib/Xv/Imakefile.
XV_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVLIB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XSHM.H
XV_PRIVATE_HEADERS = [.LIB.LIBXV.SRC]XVLIBINT.H
XV_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XV]DESCRIP.MMS
! Xv:1103 encodes a same-segment byte distance as the CARD32 wire offset.
XV_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XV_OBJECTS = $(OUT).LIB.XV]XV.OBJ

XV : $(OUT).LIB.XV]XV.OLB
	CONTINUE

$(OUT).LIB.XV]XV.OBJ : [.LIB.LIBXV.SRC]XV.C, -
    $(XV_HEADERS), $(XV_PRIVATE_HEADERS), $(XV_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XV]XV "$(XV_CFLAGS)" XV

$(OUT).LIB.XV]XV.OLB : $(XV_OBJECTS), $(XV_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XV_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XV]XV_LIBRARY.LIS $(MMS$TARGET)
