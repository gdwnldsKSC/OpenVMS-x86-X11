! Complete xauth program from programs/xauth/Imakefile, using TCP displays.
XAUTH_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XAUTH.H, -
    $(OUT).INCLUDE.X11.XMU]SYSUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SECURITY.H
XAUTH_PRIVATE_HEADERS = [.PROGRAMS.XAUTH]XAUTH.H
XAUTH_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XAUTH]DESCRIP.MMS
XAUTH_CFLAGS = $(CFLAGS)/DEFINE=(_XOPEN_SOURCE=600,TCPCONN)/MAIN=POSIX_EXIT
! Upstream display-name parsing retains int string counts with P64 ptrdiff_t.
XAUTH_COUNT_CFLAGS = $(XAUTH_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! The native entry enables the permission semantics required by umask(0077).
! The renamed upstream main exits on every path.
XAUTH_MAIN_CFLAGS = $(XAUTH_CFLAGS)/DEFINE=(_XOPEN_SOURCE=600,TCPCONN,""main""=VMS_XAUTH_MAIN) -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=MISSINGRETURN)
XAUTH_ENTRY_CFLAGS = $(XAUTH_CFLAGS)/POINTER_SIZE=64=ARGV
XAUTH_OBJECTS = $(OUT).PROGRAMS.XAUTH]ENTRY.OBJ, -
    $(OUT).PROGRAMS.XAUTH]XAUTH.OBJ, -
    $(OUT).PROGRAMS.XAUTH]GETHOST.OBJ, -
    $(OUT).PROGRAMS.XAUTH]PROCESS.OBJ, -
    $(OUT).PROGRAMS.XAUTH]PARSEDPY.OBJ

XAUTH : $(OUT).PROGRAMS.XAUTH]XAUTH.EXE
	CONTINUE

$(OUT).PROGRAMS.XAUTH]ENTRY.OBJ : [.VMS-SUPPORT.PROGRAMS.XAUTH]ENTRY.C, -
    $(XAUTH_HEADERS), $(XAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XAUTH]ENTRY "$(XAUTH_ENTRY_CFLAGS)" XAUTH

$(OUT).PROGRAMS.XAUTH]XAUTH.OBJ : [.PROGRAMS.XAUTH]XAUTH.C, -
    $(XAUTH_HEADERS), $(XAUTH_PRIVATE_HEADERS), $(XAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XAUTH]XAUTH "$(XAUTH_MAIN_CFLAGS)" XAUTH

$(OUT).PROGRAMS.XAUTH]GETHOST.OBJ : [.PROGRAMS.XAUTH]GETHOST.C, -
    $(XAUTH_HEADERS), $(XAUTH_PRIVATE_HEADERS), $(XAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XAUTH]GETHOST "$(XAUTH_CFLAGS)" XAUTH

$(OUT).PROGRAMS.XAUTH]PROCESS.OBJ : [.PROGRAMS.XAUTH]PROCESS.C, -
    $(XAUTH_HEADERS), $(XAUTH_PRIVATE_HEADERS), $(XAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XAUTH]PROCESS "$(XAUTH_COUNT_CFLAGS)" XAUTH

$(OUT).PROGRAMS.XAUTH]PARSEDPY.OBJ : [.PROGRAMS.XAUTH]PARSEDPY.C, -
    $(XAUTH_HEADERS), $(XAUTH_PRIVATE_HEADERS), $(XAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XAUTH]PARSEDPY "$(XAUTH_COUNT_CFLAGS)" XAUTH

$(OUT).PROGRAMS.XAUTH]XAUTH.EXE : $(XAUTH_OBJECTS), -
    $(OUT).LIB.XAU]XAU.OLB, $(OUT).LIB.XMUU]XMUU.OLB, -
    $(OUT).LIB.XEXT]XEXT.OLB, $(OUT).LIB.X11]X11.OLB, -
    [.VMS-SUPPORT.PROGRAMS.XAUTH]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XAUTH]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XAUTH]LINK.COM
