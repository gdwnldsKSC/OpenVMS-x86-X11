! Complete static upstream cfb32 library; PSZ=32, no optional platform/loadable hooks.
! Native P64 pointers with upstream CARD32 pixel groups and 32-bit long values.
CFB32_HEADERS = $(MFB_HEADERS)
CFB32_PRIVATE_HEADERS = $(MFB_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.CFB]CFB.H, -
    [.PROGRAMS.XSERVER.CFB]CFB16.H, -
    [.PROGRAMS.XSERVER.CFB]CFB24.H, -
    [.PROGRAMS.XSERVER.CFB]CFB32.H, -
    [.PROGRAMS.XSERVER.CFB]CFB8BIT.H, -
    [.PROGRAMS.XSERVER.CFB]CFBMAP.H, -
    [.PROGRAMS.XSERVER.CFB]CFBMSKBITS.H, -
    [.PROGRAMS.XSERVER.CFB]CFBRROP.H, -
    [.PROGRAMS.XSERVER.CFB]CFBTAB.H, -
    [.PROGRAMS.XSERVER.CFB]CFBUNMAP.H, -
    [.PROGRAMS.XSERVER.CFB24]CFBRROP24.H
CFB32_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MFB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB32]DESCRIP.MMS
CFB32_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Preserve upstream int-sized clipped-box/input counts and pixel-word indices with P64 pointers.
CFB32_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
CFB32_CPP_DEFINES = PIXPRIV,PSZ=32,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1
CFB32_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES))

CFB32_CFBSOLIDC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB32_CFBSOLIDX_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB32_CFBSOLIDG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXset"")
CFB32_CFBTILEODDC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB32_CFBTILEODDG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=0"")
CFB32_CFBTILE32C_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB32_CFBTILE32G_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=0"")
CFB32_CFBZERARCC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB32_CFBZERARCX_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB32_CFBZERARCG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXset"")
CFB32_CFBFILLARCC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB32_CFBFILLARCG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXset"")
CFB32_CFBSEG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""POLYSEGMENT"")
CFB32_CFB8LINECO_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB32_CFB8LINEX_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB32_CFB8LINEG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXset"")
CFB32_CFB8LINECP_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""PREVIOUS"")
CFB32_CFB8SEGCS_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"", -
    ""WIDTH_SHIFT"")
CFB32_CFB8SEGX_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXxor"", -
    ""POLYSEGMENT"")
CFB32_CFB8SEGG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXset"", -
    ""POLYSEGMENT"")
CFB32_CFB8SEGC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"")
CFB32_CFBBLTC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB32_CFBBLTX_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=Mxor"")
CFB32_CFBBLTO_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=Mor"")
CFB32_CFBBLTG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""MROP=0"")
CFB32_CFBPLY1RCTC_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB32_CFBPLY1RCTG_CPPFLAGS = /DEFINE=($(CFB32_CPP_DEFINES), -
    ""RROP=GXset"")

! Exact-byte aliases retain distinct native object module names for Unix variants.
$(OUT).PROGRAMS.XSERVER.CFB32]CFBSOLIDC.C : [.PROGRAMS.XSERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.CFB32]CFBSOLIDX.C : [.PROGRAMS.XSERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

