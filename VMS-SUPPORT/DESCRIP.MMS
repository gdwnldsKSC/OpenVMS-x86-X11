! Original native make entry point; invoke through BUILD.COM from any directory.
.INCLUDE [.VMS-SUPPORT]CONFIG.MMS

ALL : XAU, XDMCP, ZLIB, FONTENC, EXPAT, LBXUTIL, XFONT, FNTSTUBS, FS, PSRES, REGEX, ICE, SM, BDFTOPCF, -
      FSLSFONTS, SHOWFONT, XFSINFO, ICEAUTH, MAKEPSRES, SHOWRGB, MAKESTRS, MAKEDEPEND, LNDIR, ATOBM, GTF, -
      FREETYPE2, MKFONTSCALE, FONTTOSFNT, REVPATH, RMAN, UCS2ANY, DAMAGE, MI, CBRT, FB, RENDER
	CONTINUE

.INCLUDE [.VMS-SUPPORT]HEADERS.MMS
.INCLUDE [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.XDMCP]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.ZLIB]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.EXPAT]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FREETYPE2]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.LBXUTIL]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FNTSTUBS]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FS]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.PSRES]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.ICE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.SM]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.BDFTOPCF]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.FSLSFONTS]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.SHOWFONT]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.XFSINFO]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.ICEAUTH]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.MAKEPSRES]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.SHOWRGB]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.BITMAP]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.MKFONTSCALE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.FONTTOSFNT]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.ETC]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.CONFIG.UTIL]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.CONFIG.MAKEDEPEND]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.FONTS.UTIL]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS

HEADERS : $(XAU_HEADERS), $(XDMCP_HEADERS), $(ZLIB_HEADERS), $(FONTENC_HEADERS), -
          $(EXPAT_HEADERS), $(LBXUTIL_HEADERS), $(XFONT_HEADERS), -
          $(FNTSTUBS_HEADERS), $(FS_HEADERS), $(PSRES_HEADERS), $(REGEX_HEADERS), -
          $(REGEX_IHEADERS), $(ICE_HEADERS), $(SM_HEADERS), -
          $(BDFTOPCF_HEADERS), $(FSLSFONTS_HEADERS), $(SHOWFONT_HEADERS), -
          $(XFSINFO_HEADERS), $(ICEAUTH_HEADERS), $(MAKEPSRES_HEADERS), -
          $(SHOWRGB_HEADERS), $(MAKESTRS_HEADERS), $(MAKEDEPEND_HEADERS), $(LNDIR_HEADERS), -
          $(ATOBM_HEADERS), $(GTF_HEADERS), $(FREETYPE2_HEADERS), $(MKFONTSCALE_HEADERS), -
          $(FONTTOSFNT_HEADERS), $(DAMAGE_HEADERS), $(MI_HEADERS), $(FB_HEADERS), $(RENDER_HEADERS)
	CONTINUE
