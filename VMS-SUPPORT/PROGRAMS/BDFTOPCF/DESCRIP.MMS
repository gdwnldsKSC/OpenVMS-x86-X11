! programs/bdftopcf/Imakefile's converter, using its current Xfont object closure.
BDFTOPCF_HEADERS = $(FONT_BITMAP_HEADERS)
BDFTOPCF_PRIVATE_HEADERS = $(FONT_BITMAP_PRIVATE_HEADERS)
BDFTOPCF_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                       [.VMS-SUPPORT]HEADERS.MMS, -
                       [.VMS-SUPPORT.PROGRAMS.BDFTOPCF]DESCRIP.MMS
BDFTOPCF_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT

BDFTOPCF : $(OUT).PROGRAMS.BDFTOPCF]BDFTOPCF.EXE
	CONTINUE

$(OUT).PROGRAMS.BDFTOPCF]BDFTOPCF.OBJ : [.PROGRAMS.BDFTOPCF]BDFTOPCF.C, -
    $(BDFTOPCF_HEADERS), $(BDFTOPCF_PRIVATE_HEADERS), $(BDFTOPCF_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.BDFTOPCF]BDFTOPCF "$(BDFTOPCF_CFLAGS)" BDFTOPCF

$(OUT).PROGRAMS.BDFTOPCF]BDFTOPCF.EXE : $(OUT).PROGRAMS.BDFTOPCF]BDFTOPCF.OBJ, -
    $(OUT).LIB.FONT.BITMAP]BITMAP.OLB, $(OUT).LIB.FONT.FONTFILE]FONTFILE.OLB, -
    $(OUT).LIB.FONTUTIL]FONTUTIL.OLB, -
    $(OUT).LIB.ZLIB]Z.OLB, [.VMS-SUPPORT.PROGRAMS.BDFTOPCF]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.BDFTOPCF]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.BDFTOPCF]LINK.COM
