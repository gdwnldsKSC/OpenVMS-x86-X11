! Complete ordinary static RECORD library from the upstream Imakefile.
! Keep the server build's NDEBUG profile; standalone TESTING is excluded.
RECORD_HEADERS = $(RENDER_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]RECORD.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RECORDSTR.H
RECORD_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), [.XSERVER.XORG-SERVER.RECORD]SET.H
RECORD_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RECORD]DESCRIP.MMS
! Fixed protocol-range member offsets fit the upstream int byte-offset API.
! Setup swaps view the same aligned P64 protocol buffer as bytes and structures.
RECORD_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3,PTRMISMATCH))
! Iteration uses CARD16-domain tokens or same-array offsets; the storage cast
! checks only alignment bits and leaves the full pointer unchanged.
RECORD_SET_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3,POINTERINTCAST))
RECORD_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,XRECORD,NDEBUG,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

RECORD_OBJECTS = $(OUT).PROGRAMS.XSERVER.RECORD]RECORD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RECORD]SET.OBJ

RECORD : $(OUT).PROGRAMS.XSERVER.RECORD]RECORD.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.RECORD]RECORD.OBJ : [.XSERVER.XORG-SERVER.RECORD]RECORD.C, -
    $(RECORD_HEADERS), $(RECORD_PRIVATE_HEADERS), $(RECORD_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RECORD]RECORD "$(RECORD_COUNT_CFLAGS)" RECORD "$(RECORD_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RECORD]SET.OBJ : [.XSERVER.XORG-SERVER.RECORD]SET.C, -
    $(RECORD_HEADERS), $(RECORD_PRIVATE_HEADERS), $(RECORD_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RECORD]SET "$(RECORD_SET_CFLAGS)" RECORD "$(RECORD_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RECORD]RECORD.OLB : $(RECORD_OBJECTS), $(RECORD_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.RECORD]RECORD.OBJ,$(OUT).PROGRAMS.XSERVER.RECORD]SET.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.RECORD]RECORD_LIBRARY.LIS $(MMS$TARGET)
