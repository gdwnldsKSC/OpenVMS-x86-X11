! Complete ordinary static Xxf86vm library from lib/Xxf86vm/Imakefile.
XXF86VM_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86VMODE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86VMSTR.H
XXF86VM_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XXF86VM]DESCRIP.MMS
XXF86VM_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XXF86VM_OBJECTS = $(OUT).LIB.XXF86VM]XF86VMODE.OBJ

XXF86VM : $(OUT).LIB.XXF86VM]XXF86VM.OLB
	CONTINUE

$(OUT).LIB.XXF86VM]XF86VMODE.OBJ : [.LIB.XXF86VM]XF86VMODE.C, -
    $(XXF86VM_HEADERS), $(XXF86VM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XXF86VM]XF86VMODE "$(XXF86VM_CFLAGS)" XXF86VM

$(OUT).LIB.XXF86VM]XXF86VM.OLB : $(XXF86VM_OBJECTS), $(XXF86VM_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XXF86VM_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XXF86VM]XXF86VM_LIBRARY.LIS $(MMS$TARGET)
