	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSGETCATS "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSLISTCATS.OBJ : [.LIB.LIBFS.SRC]FSLISTCATS.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSLISTCATS "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSLISTEXT.OBJ : [.LIB.LIBFS.SRC]FSLISTEXT.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSLISTEXT "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSMISC.OBJ : [.LIB.LIBFS.SRC]FSMISC.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSMISC "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSNEXTEV.OBJ : [.LIB.LIBFS.SRC]FSNEXTEV.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSNEXTEV "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSOPENFONT.OBJ : [.LIB.LIBFS.SRC]FSOPENFONT.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSOPENFONT "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSOPENSERV.OBJ : [.LIB.LIBFS.SRC]FSOPENSERV.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSOPENSERV "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSQGLYPHS.OBJ : [.LIB.LIBFS.SRC]FSQGLYPHS.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSQGLYPHS "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSQXEXT.OBJ : [.LIB.LIBFS.SRC]FSQXEXT.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSQXEXT "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSQXINFO.OBJ : [.LIB.LIBFS.SRC]FSQXINFO.C, -
