	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XI]XEXTINT "$(XI_CFLAGS)" XI

$(OUT).LIB.XI]XI.OLB : $(XI_OBJECTS), $(XI_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XALLOWDV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCHGDCTL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCHGFCTL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCHGKBD.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCHGKMAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCHGPNT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCHGPROP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XCLOSEDEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XDEVBELL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XEXTTOWIRE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETBMAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETDCTL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETFCTL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETKMAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETMMAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETPROP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGETVERS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGMOTION.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGRABDEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGRDVBUT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGRDVKEY.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGTFOCUS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XGTSELECT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XLISTDEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XOPENDEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XQUERYDV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSELECT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSETBMAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSETDVAL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSETMMAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSETMODE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSNDEXEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XSTFOCUS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XUNGRDEV.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XUNGRDVB.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XUNGRDVK.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XI]XEXTINT.OBJ
	LIBRARY/LIST=$(OUT).LIB.XI]XI_LIBRARY.LIS $(MMS$TARGET)
