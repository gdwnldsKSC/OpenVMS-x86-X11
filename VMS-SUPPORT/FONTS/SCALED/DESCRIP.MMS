! Modular scalable font packages; Ethiopic joins TTF/OTF and Meltho joins OTF.
! Fontconfig caches are not required by the core X font path.
FONTS_SCALED : FONTS_SPEEDO, FONTS_TYPE1, FONTS_TTF, FONTS_OTF, FONTS_CID
	CONTINUE

FONTS_SPEEDO : MKFONTDIR, FONTS_ENCODINGS
	@[.VMS-SUPPORT.FONTS.SCALED]BUILD.COM SPEEDO

FONTS_TYPE1 : MKFONTDIR, FONTS_ENCODINGS
	@[.VMS-SUPPORT.FONTS.SCALED]BUILD.COM TYPE1

FONTS_TTF : MKFONTDIR, FONTS_ENCODINGS
	@[.VMS-SUPPORT.FONTS.SCALED]BUILD.COM TTF

FONTS_OTF : MKFONTDIR, FONTS_ENCODINGS
	@[.VMS-SUPPORT.FONTS.SCALED]BUILD.COM OTF

FONTS_CID : MKFONTDIR, FONTS_ENCODINGS
	@[.VMS-SUPPORT.FONTS.SCALED]BUILD.COM CID
