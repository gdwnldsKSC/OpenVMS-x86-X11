X11 : $(OUT).LIB.X11]X11.OLB
	CONTINUE

! Exact-copy counterparts of the upstream x11trans.c/ximtrans.c source links.
$(OUT).LIB.X11]X11TRANS.C : [.LIB.XTRANS]TRANSPORT.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.X11]XIMTRANS.C : [.LIB.XTRANS]TRANSPORT.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.X11]MAKEKEYS.OBJ : [.LIB.LIBX11.SRC.UTIL]MAKEKEYS.C, -
    $(X11_HEADERS), $(X11_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.X11]MAKEKEYS "$(X11_CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT" X11_MAKEKEYS

$(OUT).LIB.X11]MAKEKEYS.EXE : $(OUT).LIB.X11]MAKEKEYS.OBJ, -
    [.VMS-SUPPORT.LIB.X11]LINK_MAKEKEYS.COM
	@[.VMS-SUPPORT.LIB.X11]LINK_MAKEKEYS.COM

$(OUT).LIB.X11]KS_TABLES.H : [.PROTO.XPROTO]KEYSYMDEF.H, -
    $(OUT).LIB.X11]MAKEKEYS.EXE, [.VMS-SUPPORT.LIB.X11]MAKE_TABLES.COM
	@[.VMS-SUPPORT.LIB.X11]MAKE_TABLES.COM $(MMS$TARGET) $(MMS$SOURCE) $(OUT).LIB.X11]MAKEKEYS.EXE

