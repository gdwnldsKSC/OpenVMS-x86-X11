    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]VESAMODES., [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]EXTRAMODES., -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.COMMON]GENERATE_MODES.COM
	@[.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.COMMON]GENERATE_MODES.COM

