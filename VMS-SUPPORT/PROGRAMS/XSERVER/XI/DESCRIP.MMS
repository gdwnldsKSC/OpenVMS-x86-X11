$(OUT).PROGRAMS.XSERVER.XI]XINPUT.OLB : $(XINPUT_OBJECTS), $(XINPUT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]ALLOWEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGKBD.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGDCTL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGFCTL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGKMAP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGPROP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]CHGPTR.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CLOSEDEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]DEVBELL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]EXEVENTS.OBJ,$(OUT).PROGRAMS.XSERVER.XI]EXTINIT.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETDCTL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]GETFCTL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETFOCUS.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETBMAP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETKMAP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETMMAP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETPROP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]GETSELEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GETVERS.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GTMOTION.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GRABDEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GRABDEVB.OBJ,$(OUT).PROGRAMS.XSERVER.XI]GRABDEVK.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]LISTDEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]OPENDEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]QUERYST.OBJ,$(OUT).PROGRAMS.XSERVER.XI]SELECTEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]SENDEXEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]SETDVAL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]SETFOCUS.OBJ,$(OUT).PROGRAMS.XSERVER.XI]SETMODE.OBJ,$(OUT).PROGRAMS.XSERVER.XI]SETBMAP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]SETMMAP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]UNGRDEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]UNGRDEVB.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]UNGRDEVK.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XI]XINPUT_LIBRARY.LIS $(MMS$TARGET)

