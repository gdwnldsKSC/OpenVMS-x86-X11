! Upstream libxcb core: eight transport/runtime units and three generated protocols.
XCB_PUBLIC_HEADERS = $(OUT).INCLUDE.XCB]XCB.H, $(OUT).INCLUDE.XCB]XCBEXT.H, -
    $(OUT).INCLUDE.XCB]XPROTO.H, $(OUT).INCLUDE.XCB]BIGREQ.H, $(OUT).INCLUDE.XCB]XC_MISC.H
XCB_HEADERS = $(XCB_PUBLIC_HEADERS), $(OUT).INCLUDE.X11]XAUTH.H, -
    $(OUT).LIB.XCB]CONFIG.H, [.XCB.LIBXCB.SRC]XCBINT.H
XCB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT.LIB.XCB]DESCRIP.MMS
XCB_GENERATOR = [.XCB.LIBXCB.SRC]C_CLIENT.PY, -
    [.XCB.XCB-PROTO.XCBGEN]__INIT__.PY, [.XCB.XCB-PROTO.XCBGEN]ERROR.PY, -
    [.XCB.XCB-PROTO.XCBGEN]EXPR.PY, [.XCB.XCB-PROTO.XCBGEN]MATCHER.PY, -
    [.XCB.XCB-PROTO.XCBGEN]STATE.PY, [.XCB.XCB-PROTO.XCBGEN]XTYPES.PY, -
    [.VMS-SUPPORT.LIB.XCB]GENERATE.COM
XCB_CFLAGS = $(CFLAGS)/REENTRANCY=MULTITHREAD -
    /DEFINE=(HAVE_CONFIG_H,_REENTRANT=1)
! Native P64 iovec layouts agree; the RTL uses a separate __iovec64 tag
! and BSD iov_base is char * rather than the POSIX void *.
XCB_IO_CFLAGS = $(XCB_CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=PTRMISMATCH)
! Same-buffer differences retain upstream int/size_t count limits.
XCB_COUNT_CFLAGS = $(XCB_CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
XCB_OBJECTS = $(OUT).LIB.XCB]XCB_CONN.OBJ, -
    $(OUT).LIB.XCB]XCB_OUT.OBJ, -
    $(OUT).LIB.XCB]XCB_IN.OBJ, -
    $(OUT).LIB.XCB]XCB_EXT.OBJ, -
    $(OUT).LIB.XCB]XCB_XID.OBJ, -
    $(OUT).LIB.XCB]XCB_LIST.OBJ, -
    $(OUT).LIB.XCB]XCB_UTIL.OBJ, -
    $(OUT).LIB.XCB]XCB_AUTH.OBJ, -
    $(OUT).LIB.XCB]XPROTO.OBJ, -
    $(OUT).LIB.XCB]BIGREQ.OBJ, -
    $(OUT).LIB.XCB]XC_MISC.OBJ

XCB : $(OUT).LIB.XCB]XCB.OLB
	CONTINUE

XCB_SHAPE : $(OUT).LIB.XCB]XCB_SHAPE.OLB
	CONTINUE

$(OUT).LIB.XCB]SHAPE.C, $(OUT).LIB.XCB]SHAPE.H : -
    [.XCB.XCB-PROTO.SRC]SHAPE.XML, [.XCB.XCB-PROTO.SRC]XPROTO.XML, $(XCB_GENERATOR)
	@[.VMS-SUPPORT.LIB.XCB]GENERATE.COM "SHAPE"

$(OUT).INCLUDE.XCB]SHAPE.H : $(OUT).LIB.XCB]SHAPE.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XCB]SHAPE.OBJ : $(OUT).LIB.XCB]SHAPE.C, $(OUT).INCLUDE.XCB]SHAPE.H, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]SHAPE "$(XCB_COUNT_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_SHAPE.OLB : $(OUT).LIB.XCB]SHAPE.OBJ, -
    $(OUT).LIB.XCB]XCB.OLB, $(XCB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCB]SHAPE.OBJ
	LIBRARY/LIST=$(OUT).LIB.XCB]XCB_SHAPE_LIBRARY.LIS $(MMS$TARGET)

$(OUT).LIB.XCB]CONFIG.H : [.VMS-SUPPORT.LIB.XCB]CONFIG.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.XCB]XCB.H : [.XCB.LIBXCB.SRC]XCB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.XCB]XCBEXT.H : [.XCB.LIBXCB.SRC]XCBEXT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XCB]XPROTO.C, $(OUT).LIB.XCB]XPROTO.H : -
    [.XCB.XCB-PROTO.SRC]XPROTO.XML, [.XCB.XCB-PROTO.SRC]XPROTO.XML, $(XCB_GENERATOR)
	@[.VMS-SUPPORT.LIB.XCB]GENERATE.COM "XPROTO"

$(OUT).INCLUDE.XCB]XPROTO.H : $(OUT).LIB.XCB]XPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XCB]BIGREQ.C, $(OUT).LIB.XCB]BIGREQ.H : -
    [.XCB.XCB-PROTO.SRC]BIGREQ.XML, [.XCB.XCB-PROTO.SRC]XPROTO.XML, $(XCB_GENERATOR)
	@[.VMS-SUPPORT.LIB.XCB]GENERATE.COM "BIGREQ"

$(OUT).INCLUDE.XCB]BIGREQ.H : $(OUT).LIB.XCB]BIGREQ.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XCB]XC_MISC.C, $(OUT).LIB.XCB]XC_MISC.H : -
    [.XCB.XCB-PROTO.SRC]XC_MISC.XML, [.XCB.XCB-PROTO.SRC]XPROTO.XML, $(XCB_GENERATOR)
	@[.VMS-SUPPORT.LIB.XCB]GENERATE.COM "XC_MISC"

$(OUT).INCLUDE.XCB]XC_MISC.H : $(OUT).LIB.XCB]XC_MISC.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XCB]XCB_CONN.OBJ : [.XCB.LIBXCB.SRC]XCB_CONN.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_CONN "$(XCB_IO_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_OUT.OBJ : [.XCB.LIBXCB.SRC]XCB_OUT.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_OUT "$(XCB_IO_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_IN.OBJ : [.XCB.LIBXCB.SRC]XCB_IN.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_IN "$(XCB_IO_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_EXT.OBJ : [.XCB.LIBXCB.SRC]XCB_EXT.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_EXT "$(XCB_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_XID.OBJ : [.XCB.LIBXCB.SRC]XCB_XID.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_XID "$(XCB_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_LIST.OBJ : [.XCB.LIBXCB.SRC]XCB_LIST.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_LIST "$(XCB_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_UTIL.OBJ : [.XCB.LIBXCB.SRC]XCB_UTIL.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_UTIL "$(XCB_COUNT_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB_AUTH.OBJ : [.XCB.LIBXCB.SRC]XCB_AUTH.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XCB_AUTH "$(XCB_CFLAGS)" XCB

$(OUT).LIB.XCB]XPROTO.OBJ : $(OUT).LIB.XCB]XPROTO.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XPROTO "$(XCB_COUNT_CFLAGS)" XCB

$(OUT).LIB.XCB]BIGREQ.OBJ : $(OUT).LIB.XCB]BIGREQ.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]BIGREQ "$(XCB_COUNT_CFLAGS)" XCB

$(OUT).LIB.XCB]XC_MISC.OBJ : $(OUT).LIB.XCB]XC_MISC.C, -
    $(XCB_HEADERS), $(XCB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCB]XC_MISC "$(XCB_COUNT_CFLAGS)" XCB

$(OUT).LIB.XCB]XCB.OLB : $(XCB_OBJECTS), $(XCB_BUILD_RULES), $(OUT).LIB.XAU]XAU.OLB
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCB]XCB_CONN.OBJ,$(OUT).LIB.XCB]XCB_OUT.OBJ,$(OUT).LIB.XCB]XCB_IN.OBJ,$(OUT).LIB.XCB]XCB_EXT.OBJ,$(OUT).LIB.XCB]XCB_XID.OBJ,$(OUT).LIB.XCB]XCB_LIST.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XCB]XCB_UTIL.OBJ,$(OUT).LIB.XCB]XCB_AUTH.OBJ,$(OUT).LIB.XCB]XPROTO.OBJ,$(OUT).LIB.XCB]BIGREQ.OBJ,$(OUT).LIB.XCB]XC_MISC.OBJ
	LIBRARY/LIST=$(OUT).LIB.XCB]XCB_LIBRARY.LIS $(MMS$TARGET)
