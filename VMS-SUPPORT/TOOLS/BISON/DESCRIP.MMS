! GNU Bison 1.35: https://ftp.gnu.org/gnu/bison/bison-1.35.tar.gz
! Archive SHA256: 710d4fd96568f17ede71fa1b4205931df7e5761248b0c8a291008c1d3c7b780e
BISON_SOURCE = [.EXTRAS.BISON]
BISON_SRC = [.EXTRAS.BISON.SRC]
BISON_LIB = [.EXTRAS.BISON.LIB]
BISON_OUT = [.VMS-SUPPORT._BUILD.P64.TOOLS.BISON]
BISON_OUTPUTS = $(BISON_OUT)BISON.EXE, $(BISON_OUT)BISON.SIMPLE, -
    $(BISON_OUT)BISON.HAIRY, $(BISON_OUT)COPYING.
BISON_SOURCES = $(BISON_SRC)LR0.C, $(BISON_SRC)CLOSURE.C, -
    $(BISON_SRC)COMPLAIN.C, $(BISON_SRC)CONFLICTS.C, $(BISON_SRC)DERIVES.C, -
    $(BISON_SRC)FILES.C, $(BISON_SRC)GETARGS.C, $(BISON_SRC)GRAM.C, -
    $(BISON_SRC)LALR.C, $(BISON_SRC)LEX.C, $(BISON_SRC)MAIN.C, -
    $(BISON_SRC)NULLABLE.C, $(BISON_SRC)OUTPUT.C, $(BISON_SRC)STATE.C, -
    $(BISON_SRC)PRINT.C, $(BISON_SRC)READER.C, $(BISON_SRC)REDUCE.C, -
    $(BISON_SRC)SYMTAB.C, $(BISON_SRC)WARSHALL.C, $(BISON_SRC)VCG.C, -
    $(BISON_SRC)PRINT_GRAPH.C, $(BISON_LIB)BASENAME.C, $(BISON_LIB)DIRNAME.C, -
    $(BISON_LIB)GETOPT.C, $(BISON_LIB)GETOPT1.C, $(BISON_LIB)QUOTE.C, -
    $(BISON_LIB)QUOTEARG.C, $(BISON_LIB)XMALLOC.C, $(BISON_LIB)XSTRDUP.C, -
    $(BISON_LIB)XSTRNDUP.C, $(BISON_LIB)OBSTACK.C, $(BISON_LIB)ERROR.C, -
    $(BISON_LIB)MEMRCHR.C
BISON_HEADERS = $(BISON_SRC)CLOSURE.H, $(BISON_SRC)COMPLAIN.H, -
    $(BISON_SRC)CONFLICTS.H, $(BISON_SRC)DERIVES.H, $(BISON_SRC)FILES.H, -
    $(BISON_SRC)GETARGS.H, $(BISON_SRC)GRAM.H, $(BISON_SRC)LALR.H, -
    $(BISON_SRC)LEX.H, $(BISON_SRC)LR0.H, $(BISON_SRC)NULLABLE.H, -
    $(BISON_SRC)OUTPUT.H, $(BISON_SRC)PRINT_GRAPH.H, $(BISON_SRC)PRINT.H, -
    $(BISON_SRC)READER.H, $(BISON_SRC)REDUCE.H, $(BISON_SRC)STATE.H, -
    $(BISON_SRC)SYMTAB.H, $(BISON_SRC)SYSTEM.H, $(BISON_SRC)TYPES.H, -
    $(BISON_SRC)VCG_DEFAULTS.H, $(BISON_SRC)VCG.H, $(BISON_SRC)WARSHALL.H, -
    $(BISON_LIB)DIRNAME.H, $(BISON_LIB)ERROR.H, $(BISON_LIB)GETOPT.H, -
    $(BISON_LIB)GETTEXT.H, $(BISON_LIB)OBSTACK.H, $(BISON_LIB)QUOTE.H, -
    $(BISON_LIB)QUOTEARG.H, $(BISON_LIB)XALLOC.H

BISON : $(BISON_OUTPUTS)
	CONTINUE

$(BISON_OUT)BISON.EXE : $(BISON_SOURCES), $(BISON_HEADERS), -
    $(BISON_SOURCE)CONFIGURE., $(BISON_SOURCE)COPYING., -
    $(BISON_SRC)BISON.SIMPLE, $(BISON_SRC)BISON.HAIRY, -
    [.VMS-SUPPORT.TOOLS.BISON]CONFIG.H, -
    [.VMS-SUPPORT.TOOLS.BISON]BUILD.COM, [.VMS-SUPPORT.TOOLS.BISON]DESCRIP.MMS, $(RTL)
	@[.VMS-SUPPORT.TOOLS.BISON]BUILD.COM "$(BISON_SOURCE)" "$(BISON_OUT)"

$(BISON_OUT)BISON.SIMPLE : $(BISON_SRC)BISON.SIMPLE
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(BISON_OUT)BISON.HAIRY : $(BISON_SRC)BISON.HAIRY
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(BISON_OUT)COPYING. : $(BISON_SOURCE)COPYING.
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
