! Complete programs/mkfontscale/Imakefile executable, using existing native libraries.
MKFONTSCALE_HEADERS = $(COMMON_HEADERS), $(FONTENC_HEADERS), -
    $(FREETYPE2_HEADERS), $(ZLIB_HEADERS)
MKFONTSCALE_PRIVATE_HEADERS = [.PROGRAMS.MKFONTSCALE]LIST.H, -
    [.PROGRAMS.MKFONTSCALE]HASH.H, [.PROGRAMS.MKFONTSCALE]DATA.H, -
    [.PROGRAMS.MKFONTSCALE]IDENT.H
MKFONTSCALE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE_MKFONTSCALE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.MKFONTSCALE]DESCRIP.MMS
! Match the Unix FreeType build defines; native C99 supplies snprintf.
MKFONTSCALE_CFLAGS = $(CFLAGS)/DEFINE=(FREETYPE2,XFREE86_FT2)
MKFONTSCALE_MAIN_CFLAGS = $(MKFONTSCALE_CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT
MKFONTSCALE_OBJECTS = $(OUT).PROGRAMS.MKFONTSCALE]MKFONTSCALE.OBJ, -
    $(OUT).PROGRAMS.MKFONTSCALE]LIST.OBJ, $(OUT).PROGRAMS.MKFONTSCALE]HASH.OBJ, -
    $(OUT).PROGRAMS.MKFONTSCALE]IDENT.OBJ

MKFONTSCALE : $(OUT).PROGRAMS.MKFONTSCALE]MKFONTSCALE.EXE
	CONTINUE

$(OUT).PROGRAMS.MKFONTSCALE]MKFONTSCALE.OBJ : [.PROGRAMS.MKFONTSCALE]MKFONTSCALE.C, -
    $(MKFONTSCALE_HEADERS), $(MKFONTSCALE_PRIVATE_HEADERS), $(MKFONTSCALE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_MKFONTSCALE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.MKFONTSCALE]MKFONTSCALE "$(MKFONTSCALE_MAIN_CFLAGS)"

$(OUT).PROGRAMS.MKFONTSCALE]LIST.OBJ : [.PROGRAMS.MKFONTSCALE]LIST.C, -
    $(MKFONTSCALE_HEADERS), $(MKFONTSCALE_PRIVATE_HEADERS), $(MKFONTSCALE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_MKFONTSCALE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.MKFONTSCALE]LIST "$(MKFONTSCALE_CFLAGS)"

$(OUT).PROGRAMS.MKFONTSCALE]HASH.OBJ : [.PROGRAMS.MKFONTSCALE]HASH.C, -
    $(MKFONTSCALE_HEADERS), $(MKFONTSCALE_PRIVATE_HEADERS), $(MKFONTSCALE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_MKFONTSCALE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.MKFONTSCALE]HASH "$(MKFONTSCALE_CFLAGS)"

$(OUT).PROGRAMS.MKFONTSCALE]IDENT.OBJ : [.PROGRAMS.MKFONTSCALE]IDENT.C, -
    $(MKFONTSCALE_HEADERS), $(MKFONTSCALE_PRIVATE_HEADERS), $(MKFONTSCALE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_MKFONTSCALE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.MKFONTSCALE]IDENT "$(MKFONTSCALE_CFLAGS)"

$(OUT).PROGRAMS.MKFONTSCALE]MKFONTSCALE.EXE : $(MKFONTSCALE_OBJECTS), -
    $(OUT).LIB.FONTENC]FONTENC.OLB, $(OUT).LIB.FREETYPE2]FREETYPE.OLB, -
    $(OUT).LIB.ZLIB]Z.OLB, [.VMS-SUPPORT.PROGRAMS.MKFONTSCALE]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.MKFONTSCALE]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.MKFONTSCALE]LINK.COM
