! lib/font/util/Imakefile's ten utility modules, not the complete Xfont library.
FONTUTIL_HEADERS = $(COMMON_HEADERS), -
                   $(OUT).INCLUDE.X11]X.H, $(OUT).INCLUDE.X11]XMD.H, -
                   $(OUT).INCLUDE.X11]XPROTO.H, $(OUT).INCLUDE.X11]XPROTOSTR.H, -
                   $(OUT).INCLUDE.X11]XDEFS.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
                   $(OUT).INCLUDE.X11.FONTS]FS.H, -
                   $(OUT).INCLUDE.X11.FONTS]FSPROTO.H, -
                   $(OUT).INCLUDE.X11.FONTS]FONT.H, -
                   $(OUT).INCLUDE.X11.FONTS]FONTSTRUCT.H, -
                   $(OUT).INCLUDE.X11.FONTS]FONTPROTO.H, -
                   $(OUT).INCLUDE.X11.FONTS]FSMASKS.H
FONTUTIL_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
                           [.LIB.FONT.INCLUDE]FONTUTIL.H, -
                           [.LIB.FONT.INCLUDE]FONTXLFD.H
FONTUTIL_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FONTUTIL]DESCRIP.MMS
! Preserve upstream int-sized range and XLFD string counts with P64 pointers.
FONTUTIL_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONTUTIL_OBJECTS = $(OUT).LIB.FONTUTIL]UTILBITMAP.OBJ, -
                   $(OUT).LIB.FONTUTIL]FONTNAMES.OBJ, -
                   $(OUT).LIB.FONTUTIL]FONTUTIL.OBJ, -
                   $(OUT).LIB.FONTUTIL]FONTXLFD.OBJ, -
                   $(OUT).LIB.FONTUTIL]FORMAT.OBJ, -
                   $(OUT).LIB.FONTUTIL]FONTACCEL.OBJ, -
                   $(OUT).LIB.FONTUTIL]ATOM.OBJ, -
                   $(OUT).LIB.FONTUTIL]MISCUTIL.OBJ, -
                   $(OUT).LIB.FONTUTIL]PRIVATE.OBJ, -
                   $(OUT).LIB.FONTUTIL]PATCACHE.OBJ

FONTUTIL : $(OUT).LIB.FONTUTIL]FONTUTIL.OLB
	CONTINUE

$(OUT).INCLUDE.X11]KEYSYMDEF.H : [.INCLUDE]KEYSYMDEF.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FS.H : [.INCLUDE.FONTS]FS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FSPROTO.H : [.INCLUDE.FONTS]FSPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FONT.H : [.INCLUDE.FONTS]FONT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FONTSTRUCT.H : [.INCLUDE.FONTS]FONTSTRUCT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FONTPROTO.H : [.INCLUDE.FONTS]FONTPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FSMASKS.H : [.INCLUDE.FONTS]FSMASKS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.FONTUTIL]UTILBITMAP.OBJ : [.LIB.FONT.UTIL]UTILBITMAP.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]UTILBITMAP "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]FONTNAMES.OBJ : [.LIB.FONT.UTIL]FONTNAMES.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]FONTNAMES "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]FONTUTIL.OBJ : [.LIB.FONT.UTIL]FONTUTIL.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]FONTUTIL "$(FONTUTIL_COUNT_CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]FONTXLFD.OBJ : [.LIB.FONT.UTIL]FONTXLFD.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]FONTXLFD "$(FONTUTIL_COUNT_CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]FORMAT.OBJ : [.LIB.FONT.UTIL]FORMAT.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]FORMAT "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]FONTACCEL.OBJ : [.LIB.FONT.UTIL]FONTACCEL.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]FONTACCEL "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]ATOM.OBJ : [.LIB.FONT.UTIL]ATOM.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]ATOM "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]MISCUTIL.OBJ : [.LIB.FONT.UTIL]MISCUTIL.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]MISCUTIL "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]PRIVATE.OBJ : [.LIB.FONT.UTIL]PRIVATE.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]PRIVATE "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]PATCACHE.OBJ : [.LIB.FONT.UTIL]PATCACHE.C, -
    $(FONTUTIL_HEADERS), $(FONTUTIL_PRIVATE_HEADERS), $(FONTUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTUTIL]PATCACHE "$(CFLAGS)" FONTUTIL

$(OUT).LIB.FONTUTIL]FONTUTIL.OLB : $(FONTUTIL_OBJECTS), [.VMS-SUPPORT.LIB.FONTUTIL]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FONTUTIL_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FONTUTIL]FONTUTIL_LIBRARY.LIS $(MMS$TARGET)
