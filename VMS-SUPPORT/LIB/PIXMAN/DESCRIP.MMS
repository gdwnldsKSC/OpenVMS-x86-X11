! Complete portable libpixman-1 source profile from Pixman 0.16.2 Makefile.am.
! Native P64 pointers, long32 pixel words; optional SIMD and timing excluded.
PIXMAN_HEADERS = $(OUT).INCLUDE.PIXMAN]PIXMAN.H, -
    $(OUT).INCLUDE.PIXMAN]PIXMAN-VERSION.H, -
    $(OUT).INCLUDE.PIXMAN]CONFIG.H
PIXMAN_PRIVATE_HEADERS = [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-PRIVATE.H, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMPILER.H, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-ACCESSOR.H, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMBINE32.H, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMBINE64.H, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE-IMP.H
PIXMAN_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT.LIB.PIXMAN]DESCRIP.MMS, [.EXTRAS.PIXMAN.PIXMAN]MAKEFILE.AM
PIXMAN_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
PIXMAN_TIMER_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,EMPTYFILE))
PIXMAN_CPPFLAGS = /DEFINE=(HAVE_CONFIG_H,PIXMAN_DISABLE_DEPRECATED)

$(OUT).INCLUDE.PIXMAN]CONFIG.H : [.VMS-SUPPORT.LIB.PIXMAN]CONFIG.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.PIXMAN]PIXMAN.H : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.PIXMAN]PIXMAN-VERSION.H : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-VERSION.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

PIXMAN_OBJECTS = $(OUT).LIB.PIXMAN]PIXMAN-ACCESS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-ACCESS-ACCESSORS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-CPU.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-GRADIENT-WALKER.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-REGION16.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-REGION32.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-IMAGE.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-IMPLEMENTATION.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-COMBINE32.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-COMBINE64.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-GENERAL.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-FAST-PATH.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-SOLID-FILL.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-CONICAL-GRADIENT.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-LINEAR-GRADIENT.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-RADIAL-GRADIENT.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-BITS-IMAGE.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-UTILS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-EDGE.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-TRAP.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-TIMER.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-MATRIX.OBJ

PIXMAN : $(OUT).LIB.PIXMAN]PIXMAN.OLB
	CONTINUE

$(OUT).LIB.PIXMAN]PIXMAN-ACCESS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-ACCESS.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-ACCESS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-ACCESS-ACCESSORS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-ACCESS-ACCESSORS.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-ACCESS.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-ACCESS-ACCESSORS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-CPU.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-CPU.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-CPU "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-GRADIENT-WALKER.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-GRADIENT-WALKER.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-GRADIENT-WALKER "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-REGION16.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION16.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-REGION16 "$(PIXMAN_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST,MAYLOSEDATA3))" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-REGION32.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION32.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-REGION32 "$(PIXMAN_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST,MAYLOSEDATA3))" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-IMAGE.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-IMAGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-IMAGE "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-IMPLEMENTATION.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-IMPLEMENTATION.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-IMPLEMENTATION "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-COMBINE32.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMBINE32.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-COMBINE32 "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-COMBINE64.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMBINE64.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-COMBINE64 "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-GENERAL.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-GENERAL.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-GENERAL "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-FAST-PATH.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-FAST-PATH.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-FAST-PATH "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-SOLID-FILL.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-SOLID-FILL.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-SOLID-FILL "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-CONICAL-GRADIENT.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-CONICAL-GRADIENT.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-CONICAL-GRADIENT "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-LINEAR-GRADIENT.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-LINEAR-GRADIENT.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-LINEAR-GRADIENT "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-RADIAL-GRADIENT.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-RADIAL-GRADIENT.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-RADIAL-GRADIENT "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-BITS-IMAGE.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-BITS-IMAGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-BITS-IMAGE "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-UTILS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-UTILS.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-UTILS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-EDGE.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-EDGE "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE-ACCESSORS.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-TRAP.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-TRAP.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-TRAP "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-TIMER.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-TIMER.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-TIMER "$(PIXMAN_TIMER_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-MATRIX.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-MATRIX.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-MATRIX "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN.OLB : $(PIXMAN_OBJECTS), $(PIXMAN_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-ACCESS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-ACCESS-ACCESSORS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-CPU.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-GRADIENT-WALKER.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-REGION16.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-REGION32.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-IMAGE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-IMPLEMENTATION.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-COMBINE32.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-COMBINE64.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-GENERAL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-FAST-PATH.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-SOLID-FILL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-CONICAL-GRADIENT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-LINEAR-GRADIENT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-RADIAL-GRADIENT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-BITS-IMAGE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-UTILS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-EDGE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-TRAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-TIMER.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-MATRIX.OBJ
	LIBRARY/LIST=$(OUT).LIB.PIXMAN]PIXMAN_LIBRARY.LIS $(MMS$TARGET)
