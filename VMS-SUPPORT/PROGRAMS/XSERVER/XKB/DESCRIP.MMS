	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKMREAD "$(XKB_COUNT_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC.OBJ : $(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"



$(OUT).PROGRAMS.XSERVER.XKB]MAPRULES.OBJ : $(OUT).PROGRAMS.XSERVER.XKB]MAPRULES.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]MAPRULES "$(XKB_COUNT_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

