! Complete Xvfb profile with the mandatory upstream server extensions, P64/long32.
! All server structures use the same feature layout; leaf libraries stay unchanged.
! XSERVER_CORE reuses this profile without the VFB device-dependent objects.
! Select DDX definitions in CONFIG.MMS or MMS /MACRO in a fresh build tree.
XVFB_BASE = $(OUT).PROGRAMS.XSERVER.HW.VFB
XVFB_OUT = $(XVFB_BASE).SERVER
XVFB_RULES = [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]SERVER.MMS
XVFB_LINK_RULES = $(XVFB_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]XVFB.OPT
XSERVER_LINK_RULES = $(XVFB_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER]CORE.OPT
XVFB_HEADERS = $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), -
    $(DAMAGEEXT_HEADERS), $(DAMAGEEXT_PRIVATE_HEADERS)
XVFB_REQUIRED_DEFINES = SHAPE,XFIXES,RANDR,DAMAGE,XTEST,XSYNC,XCMISC,BIGREQS

XVFB_DAMAGE_CFLAGS = /STANDARD=C99/POINTER_SIZE=64/NAMES=(UPPERCASE,SHORTENED)/PREFIX=ALL_ENTRIES/NODEBUG/WARNINGS=(ENABLE=LEVEL4)/DEFINE=($(XVFB_REQUIRED_DEFINES),FUNCPROTO=15,PIXPRIV,GLYPHPADBYTES=4,RENDER,XKB,XKB_IN_SERVER,XINPUT) /WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XVFB_DIX_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,VENDOR_NAME=""""""$(DIX_VENDOR_STRING)"""""",VENDOR_RELEASE=$(DIX_VENDOR_RELEASE),XKB,XKB_IN_SERVER,XINPUT$(XSERVER_DIX_DEFINES))
XVFB_DIX_MAIN_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,VENDOR_NAME=""""""The X.Org Foundation"""""",VENDOR_RELEASE=10701000,""main""=VMSDIXMAIN,""CheckUserParameters""=VMSDIXCHECKUSERPARAMETERS,XKB,XKB_IN_SERVER,XINPUT$(XSERVER_DIX_DEFINES))
XVFB_FB_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT,_XOPEN_SOURCE=600)
XVFB_MI_CFLAGS = /STANDARD=C99/POINTER_SIZE=64/NAMES=(UPPERCASE,SHORTENED)/PREFIX=ALL_ENTRIES/NODEBUG/WARNINGS=(ENABLE=LEVEL4)/DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,GLYPHPADBYTES=4,_XOPEN_SOURCE=600,HAVE_CBRT,RENDER,XKB,XKB_IN_SERVER,XINPUT)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XVFB_MI_COUNT_CFLAGS = /STANDARD=C99/POINTER_SIZE=64/NAMES=(UPPERCASE,SHORTENED)/PREFIX=ALL_ENTRIES/NODEBUG/WARNINGS=(ENABLE=LEVEL4)/DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,GLYPHPADBYTES=4,_XOPEN_SOURCE=600,HAVE_CBRT,RENDER,XKB,XKB_IN_SERVER,XINPUT)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XVFB_OS_CPP_DEFINES = ""XSERV_t"",TRANS_SERVER,TCPCONN,OPEN_MAX=256,XDMCP,PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT$(XSERVER_OS_DEFINES)
XVFB_OS_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),$(XVFB_OS_CPP_DEFINES))
! Upstream connection.c supplies its transport role before including Xtrans.h.
XVFB_OS_CONNECTION_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),TCPCONN,OPEN_MAX=256,XDMCP,PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT$(XSERVER_OS_DEFINES))
XVFB_OS_TRANSPORT_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),TCPCONN,OPEN_MAX=256,XDMCP,PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT$(XSERVER_OS_DEFINES)$(XSERVER_TRANSPORT_DEFINES))
XVFB_RENDER_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT)
XVFB_VFB_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT)
XVFB_VFB_EXT_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,NO_MODULE_EXTS,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER,XINPUT)
XVFB_XINPUT_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,XINPUT,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,XKB,XKB_IN_SERVER)
XVFB_XKB_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,XINPUT,XKB,XKB_IN_SERVER,NO_ALLOCA, -
    _XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1,$(XKB_PATH_DEFINES)$(XKB_DDX_DEFINES))
XVFB_XKB_INIT_CPPFLAGS = $(XVFB_XKB_CPPFLAGS)
XVFB_EXTENSION_CPPFLAGS = /DEFINE=($(XVFB_REQUIRED_DEFINES),PIXPRIV,RENDER,XINPUT,XKB,XKB_IN_SERVER, -
    _XOPEN_SOURCE_EXTENDED=1,_XOPEN_UNIX=1,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1)
XVFB_DIX_OBJECTS = $(XVFB_OUT).DIX]ATOM.OBJ, -
    $(XVFB_OUT).DIX]COLORMAP.OBJ, -
