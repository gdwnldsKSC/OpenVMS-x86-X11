! Ordinary lib/X11/Imakefile data files; no source transformation.
X11_DATA :: $(OUT).LIB.X11]XERRORDB., $(OUT).LIB.X11]XKEYSYMDB., -
    $(OUT).LIB.X11]XCMS.TXT
	CONTINUE

$(OUT).LIB.X11]XERRORDB. : [.LIB.X11]XERRORDB.
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.X11]XKEYSYMDB. : [.LIB.X11]XKEYSYMDB.
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.X11]XCMS.TXT : [.LIB.X11]XCMS.TXT
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
