	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSQXINFO "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSQUEXT.OBJ : [.LIB.LIBFS.SRC]FSQUEXT.C, -
