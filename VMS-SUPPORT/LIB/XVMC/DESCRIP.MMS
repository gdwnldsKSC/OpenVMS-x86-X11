! Complete generic static XvMC library from lib/XvMC/Imakefile.
! The separate Linux/DRI i810 hardware library is outside this Unix profile.
XVMC_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVLIB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMCLIB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMCPROTO.H
XVMC_PRIVATE_HEADERS = [.LIB.LIBXVMC.SRC]XVMCLIBINT.H
XVMC_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XVMC]DESCRIP.MMS
XVMC_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XVMC_OBJECTS = $(OUT).LIB.XVMC]XVMC.OBJ

XVMC : $(OUT).LIB.XVMC]XVMC.OLB
	CONTINUE

$(OUT).LIB.XVMC]XVMC.OBJ : [.LIB.LIBXVMC.SRC]XVMC.C, -
    $(XVMC_HEADERS), $(XVMC_PRIVATE_HEADERS), $(XVMC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XVMC]XVMC "$(XVMC_CFLAGS)" XVMC

$(OUT).LIB.XVMC]XVMC.OLB : $(XVMC_OBJECTS), $(XVMC_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XVMC_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XVMC]XVMC_LIBRARY.LIS $(MMS$TARGET)
