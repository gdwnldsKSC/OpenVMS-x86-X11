! Complete internal damage library from the upstream miext/damage/Makefile.am.
! Static server profile; Render, Composite and rootless hooks are excluded.
DAMAGE_HEADERS = $(XFONT2_HEADERS), $(PIXMAN_HEADERS), $(OUT).INCLUDE.X11]XALLOCA.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XIPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI2.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI2PROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]GE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]GEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBGEOM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDERPROTO.H
DAMAGE_PRIVATE_HEADERS = $(OUT).INCLUDE]DIX-CONFIG.H, -
    $(OUT).INCLUDE]VERSION-CONFIG.H, -
    [.XSERVER.XORG-SERVER.MIEXT.DAMAGE]DAMAGE.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]LIST.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]EVENTS.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]EVENTSTR.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]XKBRULES.H, -
    [.XSERVER.XORG-SERVER.XEXT]GEEXT.H, -
    [.XSERVER.XORG-SERVER.MIEXT.DAMAGE]DAMAGESTR.H, -
    [.XSERVER.XORG-SERVER.MI]MI.H, -
    [.XSERVER.XORG-SERVER.RENDER]GLYPHSTR.H, -
    [.XSERVER.XORG-SERVER.RENDER]PICTURE.H, -
    [.XSERVER.XORG-SERVER.RENDER]PICTURESTR.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]CLOSURE.H, [.XSERVER.XORG-SERVER.INCLUDE]COLORMAP.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]CURSOR.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]DIX.H, [.XSERVER.XORG-SERVER.INCLUDE]DIXFONT.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]DIXFONTSTR.H, [.XSERVER.XORG-SERVER.INCLUDE]GC.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]GCSTRUCT.H, [.XSERVER.XORG-SERVER.INCLUDE]GLOBALS.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]INPUT.H, [.XSERVER.XORG-SERVER.INCLUDE]MISC.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]MISCSTRUCT.H, [.XSERVER.XORG-SERVER.INCLUDE]OPAQUE.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]OS.H, [.XSERVER.XORG-SERVER.INCLUDE]PIXMAP.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]PRIVATES.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]PIXMAPSTR.H, [.XSERVER.XORG-SERVER.INCLUDE]PROPERTY.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]REGION.H, [.XSERVER.XORG-SERVER.INCLUDE]REGIONSTR.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]RESOURCE.H, [.XSERVER.XORG-SERVER.INCLUDE]SCREENINT.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]SCRNINTSTR.H, [.XSERVER.XORG-SERVER.INCLUDE]SERVERMD.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]VALIDATE.H, [.XSERVER.XORG-SERVER.INCLUDE]WINDOW.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]WINDOWSTR.H
DAMAGE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS
! Upstream servermd.h supplies native x86-64 storage order without Unix LP64.
! Preserve upstream comments embedded between prototype tokens.
DAMAGE_CFLAGS = $(CFLAGS)/DEFINE=($(XSERVER_CRTL_DEFINES),XKB_IN_SERVER,FUNCPROTO=15,PIXPRIV,GLYPHPADBYTES=4) -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)

DAMAGE : $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OLB
	CONTINUE

$(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H : [.PROTO.XORGPROTO.INCLUDE.X11.EXTENSIONS]RENDER.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.EXTENSIONS]RENDERPROTO.H : [.PROTO.XORGPROTO.INCLUDE.X11.EXTENSIONS]RENDERPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OBJ : [.XSERVER.XORG-SERVER.MIEXT.DAMAGE]DAMAGE.C, -
    $(DAMAGE_HEADERS), $(DAMAGE_PRIVATE_HEADERS), $(DAMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE "$(DAMAGE_CFLAGS)" DAMAGE

$(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OLB : -
    $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OBJ, $(DAMAGE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE_LIBRARY.LIS $(MMS$TARGET)
