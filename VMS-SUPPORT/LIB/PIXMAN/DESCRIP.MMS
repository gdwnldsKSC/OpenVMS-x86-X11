! Complete portable libpixman-1 source profile from Pixman 0.9.6 Makefile.am.
! Native P64 pointers, long32 pixel words; optional MMX and timing excluded.
PIXMAN_HEADERS = $(OUT).INCLUDE.PIXMAN]PIXMAN.H
PIXMAN_PRIVATE_HEADERS = [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-PRIVATE.H, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE-IMP.H
PIXMAN_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT.LIB.PIXMAN]DESCRIP.MMS, [.EXTRAS.PIXMAN.PIXMAN]MAKEFILE.AM
PIXMAN_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
PIXMAN_TIMER_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,EMPTYFILE))
! PACKAGE is only a configuration-presence sentinel in pixman-private.h.
PIXMAN_CPPFLAGS = /DEFINE=(PACKAGE=1)

$(OUT).INCLUDE.PIXMAN]PIXMAN.H : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

PIXMAN_OBJECTS = $(OUT).LIB.PIXMAN]PIXMAN-REGION.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-IMAGE.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-COMPOSE.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-COMPOSE-ACCESSORS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-PICT.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-UTILS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-EDGE.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-TRAP.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-COMPUTE-REGION.OBJ, -
    $(OUT).LIB.PIXMAN]PIXMAN-TIMER.OBJ

PIXMAN : $(OUT).LIB.PIXMAN]PIXMAN.OLB
	CONTINUE

$(OUT).LIB.PIXMAN]PIXMAN-REGION.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-REGION "$(PIXMAN_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST,MAYLOSEDATA3))" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-IMAGE.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-IMAGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-IMAGE "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-COMPOSE.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMPOSE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-COMPOSE "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-COMPOSE-ACCESSORS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMPOSE-ACCESSORS.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMPOSE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-COMPOSE-ACCESSORS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-PICT.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-PICT.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-PICT "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-UTILS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-UTILS.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-UTILS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-EDGE.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-EDGE "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE-ACCESSORS.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-EDGE.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-TRAP.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-TRAP.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-TRAP "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-COMPUTE-REGION.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-COMPUTE-REGION.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-COMPUTE-REGION "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-TIMER.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-TIMER.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-TIMER "$(PIXMAN_TIMER_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN.OLB : $(PIXMAN_OBJECTS), $(PIXMAN_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-REGION.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-IMAGE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-COMPOSE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-COMPOSE-ACCESSORS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-PICT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-UTILS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-EDGE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-EDGE-ACCESSORS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-TRAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-COMPUTE-REGION.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.PIXMAN]PIXMAN-TIMER.OBJ
	LIBRARY/LIST=$(OUT).LIB.PIXMAN]PIXMAN_LIBRARY.LIS $(MMS$TARGET)
