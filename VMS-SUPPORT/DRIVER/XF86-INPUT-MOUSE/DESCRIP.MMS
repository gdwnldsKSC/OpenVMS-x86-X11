! Complete upstream mouse driver, P64/long32, with loader metadata.
! COMMON supplies XISB; OS mouse and serial services remain consumer inputs.
MOUSE_HEADERS = $(XF86COMMON_HEADERS)
MOUSE_PRIVATE_HEADERS = $(XF86COMMON_PRIVATE_HEADERS), -
    [.DRIVER.XF86-INPUT-MOUSE.SRC]MOUSE.H, -
    [.DRIVER.XF86-INPUT-MOUSE.SRC]MOUSEPRIV.H
MOUSE_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.DRIVER.XF86-INPUT-MOUSE]DESCRIP.MMS
MOUSE_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT, -
    ""XFree86LOADER"",NO_INLINE,NO_ALLOCA,OPEN_MAX=256,XORGSERVER, -
    _XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1,XORG_VERSION_CURRENT=10400000, -
    GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1, -
    PACKAGE_VERSION_MAJOR=1,PACKAGE_VERSION_MINOR=2,PACKAGE_VERSION_PATCHLEVEL=2)
MOUSE_OBJECTS = $(OUT).DRIVER.XF86-INPUT-MOUSE]MOUSE.OBJ, -
    $(OUT).DRIVER.XF86-INPUT-MOUSE]PNP.OBJ

XF86_INPUT_MOUSE : $(OUT).DRIVER.XF86-INPUT-MOUSE]MOUSE_DRV.OLB
	CONTINUE

$(OUT).DRIVER.XF86-INPUT-MOUSE]MOUSE.OBJ : [.DRIVER.XF86-INPUT-MOUSE.SRC]MOUSE.C, -
    $(MOUSE_HEADERS), $(MOUSE_PRIVATE_HEADERS), $(MOUSE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-INPUT-MOUSE]MOUSE "$(XF86COMMON_CFLAGS)" XF86_INPUT_MOUSE "$(MOUSE_CPPFLAGS)"

$(OUT).DRIVER.XF86-INPUT-MOUSE]PNP.OBJ : [.DRIVER.XF86-INPUT-MOUSE.SRC]PNP.C, -
    $(MOUSE_HEADERS), $(MOUSE_PRIVATE_HEADERS), $(MOUSE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-INPUT-MOUSE]PNP "$(XF86COMMON_CFLAGS)" XF86_INPUT_MOUSE "$(MOUSE_CPPFLAGS)"

$(OUT).DRIVER.XF86-INPUT-MOUSE]MOUSE_DRV.OLB : $(MOUSE_OBJECTS), $(MOUSE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(MOUSE_OBJECTS)
	LIBRARY/LIST=$(OUT).DRIVER.XF86-INPUT-MOUSE]MOUSE_DRV_LIBRARY.LIS $(MMS$TARGET)
