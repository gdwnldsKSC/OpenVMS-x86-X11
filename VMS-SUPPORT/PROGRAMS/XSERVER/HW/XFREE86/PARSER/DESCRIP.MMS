! Complete upstream parser/Makefile.am external libxf86config membership.
! HAS_NO_UIDS selects current-process file I/O, without Unix saved-ID switching.
XF86CONFIG_HEADERS = $(PCIACCESS_HEADERS), $(COMMON_HEADERS)
XF86CONFIG_PRIVATE_HEADERS = [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]CONFIGINT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPTIONSTR.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]LIST.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]CONFIGPROCS.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86OPTREC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86PARSER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]XF86TOKENS.H
XF86CONFIG_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.PARSER]DESCRIP.MMS
XF86CONFIG_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Upstream list helpers keep same-structure member offsets in an int.
XF86CONFIG_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XF86CONFIG_CPPFLAGS = /DEFINE=($(XSERVER_CRTL_DEFINES),XKB_IN_SERVER,FUNCPROTO=15,ANSICPP,_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1,HAS_NO_UIDS)
XF86CONFIG_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUTCLASS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XPRINTF.OBJ

XF86CONFIG : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XF86CONFIG.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]DEVICE.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]FILES.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]FLAGS.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]INPUT.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]LAYOUT.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]MODULE.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]VIDEO.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]MONITOR.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]POINTER.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]SCREEN.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]VENDOR.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]READ.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]SCAN.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]WRITE.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]DRI.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]EXTENSIONS.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XF86CONFIG.OLB : $(XF86CONFIG_OBJECTS), $(XF86CONFIG_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DEVICE.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FILES.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]FLAGS.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUT.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]LAYOUT.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MODULE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VIDEO.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]MONITOR.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]POINTER.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCREEN.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]VENDOR.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]READ.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]SCAN.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]WRITE.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]DRI.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]EXTENSIONS.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUTCLASS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XPRINTF.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XF86CONFIG_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUTCLASS.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.PARSER]INPUTCLASS.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]INPUTCLASS "$(XF86CONFIG_COUNT_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XPRINTF.OBJ : [.XSERVER.XORG-SERVER.OS]XPRINTF.C, -
    $(XF86CONFIG_HEADERS), $(XF86CONFIG_PRIVATE_HEADERS), $(XF86CONFIG_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.PARSER]XPRINTF "$(XF86CONFIG_CFLAGS)" XF86CONFIG "$(XF86CONFIG_CPPFLAGS)"
