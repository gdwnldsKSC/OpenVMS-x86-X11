! Complete libxcvt library from upstream lib/meson.build.
! Native P64 pointers; no X server, display or platform driver dependency.
XCVT_HEADERS = $(OUT).INCLUDE.LIBXCVT]LIBXCVT.H, -
    $(OUT).INCLUDE.LIBXCVT]LIBXCVT_MODE.H
XCVT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT.LIB.XCVT]DESCRIP.MMS
XCVT_OBJECTS = $(OUT).LIB.XCVT]LIBXCVT.OBJ

XCVT : $(OUT).LIB.XCVT]XCVT.OLB
	CONTINUE

$(OUT).INCLUDE.LIBXCVT]LIBXCVT.H : [.LIB.LIBXCVT.INCLUDE.LIBXCVT]LIBXCVT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.LIBXCVT]LIBXCVT_MODE.H : [.LIB.LIBXCVT.INCLUDE.LIBXCVT]LIBXCVT_MODE.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XCVT]LIBXCVT.OBJ : [.LIB.LIBXCVT.LIB]LIBXCVT.C, -
    $(XCVT_HEADERS), $(XCVT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCVT]LIBXCVT "$(CFLAGS)" XCVT

$(OUT).LIB.XCVT]XCVT.OLB : $(XCVT_OBJECTS), $(XCVT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XCVT_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XCVT]XCVT_LIBRARY.LIS $(MMS$TARGET)
