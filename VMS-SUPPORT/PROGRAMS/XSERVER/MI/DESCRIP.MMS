$(OUT).PROGRAMS.XSERVER.MI]MI.OLB : $(MI_OBJECTS), $(MI_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MIVALTREE.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPOLYSEG.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPOLYRECT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPOLY.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPOLYCON.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPOLYGEN.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MIPOLYUTIL.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIFILLRCT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIWIDELINE.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MISPANS.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIARC.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIZERARC.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MIFILLARC.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIWINDOW.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MICURSOR.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIREGION.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPOLYTEXT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIBITBLT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MIPOLYPNT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIPUSHPXL.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIEXPOSE.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIGLBLT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIZERLINE.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIZERCLIP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MIFPOLYCON.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIDASH.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIBSTORE.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIBANK.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIINITEXT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIEQ.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MIPOINTER.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MISPRITE.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIDISPCUR.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MISCRINIT.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MICLIPN.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIGC.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]MICMAP.OBJ,$(OUT).PROGRAMS.XSERVER.MI]MIOVERLAY.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MI]MI_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MI]CBRT.OBJ : [.PROGRAMS.XSERVER.MI]CBRT.C, $(MI_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MI]CBRT "$(CBRT_CFLAGS)" RTL

$(OUT).PROGRAMS.XSERVER.MI]CBRT.OLB : $(OUT).PROGRAMS.XSERVER.MI]CBRT.OBJ, $(MI_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MI]CBRT.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MI]CBRT_LIBRARY.LIS $(MMS$TARGET)
