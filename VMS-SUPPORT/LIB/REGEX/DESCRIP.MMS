! Complete lib/regex/Imakefile library and its native header-generation step.
REGEX_HEADERS = $(OUT).INCLUDE]REGEX.H
REGEX_IHEADERS = $(OUT).LIB.REGEX]REGCOMP.IH, $(OUT).LIB.REGEX]REGERROR.IH, -
                $(OUT).LIB.REGEX]REGEXEC.IH, $(OUT).LIB.REGEX]REGFREE.IH, -
                $(OUT).LIB.REGEX]ENGINE.IH
REGEX_PRIVATE_HEADERS = [.EXTRAS.REGEX]REGEX2.H, [.EXTRAS.REGEX]UTILS.H, -
                        [.EXTRAS.REGEX]CCLASS.H, [.EXTRAS.REGEX]CNAME.H
REGEX_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                    [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
REGEX_SOURCES = [.EXTRAS.REGEX]REGCOMP.C, [.EXTRAS.REGEX]REGERROR.C, -
                [.EXTRAS.REGEX]REGEXEC.C, [.EXTRAS.REGEX]REGFREE.C, -
                [.EXTRAS.REGEX]ENGINE.C
REGEX_CFLAGS = $(CFLAGS)/DEFINE=(POSIX_MISTAKE)/PREFIX=(ALL_ENTRIES,EXCEPT=(regcomp,regerror,regexec,regfree))
! Upstream parser lengths and match offsets retain their 32-bit count types.
REGEX_COUNT_CFLAGS = $(REGEX_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
REGEX_OBJECTS = $(OUT).LIB.REGEX]REGCOMP.OBJ, $(OUT).LIB.REGEX]REGERROR.OBJ, -
                $(OUT).LIB.REGEX]REGEXEC.OBJ, $(OUT).LIB.REGEX]REGFREE.OBJ

REGEX : $(OUT).LIB.REGEX]REGEX.OLB
	CONTINUE

$(OUT).LIB.REGEX]MKH.OBJ : [.VMS-SUPPORT.LIB.REGEX]MKH.C, -
    $(REGEX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.REGEX]MKH "$(CFLAGS)/MAIN=POSIX_EXIT" REGEX_MKH

$(OUT).LIB.REGEX]MKH.EXE : $(OUT).LIB.REGEX]MKH.OBJ, -
    [.VMS-SUPPORT.LIB.REGEX]LINK_MKH.COM
	@[.VMS-SUPPORT.LIB.REGEX]LINK_MKH.COM

$(OUT).INCLUDE]REGEX.H : [.EXTRAS.REGEX]REGEX2.H, $(REGEX_SOURCES), -
    $(OUT).LIB.REGEX]MKH.EXE, [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	MCR $(OUT).LIB.REGEX]MKH.EXE "-i" "_REGEX_H_" $(MMS$TARGET) -
        [.EXTRAS.REGEX]REGEX2.H [.EXTRAS.REGEX]REGCOMP.C [.EXTRAS.REGEX]REGERROR.C -
        [.EXTRAS.REGEX]REGEXEC.C [.EXTRAS.REGEX]REGFREE.C [.EXTRAS.REGEX]ENGINE.C

$(OUT).LIB.REGEX]REGCOMP.IH : [.EXTRAS.REGEX]REGCOMP.C, -
    $(OUT).LIB.REGEX]MKH.EXE, [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	MCR $(OUT).LIB.REGEX]MKH.EXE "-p" $(MMS$TARGET) $(MMS$SOURCE)

$(OUT).LIB.REGEX]REGERROR.IH : [.EXTRAS.REGEX]REGERROR.C, -
    $(OUT).LIB.REGEX]MKH.EXE, [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	MCR $(OUT).LIB.REGEX]MKH.EXE "-p" $(MMS$TARGET) $(MMS$SOURCE)

$(OUT).LIB.REGEX]REGEXEC.IH : [.EXTRAS.REGEX]REGEXEC.C, -
    $(OUT).LIB.REGEX]MKH.EXE, [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	MCR $(OUT).LIB.REGEX]MKH.EXE "-p" $(MMS$TARGET) $(MMS$SOURCE)

$(OUT).LIB.REGEX]REGFREE.IH : [.EXTRAS.REGEX]REGFREE.C, -
    $(OUT).LIB.REGEX]MKH.EXE, [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	MCR $(OUT).LIB.REGEX]MKH.EXE "-p" $(MMS$TARGET) $(MMS$SOURCE)

$(OUT).LIB.REGEX]ENGINE.IH : [.EXTRAS.REGEX]ENGINE.C, -
    $(OUT).LIB.REGEX]MKH.EXE, [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	MCR $(OUT).LIB.REGEX]MKH.EXE "-p" $(MMS$TARGET) $(MMS$SOURCE)

$(OUT).LIB.REGEX]REGCOMP.OBJ : [.EXTRAS.REGEX]REGCOMP.C, -
    $(REGEX_HEADERS), $(REGEX_IHEADERS), $(REGEX_PRIVATE_HEADERS), $(REGEX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.REGEX]REGCOMP "$(REGEX_COUNT_CFLAGS)" REGEX

$(OUT).LIB.REGEX]REGERROR.OBJ : [.EXTRAS.REGEX]REGERROR.C, -
    $(REGEX_HEADERS), $(REGEX_IHEADERS), $(REGEX_PRIVATE_HEADERS), $(REGEX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.REGEX]REGERROR "$(REGEX_CFLAGS)" REGEX

$(OUT).LIB.REGEX]REGEXEC.OBJ : [.EXTRAS.REGEX]REGEXEC.C, [.EXTRAS.REGEX]ENGINE.C, -
    $(REGEX_HEADERS), $(REGEX_IHEADERS), $(REGEX_PRIVATE_HEADERS), $(REGEX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.REGEX]REGEXEC "$(REGEX_COUNT_CFLAGS)" REGEX

$(OUT).LIB.REGEX]REGFREE.OBJ : [.EXTRAS.REGEX]REGFREE.C, -
    $(REGEX_HEADERS), $(REGEX_IHEADERS), $(REGEX_PRIVATE_HEADERS), $(REGEX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.REGEX]REGFREE "$(REGEX_CFLAGS)" REGEX

$(OUT).LIB.REGEX]REGEX.OLB : $(REGEX_OBJECTS), [.VMS-SUPPORT.LIB.REGEX]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(REGEX_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.REGEX]REGEX_LIBRARY.LIS $(MMS$TARGET)
