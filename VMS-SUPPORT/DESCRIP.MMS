! Original native make entry point; invoke through BUILD.COM from any directory.
.INCLUDE [.VMS-SUPPORT]CONFIG.MMS

ALL : XAU, XDMCP, ZLIB, FONTENC, EXPAT, LBXUTIL, FONTUTIL, BITMAP, FONTFILE, FNTSTUBS, BDFTOPCF
	CONTINUE

.INCLUDE [.VMS-SUPPORT]HEADERS.MMS
.INCLUDE [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.XDMCP]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.ZLIB]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.EXPAT]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.LBXUTIL]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONTUTIL]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FNTSTUBS]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.BITMAP]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.LIB.FONT.FONTFILE]DESCRIP.MMS
.INCLUDE [.VMS-SUPPORT.PROGRAMS.BDFTOPCF]DESCRIP.MMS

HEADERS : $(XAU_HEADERS), $(XDMCP_HEADERS), $(ZLIB_HEADERS), $(FONTENC_HEADERS), -
          $(EXPAT_HEADERS), $(LBXUTIL_HEADERS), $(FONTUTIL_HEADERS), -
          $(FONT_BITMAP_HEADERS), $(FONT_FONTFILE_HEADERS), $(FNTSTUBS_HEADERS), -
          $(BDFTOPCF_HEADERS)
	CONTINUE
