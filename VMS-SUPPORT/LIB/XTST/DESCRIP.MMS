! Complete ordinary static Xtst library from lib/Xtst/Imakefile.
XTST_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]XTEST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RECORD.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RECORDSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XIPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XINPUT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H
XTST_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XTST]DESCRIP.MMS
XTST_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! XTest stores a CARD8 event-number cookie, not an address, in info->data.
XTST_COOKIE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
XTST_OBJECTS = $(OUT).LIB.XTST]XTEST.OBJ, -
    $(OUT).LIB.XTST]XRECORD.OBJ

XTST : $(OUT).LIB.XTST]XTST.OLB
	CONTINUE

$(OUT).LIB.XTST]XTEST.OBJ : [.LIB.LIBXTST.SRC]XTEST.C, -
    $(XTST_HEADERS), $(XTST_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XTST]XTEST "$(XTST_COOKIE_CFLAGS)" XTST

$(OUT).LIB.XTST]XRECORD.OBJ : [.LIB.LIBXTST.SRC]XRECORD.C, -
    $(XTST_HEADERS), $(XTST_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XTST]XRECORD "$(XTST_CFLAGS)" XTST

$(OUT).LIB.XTST]XTST.OLB : $(XTST_OBJECTS), $(XTST_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XTST]XTEST.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XTST]XRECORD.OBJ
	LIBRARY/LIST=$(OUT).LIB.XTST]XTST_LIBRARY.LIS $(MMS$TARGET)
