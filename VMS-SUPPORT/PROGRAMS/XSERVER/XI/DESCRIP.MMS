$(OUT).PROGRAMS.XSERVER.XI]XINPUT.OLB : $(XINPUT_OBJECTS), $(XINPUT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]ALLOWEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGKBD.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGDCTL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGFCTL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGKMAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XI]CHGPROP.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CHGPTR.OBJ,$(OUT).PROGRAMS.XSERVER.XI]CLOSEDEV.OBJ,$(OUT).PROGRAMS.XSERVER.XI]DEVBELL.OBJ,$(OUT).PROGRAMS.XSERVER.XI]EXEVENTS.OBJ
