! Complete lib/font/fontcache section of Xfont, with cache initialization enabled.
FONT_FONTCACHE_HEADERS = $(FONT_UTIL_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHEP.H
FONT_FONTCACHE_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
    [.LIB.FONT.FONTCACHE]FONTCACHE.H, [.LIB.FONT.FONTCACHE]FCQUEUE.H
FONT_FONTCACHE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONT.FONTCACHE]DESCRIP.MMS
FONT_FONTCACHE_CPPFLAGS = /DEFINE=(FONTCACHE)
! The queue callback's pointer argument carries only line-size tokens 16..128.
FONT_FONTCACHE_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=POINTERINTCAST)
FONT_FONTCACHE_OBJECTS = $(OUT).LIB.FONT.FONTCACHE]FONTCACHE.OBJ

$(OUT).LIB.FONT.FONTCACHE]FONTCACHE.OBJ : [.LIB.FONT.FONTCACHE]FONTCACHE.C, -
    $(FONT_FONTCACHE_HEADERS), $(FONT_FONTCACHE_PRIVATE_HEADERS), $(FONT_FONTCACHE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FONTCACHE]FONTCACHE "$(FONT_FONTCACHE_CFLAGS)" FONT_FONTCACHE "$(FONT_FONTCACHE_CPPFLAGS)"
