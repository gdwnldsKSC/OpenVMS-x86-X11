! Complete ordinary static Composite library from the upstream Imakefile.
! Native P64 pointers and long32; matching server feature layouts are required.
COMPOSITE_HEADERS = $(XFIXES_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]COMPOSITE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]COMPOSITEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DAMAGEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DAMAGEWIRE.H
COMPOSITE_PRIVATE_HEADERS = $(XFIXES_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.COMPOSITE]COMPINT.H, -
    [.PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT.H, -
    [.PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXTINT.H
COMPOSITE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XFIXES]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.COMPOSITE]DESCRIP.MMS
COMPOSITE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Installed-visual array indices retain the upstream scalar count model.
COMPOSITE_INIT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
! Repaint work closures encode scalar Window XIDs, not addresses to dereference.
COMPOSITE_WINDOW_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
COMPOSITE_CPPFLAGS = /DEFINE=(COMPOSITE,XFIXES,DAMAGE,PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

COMPOSITE_OBJECTS = $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPALLOC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPEXT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPWINDOW.OBJ

COMPOSITE : $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPOSITE.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPALLOC.OBJ : [.PROGRAMS.XSERVER.COMPOSITE]COMPALLOC.C, -
    $(COMPOSITE_HEADERS), $(COMPOSITE_PRIVATE_HEADERS), $(COMPOSITE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPALLOC "$(COMPOSITE_CFLAGS)" COMPOSITE "$(COMPOSITE_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPEXT.OBJ : [.PROGRAMS.XSERVER.COMPOSITE]COMPEXT.C, -
    $(COMPOSITE_HEADERS), $(COMPOSITE_PRIVATE_HEADERS), $(COMPOSITE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPEXT "$(COMPOSITE_CFLAGS)" COMPOSITE "$(COMPOSITE_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPINIT.OBJ : [.PROGRAMS.XSERVER.COMPOSITE]COMPINIT.C, -
    $(COMPOSITE_HEADERS), $(COMPOSITE_PRIVATE_HEADERS), $(COMPOSITE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPINIT "$(COMPOSITE_INIT_CFLAGS)" COMPOSITE "$(COMPOSITE_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPWINDOW.OBJ : [.PROGRAMS.XSERVER.COMPOSITE]COMPWINDOW.C, -
    $(COMPOSITE_HEADERS), $(COMPOSITE_PRIVATE_HEADERS), $(COMPOSITE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPWINDOW "$(COMPOSITE_WINDOW_CFLAGS)" COMPOSITE "$(COMPOSITE_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPOSITE.OLB : $(COMPOSITE_OBJECTS), $(COMPOSITE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPALLOC.OBJ,$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPEXT.OBJ,$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPINIT.OBJ,$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPWINDOW.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.COMPOSITE]COMPOSITE_LIBRARY.LIS $(MMS$TARGET)
