! Complete setxkbmap program from programs/setxkbmap/Imakefile.
SETXKBMAP_HEADERS = $(XCLIENT_HEADERS), $(XKBFILE_HEADERS)
SETXKBMAP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.SETXKBMAP]DESCRIP.MMS
SETXKBMAP_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT/POINTER_SIZE=64=ARGV -
    /DEFINE=(_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1, -
    DFLT_XKB_CONFIG_ROOT=""""""$(XKB_CONFIG_ROOT)"""""", -
    DFLT_XKB_RULES_FILE=""""""$(XKB_RULES)"""""", -
    DFLT_XKB_MODEL=""""""$(XKB_MODEL)"""""",DFLT_XKB_LAYOUT=""""""$(XKB_LAYOUT)"""""")

SETXKBMAP : $(OUT).PROGRAMS.SETXKBMAP]SETXKBMAP.EXE
	CONTINUE

$(OUT).PROGRAMS.SETXKBMAP]SETXKBMAP.OBJ : [.PROGRAMS.SETXKBMAP]SETXKBMAP.C, -
    $(SETXKBMAP_HEADERS), $(SETXKBMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.SETXKBMAP]SETXKBMAP "$(SETXKBMAP_CFLAGS)" SETXKBMAP

$(OUT).PROGRAMS.SETXKBMAP]SETXKBMAP.EXE : $(OUT).PROGRAMS.SETXKBMAP]SETXKBMAP.OBJ, -
    $(OUT).LIB.XKBFILE]XKBFILE.OLB, $(OUT).LIB.X11]X11.OLB, -
    [.VMS-SUPPORT.PROGRAMS.SETXKBMAP]LINK.COM, [.VMS-SUPPORT.PROGRAMS.SETXKBMAP]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.SETXKBMAP]LINK.COM
