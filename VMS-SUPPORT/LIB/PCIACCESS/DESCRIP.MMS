! Portable upstream libpciaccess core and no-arbiter implementation.
! A native pci_system_vms_create and method table are supplied by the consumer.
PCIACCESS_PRIVATE_HEADERS = [.LIB.LIBPCIACCESS.SRC]PCIACCESS_PRIVATE.H, -
    [.VMS-SUPPORT.LIB.PCIACCESS]CONFIG.H
PCIACCESS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.PCIACCESS]DESCRIP.MMS
PCIACCESS_CFLAGS = $(CFLAGS)/UNDEFINE=__HIDE_FORBIDDEN_NAMES/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
PCIACCESS_CPPFLAGS = /DEFINE=(HAVE_CONFIG_H)
PCIACCESS_OBJECTS = $(OUT).LIB.PCIACCESS]COMMON_BRIDGE.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_ITERATOR.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_INIT.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_INTERFACE.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_IO.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_CAPABILITY.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_DEVICE_NAME.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_MAP.OBJ, -
    $(OUT).LIB.PCIACCESS]COMMON_VGAARB_STUB.OBJ

PCIACCESS : $(OUT).LIB.PCIACCESS]PCIACCESS.OLB
	CONTINUE

$(OUT).LIB.PCIACCESS]COMMON_BRIDGE.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_BRIDGE.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_BRIDGE "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_ITERATOR.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_ITERATOR.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_ITERATOR "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_INIT.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_INIT.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_INIT "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_INTERFACE.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_INTERFACE.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_INTERFACE "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_IO.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_IO.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_IO "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_CAPABILITY.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_CAPABILITY.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_CAPABILITY "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_DEVICE_NAME.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_DEVICE_NAME.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_DEVICE_NAME "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_MAP.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_MAP.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_MAP "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]COMMON_VGAARB_STUB.OBJ : [.LIB.LIBPCIACCESS.SRC]COMMON_VGAARB_STUB.C, -
    $(PCIACCESS_HEADERS), $(PCIACCESS_PRIVATE_HEADERS), $(PCIACCESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PCIACCESS]COMMON_VGAARB_STUB "$(PCIACCESS_CFLAGS)" PCIACCESS "$(PCIACCESS_CPPFLAGS)"

$(OUT).LIB.PCIACCESS]PCIACCESS.OLB : $(PCIACCESS_OBJECTS), $(PCIACCESS_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(PCIACCESS_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.PCIACCESS]PCIACCESS_LIBRARY.LIS $(MMS$TARGET)
