	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-RISCV "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-X86.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-X86.C, -
    $(PIXMAN_HEADERS), $(PIXMAN_PRIVATE_HEADERS), $(PIXMAN_BUILD_RULES), $(RTL)
