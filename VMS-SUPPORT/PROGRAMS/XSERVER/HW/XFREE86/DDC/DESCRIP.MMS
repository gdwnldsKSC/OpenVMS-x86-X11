! Complete upstream libddc; native bus access is supplied by the consuming OS.
XF86DDC_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.DDC]DESCRIP.MMS
XF86DDC_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]INTERPRET_EDID.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]PRINT_EDID.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDCPROPERTY.OBJ

DDC : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDC.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDC.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]DDC.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86DDC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDC "$(XF86COMMON_CFLAGS)" DDC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]INTERPRET_EDID.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]INTERPRET_EDID.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86DDC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]INTERPRET_EDID "$(XF86COMMON_CFLAGS)" DDC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]PRINT_EDID.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]PRINT_EDID.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86DDC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]PRINT_EDID "$(XF86COMMON_CFLAGS)" DDC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDCPROPERTY.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]DDCPROPERTY.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86DDC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDCPROPERTY "$(XF86COMMON_CFLAGS)" DDC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDC.OLB : $(XF86DDC_OBJECTS), $(XF86DDC_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XF86DDC_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DDC]DDC_LIBRARY.LIS $(MMS$TARGET)
