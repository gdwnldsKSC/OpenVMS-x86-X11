! Upstream miext/sync/libsync.la without the optional xshmfence backend.
SYNC_HEADERS = $(EXT_HEADERS)
SYNC_PRIVATE_HEADERS = [.XSERVER.XORG-SERVER.MIEXT.SYNC]MISYNCFD.H, -
    $(EXT_PRIVATE_HEADERS)
SYNC_BUILD_RULES = $(EXT_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.SYNC]DESCRIP.MMS, -
    [.XSERVER.XORG-SERVER.MIEXT.SYNC]MAKEFILE.AM
SYNC_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
SYNC_CPPFLAGS = $(EXT_CPPFLAGS)

SYNC_OBJECTS = $(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNCFD.OBJ

SYNC : $(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]SYNC.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNC.OBJ : -
    [.XSERVER.XORG-SERVER.MIEXT.SYNC]MISYNC.C, -
    $(SYNC_HEADERS), $(SYNC_PRIVATE_HEADERS), $(SYNC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNC "$(SYNC_CFLAGS)" SYNC "$(SYNC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]SYNC.OLB : -
    $(SYNC_OBJECTS), $(SYNC_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNC.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNCFD.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]SYNC_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNCFD.OBJ : -
    [.XSERVER.XORG-SERVER.MIEXT.SYNC]MISYNCFD.C, -
    $(SYNC_HEADERS), $(SYNC_PRIVATE_HEADERS), $(SYNC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SYNC]MISYNCFD "$(SYNC_CFLAGS)" SYNC "$(SYNC_CPPFLAGS)"
