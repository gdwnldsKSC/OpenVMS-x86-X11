! Complete static lib/font/Speedo/Imakefile section of Xfont.
! Keep the upstream useropt.h rasterizers and ordinary non-module profile.
FONT_SPEEDO_HEADERS = $(FONT_UTIL_HEADERS), $(FONTENC_HEADERS)
FONT_SPEEDO_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
    [.LIB.FONT.INCLUDE]FONTUTIL.H, -
    [.LIB.FONT.INCLUDE]FONTXLFD.H, -
    [.LIB.FONT.INCLUDE]FNTFILST.H, -
    [.LIB.FONT.INCLUDE]FNTFIL.H, -
    [.LIB.FONT.SPEEDO]SPINT.H, -
    [.LIB.FONT.SPEEDO]SPEEDO.H, -
    [.LIB.FONT.SPEEDO]SPDO_PRV.H, -
    [.LIB.FONT.SPEEDO]USEROPT.H, -
    [.LIB.FONT.SPEEDO]KEYS.H, -
    [.LIB.FONT.SPEEDO]BICS-UNICODE.H
FONT_SPEEDO_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, -
    [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.LIB.FONT]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONT.SPEEDO]DESCRIP.MMS
FONT_SPEEDO_CFLAGS = $(CFLAGS)
! Preserve upstream int-sized atom lengths and glyph counts with P64 pointers.
FONT_SPEEDO_COUNT_CFLAGS = $(FONT_SPEEDO_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONT_SPEEDO_OBJECTS = $(OUT).LIB.FONT.SPEEDO]SPFUNCS.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SPFILE.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SPINFO.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SPERR.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SPFONT.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SPGLYPH.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SPENCODE.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]BICS-UNICODE.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]DO_CHAR.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]DO_TRNS.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]OUT_BL2D.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]OUT_BLK.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]OUT_SCRN.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]OUT_UTIL.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]RESET.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SET_SPCS.OBJ, -
    $(OUT).LIB.FONT.SPEEDO]SET_TRNS.OBJ

$(OUT).LIB.FONT.SPEEDO]SPFUNCS.OBJ : [.LIB.FONT.SPEEDO]SPFUNCS.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPFUNCS "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SPFILE.OBJ : [.LIB.FONT.SPEEDO]SPFILE.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPFILE "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SPINFO.OBJ : [.LIB.FONT.SPEEDO]SPINFO.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPINFO "$(FONT_SPEEDO_COUNT_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SPERR.OBJ : [.LIB.FONT.SPEEDO]SPERR.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPERR "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SPFONT.OBJ : [.LIB.FONT.SPEEDO]SPFONT.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPFONT "$(FONT_SPEEDO_COUNT_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SPGLYPH.OBJ : [.LIB.FONT.SPEEDO]SPGLYPH.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPGLYPH "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SPENCODE.OBJ : [.LIB.FONT.SPEEDO]SPENCODE.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SPENCODE "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]BICS-UNICODE.OBJ : [.LIB.FONT.SPEEDO]BICS-UNICODE.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]BICS-UNICODE "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]DO_CHAR.OBJ : [.LIB.FONT.SPEEDO]DO_CHAR.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]DO_CHAR "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]DO_TRNS.OBJ : [.LIB.FONT.SPEEDO]DO_TRNS.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]DO_TRNS "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]OUT_BL2D.OBJ : [.LIB.FONT.SPEEDO]OUT_BL2D.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]OUT_BL2D "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]OUT_BLK.OBJ : [.LIB.FONT.SPEEDO]OUT_BLK.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]OUT_BLK "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]OUT_SCRN.OBJ : [.LIB.FONT.SPEEDO]OUT_SCRN.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]OUT_SCRN "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]OUT_UTIL.OBJ : [.LIB.FONT.SPEEDO]OUT_UTIL.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]OUT_UTIL "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]RESET.OBJ : [.LIB.FONT.SPEEDO]RESET.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]RESET "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SET_SPCS.OBJ : [.LIB.FONT.SPEEDO]SET_SPCS.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SET_SPCS "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO

$(OUT).LIB.FONT.SPEEDO]SET_TRNS.OBJ : [.LIB.FONT.SPEEDO]SET_TRNS.C, -
    $(FONT_SPEEDO_HEADERS), $(FONT_SPEEDO_PRIVATE_HEADERS), -
    $(FONT_SPEEDO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.SPEEDO]SET_TRNS "$(FONT_SPEEDO_CFLAGS)" FONT_SPEEDO
