! Complete ordinary static DIX library; native ffs, no print-only server.
! XPSTUBS is the separate upstream auxiliary for a non-Xprint server.
! Native ENTRY widens envp while preserving upstream environment removals.
DIX_HEADERS = $(RENDER_HEADERS), $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XIPROTO.H
DIX_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), [.PROGRAMS.XSERVER.DIX]DISPATCH.H
DIX_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]DESCRIP.MMS
DIX_IDENTITY_INPUTS = [.CONFIG.CF]XORG.CF, [.CONFIG.CF]XORGVERSION.DEF
! Match public xorg.cf and xorgversion.def, not the historical site.h fallback.
DIX_VENDOR_STRING = The X.Org Foundation
DIX_VENDOR_RELEASE = 60900000
DIX_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Selected same-buffer indices and request/reply offsets retain upstream int counts.
DIX_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
! RESOURCE narrows a pointer only when formatting its fatal diagnostic.
DIX_DIAGNOSTIC_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
DIX_MAIN_CFLAGS = $(DIX_CFLAGS)
DIX_ENTRY_CFLAGS = $(DIX_CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT
DIX_CPP_DEFINES = PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1$(DIX_DDX_DEFINES)
DIX_CPPFLAGS = /DEFINE=($(DIX_CPP_DEFINES))
DIX_MAIN_CPPFLAGS = /DEFINE=($(DIX_CPP_DEFINES), -
    VENDOR_STRING=""""""$(DIX_VENDOR_STRING)"""""",VENDOR_RELEASE=$(DIX_VENDOR_RELEASE), -
    ""main""=VMSDIXMAIN,""CheckUserParameters""=VMSDIXCHECKUSERPARAMETERS)

DIX_OBJECTS = $(OUT).PROGRAMS.XSERVER.DIX]ATOM.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]COLORMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]CURSOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]DEVICES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]DISPATCH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]DIXUTILS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]EVENTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]EXTENSION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]GC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]GLOBALS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]GLYPHCURS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]GRABS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]MAIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]PROPERTY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]RESOURCE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]SWAPREP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]SWAPREQ.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]TABLES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]WINDOW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]INITATOMS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]DIXFONTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]PRIVATES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]PIXMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DIX]ENTRY.OBJ

DIX : $(OUT).PROGRAMS.XSERVER.DIX]DIX.OLB
	CONTINUE
XPSTUBS : $(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.DIX]ATOM.OBJ : [.PROGRAMS.XSERVER.DIX]ATOM.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]ATOM "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]COLORMAP.OBJ : [.PROGRAMS.XSERVER.DIX]COLORMAP.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]COLORMAP "$(DIX_COUNT_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]CURSOR.OBJ : [.PROGRAMS.XSERVER.DIX]CURSOR.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]CURSOR "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]DEVICES.OBJ : [.PROGRAMS.XSERVER.DIX]DEVICES.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]DEVICES "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]DISPATCH.OBJ : [.PROGRAMS.XSERVER.DIX]DISPATCH.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]DISPATCH "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]DIXUTILS.OBJ : [.PROGRAMS.XSERVER.DIX]DIXUTILS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]DIXUTILS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]EVENTS.OBJ : [.PROGRAMS.XSERVER.DIX]EVENTS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]EVENTS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]EXTENSION.OBJ : [.PROGRAMS.XSERVER.DIX]EXTENSION.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]EXTENSION "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]GC.OBJ : [.PROGRAMS.XSERVER.DIX]GC.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]GC "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]GLOBALS.OBJ : [.PROGRAMS.XSERVER.DIX]GLOBALS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]GLOBALS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]GLYPHCURS.OBJ : [.PROGRAMS.XSERVER.DIX]GLYPHCURS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]GLYPHCURS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]GRABS.OBJ : [.PROGRAMS.XSERVER.DIX]GRABS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]GRABS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]MAIN.OBJ : [.PROGRAMS.XSERVER.DIX]MAIN.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(DIX_IDENTITY_INPUTS), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]MAIN "$(DIX_MAIN_CFLAGS)" DIX "$(DIX_MAIN_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]PROPERTY.OBJ : [.PROGRAMS.XSERVER.DIX]PROPERTY.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]PROPERTY "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]RESOURCE.OBJ : [.PROGRAMS.XSERVER.DIX]RESOURCE.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]RESOURCE "$(DIX_DIAGNOSTIC_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]SWAPREP.OBJ : [.PROGRAMS.XSERVER.DIX]SWAPREP.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]SWAPREP "$(DIX_COUNT_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]SWAPREQ.OBJ : [.PROGRAMS.XSERVER.DIX]SWAPREQ.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]SWAPREQ "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]TABLES.OBJ : [.PROGRAMS.XSERVER.DIX]TABLES.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]TABLES "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]WINDOW.OBJ : [.PROGRAMS.XSERVER.DIX]WINDOW.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]WINDOW "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]INITATOMS.OBJ : [.PROGRAMS.XSERVER.DIX]INITATOMS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]INITATOMS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]DIXFONTS.OBJ : [.PROGRAMS.XSERVER.DIX]DIXFONTS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]DIXFONTS "$(DIX_COUNT_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]PRIVATES.OBJ : [.PROGRAMS.XSERVER.DIX]PRIVATES.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]PRIVATES "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]PIXMAP.OBJ : [.PROGRAMS.XSERVER.DIX]PIXMAP.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]PIXMAP "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]ENTRY.OBJ : [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]ENTRY.C, -
    $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]ENTRY "$(DIX_ENTRY_CFLAGS)" RTL

$(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS.OBJ : [.PROGRAMS.XSERVER.DIX]XPSTUBS.C, -
    $(DIX_HEADERS), $(DIX_PRIVATE_HEADERS), $(DIX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DIX]DIX.OLB : $(DIX_OBJECTS), $(DIX_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]ATOM.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]COLORMAP.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]CURSOR.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DEVICES.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DISPATCH.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DIXUTILS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]EVENTS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]EXTENSION.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GC.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GLOBALS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GLYPHCURS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]GRABS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]MAIN.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PROPERTY.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]RESOURCE.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]SWAPREP.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]SWAPREQ.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]TABLES.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]WINDOW.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]INITATOMS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]DIXFONTS.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PRIVATES.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]PIXMAP.OBJ,$(OUT).PROGRAMS.XSERVER.DIX]ENTRY.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.DIX]DIX_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS.OLB : $(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS.OBJ, $(DIX_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.DIX]XPSTUBS_LIBRARY.LIS $(MMS$TARGET)
