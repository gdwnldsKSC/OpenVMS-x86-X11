	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]PARSE "$(XPM_COUNT_INDEX_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]HASHTAB.OBJ : [.EXTRAS.XPM.LIB]HASHTAB.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]HASHTAB "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

