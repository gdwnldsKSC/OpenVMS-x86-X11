! Internal lib/font/fc section: TCP font-server client and its upstream transport.
FONT_FC_HEADERS = $(FONT_UTIL_HEADERS), $(XTRANS_HEADERS), -
                  $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XOS_R.H
FONT_FC_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
                          [.LIB.FONT.INCLUDE]FONTUTIL.H, -
                          [.LIB.FONT.FC]FSERVE.H, [.LIB.FONT.FC]FSERVESTR.H, -
                          [.LIB.FONT.FC]FSIO.H, [.LIB.FONT.FC]FSLIBOS.H
FONT_FC_TRANSPORT_HEADERS = [.LIB.XTRANS]XTRANS.H, [.LIB.XTRANS]XTRANSINT.H
FONT_FC_TRANSPORT_SOURCES = [.LIB.XTRANS]XTRANSSOCK.C, -
                            [.LIB.XTRANS]XTRANS.C, [.LIB.XTRANS]XTRANSUTIL.C
FONT_FC_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, -
                      [.VMS-SUPPORT.LIB.FONT.FC]DESCRIP.MMS
! Double quotes preserve the lowercase t through COMPILE.COM's argument string.
FONT_FC_CFLAGS = $(CFLAGS)/DEFINE=(""FONT_t"",TRANS_CLIENT,TRANS_SERVER,TRANS_REOPEN,TCPCONN,OPEN_MAX=256)
! Preserve upstream encoding offsets, glyph counts and catalogue wire lengths.
FONT_FC_COUNT_CFLAGS = $(FONT_FC_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! R6.9 fserve.c and fsio.c supply FONT_t and TRANS_CLIENT themselves.
FONT_FC_SOURCE_CFLAGS = $(CFLAGS)/DEFINE=(TRANS_SERVER,TRANS_REOPEN,TCPCONN,OPEN_MAX=256)
FONT_FC_SOURCE_COUNT_CFLAGS = $(FONT_FC_SOURCE_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Installed P64 iovec layouts agree; their SDK structure tags differ.
! Xfuncs replaces equivalent RTL bcopy/bzero macros in relaxed mode.
FONT_FC_TRANSPORT_CFLAGS = $(FONT_FC_CFLAGS)/STANDARD=RELAXED_ANSI89/WARNINGS=(ENABLE=LEVEL4,DISABLE=(PTRMISMATCH,MACROREDEF))
FONT_FC_OBJECTS = $(OUT).LIB.FONT.FC]FSCONVERT.OBJ, -
                  $(OUT).LIB.FONT.FC]FSERVE.OBJ, -
                  $(OUT).LIB.FONT.FC]FSIO.OBJ, -
                  $(OUT).LIB.FONT.FC]TRANSPORT.OBJ

$(OUT).LIB.FONT.FC]FSCONVERT.OBJ : [.LIB.FONT.FC]FSCONVERT.C, -
    $(FONT_FC_HEADERS), $(FONT_FC_PRIVATE_HEADERS), $(FONT_FC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FC]FSCONVERT "$(FONT_FC_COUNT_CFLAGS)" FONT_FC

$(OUT).LIB.FONT.FC]FSERVE.OBJ : [.LIB.FONT.FC]FSERVE.C, -
    $(FONT_FC_HEADERS), $(FONT_FC_PRIVATE_HEADERS), $(FONT_FC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FC]FSERVE "$(FONT_FC_SOURCE_COUNT_CFLAGS)" FONT_FC

$(OUT).LIB.FONT.FC]FSIO.OBJ : [.LIB.FONT.FC]FSIO.C, -
    $(FONT_FC_HEADERS), $(FONT_FC_PRIVATE_HEADERS), $(FONT_FC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FC]FSIO "$(FONT_FC_SOURCE_CFLAGS)" FONT_FC

$(OUT).LIB.FONT.FC]TRANSPORT.OBJ : [.LIB.XTRANS]TRANSPORT.C, -
    $(FONT_FC_HEADERS), $(FONT_FC_TRANSPORT_HEADERS), $(FONT_FC_TRANSPORT_SOURCES), -
    $(FONT_FC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FC]TRANSPORT "$(FONT_FC_TRANSPORT_CFLAGS)" FONT_FC
