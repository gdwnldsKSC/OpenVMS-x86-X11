! Complete upstream libxf86modes with the selected DGA support.
XF86MODES_HEADERS = $(XF86COMMON_HEADERS), $(FB_HEADERS)
XF86MODES_PRIVATE_HEADERS = $(XF86COMMON_PRIVATE_HEADERS), $(FB_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86RANDR12.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86CURSORPRIV.H
XF86MODES_BUILD_RULES = $(XF86COMMON_BUILD_RULES), $(FB_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.MODES]DESCRIP.MMS
! The default mode table is borrowed through DisplayModePtr before duplication.
XF86MODES_MODE_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,NOTCONSTQUAL))
XF86MODES_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CRTC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CURSORS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CVT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86GTF.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86DISPLAYIDMODES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86EDIDMODES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86MODES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86RANDR12.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86ROTATE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86DIDGA.OBJ

XF86MODES : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86MODES.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CRTC.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86CRTC.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CRTC "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CURSORS.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86CURSORS.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CURSORS "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CVT.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86CVT.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86CVT "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86GTF.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86GTF.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86GTF "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86DISPLAYIDMODES.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86DISPLAYIDMODES.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86DISPLAYIDMODES "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86EDIDMODES.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86EDIDMODES.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86EDIDMODES "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86MODES.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86MODES.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86MODES "$(XF86MODES_MODE_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86RANDR12.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86RANDR12.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86RANDR12 "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86ROTATE.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86ROTATE.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86ROTATE "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86DIDGA.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.MODES]XF86DIDGA.C, -
    $(XF86MODES_HEADERS), $(XF86MODES_PRIVATE_HEADERS), $(XF86MODES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86DIDGA "$(XF86COMMON_CFLAGS)" XF86MODES "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86MODES.OLB : $(XF86MODES_OBJECTS), $(XF86MODES_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XF86MODES_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.MODES]XF86MODES_LIBRARY.LIS $(MMS$TARGET)
