XSERVER_CORE_LIBRARIES = $(XVFB_OUT).DIX]DIX.OLB, -
    $(XVFB_OUT).DIX]XPSTUBS.OLB, -
    $(XVFB_OUT).OS]OS.OLB, -
    $(XVFB_OUT).MI]MI.OLB, -
    $(XVFB_OUT).MIEXT.DAMAGE]DAMAGE.OLB, -
    $(XVFB_OUT).FB]FB.OLB, -
    $(XVFB_OUT).RENDER]RENDER.OLB, -
    $(XVFB_OUT).XKB]XKB.OLB, -
    $(XVFB_OUT).XI]XINPUT.OLB, -
    $(OUT).LIB.FONT]XFONT.OLB, -
    $(OUT).LIB.FREETYPE2]FREETYPE.OLB, -
    $(OUT).LIB.FONTENC]FONTENC.OLB, -
    $(OUT).LIB.ZLIB]Z.OLB, -
    $(OUT).LIB.XAU]XAU.OLB, -
    $(OUT).LIB.XDMCP]XDMCP.OLB

XSERVER_CORE : $(XSERVER_CORE_LIBRARIES), $(XVFB_OUT).HW.VFB]MIINITEXT.OBJ
	CONTINUE

XSERVER : XSERVER_CORE, $(XVFB_RULES)
	@[.VMS-SUPPORT.PROGRAMS.XSERVER]LINK.COM "$(XSERVER_DDX_INPUT)" "$(XSERVER_IMAGE)" "$(XSERVER_MAP)"

$(XVFB_BASE)]XVFB.EXE : $(XSERVER_CORE_LIBRARIES), $(XVFB_OUT).HW.VFB]VFB.OLB, -
    $(XVFB_RULES)
	@[.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]LINK.COM

$(XVFB_OUT).DIX]ATOM.OBJ : [.XSERVER.XORG-SERVER.DIX]ATOM.C, -
    $(DIX_HEADERS), -
    $(DIX_PRIVATE_HEADERS), -
    $(DIX_BUILD_RULES), -
    $(RTL), -
    $(XVFB_HEADERS), -
    $(XVFB_RULES)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XVFB_OUT).DIX]ATOM "$(DIX_CFLAGS)" DIX "$(XVFB_DIX_CPPFLAGS)"

