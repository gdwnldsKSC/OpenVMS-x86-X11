! Complete static Xrandr client library from lib/Xrandr/Imakefile.
XRANDR_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRENDER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RANDR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RANDRPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRANDR.H
XRANDR_PRIVATE_HEADERS = [.LIB.XRANDR]XRANDRINT.H, [.LIB.XRANDR]XRANDR.H
XRANDR_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XRANDR]DESCRIP.MMS
XRANDR_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XRANDR_OBJECTS = $(OUT).LIB.XRANDR]XRANDR.OBJ

XRANDR : $(OUT).LIB.XRANDR]XRANDR.OLB
	CONTINUE

$(OUT).LIB.XRANDR]XRANDR.OBJ : [.LIB.XRANDR]XRANDR.C, -
    $(XRANDR_HEADERS), $(XRANDR_PRIVATE_HEADERS), $(XRANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRANDR]XRANDR "$(XRANDR_CFLAGS)" XRANDR

$(OUT).LIB.XRANDR]XRANDR.OLB : $(XRANDR_OBJECTS), $(XRANDR_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XRANDR_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XRANDR]XRANDR_LIBRARY.LIS $(MMS$TARGET)
