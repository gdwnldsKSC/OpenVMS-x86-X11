! Complete static xkbui library from lib/xkbui/Imakefile.
XKBUI_HEADERS = $(XKBFILE_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]XKBUI.H
XKBUI_PRIVATE_HEADERS = $(XKBFILE_PRIVATE_HEADERS), -
    [.LIB.LIBXKBUI.SRC]XKBUIPRIV.H, [.LIB.LIBXKBUI.INCLUDE.X11.EXTENSIONS]XKBUI.H
XKBUI_BUILD_RULES = $(XKBFILE_BUILD_RULES), -
    [.VMS-SUPPORT.LIB.XKBUI]DESCRIP.MMS
XKBUI_CFLAGS = $(XKBFILE_CFLAGS)
XKBUI_OBJECTS = $(OUT).LIB.XKBUI]XKBUI.OBJ

XKBUI : $(OUT).LIB.XKBUI]XKBUI.OLB
	CONTINUE

$(OUT).LIB.XKBUI]XKBUI.OBJ : [.LIB.LIBXKBUI.SRC]XKBUI.C, -
    $(XKBUI_HEADERS), $(XKBUI_PRIVATE_HEADERS), $(XKBUI_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBUI]XKBUI "$(XKBUI_CFLAGS)" XKBUI

$(OUT).LIB.XKBUI]XKBUI.OLB : $(XKBUI_OBJECTS), $(XKBUI_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XKBUI_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XKBUI]XKBUI_LIBRARY.LIS $(MMS$TARGET)
