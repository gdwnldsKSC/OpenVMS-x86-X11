    $(XVFB_OUT).DIX]GRABS.OBJ, -
    $(XVFB_OUT).DIX]MAIN.OBJ, -
    $(XVFB_OUT).DIX]PROPERTY.OBJ, -
    $(XVFB_OUT).DIX]RESOURCE.OBJ, -
    $(XVFB_OUT).DIX]SWAPREP.OBJ, -
    $(XVFB_OUT).DIX]SWAPREQ.OBJ, -
    $(XVFB_OUT).DIX]TABLES.OBJ, -
    $(XVFB_OUT).DIX]WINDOW.OBJ, -
    $(XVFB_OUT).DIX]INITATOMS.OBJ, -
    $(XVFB_OUT).DIX]DIXFONTS.OBJ, -
    $(XVFB_OUT).DIX]PRIVATES.OBJ, -
    $(XVFB_OUT).DIX]PIXMAP.OBJ, -
    $(XVFB_OUT).DIX]ENTRY.OBJ, -
    $(XVFB_OUT).DIX]DEPRECATED.OBJ, -
    $(XVFB_OUT).DIX]REGISTRY.OBJ, -
    $(XVFB_OUT).DIX]SELECTION.OBJ, -
    $(XVFB_OUT).DIX]ENTERLEAVE.OBJ, -
    $(XVFB_OUT).DIX]EVENTCONVERT.OBJ, -
    $(XVFB_OUT).DIX]INPUTUTILS.OBJ, -
    $(XVFB_OUT).DIX]PTRVELOC.OBJ
XVFB_FB_OBJECTS = $(XVFB_OUT).FB]FBARC.OBJ, -
    $(XVFB_OUT).FB]FBALLPRIV.OBJ, -
    $(XVFB_OUT).FB]FBBITS.OBJ, -
    $(XVFB_OUT).FB]FBBLT.OBJ, -
