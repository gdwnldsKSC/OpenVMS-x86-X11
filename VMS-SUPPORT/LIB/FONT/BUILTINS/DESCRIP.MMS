! Complete five-object lib/font/builtins section of Xfont.
! Use the unchanged embedded font data supplied in upstream fonts.c.
FONT_BUILTINS_HEADERS = $(FONT_UTIL_HEADERS)
FONT_BUILTINS_PRIVATE_HEADERS = [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTMISC.H, -
    [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTXLFD.H, [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFIL.H, -
    [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILIO.H, [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILST.H, -
    [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BUFIO.H, [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTUTIL.H, -
    [.LIB.LIBXFONT.INCLUDE.X11.FONTS]PCF.H, [.LIB.LIBXFONT.SRC.BUILTINS]BUILTIN.H
FONT_BUILTINS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONT.BUILTINS]DESCRIP.MMS
! FILE uses differences within a built-in font buffer as int-sized counts.
FONT_BUILTINS_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONT_BUILTINS_OBJECTS = $(OUT).LIB.FONT.BUILTINS]DIR.OBJ, -
    $(OUT).LIB.FONT.BUILTINS]FILE.OBJ, -
    $(OUT).LIB.FONT.BUILTINS]FONTS.OBJ, -
    $(OUT).LIB.FONT.BUILTINS]FPE.OBJ, -
    $(OUT).LIB.FONT.BUILTINS]RENDER.OBJ

$(OUT).LIB.FONT.BUILTINS]DIR.OBJ : [.LIB.LIBXFONT.SRC.BUILTINS]DIR.C, -
    $(FONT_BUILTINS_HEADERS), $(FONT_BUILTINS_PRIVATE_HEADERS), $(FONT_BUILTINS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BUILTINS]DIR "$(CFLAGS)" FONT_BUILTINS

$(OUT).LIB.FONT.BUILTINS]FILE.OBJ : [.LIB.LIBXFONT.SRC.BUILTINS]FILE.C, -
    $(FONT_BUILTINS_HEADERS), $(FONT_BUILTINS_PRIVATE_HEADERS), $(FONT_BUILTINS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BUILTINS]FILE "$(FONT_BUILTINS_COUNT_CFLAGS)" FONT_BUILTINS

$(OUT).LIB.FONT.BUILTINS]FONTS.OBJ : [.LIB.LIBXFONT.SRC.BUILTINS]FONTS.C, -
    $(FONT_BUILTINS_HEADERS), $(FONT_BUILTINS_PRIVATE_HEADERS), $(FONT_BUILTINS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BUILTINS]FONTS "$(CFLAGS)" FONT_BUILTINS

$(OUT).LIB.FONT.BUILTINS]FPE.OBJ : [.LIB.LIBXFONT.SRC.BUILTINS]FPE.C, -
    $(FONT_BUILTINS_HEADERS), $(FONT_BUILTINS_PRIVATE_HEADERS), $(FONT_BUILTINS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BUILTINS]FPE "$(CFLAGS)" FONT_BUILTINS

$(OUT).LIB.FONT.BUILTINS]RENDER.OBJ : [.LIB.LIBXFONT.SRC.BUILTINS]RENDER.C, -
    $(FONT_BUILTINS_HEADERS), $(FONT_BUILTINS_PRIVATE_HEADERS), $(FONT_BUILTINS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BUILTINS]RENDER "$(CFLAGS)" FONT_BUILTINS
