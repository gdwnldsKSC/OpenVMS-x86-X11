	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXLEDS "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXVT.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXVT.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXVT "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXLOAD.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXLOAD.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXLOAD "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXLIST.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXLIST.C, -
