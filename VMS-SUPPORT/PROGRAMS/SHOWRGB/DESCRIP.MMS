! programs/rgb/Imakefile's text color-database viewer (UseRgbTxt).
SHOWRGB_HEADERS = $(COMMON_HEADERS), [.PROGRAMS.XSERVER.INCLUDE]RGB.H, -
                  [.PROGRAMS.XSERVER.INCLUDE]SITE.H
SHOWRGB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                     [.VMS-SUPPORT]HEADERS.MMS, -
                     [.VMS-SUPPORT.PROGRAMS.SHOWRGB]DESCRIP.MMS
! Upstream appends .txt; resolve the default database from the repository root.
SHOWRGB_RGB_DB = [.PROGRAMS.RGB]RGB
SHOWRGB_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /DEFINE=(USE_RGB_TXT,RGB_DB=""""""$(SHOWRGB_RGB_DB)"""""")

SHOWRGB : $(OUT).PROGRAMS.SHOWRGB]SHOWRGB.EXE
	CONTINUE

$(OUT).PROGRAMS.SHOWRGB]SHOWRGB.OBJ : [.PROGRAMS.RGB]SHOWRGB.C, -
    $(SHOWRGB_HEADERS), $(SHOWRGB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.SHOWRGB]SHOWRGB "$(SHOWRGB_CFLAGS)" SHOWRGB

$(OUT).PROGRAMS.SHOWRGB]SHOWRGB.EXE : $(OUT).PROGRAMS.SHOWRGB]SHOWRGB.OBJ, -
    [.VMS-SUPPORT.PROGRAMS.SHOWRGB]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.SHOWRGB]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.SHOWRGB]LINK.COM
