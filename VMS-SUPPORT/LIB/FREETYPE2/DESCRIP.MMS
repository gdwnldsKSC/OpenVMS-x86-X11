FREETYPE2_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE_FREETYPE2.COM, -
    [.VMS-SUPPORT.LIB.FREETYPE2]DESCRIP.MMS
FREETYPE2_CFLAGS = $(CFLAGS)/DEFINE=XFREE86_FT2
! Native span diagnostics retain upstream int/long count limits after P64 table rebasing.
FREETYPE2_COUNT_CFLAGS = $(FREETYPE2_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! GX variation frame offsets retain upstream FT_ULong-sized counts.
! Keep 2.1.9's inherited error=FT_NEW_ARRAY double assignment unchanged.
FREETYPE2_TRUETYPE_CFLAGS = $(FREETYPE2_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,UNDEFVARMOD))
! BDF stores property indices in pointer slots; CFF masks address-derived seed entropy.
FREETYPE2_POINTER_CFLAGS = $(FREETYPE2_CFLAGS) -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,POINTERINTCAST))
FREETYPE2_OBJECTS = $(OUT).LIB.FREETYPE2]FTAPI.OBJ, -
    $(OUT).LIB.FREETYPE2]FTBASE.OBJ, -
    $(OUT).LIB.FREETYPE2]FTBBOX.OBJ, -
