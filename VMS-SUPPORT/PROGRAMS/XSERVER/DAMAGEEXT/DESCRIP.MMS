! Complete ordinary static Damage extension library from the upstream Imakefile.
! Keep the Unix damage basename in its directory, separate from miext/damage.
DAMAGEEXT_HEADERS = $(XFIXES_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]DAMAGEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DAMAGEWIRE.H
DAMAGEEXT_PRIVATE_HEADERS = $(XFIXES_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT.H, -
    [.PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXTINT.H
DAMAGEEXT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XFIXES]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DAMAGEEXT]DESCRIP.MMS
DAMAGEEXT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
DAMAGEEXT_CPPFLAGS = /DEFINE=(COMPOSITE,XFIXES,DAMAGE,PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

DAMAGEEXT : $(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGE.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT.OBJ : [.PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT.C, -
    $(DAMAGEEXT_HEADERS), $(DAMAGEEXT_PRIVATE_HEADERS), $(DAMAGEEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT "$(DAMAGEEXT_CFLAGS)" DAMAGEEXT "$(DAMAGEEXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGE.OLB : -
    $(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT.OBJ, $(DAMAGEEXT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGEEXT.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.DAMAGEEXT]DAMAGE_LIBRARY.LIS $(MMS$TARGET)
