! Mirrors lib/FS/Imakefile's normal library with TCP-only client transport.
FS_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]XMD.H, -
             $(OUT).INCLUDE.X11]XDEFS.H, $(XTRANS_HEADERS), -
             $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XOS_R.H, -
             $(OUT).INCLUDE.X11.FONTS]FS.H, -
             $(OUT).INCLUDE.X11.FONTS]FSPROTO.H, -
             $(OUT).INCLUDE.X11.FONTS]FSMASKS.H, -
             $(OUT).INCLUDE.X11.FONTS]FSLIB.H
FS_PRIVATE_HEADERS = [.LIB.LIBFS.INCLUDE.X11.FONTS]FSLIB.H, [.LIB.LIBFS.SRC]FSLIBINT.H, [.LIB.LIBFS.SRC]FSLIBOS.H
FS_TRANSPORT_HEADERS = [.LIB.XTRANS]XTRANS.H, [.LIB.XTRANS]XTRANSINT.H
FS_TRANSPORT_SOURCES = [.LIB.XTRANS]XTRANSSOCK.C, -
                       [.LIB.XTRANS]XTRANS.C, [.LIB.XTRANS]XTRANSUTIL.C
FS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                 [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FS]DESCRIP.MMS
! Double quotes preserve the lowercase t through COMPILE.COM's argument string.
FS_CFLAGS = $(CFLAGS)/DEFINE=(""FS_t"",TRANS_CLIENT,TCPCONN,OPEN_MAX=256)
! The two pointer differences are counts within the BUFSIZE output buffer.
! The upstream fatal IO handler exits unconditionally without returning.
FS_LIBINT_CFLAGS = $(FS_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,MISSINGRETURN))
! Installed P64 iovec layouts agree; their SDK structure tags differ.
! Xfuncs replaces equivalent RTL bcopy/bzero macros in relaxed mode.
FS_TRANSPORT_CFLAGS = $(FS_CFLAGS)/STANDARD=RELAXED_ANSI89/WARNINGS=(ENABLE=LEVEL4,DISABLE=(PTRMISMATCH,MACROREDEF))
FS_OBJECTS = $(OUT).LIB.FS]FSCLSERV.OBJ, -
             $(OUT).LIB.FS]FSCLOSEFT.OBJ, -
             $(OUT).LIB.FS]FSCONNSERV.OBJ, -
             $(OUT).LIB.FS]FSERRDIS.OBJ, -
             $(OUT).LIB.FS]FSERRHNDLR.OBJ, -
             $(OUT).LIB.FS]FSFLUSH.OBJ, -
             $(OUT).LIB.FS]FSFONTINFO.OBJ, -
             $(OUT).LIB.FS]FSFTNAMES.OBJ, -
             $(OUT).LIB.FS]FSGETCATS.OBJ, -
             $(OUT).LIB.FS]FSLISTCATS.OBJ, -
             $(OUT).LIB.FS]FSLISTEXT.OBJ, -
             $(OUT).LIB.FS]FSMISC.OBJ, -
             $(OUT).LIB.FS]FSNEXTEV.OBJ, -
             $(OUT).LIB.FS]FSOPENFONT.OBJ, -
             $(OUT).LIB.FS]FSOPENSERV.OBJ, -
             $(OUT).LIB.FS]FSQGLYPHS.OBJ, -
             $(OUT).LIB.FS]FSQXEXT.OBJ, -
             $(OUT).LIB.FS]FSQXINFO.OBJ, -
             $(OUT).LIB.FS]FSQUEXT.OBJ, -
             $(OUT).LIB.FS]FSSERVNAME.OBJ, -
             $(OUT).LIB.FS]FSSETCATS.OBJ, -
             $(OUT).LIB.FS]FSSYNC.OBJ, -
             $(OUT).LIB.FS]FSSYNCHRO.OBJ, -
             $(OUT).LIB.FS]FSLIBINT.OBJ, -
             $(OUT).LIB.FS]TRANSPORT.OBJ

FS : $(OUT).LIB.FS]FS.OLB
	CONTINUE

$(OUT).LIB.FS]FSCLSERV.OBJ : [.LIB.LIBFS.SRC]FSCLSERV.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSCLSERV "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSCLOSEFT.OBJ : [.LIB.LIBFS.SRC]FSCLOSEFT.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSCLOSEFT "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSCONNSERV.OBJ : [.LIB.LIBFS.SRC]FSCONNSERV.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSCONNSERV "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSERRDIS.OBJ : [.LIB.LIBFS.SRC]FSERRDIS.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSERRDIS "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSERRHNDLR.OBJ : [.LIB.LIBFS.SRC]FSERRHNDLR.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSERRHNDLR "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSFLUSH.OBJ : [.LIB.LIBFS.SRC]FSFLUSH.C, -
