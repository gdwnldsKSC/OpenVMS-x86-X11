! Complete programs/fonttosfnt/Imakefile target with native setenv and snprintf.
FONTTOSFNT_HEADERS = $(COMMON_HEADERS), $(FREETYPE2_HEADERS), -
    $(FONTENC_HEADERS), $(ZLIB_HEADERS)
FONTTOSFNT_PRIVATE_HEADERS = [.APP.FONTTOSFNT]FONTTOSFNT.H
FONTTOSFNT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE_FONTTOSFNT.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.FONTTOSFNT]DESCRIP.MMS
! Public X11.tmpl vendor strings; retain the upstream PCLT initializer.
FONTTOSFNT_VENDORNAME = The X.Org Foundation
FONTTOSFNT_VENDORNAMESHORT = X.Org
FONTTOSFNT_CFLAGS = $(CFLAGS) -
    /DEFINE=(XFREE86_FT2,_XOPEN_SOURCE=600,XVENDORNAME=""""""$(FONTTOSFNT_VENDORNAME)"""""", -
    XVENDORNAMESHORT=""""""$(FONTTOSFNT_VENDORNAMESHORT)"""""")
FONTTOSFNT_MAIN_CFLAGS = $(FONTTOSFNT_CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT
FONTTOSFNT_OBJECTS = $(OUT).PROGRAMS.FONTTOSFNT]FONTTOSFNT.OBJ, -
    $(OUT).PROGRAMS.FONTTOSFNT]READ.OBJ, $(OUT).PROGRAMS.FONTTOSFNT]WRITE.OBJ, -
    $(OUT).PROGRAMS.FONTTOSFNT]STRUCT.OBJ, $(OUT).PROGRAMS.FONTTOSFNT]UTIL.OBJ

FONTTOSFNT : $(OUT).PROGRAMS.FONTTOSFNT]FONTTOSFNT.EXE
	CONTINUE

$(OUT).PROGRAMS.FONTTOSFNT]FONTTOSFNT.OBJ : [.APP.FONTTOSFNT]FONTTOSFNT.C, -
    $(FONTTOSFNT_HEADERS), $(FONTTOSFNT_PRIVATE_HEADERS), $(FONTTOSFNT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_FONTTOSFNT.COM $(MMS$SOURCE) $(OUT).PROGRAMS.FONTTOSFNT]FONTTOSFNT "$(FONTTOSFNT_MAIN_CFLAGS)"

$(OUT).PROGRAMS.FONTTOSFNT]READ.OBJ : [.APP.FONTTOSFNT]READ.C, -
    $(FONTTOSFNT_HEADERS), $(FONTTOSFNT_PRIVATE_HEADERS), $(FONTTOSFNT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_FONTTOSFNT.COM $(MMS$SOURCE) $(OUT).PROGRAMS.FONTTOSFNT]READ "$(FONTTOSFNT_CFLAGS)"

$(OUT).PROGRAMS.FONTTOSFNT]WRITE.OBJ : [.APP.FONTTOSFNT]WRITE.C, -
    $(FONTTOSFNT_HEADERS), $(FONTTOSFNT_PRIVATE_HEADERS), $(FONTTOSFNT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_FONTTOSFNT.COM $(MMS$SOURCE) $(OUT).PROGRAMS.FONTTOSFNT]WRITE "$(FONTTOSFNT_CFLAGS)"

$(OUT).PROGRAMS.FONTTOSFNT]STRUCT.OBJ : [.APP.FONTTOSFNT]STRUCT.C, -
    $(FONTTOSFNT_HEADERS), $(FONTTOSFNT_PRIVATE_HEADERS), $(FONTTOSFNT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_FONTTOSFNT.COM $(MMS$SOURCE) $(OUT).PROGRAMS.FONTTOSFNT]STRUCT "$(FONTTOSFNT_CFLAGS)"

$(OUT).PROGRAMS.FONTTOSFNT]UTIL.OBJ : [.APP.FONTTOSFNT]UTIL.C, -
    $(FONTTOSFNT_HEADERS), $(FONTTOSFNT_PRIVATE_HEADERS), $(FONTTOSFNT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE_FONTTOSFNT.COM $(MMS$SOURCE) $(OUT).PROGRAMS.FONTTOSFNT]UTIL "$(FONTTOSFNT_CFLAGS)"

$(OUT).PROGRAMS.FONTTOSFNT]FONTTOSFNT.EXE : $(FONTTOSFNT_OBJECTS), -
    $(OUT).LIB.FREETYPE2]FREETYPE.OLB, $(OUT).LIB.FONTENC]FONTENC.OLB, -
    $(OUT).LIB.ZLIB]Z.OLB, [.VMS-SUPPORT.PROGRAMS.FONTTOSFNT]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.FONTTOSFNT]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.FONTTOSFNT]LINK.COM
