	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBPRKEYEV "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

