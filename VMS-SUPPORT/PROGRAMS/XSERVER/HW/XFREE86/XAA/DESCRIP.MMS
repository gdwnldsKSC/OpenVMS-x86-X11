! Complete static XFree86 XAA library, including all upstream generated variants.
! P64/long32 with Render; loadable hooks, Xinerama and architecture assembly excluded.
XAA_HEADERS = $(MI_HEADERS)
XAA_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]COMPILER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VERSION.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86FBMAN.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAA.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAALOCAL.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAAROP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAACEXP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAAWRAP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAAWRAPPER.H, -
    [.XSERVER.XORG-SERVER.RENDER]GLYPHSTR.H, -
    [.XSERVER.XORG-SERVER.RENDER]MIPICT.H, -
    [.XSERVER.XORG-SERVER.RENDER]PICTURE.H, -
    [.XSERVER.XORG-SERVER.RENDER]PICTURESTR.H
XAA_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.XAA]DESCRIP.MMS
XAA_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Region/span pointer differences retain upstream int32 element-count interfaces.
XAA_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XAA_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT, -
    NO_INLINE,XORG_VERSION_CURRENT=70100000,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0, -
    IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)
XAA_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAGC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAINITACCEL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAFALLBACK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAABITBLT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAACPYAREA.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAGCMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAACPYWIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAACPYPLANE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAFILLRECT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAATETEXT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAANONTETEXT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAPCACHE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAASPANS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAROP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAIMAGE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAWRAPPER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAPAINTWIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAARECT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAALINEMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAABITORDER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAFILLPOLY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAWIDELINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAATABLES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAFILLARC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAALINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAADASHLINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAOVERLAY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAOFFSCREEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAOVERLAYDF.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAASTATECHANGE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAPICT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]S-XAALINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]S-XAADASHLINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]L-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]L-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]L-XAATEGLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]M-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]M-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]M-XAATEGLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]LF-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]LF-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]LF-XAATEGLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]MF-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]MF-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]MF-XAATEGLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]L3-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]L3-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]M3-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]M3-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]LF3-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]LF3-XAASTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]MF3-XAABITMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]MF3-XAASTIPPLE.OBJ

XAA : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAA.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAINIT.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAAINIT.C, -
    $(XAA_HEADERS), $(XAA_PRIVATE_HEADERS), $(XAA_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.XAA]XAAINIT "$(XAA_CFLAGS)" XAA "$(XAA_CPPFLAGS)"

