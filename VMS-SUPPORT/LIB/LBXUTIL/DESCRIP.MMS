! Full upstream lbxutil: delta, zlib transport and the existing five image codecs.
! Optional LBXREQSTATS is disabled, as in the ordinary upstream build.
.INCLUDE [.VMS-SUPPORT.LIB.LBXUTIL.IMAGE]DESCRIP.MMS

LBXUTIL_HEADERS = $(LBXUTIL_IMAGE_HEADERS), $(ZLIB_HEADERS), -
                  $(OUT).INCLUDE.X11]X.H, $(OUT).INCLUDE.X11]XMD.H, -
                  $(OUT).INCLUDE.X11]XPROTO.H, -
                  $(OUT).INCLUDE.X11]XPROTOSTR.H, -
                  $(OUT).INCLUDE.X11]XDEFS.H, -
                  $(OUT).INCLUDE.X11]XALLOCA.H, -
                  $(OUT).INCLUDE.X11.EXTENSIONS]XLBX.H, -
                  $(OUT).INCLUDE.X11.EXTENSIONS]LBXSTR.H, -
                  $(OUT).INCLUDE.X11.EXTENSIONS]LBXDELTASTR.H, -
                  $(OUT).INCLUDE.X11.EXTENSIONS]LBXBUF.H, -
                  $(OUT).INCLUDE.X11.EXTENSIONS]LBXBUFSTR.H, -
                  $(OUT).INCLUDE.X11.EXTENSIONS]LBXZLIB.H
LBXUTIL_PRIVATE_HEADERS = [.XSERVER.XORG-SERVER.INCLUDE]OS.H, -
                          [.XSERVER.XORG-SERVER.INCLUDE]MISC.H, -
                          [.LIB.LIBLBXUTIL.SRC.LBX_ZLIB]LBX_ZLIB.H, -
                          [.LIB.LIBLBXUTIL.SRC.LBX_ZLIB]REQSTATS.H
LBXUTIL_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                     [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.LBXUTIL]DESCRIP.MMS
! Keep the upstream int-sized packet/buffer counts with P64 data pointers.
LBXUTIL_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Native P64 vector I/O uses compatible layouts with distinct structure tags.
LBXUTIL_IO_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,PTRMISMATCH))
LBXUTIL_OBJECTS = $(OUT).LIB.LBXUTIL]LBXDELTA.OBJ, -
                  $(OUT).LIB.LBXUTIL]LBX_ZLIB.OBJ, -
                  $(OUT).LIB.LBXUTIL]LBX_ZLIB_IO.OBJ, -
                  $(OUT).LIB.LBXUTIL]REQSTATS.OBJ, $(LBXUTIL_IMAGE_OBJECTS)

LBXUTIL : $(OUT).LIB.LBXUTIL]LBXUTIL.OLB, $(OUT).LIB.ZLIB]Z.OLB
	CONTINUE

$(OUT).INCLUDE.X11.EXTENSIONS]XLBX.H : [.PROTO.XEXTPROTO]XLBX.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.EXTENSIONS]LBXSTR.H : [.PROTO.XEXTPROTO]LBXSTR.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.EXTENSIONS]LBXDELTASTR.H : [.PROTO.XEXTPROTO]LBXDELTASTR.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.EXTENSIONS]LBXBUF.H : [.PROTO.XEXTPROTO]LBXBUF.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.EXTENSIONS]LBXBUFSTR.H : [.PROTO.XEXTPROTO]LBXBUFSTR.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.EXTENSIONS]LBXZLIB.H : [.PROTO.XEXTPROTO]LBXZLIB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.LBXUTIL]LBXDELTA.OBJ : [.LIB.LIBLBXUTIL.SRC.DELTA]LBXDELTA.C, -
    $(LBXUTIL_HEADERS), $(LBXUTIL_PRIVATE_HEADERS), $(LBXUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL]LBXDELTA "$(CFLAGS)" LBXUTIL

$(OUT).LIB.LBXUTIL]LBX_ZLIB.OBJ : [.LIB.LIBLBXUTIL.SRC.LBX_ZLIB]LBX_ZLIB.C, -
    $(LBXUTIL_HEADERS), $(LBXUTIL_PRIVATE_HEADERS), $(LBXUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL]LBX_ZLIB "$(LBXUTIL_COUNT_CFLAGS)" LBXUTIL

$(OUT).LIB.LBXUTIL]LBX_ZLIB_IO.OBJ : [.LIB.LIBLBXUTIL.SRC.LBX_ZLIB]LBX_ZLIB_IO.C, -
    $(LBXUTIL_HEADERS), $(LBXUTIL_PRIVATE_HEADERS), $(LBXUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL]LBX_ZLIB_IO "$(LBXUTIL_IO_CFLAGS)" LBXUTIL

$(OUT).LIB.LBXUTIL]REQSTATS.OBJ : [.LIB.LIBLBXUTIL.SRC.LBX_ZLIB]REQSTATS.C, -
    $(LBXUTIL_HEADERS), $(LBXUTIL_PRIVATE_HEADERS), $(LBXUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL]REQSTATS "$(CFLAGS)" LBXUTIL

$(OUT).LIB.LBXUTIL]LBXUTIL.OLB : $(LBXUTIL_OBJECTS), [.VMS-SUPPORT.LIB.LBXUTIL]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(LBXUTIL_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.LBXUTIL]LBXUTIL_LIBRARY.LIS $(MMS$TARGET)
