! Complete static XFree86 ramdac library; xf86RamDacMod.c is loader-only metadata.
! Compile the upstream bit-order wrapper in its original source directory.
RAMDAC_HEADERS = $(MI_HEADERS)
RAMDAC_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]COMPILER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VERSION.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86CMAP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86PCIINFO.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86RAMDAC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86RAMDACPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86CURSOR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86CURSORPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]IBM.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]IBMPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]BT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]BTPRIV.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]TI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]TIPRIV.H
RAMDAC_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]DESCRIP.MMS
RAMDAC_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
RAMDAC_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT, -
    NO_INLINE,XORG_VERSION_CURRENT=70100000,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0, -
    IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,RAMDAC_MODULE, -
    XAAReverseBitOrder=xf86ReverseBitOrder)
RAMDAC_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDAC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDACCMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86CURSOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86HWCURS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]IBM.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]BT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]TI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86BITORDER.OBJ

RAMDAC : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]RAMDAC.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDAC.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86RAMDAC.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDAC "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDACCMAP.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86RAMDACCMAP.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDACCMAP "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86CURSOR.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86CURSOR.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86CURSOR "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86HWCURS.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86HWCURS.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86HWCURS "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]IBM.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]IBM.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]IBM "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]BT.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]BT.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]BT "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]TI.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]TI.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]TI "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86BITORDER.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.RAMDAC]XF86BITORDER.C, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.XAA]XAABITORDER.C, -
    $(RAMDAC_HEADERS), $(RAMDAC_PRIVATE_HEADERS), $(RAMDAC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86BITORDER "$(RAMDAC_CFLAGS)" RAMDAC "$(RAMDAC_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]RAMDAC.OLB : $(RAMDAC_OBJECTS), $(RAMDAC_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDAC.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86RAMDACCMAP.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86CURSOR.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86HWCURS.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]IBM.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]BT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]TI.OBJ,$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]XF86BITORDER.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.RAMDAC]RAMDAC_LIBRARY.LIS $(MMS$TARGET)
