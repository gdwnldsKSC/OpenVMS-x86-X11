! Complete ordinary static Xi library from lib/Xi/Imakefile.
XI_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]XI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XIPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XINPUT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H
XI_PRIVATE_HEADERS = [.LIB.XI]XIINT.H
XI_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XI]DESCRIP.MMS
XI_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XI_OBJECTS = $(OUT).LIB.XI]XALLOWDV.OBJ, -
    $(OUT).LIB.XI]XCHGDCTL.OBJ, -
    $(OUT).LIB.XI]XCHGFCTL.OBJ, -
    $(OUT).LIB.XI]XCHGKBD.OBJ, -
    $(OUT).LIB.XI]XCHGKMAP.OBJ, -
    $(OUT).LIB.XI]XCHGPNT.OBJ, -
    $(OUT).LIB.XI]XCHGPROP.OBJ, -
    $(OUT).LIB.XI]XCLOSEDEV.OBJ, -
    $(OUT).LIB.XI]XDEVBELL.OBJ, -
    $(OUT).LIB.XI]XEXTTOWIRE.OBJ, -
    $(OUT).LIB.XI]XGETBMAP.OBJ, -
    $(OUT).LIB.XI]XGETDCTL.OBJ, -
    $(OUT).LIB.XI]XGETFCTL.OBJ, -
    $(OUT).LIB.XI]XGETKMAP.OBJ, -
    $(OUT).LIB.XI]XGETMMAP.OBJ, -
    $(OUT).LIB.XI]XGETPROP.OBJ, -
    $(OUT).LIB.XI]XGETVERS.OBJ, -
    $(OUT).LIB.XI]XGMOTION.OBJ, -
    $(OUT).LIB.XI]XGRABDEV.OBJ, -
    $(OUT).LIB.XI]XGRDVBUT.OBJ, -
    $(OUT).LIB.XI]XGRDVKEY.OBJ, -
    $(OUT).LIB.XI]XGTFOCUS.OBJ, -
    $(OUT).LIB.XI]XGTSELECT.OBJ, -
    $(OUT).LIB.XI]XLISTDEV.OBJ, -
    $(OUT).LIB.XI]XOPENDEV.OBJ, -
    $(OUT).LIB.XI]XQUERYDV.OBJ, -
    $(OUT).LIB.XI]XSELECT.OBJ, -
    $(OUT).LIB.XI]XSETBMAP.OBJ, -
    $(OUT).LIB.XI]XSETDVAL.OBJ, -
    $(OUT).LIB.XI]XSETMMAP.OBJ, -
    $(OUT).LIB.XI]XSETMODE.OBJ, -
    $(OUT).LIB.XI]XSNDEXEV.OBJ, -
    $(OUT).LIB.XI]XSTFOCUS.OBJ, -
    $(OUT).LIB.XI]XUNGRDEV.OBJ, -
    $(OUT).LIB.XI]XUNGRDVB.OBJ, -
    $(OUT).LIB.XI]XUNGRDVK.OBJ, -
    $(OUT).LIB.XI]XEXTINT.OBJ

XI : $(OUT).LIB.XI]XI.OLB
	CONTINUE

$(OUT).LIB.XI]XALLOWDV.OBJ : [.LIB.XI]XALLOWDV.C, -
    $(XI_HEADERS), $(XI_PRIVATE_HEADERS), $(XI_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XI]XALLOWDV "$(XI_CFLAGS)" XI

$(OUT).LIB.XI]XCHGDCTL.OBJ : [.LIB.XI]XCHGDCTL.C, -
    $(XI_HEADERS), $(XI_PRIVATE_HEADERS), $(XI_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XI]XCHGDCTL "$(XI_CFLAGS)" XI

