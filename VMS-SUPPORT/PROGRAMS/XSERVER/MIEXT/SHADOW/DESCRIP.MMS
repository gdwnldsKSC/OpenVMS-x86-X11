! Complete ordinary static shadow library; loadable shmodule glue is excluded.
! Native P64 pointers and long32 match the existing framebuffer storage profile.
SHADOW_HEADERS = $(FB_HEADERS)
SHADOW_PRIVATE_HEADERS = $(FB_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHADOW.H, -
    [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROTPACK.H, -
    [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROTPACKYX.H
SHADOW_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.SHADOW]DESCRIP.MMS
SHADOW_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Upstream YX row strides use FbStride (int) for the framebuffer row difference.
SHADOW_STRIDE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
SHADOW_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

SHADOW_OBJECTS = $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHALLOC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR8.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPACKED.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROTATE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_90.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_180.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_270.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90YX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_180.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270YX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_90.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_180.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_270.OBJ

SHADOW : $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHADOW.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHALLOC.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHALLOC.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHALLOC "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHPLANAR.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR8.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHPLANAR8.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR8 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPACKED.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHPACKED.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPACKED "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROTATE.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROTATE.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROTATE "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_90.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT8PACK_90.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_90 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT8PACK.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT16PACK.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT32PACK.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_180.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT8PACK_180.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_180 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_270.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT8PACK_270.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_270 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT16PACK_90.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_180.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT16PACK_180.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_180 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90YX.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT16PACK_90YX.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90YX "$(SHADOW_STRIDE_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270YX.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT16PACK_270YX.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270YX "$(SHADOW_STRIDE_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT16PACK_270.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_90.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT32PACK_90.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_90 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_180.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT32PACK_180.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_180 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_270.OBJ : [.XSERVER.XORG-SERVER.MIEXT.SHADOW]SHROT32PACK_270.C, -
    $(SHADOW_HEADERS), $(SHADOW_PRIVATE_HEADERS), $(SHADOW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_270 "$(SHADOW_CFLAGS)" SHADOW "$(SHADOW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW.OLB : $(SHADOW_OBJECTS), $(SHADOW_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHALLOC.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPLANAR8.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHPACKED.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROTATE.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_90.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_180.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK_270.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_180.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_90.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_180.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK_270.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_90YX.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK_270YX.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT8PACK.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT16PACK.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHROT32PACK.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.SHADOW]SHADOW_LIBRARY.LIS $(MMS$TARGET)
