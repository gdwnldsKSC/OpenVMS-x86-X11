	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRBUFFRI "$(XPM_COUNT_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]CRDATFRP.OBJ : [.EXTRAS.XPM.LIB]CRDATFRP.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRDATFRP "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

