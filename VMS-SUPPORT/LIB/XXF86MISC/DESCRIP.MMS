! Complete ordinary static Xxf86misc library from lib/Xxf86misc/Imakefile.
XXF86MISC_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86MISC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86MSCSTR.H
XXF86MISC_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XXF86MISC]DESCRIP.MMS
XXF86MISC_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XXF86MISC_OBJECTS = $(OUT).LIB.XXF86MISC]XF86MISC.OBJ

XXF86MISC : $(OUT).LIB.XXF86MISC]XXF86MISC.OLB
	CONTINUE

$(OUT).LIB.XXF86MISC]XF86MISC.OBJ : [.LIB.XXF86MISC]XF86MISC.C, -
    $(XXF86MISC_HEADERS), $(XXF86MISC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XXF86MISC]XF86MISC "$(XXF86MISC_CFLAGS)" XXF86MISC

$(OUT).LIB.XXF86MISC]XXF86MISC.OLB : $(XXF86MISC_OBJECTS), $(XXF86MISC_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XXF86MISC_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XXF86MISC]XXF86MISC_LIBRARY.LIS $(MMS$TARGET)
