! Complete upstream libi2c; native bus access is supplied by the consuming OS.
XF86I2C_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.I2C]DESCRIP.MMS
XF86I2C_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.I2C]XF86I2C.OBJ

I2C : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.I2C]I2C.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.I2C]XF86I2C.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]XF86I2C.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86I2C_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.I2C]XF86I2C "$(XF86COMMON_CFLAGS)" I2C "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.I2C]I2C.OLB : $(XF86I2C_OBJECTS), $(XF86I2C_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XF86I2C_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.I2C]I2C_LIBRARY.LIS $(MMS$TARGET)
