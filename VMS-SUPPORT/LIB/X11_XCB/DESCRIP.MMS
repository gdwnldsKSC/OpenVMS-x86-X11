! Separate upstream libX11-xcb from lib/libX11/src/Makefile.am.
X11_XCB_RULES = [.VMS-SUPPORT.LIB.X11_XCB]DESCRIP.MMS, $(X11_BUILD_RULES)

X11_XCB : $(OUT).LIB.X11_XCB]X11_XCB.OLB
	CONTINUE

$(OUT).LIB.X11_XCB]X11_XCB.OBJ : [.LIB.LIBX11.SRC]X11_XCB.C, -
    [.LIB.LIBX11.SRC]XXCBINT.H, $(X11_HEADERS), $(X11_PRIVATE_HEADERS), -
    $(X11_XCB_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.X11_XCB]X11_XCB "$(X11_CFLAGS)" X11 "$(X11_CPPFLAGS)"

$(OUT).LIB.X11_XCB]X11_XCB.OLB : $(OUT).LIB.X11_XCB]X11_XCB.OBJ, -
    $(OUT).LIB.X11]X11.OLB, $(X11_XCB_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.X11_XCB]X11_XCB.OBJ
	LIBRARY/LIST=$(OUT).LIB.X11_XCB]X11_XCB_LIBRARY.LIS $(MMS$TARGET)
