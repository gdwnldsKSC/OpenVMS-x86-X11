! Complete Xvfb server profile: native P64, long32, Render, XKB and X Input.
! All server structures use the same feature layout; leaf libraries stay unchanged.
! XSERVER_CORE reuses this profile without the VFB device-dependent objects.
! Select DDX definitions in CONFIG.MMS or MMS /MACRO in a fresh build tree.
XVFB_BASE = $(OUT).PROGRAMS.XSERVER.HW.VFB
XVFB_OUT = $(XVFB_BASE).SERVER
XVFB_RULES = [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]SERVER.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]XVFB.OPT, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER]CORE.OPT
XVFB_HEADERS = $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS)

XVFB_DAMAGE_CFLAGS = /STANDARD=C99/POINTER_SIZE=64/NAMES=(UPPERCASE,SHORTENED)/PREFIX=ALL_ENTRIES/NODEBUG/WARNINGS=(ENABLE=LEVEL4)/DEFINE=(FUNCPROTO=15,PIXPRIV,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,RENDER,XKB,XINPUT) /WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XVFB_DIX_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT$(XSERVER_DIX_DEFINES))
XVFB_DIX_MAIN_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,VENDOR_STRING=""""""The X.Org Foundation"""""",VENDOR_RELEASE=70000000,""main""=VMSDIXMAIN,""CheckUserParameters""=VMSDIXCHECKUSERPARAMETERS,XKB,XINPUT$(XSERVER_DIX_DEFINES))
XVFB_FB_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT,_XOPEN_SOURCE=600)
XVFB_MI_CFLAGS = /STANDARD=C99/POINTER_SIZE=64/NAMES=(UPPERCASE,SHORTENED)/PREFIX=ALL_ENTRIES/NODEBUG/WARNINGS=(ENABLE=LEVEL4)/DEFINE=(PIXPRIV,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,_XOPEN_SOURCE=600,RENDER,XKB,XINPUT)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XVFB_MI_COUNT_CFLAGS = /STANDARD=C99/POINTER_SIZE=64/NAMES=(UPPERCASE,SHORTENED)/PREFIX=ALL_ENTRIES/NODEBUG/WARNINGS=(ENABLE=LEVEL4)/DEFINE=(PIXPRIV,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,_XOPEN_SOURCE=600,RENDER,XKB,XINPUT)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XVFB_OS_CPP_DEFINES = ""XSERV_t"",TRANS_SERVER,TCPCONN,OPEN_MAX=256,USE_RGB_TXT,XDMCP,PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT$(XSERVER_OS_DEFINES)
XVFB_OS_CPPFLAGS = /DEFINE=($(XVFB_OS_CPP_DEFINES))
! R6.9 connection.c supplies its transport role before including Xtrans.h.
XVFB_OS_CONNECTION_CPPFLAGS = /DEFINE=(TCPCONN,OPEN_MAX=256,USE_RGB_TXT,XDMCP,PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT$(XSERVER_OS_DEFINES))
XVFB_OS_TRANSPORT_CPPFLAGS = /DEFINE=($(XVFB_OS_CPP_DEFINES)$(XSERVER_TRANSPORT_DEFINES))
XVFB_RENDER_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT)
XVFB_VFB_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT)
XVFB_VFB_EXT_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,NO_MODULE_EXTS,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT)
XVFB_XINPUT_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,XINPUT,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB)
XVFB_XKB_CPPFLAGS = $(XKB_CPPFLAGS)
XVFB_XKB_INIT_CPPFLAGS = $(XKB_INIT_CPPFLAGS)
XVFB_DIX_OBJECTS = $(XVFB_OUT).DIX]ATOM.OBJ, -
    $(XVFB_OUT).DIX]COLORMAP.OBJ, -
    $(XVFB_OUT).DIX]CURSOR.OBJ, -
    $(XVFB_OUT).DIX]DEVICES.OBJ, -
