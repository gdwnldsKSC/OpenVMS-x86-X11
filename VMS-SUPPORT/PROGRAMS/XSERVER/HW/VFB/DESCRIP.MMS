! Complete ordinary static virtual-framebuffer DDx library from the upstream Imakefile.
! Native P64 pointers; malloc framebuffer, Render enabled, no SHM/MMAP/loadable hooks.
! STUBS and MIINITEXT use the unchanged Unix linked-source inputs directly.
VFB_HEADERS = $(DIX_HEADERS), -
    $(OUT).INCLUDE.X11]KEYSYM.H, -
    $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11]XWDFILE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI.H
VFB_PRIVATE_HEADERS = $(FB_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.HW.VFB]LK201KBD.H
VFB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]DESCRIP.MMS
VFB_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! The same-buffer XWD header offset is 160 bytes and is stored in a CARD32 field.
VFB_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
VFB_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)
VFB_EXT_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,NO_HW_ONLY_EXTS,NO_MODULE_EXTS,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

VFB_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.VFB]INITINPUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.VFB]INITOUTPUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.VFB]STUBS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.VFB]MIINITEXT.OBJ

VFB : $(OUT).PROGRAMS.XSERVER.HW.VFB]VFB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.VFB]INITINPUT.OBJ : [.PROGRAMS.XSERVER.HW.VFB]INITINPUT.C, -
    $(VFB_HEADERS), $(VFB_PRIVATE_HEADERS), $(VFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.VFB]INITINPUT "$(VFB_CFLAGS)" VFB "$(VFB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.VFB]INITOUTPUT.OBJ : [.PROGRAMS.XSERVER.HW.VFB]INITOUTPUT.C, -
    $(VFB_HEADERS), $(VFB_PRIVATE_HEADERS), $(VFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.VFB]INITOUTPUT "$(VFB_COUNT_CFLAGS)" VFB "$(VFB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.VFB]STUBS.OBJ : [.PROGRAMS.XSERVER.XI]STUBS.C, -
    $(VFB_HEADERS), $(VFB_PRIVATE_HEADERS), $(VFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.VFB]STUBS "$(VFB_CFLAGS)" VFB "$(VFB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.VFB]MIINITEXT.OBJ : [.PROGRAMS.XSERVER.MI]MIINITEXT.C, -
    $(VFB_HEADERS), $(VFB_PRIVATE_HEADERS), $(VFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.VFB]MIINITEXT "$(VFB_CFLAGS)" VFB "$(VFB_EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.VFB]VFB.OLB : $(VFB_OBJECTS), $(VFB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.VFB]INITINPUT.OBJ,$(OUT).PROGRAMS.XSERVER.HW.VFB]INITOUTPUT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.VFB]STUBS.OBJ,$(OUT).PROGRAMS.XSERVER.HW.VFB]MIINITEXT.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.VFB]VFB_LIBRARY.LIS $(MMS$TARGET)
