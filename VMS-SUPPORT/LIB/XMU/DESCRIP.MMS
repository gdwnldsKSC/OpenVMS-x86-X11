! Complete static XMU profile from lib/Xmu/Imakefile.
XMU_PUBLIC_HEADERS = $(OUT).INCLUDE.X11.XMU]XMU.H, -
    $(OUT).INCLUDE.X11.XMU]ATOMS.H, -
    $(OUT).INCLUDE.X11.XMU]CHARSET.H, -
    $(OUT).INCLUDE.X11.XMU]CLOSEHOOK.H, -
    $(OUT).INCLUDE.X11.XMU]CONVERTERS.H, -
    $(OUT).INCLUDE.X11.XMU]CURUTIL.H, -
    $(OUT).INCLUDE.X11.XMU]CVTCACHE.H, -
    $(OUT).INCLUDE.X11.XMU]DISPLAYQUE.H, -
    $(OUT).INCLUDE.X11.XMU]DRAWING.H, -
    $(OUT).INCLUDE.X11.XMU]EDITRES.H, -
    $(OUT).INCLUDE.X11.XMU]EDITRESP.H, -
    $(OUT).INCLUDE.X11.XMU]ERROR.H, -
    $(OUT).INCLUDE.X11.XMU]EXTAGENT.H, -
    $(OUT).INCLUDE.X11.XMU]INITER.H, -
    $(OUT).INCLUDE.X11.XMU]LOOKUP.H, -
    $(OUT).INCLUDE.X11.XMU]MISC.H, -
    $(OUT).INCLUDE.X11.XMU]STDSEL.H, -
    $(OUT).INCLUDE.X11.XMU]STDCMAP.H, -
    $(OUT).INCLUDE.X11.XMU]SYSUTIL.H, -
    $(OUT).INCLUDE.X11.XMU]WIDGETNODE.H, -
    $(OUT).INCLUDE.X11.XMU]WINUTIL.H, -
    $(OUT).INCLUDE.X11.XMU]XCT.H
XMU_HEADERS = $(XCLIENT_HEADERS), $(XMU_PUBLIC_HEADERS), -
    $(OUT).INCLUDE.X11]XATOM.H, $(OUT).INCLUDE.X11]XRESOURCE.H, -
    $(OUT).INCLUDE.X11]XLOCALE.H, $(OUT).INCLUDE.X11]XALLOCA.H, -
    $(OUT).INCLUDE.X11]KEYSYM.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11]CURSORFONT.H, $(OUT).INCLUDE.X11]XOS_R.H, -
    $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XKBLIB.H, -
    $(XKBFILE_HEADERS), $(ICE_HEADERS), $(SM_HEADERS), $(XT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H
XMU_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XMU]DESCRIP.MMS
XMU_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XMU_CPPFLAGS = /DEFINE=(HAS_SNPRINTF,TCPCONN)
! LocBitmap's path-buffer differences are bounded 32-bit allocation counts.
XMU_BITMAP_CFLAGS = $(XMU_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))/DEFINE=(BITMAPDIR=""""""./data/xbitmaps"""""")
XMU_OBJECTS = $(OUT).LIB.XMU]ALLCMAP.OBJ, -
    $(OUT).LIB.XMU]ATOMS.OBJ, -
    $(OUT).LIB.XMU]CLIENTWIN.OBJ, -
    $(OUT).LIB.XMU]CLIP.OBJ, -
    $(OUT).LIB.XMU]CLOSEHOOK.OBJ, -
    $(OUT).LIB.XMU]CMAPALLOC.OBJ, -
    $(OUT).LIB.XMU]CRCMAP.OBJ, -
    $(OUT).LIB.XMU]CRPIXFBIT.OBJ, -
    $(OUT).LIB.XMU]CURSORNAME.OBJ, -
    $(OUT).LIB.XMU]CVTCACHE.OBJ, -
    $(OUT).LIB.XMU]CVTSTDSEL.OBJ, -
    $(OUT).LIB.XMU]DEFERRMSG.OBJ, -
    $(OUT).LIB.XMU]DELCMAP.OBJ, -
    $(OUT).LIB.XMU]DISPLAYQUE.OBJ, -
    $(OUT).LIB.XMU]DISTINCT.OBJ, -
    $(OUT).LIB.XMU]DRAWLOGO.OBJ, -
    $(OUT).LIB.XMU]DRRNDRECT.OBJ, -
    $(OUT).LIB.XMU]EDITRESCOM.OBJ, -
    $(OUT).LIB.XMU]EXTAGENT.OBJ, -
    $(OUT).LIB.XMU]FTOCBACK.OBJ, -
    $(OUT).LIB.XMU]GETHOST.OBJ, -
    $(OUT).LIB.XMU]GRAYPIXMAP.OBJ, -
    $(OUT).LIB.XMU]INITER.OBJ, -
    $(OUT).LIB.XMU]LOCBITMAP.OBJ, -
    $(OUT).LIB.XMU]LOOKUP.OBJ, -
    $(OUT).LIB.XMU]LOOKUPCMAP.OBJ, -
    $(OUT).LIB.XMU]LOWER.OBJ, -
    $(OUT).LIB.XMU]RDBITF.OBJ, -
    $(OUT).LIB.XMU]SCROFWIN.OBJ, -
    $(OUT).LIB.XMU]SHAPEWIDG.OBJ, -
    $(OUT).LIB.XMU]STDCMAP.OBJ, -
    $(OUT).LIB.XMU]STRTOBS.OBJ, -
    $(OUT).LIB.XMU]STRTOBMAP.OBJ, -
    $(OUT).LIB.XMU]STRTOCURS.OBJ, -
    $(OUT).LIB.XMU]STRTOGRAV.OBJ, -
    $(OUT).LIB.XMU]STRTOJUST.OBJ, -
    $(OUT).LIB.XMU]STRTOLONG.OBJ, -
    $(OUT).LIB.XMU]STRTOORNT.OBJ, -
    $(OUT).LIB.XMU]STRTOSHAP.OBJ, -
    $(OUT).LIB.XMU]STRTOWIDG.OBJ, -
    $(OUT).LIB.XMU]UPDMAPHINT.OBJ, -
    $(OUT).LIB.XMU]VISCMAP.OBJ, -
    $(OUT).LIB.XMU]WIDGETNODE.OBJ, -
    $(OUT).LIB.XMU]XCT.OBJ

XMU : $(OUT).LIB.XMU]XMU.OLB
	CONTINUE

