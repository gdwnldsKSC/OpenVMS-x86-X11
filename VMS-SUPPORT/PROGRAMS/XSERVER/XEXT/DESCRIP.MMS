! Static ext library from the upstream Xext Makefile.am.
! Seven core objects including Generic Events.
! ScreenSaver, DPMS, XVideo/XvMC, XRes complete optional sections.
! Native P64 pointers and long32; remaining optional/loadable sections excluded.
EXT_HEADERS = $(RENDER_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPECONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMSCONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNCCONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTCONST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]GE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]GEPROTO.H, -
    $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11]XDMCP.H, -
    $(OUT).INCLUDE.X11]XPOLL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTEST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTEXT1.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]BIGREQSPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNCPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SAVER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SAVERPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XCMISCPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMSPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XV.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XVMCPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRESPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBSRV.H
EXT_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS.EXTMOD]MODINIT.H, -
    [.XSERVER.XORG-SERVER.XEXT]SLEEPUNTIL.H, -
    [.XSERVER.XORG-SERVER.XEXT]GEEXT.H, -
    [.XSERVER.XORG-SERVER.XEXT]GEINT.H, -
    [.XSERVER.XORG-SERVER.XEXT]SYNCSRV.H, -
    [.XSERVER.XORG-SERVER.XEXT]DPMSPROC.H, -
    [.XSERVER.XORG-SERVER.XEXT]XVDIX.H, -
    [.XSERVER.XORG-SERVER.XEXT]XVDISP.H, -
    [.XSERVER.XORG-SERVER.XEXT]XVMCEXT.H, -
    [.XSERVER.XORG-SERVER.OS]OSDEP.H
EXT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.LIB.XDMCP]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XEXT]DESCRIP.MMS
EXT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Expose SDK timeval/gettimeofday and select Xos.h's matching two-argument call.
! Preserve the upstream mixed-case feature names through the quoted DCL argument.
EXT_CPPFLAGS = /DEFINE=(XKB_IN_SERVER,PIXPRIV,RENDER,SHAPE,XTEST,XSYNC,BIGREQS,XCMISC,SCREENSAVER,""DPMSExtension"",XV,XVMC,""XvMCExtension"",RES,""XResExtension"",_XOPEN_SOURCE_EXTENDED=1,_XOPEN_UNIX=1,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1)

EXT_OBJECTS = $(OUT).PROGRAMS.XSERVER.XEXT]SHAPE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XTEST.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]SYNC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]SAVER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XCMISC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]DPMS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XRES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]GEEXT.OBJ

EXT : $(OUT).PROGRAMS.XSERVER.XEXT]EXT.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.XEXT]SHAPE.OBJ : [.XSERVER.XORG-SERVER.XEXT]SHAPE.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SHAPE "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"


$(OUT).PROGRAMS.XSERVER.XEXT]XTEST.OBJ : [.XSERVER.XORG-SERVER.XEXT]XTEST.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XTEST "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.OBJ : [.XSERVER.XORG-SERVER.XEXT]SLEEPUNTIL.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ.OBJ : [.XSERVER.XORG-SERVER.XEXT]BIGREQ.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]SYNC.OBJ : [.XSERVER.XORG-SERVER.XEXT]SYNC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SYNC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]SAVER.OBJ : [.XSERVER.XORG-SERVER.XEXT]SAVER.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]SAVER "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XCMISC.OBJ : [.XSERVER.XORG-SERVER.XEXT]XCMISC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XCMISC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"




$(OUT).PROGRAMS.XSERVER.XEXT]DPMS.OBJ : [.XSERVER.XORG-SERVER.XEXT]DPMS.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]DPMS "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ : [.XSERVER.XORG-SERVER.XEXT]XVMAIN.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ : [.XSERVER.XORG-SERVER.XEXT]XVDISP.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XVDISP "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ : [.XSERVER.XORG-SERVER.XEXT]XVMC.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XVMC "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XEXT]XRES.OBJ : [.XSERVER.XORG-SERVER.XEXT]XRES.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]XRES "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"





$(OUT).PROGRAMS.XSERVER.XEXT]EXT.OLB : $(EXT_OBJECTS), $(EXT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XEXT]SHAPE.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XTEST.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]SLEEPUNTIL.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]BIGREQ.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]SYNC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]SAVER.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XEXT]XCMISC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]DPMS.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ,$(OUT).PROGRAMS.XSERVER.XEXT]XRES.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XEXT]GEEXT.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XEXT]EXT_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XEXT]GEEXT.OBJ : [.XSERVER.XORG-SERVER.XEXT]GEEXT.C, -
    $(EXT_HEADERS), $(EXT_PRIVATE_HEADERS), $(EXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XEXT]GEEXT "$(EXT_CFLAGS)" EXT "$(EXT_CPPFLAGS)"
