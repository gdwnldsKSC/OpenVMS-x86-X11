! Upstream kbd driver and portable AT scan-code helper, P64/long32.
! The driver owns its key-map header; the consuming OS supplies keyboard I/O.
KBD_HEADERS = $(PCIACCESS_HEADERS), $(XF86COMMON_HEADERS), $(OUT).INCLUDE]XORG-SERVER.H
KBD_PRIVATE_HEADERS = $(XF86COMMON_PRIVATE_HEADERS), -
    [.DRIVER.XF86-INPUT-KEYBOARD.SRC]XF86OSKBD.H, -
    [.DRIVER.XF86-INPUT-KEYBOARD.SRC]XF86KEYMAP.H
KBD_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.DRIVER.XF86-INPUT-KEYBOARD]DESCRIP.MMS
KBD_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT,XKB_IN_SERVER, -
    ""XFree86LOADER"",NO_INLINE,NO_ALLOCA,OPEN_MAX=256,XORGSERVER, -
    _XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1,XORG_VERSION_CURRENT=11202000,XSERVER_LIBPCIACCESS=1, -
    GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1, -
    PACKAGE_VERSION_MAJOR=1,PACKAGE_VERSION_MINOR=6,PACKAGE_VERSION_PATCHLEVEL=1)
KBD_OBJECTS = $(OUT).DRIVER.XF86-INPUT-KEYBOARD]KBD.OBJ, -
    $(OUT).DRIVER.XF86-INPUT-KEYBOARD]AT_SCANCODE.OBJ

XF86_INPUT_KEYBOARD : $(OUT).DRIVER.XF86-INPUT-KEYBOARD]KBD_DRV.OLB
	CONTINUE

$(OUT).DRIVER.XF86-INPUT-KEYBOARD]KBD.OBJ : [.DRIVER.XF86-INPUT-KEYBOARD.SRC]KBD.C, -
    $(KBD_HEADERS), $(KBD_PRIVATE_HEADERS), $(KBD_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-INPUT-KEYBOARD]KBD "$(XF86COMMON_CFLAGS)" XF86_INPUT_KEYBOARD "$(KBD_CPPFLAGS)"

$(OUT).DRIVER.XF86-INPUT-KEYBOARD]AT_SCANCODE.OBJ : -
    [.DRIVER.XF86-INPUT-KEYBOARD.SRC]AT_SCANCODE.C, -
    $(KBD_HEADERS), $(KBD_PRIVATE_HEADERS), $(KBD_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).DRIVER.XF86-INPUT-KEYBOARD]AT_SCANCODE "$(XF86COMMON_CFLAGS)" XF86_INPUT_KEYBOARD "$(KBD_CPPFLAGS)"

$(OUT).DRIVER.XF86-INPUT-KEYBOARD]KBD_DRV.OLB : $(KBD_OBJECTS), $(KBD_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(KBD_OBJECTS)
	LIBRARY/LIST=$(OUT).DRIVER.XF86-INPUT-KEYBOARD]KBD_DRV_LIBRARY.LIS $(MMS$TARGET)
