! Complete ordinary static oldX library from lib/oldX/Imakefile.
OLDX_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]X10.H
OLDX_PRIVATE_HEADERS = [.LIB.LIBOLDX.INCLUDE.X11]X10.H
OLDX_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.OLDX]DESCRIP.MMS
OLDX_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
OLDX_OBJECTS = $(OUT).LIB.OLDX]XDRAW.OBJ, -
    $(OUT).LIB.OLDX]XCRASSOC.OBJ, -
    $(OUT).LIB.OLDX]XDELASSOC.OBJ, -
    $(OUT).LIB.OLDX]XDESTASSOC.OBJ, -
    $(OUT).LIB.OLDX]XLOOKASSOC.OBJ, -
    $(OUT).LIB.OLDX]XMAKEASSOC.OBJ

OLDX : $(OUT).LIB.OLDX]OLDX.OLB
	CONTINUE

$(OUT).LIB.OLDX]XDRAW.OBJ : [.LIB.LIBOLDX.SRC]XDRAW.C, -
    $(OLDX_HEADERS), $(OLDX_PRIVATE_HEADERS), $(OLDX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.OLDX]XDRAW "$(OLDX_CFLAGS)" OLDX

$(OUT).LIB.OLDX]XCRASSOC.OBJ : [.LIB.LIBOLDX.SRC]XCRASSOC.C, -
    $(OLDX_HEADERS), $(OLDX_PRIVATE_HEADERS), $(OLDX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.OLDX]XCRASSOC "$(OLDX_CFLAGS)" OLDX

$(OUT).LIB.OLDX]XDELASSOC.OBJ : [.LIB.LIBOLDX.SRC]XDELASSOC.C, -
    $(OLDX_HEADERS), $(OLDX_PRIVATE_HEADERS), $(OLDX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.OLDX]XDELASSOC "$(OLDX_CFLAGS)" OLDX

$(OUT).LIB.OLDX]XDESTASSOC.OBJ : [.LIB.LIBOLDX.SRC]XDESTASSOC.C, -
    $(OLDX_HEADERS), $(OLDX_PRIVATE_HEADERS), $(OLDX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.OLDX]XDESTASSOC "$(OLDX_CFLAGS)" OLDX

$(OUT).LIB.OLDX]XLOOKASSOC.OBJ : [.LIB.LIBOLDX.SRC]XLOOKASSOC.C, -
    $(OLDX_HEADERS), $(OLDX_PRIVATE_HEADERS), $(OLDX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.OLDX]XLOOKASSOC "$(OLDX_CFLAGS)" OLDX

$(OUT).LIB.OLDX]XMAKEASSOC.OBJ : [.LIB.LIBOLDX.SRC]XMAKEASSOC.C, -
    $(OLDX_HEADERS), $(OLDX_PRIVATE_HEADERS), $(OLDX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.OLDX]XMAKEASSOC "$(OLDX_CFLAGS)" OLDX

$(OUT).LIB.OLDX]OLDX.OLB : $(OLDX_OBJECTS), $(OLDX_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.OLDX]XDRAW.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.OLDX]XCRASSOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.OLDX]XDELASSOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.OLDX]XDESTASSOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.OLDX]XLOOKASSOC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.OLDX]XMAKEASSOC.OBJ
	LIBRARY/LIST=$(OUT).LIB.OLDX]OLDX_LIBRARY.LIS $(MMS$TARGET)
