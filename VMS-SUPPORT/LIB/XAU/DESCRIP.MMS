! Mirrors lib/libXau/Makefile.am's library sources and exported header.
XAU_CFLAGS = $(CFLAGS)/DEFINE=(HAVE_PATHCONF,HAVE_UNISTD_H)
XAU_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]XAUTH.H
XAU_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
              [.VMS-SUPPORT]HEADERS.MMS, -
              [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS
XAU_OBJECTS = $(OUT).LIB.XAU]AUDISPOSE.OBJ, $(OUT).LIB.XAU]AUFILENAME.OBJ, -
              $(OUT).LIB.XAU]AUGETADDR.OBJ, $(OUT).LIB.XAU]AUGETBEST.OBJ, -
              $(OUT).LIB.XAU]AULOCK.OBJ, $(OUT).LIB.XAU]AUREAD.OBJ, -
              $(OUT).LIB.XAU]AUUNLOCK.OBJ, $(OUT).LIB.XAU]AUWRITE.OBJ

XAU : $(OUT).LIB.XAU]XAU.OLB
	CONTINUE

$(OUT).INCLUDE.X11]XAUTH.H : [.LIB.LIBXAU.INCLUDE.X11]XAUTH.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XAU]AUDISPOSE.OBJ : [.LIB.LIBXAU]AUDISPOSE.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUDISPOSE "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AUFILENAME.OBJ : [.LIB.LIBXAU]AUFILENAME.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUFILENAME "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AUGETADDR.OBJ : [.LIB.LIBXAU]AUGETADDR.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUGETADDR "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AUGETBEST.OBJ : [.LIB.LIBXAU]AUGETBEST.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUGETBEST "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AULOCK.OBJ : [.LIB.LIBXAU]AULOCK.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AULOCK "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AUREAD.OBJ : [.LIB.LIBXAU]AUREAD.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUREAD "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AUUNLOCK.OBJ : [.LIB.LIBXAU]AUUNLOCK.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUUNLOCK "$(XAU_CFLAGS)"
$(OUT).LIB.XAU]AUWRITE.OBJ : [.LIB.LIBXAU]AUWRITE.C, $(XAU_HEADERS), $(XAU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUWRITE "$(XAU_CFLAGS)"

$(OUT).LIB.XAU]XAU.OLB : $(XAU_OBJECTS), [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XAU_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XAU]XAU_LIBRARY.LIS $(MMS$TARGET)
