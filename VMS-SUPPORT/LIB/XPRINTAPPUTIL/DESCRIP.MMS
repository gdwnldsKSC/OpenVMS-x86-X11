! Complete ordinary static XprintAppUtil library from lib/XprintAppUtil/Imakefile.
! Linking requires XprintUtil, Xp, and matching native 64-bit Xlib.
XPRINTAPPUTIL_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11]XAUTH.H, $(OUT).INCLUDE.X11]XRESOURCE.H, -
    $(OUT).INCLUDE.X11]INTRINSIC.H, $(OUT).INCLUDE.X11]CORE.H, -
    $(OUT).INCLUDE.X11]COMPOSITE.H, $(OUT).INCLUDE.X11]CONSTRAINT.H, -
    $(OUT).INCLUDE.X11]OBJECT.H, $(OUT).INCLUDE.X11]RECTOBJ.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRINT.H, -
    $(OUT).INCLUDE.X11.XPRINTUTIL]XPRINTUTIL.H, -
    $(OUT).INCLUDE.X11.XPRINTAPPUTIL]XPAPPUTIL.H
XPRINTAPPUTIL_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XPRINTAPPUTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XPRINTAPPUTIL]VMS_XPRINTAPPUTIL_NATIVE.H
XPRINTAPPUTIL_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XPRINTAPPUTIL_CPPFLAGS = /DEFINE=(_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1)
XPRINTAPPUTIL_OBJECTS = $(OUT).LIB.XPRINTAPPUTIL]XPAPPUTIL.OBJ

XPRINTAPPUTIL : $(OUT).LIB.XPRINTAPPUTIL]XPRINTAPPUTIL.OLB
	CONTINUE

$(OUT).LIB.XPRINTAPPUTIL]XPAPPUTIL.OBJ : [.LIB.LIBXPRINTAPPUTIL.SRC]XPAPPUTIL.C, -
    $(XPRINTAPPUTIL_HEADERS), $(XPRINTAPPUTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPRINTAPPUTIL]XPAPPUTIL "$(XPRINTAPPUTIL_CFLAGS)" XPRINTAPPUTIL "$(XPRINTAPPUTIL_CPPFLAGS)"

$(OUT).LIB.XPRINTAPPUTIL]XPRINTAPPUTIL.OLB : $(XPRINTAPPUTIL_OBJECTS), $(XPRINTAPPUTIL_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XPRINTAPPUTIL_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XPRINTAPPUTIL]XPRINTAPPUTIL_LIBRARY.LIS $(MMS$TARGET)
