$(OUT).PROGRAMS.XSERVER.MFB]MFBBLTCI.C : [.PROGRAMS.XSERVER.MFB]MFBBLT.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MFB]MFBBLTO.C : [.PROGRAMS.XSERVER.MFB]MFBBLT.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MFB]MFBBLTG.C : [.PROGRAMS.XSERVER.MFB]MFBBLT.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MFB]MFBTILEC.C : [.PROGRAMS.XSERVER.MFB]MFBTILE.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MFB]MFBTILEG.C : [.PROGRAMS.XSERVER.MFB]MFBTILE.C
