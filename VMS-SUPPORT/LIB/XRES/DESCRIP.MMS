! Complete ordinary static XRes library from lib/XRes/Imakefile.
XRES_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRES.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRESPROTO.H
XRES_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XRES]DESCRIP.MMS
XRES_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XRES_OBJECTS = $(OUT).LIB.XRES]XRES.OBJ

XRES : $(OUT).LIB.XRES]XRES.OLB
	CONTINUE

$(OUT).LIB.XRES]XRES.OBJ : [.LIB.XRES]XRES.C, -
    $(XRES_HEADERS), $(XRES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRES]XRES "$(XRES_CFLAGS)" XRES

$(OUT).LIB.XRES]XRES.OLB : $(XRES_OBJECTS), $(XRES_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XRES_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XRES]XRES_LIBRARY.LIS $(MMS$TARGET)
