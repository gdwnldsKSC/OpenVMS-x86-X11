! Internal lib/font/util section of Xfont.
FONT_UTIL_HEADERS = $(COMMON_HEADERS), $(FONT_INCLUDE_HEADERS), -
                   $(OUT).INCLUDE.X11]X.H, $(OUT).INCLUDE.X11]XMD.H, -
                   $(OUT).INCLUDE.X11]XPROTO.H, $(OUT).INCLUDE.X11]XPROTOSTR.H, -
                   $(OUT).INCLUDE.X11]XDEFS.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
                   $(OUT).INCLUDE.X11.FONTS]FS.H, -
                   $(OUT).INCLUDE.X11.FONTS]FSPROTO.H, -
                   $(OUT).INCLUDE.X11.FONTS]FONT.H, -
                   $(OUT).INCLUDE.X11.FONTS]FONTSTRUCT.H, -
                   $(OUT).INCLUDE.X11.FONTS]FONTPROTO.H, -
                   $(OUT).INCLUDE.X11.FONTS]FSMASKS.H
FONT_UTIL_PRIVATE_HEADERS = [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTMISC.H, -
                           [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTUTIL.H, -
                           [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTXLFD.H
FONT_UTIL_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS
! Preserve upstream int-sized range and XLFD string counts with P64 pointers.
FONT_UTIL_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONT_UTIL_OBJECTS = $(OUT).LIB.FONT.UTIL]UTILBITMAP.OBJ, -
                   $(OUT).LIB.FONT.UTIL]FONTNAMES.OBJ, -
                   $(OUT).LIB.FONT.UTIL]FONTUTIL.OBJ, -
                   $(OUT).LIB.FONT.UTIL]FONTXLFD.OBJ, -
                   $(OUT).LIB.FONT.UTIL]FORMAT.OBJ, -
                   $(OUT).LIB.FONT.UTIL]FONTACCEL.OBJ, -
                   $(OUT).LIB.FONT.UTIL]ATOM.OBJ, -
                   $(OUT).LIB.FONT.UTIL]MISCUTIL.OBJ, -
                   $(OUT).LIB.FONT.UTIL]PRIVATE.OBJ, -
                   $(OUT).LIB.FONT.UTIL]PATCACHE.OBJ


$(OUT).INCLUDE.X11]KEYSYMDEF.H : [.PROTO.XPROTO]KEYSYMDEF.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FS.H : [.PROTO.FONTSPROTO]FS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FSPROTO.H : [.PROTO.FONTSPROTO]FSPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FONT.H : [.PROTO.FONTSPROTO]FONT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FONTSTRUCT.H : [.PROTO.FONTSPROTO]FONTSTRUCT.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FONTPROTO.H : [.PROTO.FONTSPROTO]FONTPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FSMASKS.H : [.PROTO.FONTSPROTO]FSMASKS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.FONT.UTIL]UTILBITMAP.OBJ : [.LIB.LIBXFONT.SRC.UTIL]UTILBITMAP.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]UTILBITMAP "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]FONTNAMES.OBJ : [.LIB.LIBXFONT.SRC.UTIL]FONTNAMES.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]FONTNAMES "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]FONTUTIL.OBJ : [.LIB.LIBXFONT.SRC.UTIL]FONTUTIL.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]FONTUTIL "$(FONT_UTIL_COUNT_CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]FONTXLFD.OBJ : [.LIB.LIBXFONT.SRC.UTIL]FONTXLFD.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]FONTXLFD "$(FONT_UTIL_COUNT_CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]FORMAT.OBJ : [.LIB.LIBXFONT.SRC.UTIL]FORMAT.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]FORMAT "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]FONTACCEL.OBJ : [.LIB.LIBXFONT.SRC.UTIL]FONTACCEL.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]FONTACCEL "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]ATOM.OBJ : [.LIB.LIBXFONT.SRC.UTIL]ATOM.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]ATOM "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]MISCUTIL.OBJ : [.LIB.LIBXFONT.SRC.UTIL]MISCUTIL.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]MISCUTIL "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]PRIVATE.OBJ : [.LIB.LIBXFONT.SRC.UTIL]PRIVATE.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]PRIVATE "$(CFLAGS)" FONT_UTIL

$(OUT).LIB.FONT.UTIL]PATCACHE.OBJ : [.LIB.LIBXFONT.SRC.UTIL]PATCACHE.C, -
    $(FONT_UTIL_HEADERS), $(FONT_UTIL_PRIVATE_HEADERS), $(FONT_UTIL_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.UTIL]PATCACHE "$(CFLAGS)" FONT_UTIL
