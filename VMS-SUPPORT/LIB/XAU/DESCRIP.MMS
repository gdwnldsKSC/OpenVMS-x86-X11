! Mirrors lib/Xau/Imakefile's object and exported-header organization.
! The eight standard library modules; optional Kerberos support is not selected.
XAU_HEADERS = $(OUT).INCLUDE.X11]XAUTH.H, -
              $(OUT).INCLUDE.X11]XFUNCPROTO.H, -
              $(OUT).INCLUDE.X11]XFUNCS.H, -
              $(OUT).INCLUDE.X11]XOSDEFS.H, -
              $(OUT).INCLUDE.X11]XOS.H, -
              $(OUT).INCLUDE.X11]XARCH.H
BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
              [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS
XAU_OBJECTS = $(OUT).LIB.XAU]AUDISPOSE.OBJ, $(OUT).LIB.XAU]AUFILENAME.OBJ, -
              $(OUT).LIB.XAU]AUGETADDR.OBJ, $(OUT).LIB.XAU]AUGETBEST.OBJ, -
              $(OUT).LIB.XAU]AULOCK.OBJ, $(OUT).LIB.XAU]AUREAD.OBJ, -
              $(OUT).LIB.XAU]AUUNLOCK.OBJ, $(OUT).LIB.XAU]AUWRITE.OBJ

XAU : $(OUT).LIB.XAU]XAU.OLB
	CONTINUE

HEADERS : $(XAU_HEADERS)
	CONTINUE

$(OUT).INCLUDE.X11]XAUTH.H : [.LIB.XAU]XAUTH.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XFUNCPROTO.H : [.INCLUDE]XFUNCPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XFUNCS.H : [.INCLUDE]XFUNCS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XOSDEFS.H : [.INCLUDE]XOSDEFS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XOS.H : [.INCLUDE]XOS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XARCH.H : [.INCLUDE]XARCH.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XAU]AUDISPOSE.OBJ : [.LIB.XAU]AUDISPOSE.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUDISPOSE "$(CFLAGS)"
$(OUT).LIB.XAU]AUFILENAME.OBJ : [.LIB.XAU]AUFILENAME.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUFILENAME "$(CFLAGS)"
$(OUT).LIB.XAU]AUGETADDR.OBJ : [.LIB.XAU]AUGETADDR.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUGETADDR "$(CFLAGS)"
$(OUT).LIB.XAU]AUGETBEST.OBJ : [.LIB.XAU]AUGETBEST.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUGETBEST "$(CFLAGS)"
$(OUT).LIB.XAU]AULOCK.OBJ : [.LIB.XAU]AULOCK.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AULOCK "$(CFLAGS)"
$(OUT).LIB.XAU]AUREAD.OBJ : [.LIB.XAU]AUREAD.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUREAD "$(CFLAGS)"
$(OUT).LIB.XAU]AUUNLOCK.OBJ : [.LIB.XAU]AUUNLOCK.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUUNLOCK "$(CFLAGS)"
$(OUT).LIB.XAU]AUWRITE.OBJ : [.LIB.XAU]AUWRITE.C, $(XAU_HEADERS), $(BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XAU]AUWRITE "$(CFLAGS)"

$(OUT).LIB.XAU]XAU.OLB : $(XAU_OBJECTS), [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XAU_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XAU]XAU_LIBRARY.LIS $(MMS$TARGET)
