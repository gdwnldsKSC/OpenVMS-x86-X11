! Complete static XT profile from lib/Xt/Imakefile.
! XKB, session management, default string ABI; no shared-library or thread hooks.
XT_PUBLIC_HEADERS = $(OUT).INCLUDE.X11]COMPOSITE.H, -
    $(OUT).INCLUDE.X11]COMPOSITEP.H, -
    $(OUT).INCLUDE.X11]CONSTRAINT.H, -
    $(OUT).INCLUDE.X11]CONSTRAINP.H, -
    $(OUT).INCLUDE.X11]CORE.H, -
    $(OUT).INCLUDE.X11]COREP.H, -
    $(OUT).INCLUDE.X11]INTRINSIC.H, -
    $(OUT).INCLUDE.X11]INTRINSICP.H, -
    $(OUT).INCLUDE.X11]OBJECT.H, -
    $(OUT).INCLUDE.X11]OBJECTP.H, -
    $(OUT).INCLUDE.X11]RECTOBJ.H, -
    $(OUT).INCLUDE.X11]RECTOBJP.H, -
    $(OUT).INCLUDE.X11]SHELL.H, -
    $(OUT).INCLUDE.X11]SHELLP.H, -
    $(OUT).INCLUDE.X11]STRINGDEFS.H, -
    $(OUT).INCLUDE.X11]VENDOR.H, -
    $(OUT).INCLUDE.X11]VENDORP.H, -
    $(OUT).INCLUDE.X11]CALLBACKI.H, -
    $(OUT).INCLUDE.X11]CONVERTI.H, -
    $(OUT).INCLUDE.X11]CREATEI.H, -
    $(OUT).INCLUDE.X11]EVENTI.H, -
    $(OUT).INCLUDE.X11]HOOKOBJI.H, -
    $(OUT).INCLUDE.X11]INITIALI.H, -
    $(OUT).INCLUDE.X11]INTRINSICI.H, -
    $(OUT).INCLUDE.X11]PASSIVGRAI.H, -
    $(OUT).INCLUDE.X11]RESOURCEI.H, -
    $(OUT).INCLUDE.X11]SELECTIONI.H, -
    $(OUT).INCLUDE.X11]SHELLI.H, -
    $(OUT).INCLUDE.X11]THREADSI.H, -
    $(OUT).INCLUDE.X11]TRANSLATEI.H, -
    $(OUT).INCLUDE.X11]VARARGSI.H
XT_HEADERS = $(XCLIENT_HEADERS), $(XT_PUBLIC_HEADERS), -
    $(OUT).INCLUDE.X11]XATOM.H, $(OUT).INCLUDE.X11]XRESOURCE.H, -
    $(OUT).INCLUDE.X11]XLOCALE.H, $(OUT).INCLUDE.X11]XALLOCA.H, -
    $(OUT).INCLUDE.X11]KEYSYM.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11]CURSORFONT.H, $(OUT).INCLUDE.X11]XOS_R.H, -
    $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XKBLIB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBSTR.H, -
    $(ICE_HEADERS), $(SM_HEADERS)
XT_PRIVATE_HEADERS = [.LIB.XT]CALLBACKI.H, -
    [.LIB.XT]CONVERTI.H, -
    [.LIB.XT]CREATEI.H, -
    [.LIB.XT]EVENTI.H, -
    [.LIB.XT]HOOKOBJI.H, -
    [.LIB.XT]INITIALI.H, -
    [.LIB.XT]INTRINSICI.H, -
    [.LIB.XT]PASSIVGRAI.H, -
    [.LIB.XT]RESCONFIGP.H, -
    [.LIB.XT]RESOURCEI.H, -
    [.LIB.XT]SELECTIONI.H, -
    [.LIB.XT]SHELLI.H, -
    [.LIB.XT]THREADSI.H, -
    [.LIB.XT]TRANSLATEI.H, -
    [.LIB.XT]VARARGSI.H, -
    [.LIB.XT]XTOS.H
XT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XT]DESCRIP.MMS
XT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Upstream argument-array and string differences remain bounded 32-bit counts.
XT_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XT_CPPFLAGS = /DEFINE=(UNALIGNED,USE_SNPRINTF,LIBXT,X_NO_RESOURCE_CONFIGURATION_MANAGEMENT,X_NO_XT_POPDOWN_CONFORMANCE,XKB)
XT_ERROR_CFLAGS = $(XT_CFLAGS)/DEFINE=(ERRORDB=""""""./lib/Xt/XtErrorDB"""""")
XT_OBJECTS = $(OUT).LIB.XT]ACTIONHOOK.OBJ, -
    $(OUT).LIB.XT]ALLOC.OBJ, -
    $(OUT).LIB.XT]ARGLIST.OBJ, -
    $(OUT).LIB.XT]CALLBACK.OBJ, -
    $(OUT).LIB.XT]CLICKTIME.OBJ, -
    $(OUT).LIB.XT]COMPOSITE.OBJ, -
    $(OUT).LIB.XT]CONSTRAINT.OBJ, -
    $(OUT).LIB.XT]CONVERT.OBJ, -
    $(OUT).LIB.XT]CONVERTERS.OBJ, -
    $(OUT).LIB.XT]CORE.OBJ, -
    $(OUT).LIB.XT]CREATE.OBJ, -
    $(OUT).LIB.XT]DESTROY.OBJ, -
    $(OUT).LIB.XT]DISPLAY.OBJ, -
    $(OUT).LIB.XT]ERROR.OBJ, -
    $(OUT).LIB.XT]EVENT.OBJ, -
    $(OUT).LIB.XT]EVENTUTIL.OBJ, -
    $(OUT).LIB.XT]FUNCTIONS.OBJ, -
    $(OUT).LIB.XT]GCMANAGER.OBJ, -
    $(OUT).LIB.XT]GEOMETRY.OBJ, -
    $(OUT).LIB.XT]GETACTKEY.OBJ, -
    $(OUT).LIB.XT]GETRESLIST.OBJ, -
    $(OUT).LIB.XT]GETVALUES.OBJ, -
    $(OUT).LIB.XT]HOOKOBJ.OBJ, -
    $(OUT).LIB.XT]HOOKS.OBJ, -
    $(OUT).LIB.XT]INITIALIZE.OBJ, -
    $(OUT).LIB.XT]INTRINSIC.OBJ, -
    $(OUT).LIB.XT]KEYBOARD.OBJ, -
    $(OUT).LIB.XT]MANAGE.OBJ, -
    $(OUT).LIB.XT]NEXTEVENT.OBJ, -
    $(OUT).LIB.XT]OBJECT.OBJ, -
    $(OUT).LIB.XT]PASSIVGRAB.OBJ, -
    $(OUT).LIB.XT]POINTER.OBJ, -
    $(OUT).LIB.XT]POPUP.OBJ, -
    $(OUT).LIB.XT]POPUPCB.OBJ, -
    $(OUT).LIB.XT]RECTOBJ.OBJ, -
    $(OUT).LIB.XT]RESOURCES.OBJ, -
    $(OUT).LIB.XT]SELECTION.OBJ, -
    $(OUT).LIB.XT]SETSENS.OBJ, -
    $(OUT).LIB.XT]SETVALUES.OBJ, -
    $(OUT).LIB.XT]SETWMCW.OBJ, -
    $(OUT).LIB.XT]SHELL.OBJ, -
    $(OUT).LIB.XT]STRINGDEFS.OBJ, -
    $(OUT).LIB.XT]THREADS.OBJ, -
    $(OUT).LIB.XT]TMACTION.OBJ, -
    $(OUT).LIB.XT]TMGRAB.OBJ, -
    $(OUT).LIB.XT]TMKEY.OBJ, -
    $(OUT).LIB.XT]TMPARSE.OBJ, -
    $(OUT).LIB.XT]TMPRINT.OBJ, -
    $(OUT).LIB.XT]TMSTATE.OBJ, -
    $(OUT).LIB.XT]VARCREATE.OBJ, -
    $(OUT).LIB.XT]VARGET.OBJ, -
    $(OUT).LIB.XT]VARARGS.OBJ, -
    $(OUT).LIB.XT]VENDOR.OBJ

XT : $(OUT).LIB.XT]XT.OLB
	CONTINUE

XT_STRING_INPUTS = -
    [.LIB.XT.UTIL]STRING.LIST, [.LIB.XT.UTIL]STRDEFS.CT, -
    [.LIB.XT.UTIL]STRDEFS.HT, [.LIB.XT.UTIL]SHELL.HT, -
    $(OUT).CONFIG.UTIL]MAKESTRS.EXE, [.VMS-SUPPORT.LIB.XT]MAKE_STRINGS.COM

$(OUT).LIB.XT]STRINGDEFS.C : $(XT_STRING_INPUTS)
	@[.VMS-SUPPORT.LIB.XT]MAKE_STRINGS.COM STRINGDEFS.C

$(OUT).LIB.XT]STRINGDEFS.H : $(XT_STRING_INPUTS)
	@[.VMS-SUPPORT.LIB.XT]MAKE_STRINGS.COM STRINGDEFS.H

$(OUT).LIB.XT]SHELL.H : $(XT_STRING_INPUTS)
	@[.VMS-SUPPORT.LIB.XT]MAKE_STRINGS.COM SHELL.H

$(OUT).INCLUDE.X11]COMPOSITEP.H : [.LIB.XT]COMPOSITEP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]CONSTRAINP.H : [.LIB.XT]CONSTRAINP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]COREP.H : [.LIB.XT]COREP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]INTRINSICP.H : [.LIB.XT]INTRINSICP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]OBJECTP.H : [.LIB.XT]OBJECTP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]RECTOBJP.H : [.LIB.XT]RECTOBJP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]SHELL.H : $(OUT).LIB.XT]SHELL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]SHELLP.H : [.LIB.XT]SHELLP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]STRINGDEFS.H : $(OUT).LIB.XT]STRINGDEFS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]VENDOR.H : [.LIB.XT]VENDOR.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]VENDORP.H : [.LIB.XT]VENDORP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XT]ACTIONHOOK.OBJ : [.LIB.XT]ACTIONHOOK.C, -
    $(XT_HEADERS), $(XT_PRIVATE_HEADERS), $(XT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XT]ACTIONHOOK "$(XT_CFLAGS)" XT "$(XT_CPPFLAGS)"

