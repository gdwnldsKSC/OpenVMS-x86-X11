! Complete five-object Xmuu library from lib/Xmuu/Imakefile.
! The upstream sources are shared with Xmu and require only Xlib and the C RTL.
XMUU_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11]CURSORFONT.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11.XMU]CHARSET.H, -
    $(OUT).INCLUDE.X11.XMU]CURUTIL.H, -
    $(OUT).INCLUDE.X11.XMU]ERROR.H, -
    $(OUT).INCLUDE.X11.XMU]SYSUTIL.H, -
    $(OUT).INCLUDE.X11.XMU]WINUTIL.H
XMUU_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XMUU]DESCRIP.MMS
XMUU_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XMUU_CPPFLAGS = /DEFINE=(HAS_SNPRINTF)
XMUU_OBJECTS = $(OUT).LIB.XMUU]CLIENTWIN.OBJ, -
    $(OUT).LIB.XMUU]CURSORNAME.OBJ, -
    $(OUT).LIB.XMUU]DEFERRMSG.OBJ, -
    $(OUT).LIB.XMUU]GETHOST.OBJ, -
    $(OUT).LIB.XMUU]LOWER.OBJ

XMUU : $(OUT).LIB.XMUU]XMUU.OLB
	CONTINUE

$(OUT).LIB.XMUU]CLIENTWIN.OBJ : [.LIB.LIBXMU.SRC]CLIENTWIN.C, -
    $(XMUU_HEADERS), $(XMUU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XMUU]CLIENTWIN "$(XMUU_CFLAGS)" XMUU "$(XMUU_CPPFLAGS)"

$(OUT).LIB.XMUU]CURSORNAME.OBJ : [.LIB.LIBXMU.SRC]CURSORNAME.C, -
    $(XMUU_HEADERS), $(XMUU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XMUU]CURSORNAME "$(XMUU_CFLAGS)" XMUU "$(XMUU_CPPFLAGS)"

$(OUT).LIB.XMUU]DEFERRMSG.OBJ : [.LIB.LIBXMU.SRC]DEFERRMSG.C, -
    $(XMUU_HEADERS), $(XMUU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XMUU]DEFERRMSG "$(XMUU_CFLAGS)" XMUU "$(XMUU_CPPFLAGS)"

$(OUT).LIB.XMUU]GETHOST.OBJ : [.LIB.LIBXMU.SRC]GETHOST.C, -
    $(XMUU_HEADERS), $(XMUU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XMUU]GETHOST "$(XMUU_CFLAGS)" XMUU "$(XMUU_CPPFLAGS)"

$(OUT).LIB.XMUU]LOWER.OBJ : [.LIB.LIBXMU.SRC]LOWER.C, -
    $(XMUU_HEADERS), $(XMUU_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XMUU]LOWER "$(XMUU_CFLAGS)" XMUU "$(XMUU_CPPFLAGS)"

$(OUT).LIB.XMUU]XMUU.OLB : $(XMUU_OBJECTS), $(XMUU_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XMUU]CLIENTWIN.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XMUU]CURSORNAME.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XMUU]DEFERRMSG.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XMUU]GETHOST.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XMUU]LOWER.OBJ
	LIBRARY/LIST=$(OUT).LIB.XMUU]XMUU_LIBRARY.LIS $(MMS$TARGET)
