! Mirrors lib/font/include/Imakefile's X11/fonts header exports.
FONT_INCLUDE_HEADERS = $(OUT).INCLUDE.X11.FONTS]BITMAP.H, -
    $(OUT).INCLUDE.X11.FONTS]BUFIO.H, $(OUT).INCLUDE.X11.FONTS]FNTFIL.H, -
    $(OUT).INCLUDE.X11.FONTS]FNTFILIO.H, $(OUT).INCLUDE.X11.FONTS]FNTFILST.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTENC.H, $(OUT).INCLUDE.X11.FONTS]FONTENCC.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTMISC.H, $(OUT).INCLUDE.X11.FONTS]FONTMOD.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTSHOW.H, $(OUT).INCLUDE.X11.FONTS]FONTUTIL.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTXLFD.H

$(OUT).INCLUDE.X11.FONTS]BITMAP.H : [.LIB.FONT.INCLUDE]BITMAP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]BUFIO.H : [.LIB.FONT.INCLUDE]BUFIO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FNTFIL.H : [.LIB.FONT.INCLUDE]FNTFIL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FNTFILIO.H : [.LIB.FONT.INCLUDE]FNTFILIO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FNTFILST.H : [.LIB.FONT.INCLUDE]FNTFILST.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTENCC.H : [.LIB.FONT.INCLUDE]FONTENCC.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTMISC.H : [.LIB.FONT.INCLUDE]FONTMISC.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTMOD.H : [.LIB.FONT.INCLUDE]FONTMOD.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTSHOW.H : [.LIB.FONT.INCLUDE]FONTSHOW.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTUTIL.H : [.LIB.FONT.INCLUDE]FONTUTIL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTXLFD.H : [.LIB.FONT.INCLUDE]FONTXLFD.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
