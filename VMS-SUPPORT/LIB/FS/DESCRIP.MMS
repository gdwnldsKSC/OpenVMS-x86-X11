	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSLIBINT "$(FS_LIBINT_CFLAGS)" FS

$(OUT).LIB.FS]TRANSPORT.OBJ : [.LIB.XTRANS]TRANSPORT.C, -
    $(FS_HEADERS), $(FS_TRANSPORT_HEADERS), $(FS_TRANSPORT_SOURCES), -
    $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]TRANSPORT "$(FS_TRANSPORT_CFLAGS)" FS

$(OUT).LIB.FS]FS.OLB : $(FS_OBJECTS), [.VMS-SUPPORT.LIB.FS]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FS_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FS]FS_LIBRARY.LIS $(MMS$TARGET)
