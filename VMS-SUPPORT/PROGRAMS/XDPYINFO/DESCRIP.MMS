! Complete xdpyinfo with its mandatory core, Xext and Xtst queries.
XDPYINFO_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTEST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XINPUT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XDBE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XDBEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RECORD.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H
XDPYINFO_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XDPYINFO]DESCRIP.MMS
XDPYINFO_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT

XDPYINFO : $(OUT).PROGRAMS.XDPYINFO]XDPYINFO.EXE
	CONTINUE

$(OUT).PROGRAMS.XDPYINFO]XDPYINFO.OBJ : [.PROGRAMS.XDPYINFO]XDPYINFO.C, -
    $(XDPYINFO_HEADERS), $(XDPYINFO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XDPYINFO]XDPYINFO "$(XDPYINFO_CFLAGS)" XDPYINFO

$(OUT).PROGRAMS.XDPYINFO]XDPYINFO.EXE : $(OUT).PROGRAMS.XDPYINFO]XDPYINFO.OBJ, -
    $(OUT).LIB.XTST]XTST.OLB, $(OUT).LIB.XEXT]XEXT.OLB, -
    $(OUT).LIB.X11]X11.OLB, [.VMS-SUPPORT.PROGRAMS.XDPYINFO]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XDPYINFO]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XDPYINFO]LINK.COM
