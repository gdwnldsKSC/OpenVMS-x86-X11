! Complete static xkbfile library from lib/xkbfile/Imakefile.
XKBFILE_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]X.H, -
    $(OUT).INCLUDE.X11]XMD.H, $(OUT).INCLUDE.X11]XPROTO.H, -
    $(OUT).INCLUDE.X11]XPROTOSTR.H, $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11]KEYSYM.H, $(OUT).INCLUDE.X11]KEYSYMDEF.H, -
    $(OUT).INCLUDE.X11]XOS_R.H, $(OUT).INCLUDE.X11]XLIB.H, -
    $(OUT).INCLUDE.X11]XKBLIB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKB.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBGEOM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBFILE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKM.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKMFORMAT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBRULES.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBCONFIG.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XKBBELLS.H
XKBFILE_PRIVATE_HEADERS = [.LIB.LIBXKBFILE.SRC]XKBFILEINT.H, -
    [.LIB.LIBXKBFILE.INCLUDE.X11.EXTENSIONS]XKBFILE.H, [.LIB.LIBXKBFILE.INCLUDE.X11.EXTENSIONS]XKM.H, -
    [.LIB.LIBXKBFILE.INCLUDE.X11.EXTENSIONS]XKMFORMAT.H, [.LIB.LIBXKBFILE.INCLUDE.X11.EXTENSIONS]XKBRULES.H, -
    [.LIB.LIBXKBFILE.INCLUDE.X11.EXTENSIONS]XKBCONFIG.H, [.LIB.LIBXKBFILE.INCLUDE.X11.EXTENSIONS]XKBBELLS.H
XKBFILE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XKBFILE]DESCRIP.MMS
XKBFILE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Array indices and buffer lengths retain upstream's int-sized count model.
XKBFILE_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XKBFILE_OBJECTS = $(OUT).LIB.XKBFILE]XKBTEXT.OBJ, -
    $(OUT).LIB.XKBFILE]XKBDRAW.OBJ, -
    $(OUT).LIB.XKBFILE]XKBMISC.OBJ, -
    $(OUT).LIB.XKBFILE]XKBATOM.OBJ, -
    $(OUT).LIB.XKBFILE]XKBERRS.OBJ, -
    $(OUT).LIB.XKBFILE]COUT.OBJ, -
    $(OUT).LIB.XKBFILE]XKBOUT.OBJ, -
    $(OUT).LIB.XKBFILE]XKMOUT.OBJ, -
    $(OUT).LIB.XKBFILE]XKMREAD.OBJ, -
    $(OUT).LIB.XKBFILE]SRVMISC.OBJ, -
    $(OUT).LIB.XKBFILE]XKBCONFIG.OBJ, -
    $(OUT).LIB.XKBFILE]XKBBELLS.OBJ, -
    $(OUT).LIB.XKBFILE]MAPRULES.OBJ

XKBFILE : $(OUT).LIB.XKBFILE]XKBFILE.OLB
	CONTINUE

$(OUT).LIB.XKBFILE]XKBTEXT.OBJ : [.LIB.LIBXKBFILE.SRC]XKBTEXT.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBTEXT "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBDRAW.OBJ : [.LIB.LIBXKBFILE.SRC]XKBDRAW.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBDRAW "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBMISC.OBJ : [.LIB.LIBXKBFILE.SRC]XKBMISC.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBMISC "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBATOM.OBJ : [.LIB.LIBXKBFILE.SRC]XKBATOM.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBATOM "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBERRS.OBJ : [.LIB.LIBXKBFILE.SRC]XKBERRS.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBERRS "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]COUT.OBJ : [.LIB.LIBXKBFILE.SRC]COUT.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]COUT "$(XKBFILE_COUNT_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBOUT.OBJ : [.LIB.LIBXKBFILE.SRC]XKBOUT.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBOUT "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKMOUT.OBJ : [.LIB.LIBXKBFILE.SRC]XKMOUT.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKMOUT "$(XKBFILE_COUNT_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKMREAD.OBJ : [.LIB.LIBXKBFILE.SRC]XKMREAD.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKMREAD "$(XKBFILE_COUNT_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]SRVMISC.OBJ : [.LIB.LIBXKBFILE.SRC]SRVMISC.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]SRVMISC "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBCONFIG.OBJ : [.LIB.LIBXKBFILE.SRC]XKBCONFIG.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBCONFIG "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBBELLS.OBJ : [.LIB.LIBXKBFILE.SRC]XKBBELLS.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]XKBBELLS "$(XKBFILE_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]MAPRULES.OBJ : [.LIB.LIBXKBFILE.SRC]MAPRULES.C, -
    $(XKBFILE_HEADERS), $(XKBFILE_PRIVATE_HEADERS), $(XKBFILE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XKBFILE]MAPRULES "$(XKBFILE_COUNT_CFLAGS)" XKBFILE

$(OUT).LIB.XKBFILE]XKBFILE.OLB : $(XKBFILE_OBJECTS), $(XKBFILE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBTEXT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBDRAW.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBMISC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBATOM.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBERRS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]COUT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBOUT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKMOUT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKMREAD.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]SRVMISC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBCONFIG.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]XKBBELLS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XKBFILE]MAPRULES.OBJ
	LIBRARY/LIST=$(OUT).LIB.XKBFILE]XKBFILE_LIBRARY.LIS $(MMS$TARGET)
