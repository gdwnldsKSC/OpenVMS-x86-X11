! nls/Imakefile static-locale data profile, matching its default R63Compat.
NLS :: NLS_XLC_LOCALE, NLS_COMPOSE, $(OUT).NLS]LOCALE.ALIAS, -
    $(OUT).NLS]LOCALE.DIR, $(OUT).NLS]COMPOSE.DIR
	CONTINUE

NLS_XLC_LOCALE :: $(OUT).NLS]NLSFILTER.EXE, [.VMS-SUPPORT.NLS]GENERATE_SET.COM, -
    [.VMS-SUPPORT.NLS]GENERATE.COM, [.VMS-SUPPORT.NLS]XLC_LOCALE.LIST, -
    [.NLS.XLC_LOCALE]C., -
    [.NLS.XLC_LOCALE]ARMSCII-8., -
    [.NLS.XLC_LOCALE]EN_US.UTF-8, -
    [.NLS.XLC_LOCALE]GEORGIAN-ACADEMY., -
    [.NLS.XLC_LOCALE]GEORGIAN-PS., -
    [.NLS.XLC_LOCALE]IBM-CP1133., -
    [.NLS.XLC_LOCALE]ISCII-DEV., -
    [.NLS.XLC_LOCALE]ISIRI-3342., -
    [.NLS.XLC_LOCALE]ISO8859-1., -
    [.NLS.XLC_LOCALE]ISO8859-2., -
    [.NLS.XLC_LOCALE]ISO8859-3., -
    [.NLS.XLC_LOCALE]ISO8859-4., -
    [.NLS.XLC_LOCALE]ISO8859-5., -
    [.NLS.XLC_LOCALE]ISO8859-6., -
    [.NLS.XLC_LOCALE]ISO8859-7., -
    [.NLS.XLC_LOCALE]ISO8859-8., -
    [.NLS.XLC_LOCALE]ISO8859-9., -
    [.NLS.XLC_LOCALE]ISO8859-10., -
    [.NLS.XLC_LOCALE]ISO8859-11., -
    [.NLS.XLC_LOCALE]ISO8859-13., -
    [.NLS.XLC_LOCALE]ISO8859-14., -
    [.NLS.XLC_LOCALE]ISO8859-15., -
    [.NLS.XLC_LOCALE]ISO8859-9E., -
    [.NLS.XLC_LOCALE]JA., -
    [.NLS.XLC_LOCALE]JA.JIS, -
    [.NLS.XLC_LOCALE]JA.SJIS, -
    [.NLS.XLC_LOCALE]JA_JP.UTF-8, -
    [.NLS.XLC_LOCALE]KO., -
    [.NLS.XLC_LOCALE]KO_KR.UTF-8, -
    [.NLS.XLC_LOCALE]KOI8-R., -
    [.NLS.XLC_LOCALE]KOI8-U., -
    [.NLS.XLC_LOCALE]KOI8-C., -
    [.NLS.XLC_LOCALE]MICROSOFT-CP1251., -
    [.NLS.XLC_LOCALE]MICROSOFT-CP1255., -
    [.NLS.XLC_LOCALE]MICROSOFT-CP1256., -
    [.NLS.XLC_LOCALE]MULELAO-1., -
    [.NLS.XLC_LOCALE]NOKHCHI-1., -
    [.NLS.XLC_LOCALE]PT_BR.UTF-8, -
    [.NLS.XLC_LOCALE]TATAR-CYR., -
    [.NLS.XLC_LOCALE]TH_TH., -
    [.NLS.XLC_LOCALE]TH_TH.UTF-8, -
    [.NLS.XLC_LOCALE]TSCII-0., -
    [.NLS.XLC_LOCALE]VI_VN.TCVN, -
    [.NLS.XLC_LOCALE]VI_VN.VISCII, -
    [.NLS.XLC_LOCALE]ZH_CN., -
    [.NLS.XLC_LOCALE]ZH_CN.GBK, -
    [.NLS.XLC_LOCALE]ZH_CN.UTF-8, -
    [.NLS.XLC_LOCALE]ZH_HK.BIG5, -
    [.NLS.XLC_LOCALE]ZH_HK.BIG5HKSCS, -
    [.NLS.XLC_LOCALE]ZH_TW., -
    [.NLS.XLC_LOCALE]ZH_TW.BIG5, -
    [.NLS.XLC_LOCALE]ZH_TW.UTF-8
	@[.VMS-SUPPORT.NLS]GENERATE_SET.COM XLC_LOCALE "$(OUT).NLS]"

NLS_COMPOSE :: $(OUT).NLS]NLSFILTER.EXE, [.VMS-SUPPORT.NLS]GENERATE_SET.COM, -
    [.VMS-SUPPORT.NLS]GENERATE.COM, [.VMS-SUPPORT.NLS]COMPOSE.LIST, -
    [.NLS.COMPOSE]ARMSCII-8., -
    [.NLS.COMPOSE]EL_GR.UTF-8, -
    [.NLS.COMPOSE]EN_US.UTF-8, -
    [.NLS.COMPOSE]GEORGIAN-ACADEMY., -
    [.NLS.COMPOSE]GEORGIAN-PS., -
    [.NLS.COMPOSE]IBM-CP1133., -
    [.NLS.COMPOSE]ISO8859-1., -
    [.NLS.COMPOSE]ISO8859-2., -
    [.NLS.COMPOSE]ISO8859-3., -
    [.NLS.COMPOSE]ISO8859-4., -
    [.NLS.COMPOSE]ISO8859-5., -
    [.NLS.COMPOSE]ISO8859-6., -
    [.NLS.COMPOSE]ISO8859-7., -
    [.NLS.COMPOSE]ISO8859-8., -
    [.NLS.COMPOSE]ISO8859-9., -
    [.NLS.COMPOSE]ISO8859-10., -
    [.NLS.COMPOSE]ISO8859-13., -
    [.NLS.COMPOSE]ISO8859-14., -
    [.NLS.COMPOSE]ISO8859-15., -
    [.NLS.COMPOSE]ISO8859-9E., -
    [.NLS.COMPOSE]JA., -
    [.NLS.COMPOSE]JA.JIS, -
    [.NLS.COMPOSE]JA.SJIS, -
    [.NLS.COMPOSE]KO., -
    [.NLS.COMPOSE]KOI8-R., -
    [.NLS.COMPOSE]KOI8-U., -
    [.NLS.COMPOSE]KOI8-C., -
    [.NLS.COMPOSE]MULELAO-1., -
    [.NLS.COMPOSE]PT_BR.UTF-8, -
    [.NLS.COMPOSE]VI_VN.TCVN, -
    [.NLS.COMPOSE]VI_VN.VISCII, -
    [.NLS.COMPOSE]ZH_CN., -
    [.NLS.COMPOSE]ZH_CN.GBK, -
    [.NLS.COMPOSE]ZH_TW., -
    [.NLS.COMPOSE]ZH_TW.BIG5
	@[.VMS-SUPPORT.NLS]GENERATE_SET.COM COMPOSE "$(OUT).NLS]"

$(OUT).NLS]LOCALE.ALIAS : [.NLS]LOCALE.ALIAS, [.VMS-SUPPORT.NLS]GENERATE.COM, $(OUT).NLS]NLSFILTER.EXE
	@[.VMS-SUPPORT.NLS]GENERATE.COM [.NLS]LOCALE.ALIAS $(OUT).NLS]LOCALE.ALIAS "" "R63"

$(OUT).NLS]LOCALE.DIR : [.NLS]LOCALE.DIR, [.VMS-SUPPORT.NLS]GENERATE.COM, $(OUT).NLS]NLSFILTER.EXE
	@[.VMS-SUPPORT.NLS]GENERATE.COM [.NLS]LOCALE.DIR $(OUT).NLS]LOCALE.DIR "" "R63"

$(OUT).NLS]COMPOSE.DIR : [.NLS]COMPOSE.DIR, [.VMS-SUPPORT.NLS]GENERATE.COM, $(OUT).NLS]NLSFILTER.EXE
	@[.VMS-SUPPORT.NLS]GENERATE.COM [.NLS]COMPOSE.DIR $(OUT).NLS]COMPOSE.DIR "" "R63"

$(OUT).NLS]NLSFILTER.OBJ : [.VMS-SUPPORT.NLS]FILTER.C, [.VMS-SUPPORT]COMPILE.COM, [.VMS-SUPPORT.NLS]DESCRIP.MMS
	@[.VMS-SUPPORT]COMPILE.COM [.VMS-SUPPORT.NLS]FILTER.C $(OUT).NLS]NLSFILTER -
        "$(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT" RTL

$(OUT).NLS]NLSFILTER.EXE : $(OUT).NLS]NLSFILTER.OBJ, [.VMS-SUPPORT.NLS]LINK_FILTER.COM
	@[.VMS-SUPPORT.NLS]LINK_FILTER.COM
