! Complete ordinary static X Input library from upstream Makefile.am.
! Device-dependent stubs are supplied separately by the DDX.
XINPUT_HEADERS = $(DIX_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]XI.H
XINPUT_PRIVATE_HEADERS = [.XSERVER.XORG-SERVER.XI]XIBARRIERS.H, -
    $(DIX_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.INCLUDE]DIXEVENTS.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]DIXGRABS.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]EXEVENTS.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]EXTINIT.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]XISTUBS.H, -
    [.XSERVER.XORG-SERVER.XI]ALLOWEV.H, -
    [.XSERVER.XORG-SERVER.XI]CHGDCTL.H, -
    [.XSERVER.XORG-SERVER.XI]CHGFCTL.H, -
    [.XSERVER.XORG-SERVER.XI]CHGKBD.H, -
    [.XSERVER.XORG-SERVER.XI]CHGKMAP.H, -
    [.XSERVER.XORG-SERVER.XI]CHGPROP.H, -
    [.XSERVER.XORG-SERVER.XI]CHGPTR.H, -
    [.XSERVER.XORG-SERVER.XI]CLOSEDEV.H, -
    [.XSERVER.XORG-SERVER.XI]DEVBELL.H, -
    [.XSERVER.XORG-SERVER.XI]EXGLOBALS.H, -
    [.XSERVER.XORG-SERVER.XI]GETBMAP.H, -
    [.XSERVER.XORG-SERVER.XI]GETDCTL.H, -
    [.XSERVER.XORG-SERVER.XI]GETFCTL.H, -
    [.XSERVER.XORG-SERVER.XI]GETFOCUS.H, -
    [.XSERVER.XORG-SERVER.XI]GETKMAP.H, -
    [.XSERVER.XORG-SERVER.XI]GETMMAP.H, -
    [.XSERVER.XORG-SERVER.XI]GETPROP.H, -
    [.XSERVER.XORG-SERVER.XI]GETSELEV.H, -
    [.XSERVER.XORG-SERVER.XI]GETVERS.H, -
    [.XSERVER.XORG-SERVER.XI]GRABDEV.H, -
    [.XSERVER.XORG-SERVER.XI]GRABDEVB.H, -
    [.XSERVER.XORG-SERVER.XI]GRABDEVK.H, -
    [.XSERVER.XORG-SERVER.XI]GTMOTION.H, -
    [.XSERVER.XORG-SERVER.XI]LISTDEV.H, -
    [.XSERVER.XORG-SERVER.XI]OPENDEV.H, -
    [.XSERVER.XORG-SERVER.XI]QUERYST.H, -
    [.XSERVER.XORG-SERVER.XI]SELECTEV.H, -
    [.XSERVER.XORG-SERVER.XI]SENDEXEV.H, -
    [.XSERVER.XORG-SERVER.XI]SETBMAP.H, -
    [.XSERVER.XORG-SERVER.XI]SETDVAL.H, -
    [.XSERVER.XORG-SERVER.XI]SETFOCUS.H, -
    [.XSERVER.XORG-SERVER.XI]SETMMAP.H, -
    [.XSERVER.XORG-SERVER.XI]SETMODE.H, -
    [.XSERVER.XORG-SERVER.XI]UNGRDEV.H, -
    [.XSERVER.XORG-SERVER.XI]UNGRDEVB.H, -
    [.XSERVER.XORG-SERVER.XI]UNGRDEVK.H, -
    [.XSERVER.XORG-SERVER.XI]XIALLOWEV.H, -
    [.XSERVER.XORG-SERVER.XI]XICHANGECURSOR.H, -
    [.XSERVER.XORG-SERVER.XI]XICHANGEHIERARCHY.H, -
    [.XSERVER.XORG-SERVER.XI]XIGETCLIENTPOINTER.H, -
    [.XSERVER.XORG-SERVER.XI]XIGRABDEV.H, -
    [.XSERVER.XORG-SERVER.XI]XIPASSIVEGRAB.H, -
    [.XSERVER.XORG-SERVER.XI]XIPROPERTY.H, -
    [.XSERVER.XORG-SERVER.XI]XIQUERYDEVICE.H, -
    [.XSERVER.XORG-SERVER.XI]XIQUERYPOINTER.H, -
    [.XSERVER.XORG-SERVER.XI]XIQUERYVERSION.H, -
    [.XSERVER.XORG-SERVER.XI]XISELECTEV.H, -
    [.XSERVER.XORG-SERVER.XI]XISETCLIENTPOINTER.H, -
    [.XSERVER.XORG-SERVER.XI]XISETDEVFOCUS.H, -
    [.XSERVER.XORG-SERVER.XI]XIWARPPOINTER.H
XINPUT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XI]DESCRIP.MMS
XINPUT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XINPUT_INIT_CFLAGS = $(XINPUT_CFLAGS)/UNDEFINE=__HIDE_FORBIDDEN_NAMES
XINPUT_CPPFLAGS = /DEFINE=($(XSERVER_CRTL_DEFINES),XKB_IN_SERVER,PIXPRIV,RENDER,XINPUT,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1)

XINPUT_OBJECTS = $(OUT).PROGRAMS.XSERVER.XI]ALLOWEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CHGKBD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CHGDCTL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CHGFCTL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CHGKMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CHGPROP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CHGPTR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]CLOSEDEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]DEVBELL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]EXEVENTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]EXTINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETDCTL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETFCTL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETFOCUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETBMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETKMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETMMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETPROP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETSELEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GETVERS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GTMOTION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GRABDEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GRABDEVB.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]GRABDEVK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]LISTDEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]OPENDEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]QUERYST.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SELECTEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SENDEXEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SETDVAL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SETFOCUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SETMODE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SETBMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]SETMMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]UNGRDEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]UNGRDEVB.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]UNGRDEVK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIALLOWEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XICHANGECURSOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XICHANGEHIERARCHY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIGETCLIENTPOINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIGRABDEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIPASSIVEGRAB.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIPROPERTY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIQUERYDEVICE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIQUERYPOINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIQUERYVERSION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XISELECTEV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XISETCLIENTPOINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XISETDEVFOCUS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIWARPPOINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XI]XIBARRIERS.OBJ

XINPUT : $(OUT).PROGRAMS.XSERVER.XI]XINPUT.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.XI]ALLOWEV.OBJ : [.XSERVER.XORG-SERVER.XI]ALLOWEV.C, -
    $(XINPUT_HEADERS), $(XINPUT_PRIVATE_HEADERS), $(XINPUT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XI]ALLOWEV "$(XINPUT_CFLAGS)" XINPUT "$(XINPUT_CPPFLAGS)"

