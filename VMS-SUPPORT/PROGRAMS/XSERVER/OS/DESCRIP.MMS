! Ordinary upstream os library with TCP, XDMCP, MIT cookies and text RGB.
OS_HEADERS = $(RENDER_HEADERS), $(XAU_HEADERS), $(XDMCP_HEADERS), -
    $(OUT).INCLUDE.X11]XTRANS.H, $(OUT).INCLUDE.X11]XPOLL.H, -
    $(OUT).INCLUDE.X11]XOS_R.H
OS_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), [.PROGRAMS.XSERVER.OS]OSDEP.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SITE.H, [.LIB.XTRANS]XTRANS.H, -
    [.LIB.XTRANS]XTRANSINT.H
OS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.OS]DESCRIP.MMS
! Xfuncs replaces equivalent RTL bcopy/bzero macros in the socket namespace.
OS_CFLAGS = $(CFLAGS)/STANDARD=RELAXED_ANSI89/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF))
! Same-buffer differences retain the upstream int/size_t count limits.
OS_COUNT_CFLAGS = $(CFLAGS)/STANDARD=RELAXED_ANSI89/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF,MAYLOSEDATA3))
! Native P64 iovec layouts agree; the RTL uses its separate __iovec64 tag.
OS_TRANSPORT_CFLAGS = $(CFLAGS)/STANDARD=RELAXED_ANSI89/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF,PTRMISMATCH))
OS_CPPFLAGS = /DEFINE=(""XSERV_t"",TRANS_SERVER,TCPCONN,OPEN_MAX=256,USE_RGB_TXT,XDMCP, -
    PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

OS_OBJECTS = $(OUT).PROGRAMS.XSERVER.OS]WAITFOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]ACCESS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]CONNECTION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]IO.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]OSCOLOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]OSINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]UTILS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]LOG.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]AUTH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]MITAUTH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]SECAUTH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]XDMCP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]TRANSPORT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]STRLCAT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]STRLCPY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS.OBJ

OS : $(OUT).PROGRAMS.XSERVER.OS]OS.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.OS]WAITFOR.OBJ : [.PROGRAMS.XSERVER.OS]WAITFOR.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]WAITFOR "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]ACCESS.OBJ : [.PROGRAMS.XSERVER.OS]ACCESS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]ACCESS "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]CONNECTION.OBJ : [.PROGRAMS.XSERVER.OS]CONNECTION.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]CONNECTION "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]IO.OBJ : [.PROGRAMS.XSERVER.OS]IO.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]IO "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OSCOLOR.OBJ : [.PROGRAMS.XSERVER.OS]OSCOLOR.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]OSCOLOR "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OSINIT.OBJ : [.PROGRAMS.XSERVER.OS]OSINIT.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]OSINIT "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]UTILS.OBJ : [.PROGRAMS.XSERVER.OS]UTILS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]UTILS "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]LOG.OBJ : [.PROGRAMS.XSERVER.OS]LOG.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]LOG "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]AUTH.OBJ : [.PROGRAMS.XSERVER.OS]AUTH.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]AUTH "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]MITAUTH.OBJ : [.PROGRAMS.XSERVER.OS]MITAUTH.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]MITAUTH "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]SECAUTH.OBJ : [.PROGRAMS.XSERVER.OS]SECAUTH.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]SECAUTH "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]XDMCP.OBJ : [.PROGRAMS.XSERVER.OS]XDMCP.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]XDMCP "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]TRANSPORT.OBJ : [.LIB.XTRANS]TRANSPORT.C, -
    [.LIB.XTRANS]XTRANSSOCK.C, [.LIB.XTRANS]XTRANS.C, [.LIB.XTRANS]XTRANSUTIL.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]TRANSPORT "$(OS_TRANSPORT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]STRLCAT.OBJ : [.LIB.MISC]STRLCAT.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]STRLCAT "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]STRLCPY.OBJ : [.LIB.MISC]STRLCPY.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]STRLCPY "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS.OBJ : [.VMS-SUPPORT.PROGRAMS.XSERVER.OS]VMS_PROCESS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL), SYS$LIBRARY:SYS$STARLET_C.TLB
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OS.OLB : $(OS_OBJECTS), $(OS_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]WAITFOR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]ACCESS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]CONNECTION.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]IO.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]OSCOLOR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]OSINIT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]UTILS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]LOG.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]AUTH.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]MITAUTH.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]SECAUTH.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]XDMCP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]TRANSPORT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]STRLCAT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]STRLCPY.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.OS]OS_LIBRARY.LIS $(MMS$TARGET)
