! Portable OS-support subset of upstream libstub; native services stay external.
STUB_HEADERS = $(XF86COMMON_HEADERS)
STUB_PRIVATE_HEADERS = $(XF86COMMON_PRIVATE_HEADERS)
STUB_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]DESCRIP.MMS
STUB_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]VIDMEM.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]VTSW_NOOP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB_BELL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]PM_NOOP.OBJ

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]PM_NOOP.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.SHARED]PM_NOOP.C, -
    $(STUB_HEADERS), $(STUB_PRIVATE_HEADERS), $(STUB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]PM_NOOP "$(XF86COMMON_CFLAGS)" STUB "$(XF86COMMON_CPPFLAGS)"

STUB : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]VIDMEM.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.SHARED]VIDMEM.C, -
    $(STUB_HEADERS), $(STUB_PRIVATE_HEADERS), $(STUB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]VIDMEM "$(XF86COMMON_CFLAGS)" STUB "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]VTSW_NOOP.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.SHARED]VTSW_NOOP.C, -
    $(STUB_HEADERS), $(STUB_PRIVATE_HEADERS), $(STUB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]VTSW_NOOP "$(XF86COMMON_CFLAGS)" STUB "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB_BELL.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB_BELL.C, -
    $(STUB_HEADERS), $(STUB_PRIVATE_HEADERS), $(STUB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB_BELL "$(XF86COMMON_CFLAGS)" STUB "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB.OLB : $(STUB_OBJECTS), $(STUB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(STUB_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.STUB]STUB_LIBRARY.LIS $(MMS$TARGET)
