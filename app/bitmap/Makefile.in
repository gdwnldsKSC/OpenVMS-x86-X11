         BitEdit.c \
         CutPaste.c \
         Graphics.c \
         ReqMach.c \
         Bitmap.c \
         Dialog.c \
         Handlers.c \
         Bitmap.h \
         BitmapP.h \
         Dialog.h \
         Requests.h



