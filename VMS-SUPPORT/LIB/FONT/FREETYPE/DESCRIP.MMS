! Complete static lib/font/FreeType/Imakefile section of Xfont.
! Use the existing bundled FreeType2 library without loadable-server hooks.
FONT_FREETYPE_HEADERS = $(FONT_UTIL_HEADERS), $(FONTENC_HEADERS), -
    $(FREETYPE2_HEADERS)
FONT_FREETYPE_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
    [.LIB.FONT.INCLUDE]FONTUTIL.H, -
    [.LIB.FONT.INCLUDE]FONTXLFD.H, -
    [.LIB.FONT.INCLUDE]FNTFILST.H, -
    [.LIB.FONT.INCLUDE]FNTFIL.H, -
    [.LIB.FONT.FREETYPE]FT.H, -
    [.LIB.FONT.FREETYPE]FTFUNCS.H, -
    [.LIB.FONT.FREETYPE]XTTCAP.H
FONT_FREETYPE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, -
    [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.LIB.FONT]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONT.UTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FREETYPE2]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.FONT.FREETYPE]DESCRIP.MMS
FONT_FREETYPE_CFLAGS = $(CFLAGS)
! Preserve upstream int-sized substring, atom, glyph, and metric counts.
FONT_FREETYPE_COUNT_CFLAGS = $(FONT_FREETYPE_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONT_FREETYPE_CPPFLAGS = /DEFINE=(XFREE86_FT2,NEED_STRCASECMP)
FONT_FREETYPE_OBJECTS = $(OUT).LIB.FONT.FREETYPE]XTTCAP.OBJ, -
    $(OUT).LIB.FONT.FREETYPE]FTFUNCS.OBJ, -
    $(OUT).LIB.FONT.FREETYPE]FTENC.OBJ, -
    $(OUT).LIB.FONT.FREETYPE]FTTOOLS.OBJ

$(OUT).LIB.FONT.FREETYPE]XTTCAP.OBJ : [.LIB.FONT.FREETYPE]XTTCAP.C, -
    $(FONT_FREETYPE_HEADERS), $(FONT_FREETYPE_PRIVATE_HEADERS), -
    $(FONT_FREETYPE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FREETYPE]XTTCAP "$(FONT_FREETYPE_COUNT_CFLAGS)" FONT_FREETYPE "$(FONT_FREETYPE_CPPFLAGS)"

$(OUT).LIB.FONT.FREETYPE]FTFUNCS.OBJ : [.LIB.FONT.FREETYPE]FTFUNCS.C, -
    $(FONT_FREETYPE_HEADERS), $(FONT_FREETYPE_PRIVATE_HEADERS), -
    $(FONT_FREETYPE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FREETYPE]FTFUNCS "$(FONT_FREETYPE_COUNT_CFLAGS)" FONT_FREETYPE "$(FONT_FREETYPE_CPPFLAGS)"

$(OUT).LIB.FONT.FREETYPE]FTENC.OBJ : [.LIB.FONT.FREETYPE]FTENC.C, -
    $(FONT_FREETYPE_HEADERS), $(FONT_FREETYPE_PRIVATE_HEADERS), -
    $(FONT_FREETYPE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FREETYPE]FTENC "$(FONT_FREETYPE_CFLAGS)" FONT_FREETYPE "$(FONT_FREETYPE_CPPFLAGS)"

$(OUT).LIB.FONT.FREETYPE]FTTOOLS.OBJ : [.LIB.FONT.FREETYPE]FTTOOLS.C, -
    $(FONT_FREETYPE_HEADERS), $(FONT_FREETYPE_PRIVATE_HEADERS), -
    $(FONT_FREETYPE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.FREETYPE]FTTOOLS "$(FONT_FREETYPE_CFLAGS)" FONT_FREETYPE "$(FONT_FREETYPE_CPPFLAGS)"
