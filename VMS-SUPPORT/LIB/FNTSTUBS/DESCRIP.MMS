! Complete lib/font/stubs/Imakefile fntstubs library for standalone font tools.
FNTSTUBS_HEADERS = $(FONT_UTIL_HEADERS)
FNTSTUBS_PRIVATE_HEADERS = [.LIB.LIBXFONT.SRC.STUBS]STUBS.H, -
                           [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTMISC.H, -
                           [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTXLFD.H, -
                           [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILST.H, [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFIL.H
FNTSTUBS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                      [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FNTSTUBS]DESCRIP.MMS
FNTSTUBS_OBJECTS = $(OUT).LIB.FNTSTUBS]CAUTHGEN.OBJ, -
                   $(OUT).LIB.FNTSTUBS]CSIGNAL.OBJ, -
                   $(OUT).LIB.FNTSTUBS]DELFNTCID.OBJ, -
                   $(OUT).LIB.FNTSTUBS]ERRORF.OBJ, -
                   $(OUT).LIB.FNTSTUBS]FATALERROR.OBJ, -
                   $(OUT).LIB.FNTSTUBS]FINDOLDFNT.OBJ, -
                   $(OUT).LIB.FNTSTUBS]GETCRES.OBJ, -
                   $(OUT).LIB.FNTSTUBS]GETDEFPTSIZE.OBJ, -
                   $(OUT).LIB.FNTSTUBS]GETNEWFNTCID.OBJ, -
                   $(OUT).LIB.FNTSTUBS]GETTIME.OBJ, -
                   $(OUT).LIB.FNTSTUBS]INITFSHDL.OBJ, -
                   $(OUT).LIB.FNTSTUBS]REGFPEFUNC.OBJ, -
                   $(OUT).LIB.FNTSTUBS]RMFSHDL.OBJ, -
                   $(OUT).LIB.FNTSTUBS]SERVCLIENT.OBJ, -
                   $(OUT).LIB.FNTSTUBS]SETFNTAUTH.OBJ, -
                   $(OUT).LIB.FNTSTUBS]STFNTCFNT.OBJ, -
                   $(OUT).LIB.FNTSTUBS]XPSTUBS.OBJ

FNTSTUBS : $(OUT).LIB.FNTSTUBS]FNTSTUBS.OLB
	CONTINUE

$(OUT).LIB.FNTSTUBS]CAUTHGEN.OBJ : [.LIB.LIBXFONT.SRC.STUBS]CAUTHGEN.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]CAUTHGEN "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]CSIGNAL.OBJ : [.LIB.LIBXFONT.SRC.STUBS]CSIGNAL.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]CSIGNAL "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]DELFNTCID.OBJ : [.LIB.LIBXFONT.SRC.STUBS]DELFNTCID.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]DELFNTCID "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]ERRORF.OBJ : [.LIB.LIBXFONT.SRC.STUBS]ERRORF.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]ERRORF "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]FATALERROR.OBJ : [.LIB.LIBXFONT.SRC.STUBS]FATALERROR.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]FATALERROR "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]FINDOLDFNT.OBJ : [.LIB.LIBXFONT.SRC.STUBS]FINDOLDFNT.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]FINDOLDFNT "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]GETCRES.OBJ : [.LIB.LIBXFONT.SRC.STUBS]GETCRES.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]GETCRES "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]GETDEFPTSIZE.OBJ : [.LIB.LIBXFONT.SRC.STUBS]GETDEFPTSIZE.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]GETDEFPTSIZE "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]GETNEWFNTCID.OBJ : [.LIB.LIBXFONT.SRC.STUBS]GETNEWFNTCID.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]GETNEWFNTCID "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]GETTIME.OBJ : [.LIB.LIBXFONT.SRC.STUBS]GETTIME.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]GETTIME "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]INITFSHDL.OBJ : [.LIB.LIBXFONT.SRC.STUBS]INITFSHDL.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]INITFSHDL "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]REGFPEFUNC.OBJ : [.LIB.LIBXFONT.SRC.STUBS]REGFPEFUNC.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]REGFPEFUNC "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]RMFSHDL.OBJ : [.LIB.LIBXFONT.SRC.STUBS]RMFSHDL.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]RMFSHDL "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]SERVCLIENT.OBJ : [.LIB.LIBXFONT.SRC.STUBS]SERVCLIENT.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]SERVCLIENT "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]SETFNTAUTH.OBJ : [.LIB.LIBXFONT.SRC.STUBS]SETFNTAUTH.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]SETFNTAUTH "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]STFNTCFNT.OBJ : [.LIB.LIBXFONT.SRC.STUBS]STFNTCFNT.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]STFNTCFNT "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]XPSTUBS.OBJ : [.LIB.LIBXFONT.SRC.STUBS]XPSTUBS.C, -
    $(FNTSTUBS_HEADERS), $(FNTSTUBS_PRIVATE_HEADERS), $(FNTSTUBS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FNTSTUBS]XPSTUBS "$(CFLAGS)" FNTSTUBS

$(OUT).LIB.FNTSTUBS]FNTSTUBS.OLB : $(FNTSTUBS_OBJECTS), [.VMS-SUPPORT.LIB.FNTSTUBS]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FNTSTUBS_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FNTSTUBS]FNTSTUBS_LIBRARY.LIS $(MMS$TARGET)
