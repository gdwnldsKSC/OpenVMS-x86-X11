! Complete ordinary static dmx library from lib/dmx/Imakefile.
DMX_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DMXEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DMXPROTO.H
DMX_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.DMX]DESCRIP.MMS
DMX_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
DMX_OBJECTS = $(OUT).LIB.DMX]DMX.OBJ

DMX : $(OUT).LIB.DMX]DMX.OLB
	CONTINUE

$(OUT).LIB.DMX]DMX.OBJ : [.LIB.LIBDMX.SRC]DMX.C, -
    $(DMX_HEADERS), $(DMX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.DMX]DMX "$(DMX_CFLAGS)" DMX

$(OUT).LIB.DMX]DMX.OLB : $(DMX_OBJECTS), $(DMX_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(DMX_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.DMX]DMX_LIBRARY.LIS $(MMS$TARGET)
