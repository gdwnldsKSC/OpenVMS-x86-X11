! Ordinary libX11 data files; no source transformation.
X11_DATA :: $(OUT).LIB.X11]XERRORDB., $(OUT).LIB.X11]XKEYSYMDB., -
    $(OUT).LIB.X11]XCMS.TXT
	CONTINUE

$(OUT).LIB.X11]XERRORDB. : [.LIB.LIBX11.SRC]XERRORDB.
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.X11]XKEYSYMDB. : [.LIB.LIBX11.SRC]XKEYSYMDB.
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.X11]XCMS.TXT : [.LIB.LIBX11.SRC.XCMS]XCMS.TXT
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
