! Modular font packages, with the former Latin-1/JIS runtime selection.
! Generate derived BDFs with upstream font-util; never edit source BDFs.
FONTS_BDF : FONTS_MISC, FONTS_75DPI, FONTS_100DPI, FONTS_CYRILLIC
	CONTINUE

FONTS_MISC : BDFTOPCF, MKFONTDIR, UCS2ANY
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM MISC

FONTS_75DPI : BDFTOPCF, MKFONTDIR, UCS2ANY
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM 75DPI

FONTS_100DPI : BDFTOPCF, MKFONTDIR, UCS2ANY
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM 100DPI

FONTS_CYRILLIC : BDFTOPCF, MKFONTDIR, UCS2ANY
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM CYRILLIC
