	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DIX]EVENTS "$(DIX_CFLAGS)" DIX "$(DIX_CPPFLAGS)"

