! Original native make entry point; invoke through BUILD.COM from any directory.
.INCLUDE [.VMS-SUPPORT]CONFIG.MMS

ALL : PIXMAN, XCB, XCB_SHAPE, XAU, XDMCP, ZLIB, FONTENC, EXPAT, XFONT, FNTSTUBS, FS, ICE, SM, -
      ICEAUTH, MAKESTRS, MAKEDEPEND, GTF, -
      FREETYPE2, MKFONTSCALE, UCS2ANY, DAMAGE, MI, FB, RENDER, DIX, -
      SHADOW, SYNC, RANDR, DBE, RECORD, XFIXES, COMPOSITE, CW, DAMAGEEXT, EXT, XINPUT, OS, VFB, XKB, -
      XKBFILE, ROOTLESS, XEXT, XRENDER, XRANDR, XINERAMA, -
      XI, XTST, XV, XRES, XFIXESLIB, XDAMAGE, XCOMPOSITE, XCURSOR, XSS, XVMC, XXF86VM, -
      DMX, XMUU, XPM, X11, X11_XCB, XAUTH, XDPYINFO, XWININFO, -
      XSET, XMODMAP, XEV, BISON, XKBCOMP, SETXKBMAP, XKB_DATA, XVFB, XT, XMU, MKFONTDIR, FONTS, NLS, X11_DATA, -
      XF86_VIDEO_VMWARE, SHADOWFB, VGAHW, RAMDAC, XAA, XF86CONFIG, COMMON, BUS, MISC, XORGXKB, -
      LOADER, XORGFB, XF86_INPUT_KEYBOARD, XF86_INPUT_MOUSE, CONFIG, FBCMAP, GAWK, -
      XF86MODES, DDC, I2C, STUB, PCIACCESS
	CONTINUE

