    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRIFRDAT "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]RDFTODAT.OBJ : [.EXTRAS.XPM.LIB]RDFTODAT.C, -
