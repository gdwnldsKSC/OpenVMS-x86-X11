	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSQUEXT "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSSERVNAME.OBJ : [.LIB.LIBFS.SRC]FSSERVNAME.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSSERVNAME "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSSETCATS.OBJ : [.LIB.LIBFS.SRC]FSSETCATS.C, -
    $(FS_HEADERS), $(FS_PRIVATE_HEADERS), $(FS_BUILD_RULES), $(RTL)
