! Complete xev program from programs/xev/Imakefile.
XEV_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XLOCALE.H
XEV_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XEV]DESCRIP.MMS
XEV_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT
XEV_MAIN_CFLAGS = $(XEV_CFLAGS)/POINTER_SIZE=64=ARGV
XEV_OBJECTS = $(OUT).PROGRAMS.XEV]XEV.OBJ

XEV : $(OUT).PROGRAMS.XEV]XEV.EXE
	CONTINUE

$(OUT).PROGRAMS.XEV]XEV.OBJ : [.APP.XEV]XEV.C, -
    $(XEV_HEADERS), $(XEV_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XEV]XEV "$(XEV_MAIN_CFLAGS)" XEV

$(OUT).PROGRAMS.XEV]XEV.EXE : $(XEV_OBJECTS), -
    $(OUT).LIB.X11]X11.OLB, [.VMS-SUPPORT.PROGRAMS.XEV]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XEV]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XEV]LINK.COM
