! Original native make entry point; invoke through BUILD.COM from any directory.
.INCLUDE [.VMS-SUPPORT]CONFIG.MMS

ALL : XAU, XDMCP, ZLIB, FONTENC, EXPAT, LBXUTIL, XFONT, FNTSTUBS, FS, ICE, SM, BDFTOPCF, -
      FSLSFONTS, SHOWFONT, XFSINFO, ICEAUTH, SHOWRGB, MAKESTRS, MAKEDEPEND, LNDIR, ATOBM, GTF, -
      FREETYPE2, MKFONTSCALE, FONTTOSFNT, REVPATH, UCS2ANY, DAMAGE, MI, CBRT, FB, RENDER, DIX, XPSTUBS, -
      SHADOW, RANDR, DBE, RECORD, XFIXES, COMPOSITE, CW, DAMAGEEXT, EXT, XINPUT, OS, MFB, VFB, XKB, LBX, -
      CFB, CFB16, CFB32, XKBFILE, XKBUI, ROOTLESS, XTRAP, XEXT, XRENDER, XRANDR, XINERAMA, -
      XI, XTST, XV, XRES, XFIXESLIB, XDAMAGE, XCOMPOSITE, XCURSOR, XSS, XVMC, XXF86VM, XXF86MISC, -
      XEVIE, XFONTCACHE, DMX, XP, OLDX, XMUU, XPM, XPRINTAPPUTIL, X11, XAUTH, XDPYINFO, XWININFO, -
      XSET, XMODMAP, XEV, BISON, XKBCOMP, SETXKBMAP, XKB_DATA, XVFB, XT, XMU, MKFONTDIR, FONTS, NLS, X11_DATA, -
      XF86_VIDEO_VMWARE, SHADOWFB, VGAHW, RAMDAC, XAA, XF86CONFIG, RAC
	CONTINUE

