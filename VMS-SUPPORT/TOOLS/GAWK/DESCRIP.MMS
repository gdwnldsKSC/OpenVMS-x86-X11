! GNU Gawk's supplied native OpenVMS build, with isolated generated files.
GAWK_SOURCE = [.EXTRAS.GAWK]
GAWK_OUT = [.VMS-SUPPORT._BUILD.P64.TOOLS.GAWK]
GAWK_CCFLAGS = /NOPOINTER_SIZE

GAWK : $(GAWK_OUT)GAWK.EXE
	CONTINUE

GAWK_INPUTS = -
    [.EXTRAS.GAWK]ARRAY.C, [.EXTRAS.GAWK]AWK.H, -
    [.EXTRAS.GAWK]AWKGRAM.C, [.EXTRAS.GAWK]BUILTIN.C, -
    [.EXTRAS.GAWK]CINT_ARRAY.C, [.EXTRAS.GAWK]CMD.H, -
    [.EXTRAS.GAWK]COMMAND.C, [.EXTRAS.GAWK]CONFIGH.IN, -
    [.EXTRAS.GAWK]CONFIGURE., [.EXTRAS.GAWK]COPYING., -
    [.EXTRAS.GAWK]CUSTOM.H, [.EXTRAS.GAWK]DEBUG.C, -
    [.EXTRAS.GAWK]EVAL.C, [.EXTRAS.GAWK]EXT.C, -
    [.EXTRAS.GAWK]FIELD.C, [.EXTRAS.GAWK]FLOATCOMP.C, -
    [.EXTRAS.GAWK]FLOATMAGIC.H, [.EXTRAS.GAWK]GAWKAPI.C, -
    [.EXTRAS.GAWK]GAWKAPI.H, [.EXTRAS.GAWK]GAWKMISC.C, -
    [.EXTRAS.GAWK]GETTEXT.H, [.EXTRAS.GAWK]INT_ARRAY.C, -
    [.EXTRAS.GAWK]INTERPRET.H, [.EXTRAS.GAWK]IO.C, -
    [.EXTRAS.GAWK]MAIN.C, [.EXTRAS.GAWK.MISSING_D]FNMATCH.C, -
    [.EXTRAS.GAWK.MISSING_D]FNMATCH.H, [.EXTRAS.GAWK.MISSING_D]GETADDRINFO.C, -
    [.EXTRAS.GAWK.MISSING_D]GETADDRINFO.H, [.EXTRAS.GAWK.MISSING_D]STDIO-CONSOLESAFE.C, -
    [.EXTRAS.GAWK.MISSING_D]STRCOLL.C, [.EXTRAS.GAWK.MISSING_D]STRFTIME.C, -
    [.EXTRAS.GAWK.MISSING_D]STRNCASECMP.C, [.EXTRAS.GAWK.MISSING_D]STRPTIME.C, -
    [.EXTRAS.GAWK.MISSING_D]STRSIGNAL.C, [.EXTRAS.GAWK.MISSING_D]TIMEGM.C, -
    [.EXTRAS.GAWK]MPFR.C, [.EXTRAS.GAWK]MSG.C, -
    [.EXTRAS.GAWK]NODE.C, [.EXTRAS.GAWK]NONPOSIX.H, -
    [.EXTRAS.GAWK]PRINTF.C, [.EXTRAS.GAWK]PROFILE.C, -
    [.EXTRAS.GAWK]RE.C, [.EXTRAS.GAWK]REPLACE.C, -
    [.EXTRAS.GAWK]STR_ARRAY.C, [.EXTRAS.GAWK.SUPPORT]ATTRIBUTE.H, -
    [.EXTRAS.GAWK.SUPPORT]CDEFS.H, [.EXTRAS.GAWK.SUPPORT]CHARSET.C, -
    [.EXTRAS.GAWK.SUPPORT]CHARSET.H, [.EXTRAS.GAWK.SUPPORT]DFA.C, -
    [.EXTRAS.GAWK.SUPPORT]DFA.H, [.EXTRAS.GAWK.SUPPORT]DYNARRAY.H, -
    [.EXTRAS.GAWK.SUPPORT]FLEXMEMBER.H, [.EXTRAS.GAWK.SUPPORT]GETOPT_INT.H, -
    [.EXTRAS.GAWK.SUPPORT]GETOPT.C, [.EXTRAS.GAWK.SUPPORT]GETOPT.H, -
    [.EXTRAS.GAWK.SUPPORT]GETOPT1.C, [.EXTRAS.GAWK.SUPPORT]IDX.H, -
    [.EXTRAS.GAWK.SUPPORT]INTPROPS-INTERNAL.H, [.EXTRAS.GAWK.SUPPORT]INTPROPS.H, -
    [.EXTRAS.GAWK.SUPPORT]LIBC-CONFIG.H, [.EXTRAS.GAWK.SUPPORT]LOCALEINFO.C, -
    [.EXTRAS.GAWK.SUPPORT]LOCALEINFO.H, [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY_AT_FAILURE.C, -
    [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY_EMPLACE_ENLARGE.C, [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY_FINALIZE.C, -
    [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY_RESIZE_CLEAR.C, [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY_RESIZE.C, -
    [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY-SKELETON.C, [.EXTRAS.GAWK.SUPPORT.MALLOC]DYNARRAY.H, -
    [.EXTRAS.GAWK.SUPPORT]MINRX.C, [.EXTRAS.GAWK.SUPPORT]MINRX.H, -
    [.EXTRAS.GAWK.SUPPORT]PMA.C, [.EXTRAS.GAWK.SUPPORT]PMA.H, -
    [.EXTRAS.GAWK.SUPPORT]RANDOM.C, [.EXTRAS.GAWK.SUPPORT]RANDOM.H, -
    [.EXTRAS.GAWK.SUPPORT]REGCOMP.C, [.EXTRAS.GAWK.SUPPORT]REGEX_INTERNAL.C, -
    [.EXTRAS.GAWK.SUPPORT]REGEX_INTERNAL.H, [.EXTRAS.GAWK.SUPPORT]REGEX.C, -
    [.EXTRAS.GAWK.SUPPORT]REGEX.H, [.EXTRAS.GAWK.SUPPORT]REGEXEC.C, -
    [.EXTRAS.GAWK.SUPPORT]VERIFY.H, [.EXTRAS.GAWK.SUPPORT]XALLOC.H, -
    [.EXTRAS.GAWK]SYMBOL.C, [.EXTRAS.GAWK]VERSION.C, -
    [.EXTRAS.GAWK.VMS]CONFIG_H.COM, [.EXTRAS.GAWK.VMS]CONFIG_VMS.H, -
    [.EXTRAS.GAWK.VMS]DESCRIP.MMS, [.EXTRAS.GAWK.VMS]GAWK_IDENT.COM, -
    [.EXTRAS.GAWK.VMS]GAWK.CLD, [.EXTRAS.GAWK.VMS]GAWKMISC.VMS, -
    [.EXTRAS.GAWK.VMS]GENERATE_CONFIG_VMS_H_GAWK.COM, [.EXTRAS.GAWK.VMS]INTTYPES.H, -
    [.EXTRAS.GAWK.VMS]MATH.H, [.EXTRAS.GAWK.VMS]REDIRECT.H, -
    [.EXTRAS.GAWK.VMS]STDINT.H, [.EXTRAS.GAWK.VMS]STDIO.H, -
    [.EXTRAS.GAWK.VMS]UNIXLIB.H, [.EXTRAS.GAWK.VMS]VARARGS.H, -
    [.EXTRAS.GAWK.VMS]VMS_ARGS.C, [.EXTRAS.GAWK.VMS]VMS_CLI.C, -
    [.EXTRAS.GAWK.VMS]VMS_CRTL_INIT.C, [.EXTRAS.GAWK.VMS]VMS_FWRITE.C, -
    [.EXTRAS.GAWK.VMS]VMS_GAWK.C, [.EXTRAS.GAWK.VMS]VMS_MISC.C, -
    [.EXTRAS.GAWK.VMS]VMS_POPEN.C, [.EXTRAS.GAWK.VMS]VMS_PRINTF.C, -
    [.EXTRAS.GAWK.VMS]VMS.H

$(GAWK_OUT)GAWK.EXE : $(GAWK_INPUTS), [.VMS-SUPPORT.TOOLS.GAWK]BUILD.COM, -
    [.VMS-SUPPORT.TOOLS.GAWK]DESCRIP.MMS, $(RTL)
	@[.VMS-SUPPORT.TOOLS.GAWK]BUILD.COM "$(GAWK_SOURCE)" "$(GAWK_OUT)" "$(GAWK_CCFLAGS)"
