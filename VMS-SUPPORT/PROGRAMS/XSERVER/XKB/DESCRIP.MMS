	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXBEEP "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

