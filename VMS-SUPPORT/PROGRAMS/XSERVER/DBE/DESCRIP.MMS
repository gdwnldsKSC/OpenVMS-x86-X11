! Complete ordinary static DBE library with the machine-independent backend.
! The upstream default leaves the pervasive buffer-bit/validation options off.
DBE_HEADERS = $(RENDER_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]XDBEPROTO.H
DBE_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), [.PROGRAMS.XSERVER.DBE]DBESTRUCT.H, -
    [.PROGRAMS.XSERVER.DBE]MIDBE.H, [.PROGRAMS.XSERVER.DBE]MIDBESTR.H
DBE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DBE]DESCRIP.MMS
DBE_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
DBE_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,DBE,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

DBE_OBJECTS = $(OUT).PROGRAMS.XSERVER.DBE]DBE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.DBE]MIDBE.OBJ

DBE : $(OUT).PROGRAMS.XSERVER.DBE]DBE.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.DBE]DBE.OBJ : [.PROGRAMS.XSERVER.DBE]DBE.C, -
    $(DBE_HEADERS), $(DBE_PRIVATE_HEADERS), $(DBE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DBE]DBE "$(DBE_CFLAGS)" DBE "$(DBE_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DBE]MIDBE.OBJ : [.PROGRAMS.XSERVER.DBE]MIDBE.C, -
    $(DBE_HEADERS), $(DBE_PRIVATE_HEADERS), $(DBE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.DBE]MIDBE "$(DBE_CFLAGS)" DBE "$(DBE_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.DBE]DBE.OLB : $(DBE_OBJECTS), $(DBE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.DBE]DBE.OBJ,$(OUT).PROGRAMS.XSERVER.DBE]MIDBE.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.DBE]DBE_LIBRARY.LIS $(MMS$TARGET)
