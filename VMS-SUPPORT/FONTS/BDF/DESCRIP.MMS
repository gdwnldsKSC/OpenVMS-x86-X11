! fonts/bdf/Imakefile sections. The supplied pre-derived Latin-1 fonts
! implement the upstream DerivedUCSFonts=no profile without changing BDFs.
FONTS_BDF : FONTS_MISC, FONTS_75DPI, FONTS_100DPI, FONTS_CYRILLIC
	CONTINUE

FONTS_MISC : BDFTOPCF, MKFONTDIR
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM MISC

FONTS_75DPI : BDFTOPCF, MKFONTDIR
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM 75DPI

FONTS_100DPI : BDFTOPCF, MKFONTDIR
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM 100DPI

FONTS_CYRILLIC : BDFTOPCF, MKFONTDIR
	@[.VMS-SUPPORT.FONTS.BDF]BUILD.COM CYRILLIC
