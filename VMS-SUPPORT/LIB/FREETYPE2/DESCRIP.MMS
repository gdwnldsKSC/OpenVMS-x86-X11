FREETYPE2_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, -
    [.VMS-SUPPORT]COMPILE_FREETYPE2.COM, -
    [.VMS-SUPPORT.LIB.FREETYPE2]DESCRIP.MMS, -
    [.EXTRAS.FREETYPE]MODULES.CFG, -
    [.EXTRAS.FREETYPE.SRC.BASE]RULES.MK
FREETYPE2_CFLAGS = $(CFLAGS)/DEFINE=FT2_BUILD_LIBRARY
! Native pointer-span diagnostics retain upstream int/long-sized count fields.
FREETYPE2_COUNT_CFLAGS = $(FREETYPE2_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! BDF property indices and CFF address-derived seed entropy retain upstream casts.
FREETYPE2_POINTER_CFLAGS = $(FREETYPE2_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,POINTERINTCAST))
FREETYPE2_OBJECTS = $(OUT).LIB.FREETYPE2]FTAPI.OBJ, -
    $(OUT).LIB.FREETYPE2]FTBASE.OBJ, -
