! Separate upstream libxorgxkb action handlers; not the generic XKB DDX members.
! The consuming XFree86 server supplies xf86ProcessActionEvent.
XORGXKB_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]DESCRIP.MMS
XORGXKB_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT,XKB_IN_SERVER, -
    NO_INLINE,NO_ALLOCA,OPEN_MAX=256,XORGSERVER,_XOPEN_SOURCE=600,_XOPEN_SOURCE_EXTENDED=1, -
    XORG_VERSION_CURRENT=10501000,XSERVER_LIBPCIACCESS=1,GLYPHPADBYTES=4, -
    GETLEFTBITS_ALIGNMENT=1)
XORGXKB_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBVT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBPRIVATE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBKILLSRV.OBJ

XORGXKB : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XORGXKB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBVT.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS]XKBVT.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XORGXKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBVT "$(XF86COMMON_CFLAGS)" XORGXKB "$(XORGXKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBPRIVATE.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS]XKBPRIVATE.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XORGXKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBPRIVATE "$(XF86COMMON_CFLAGS)" XORGXKB "$(XORGXKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBKILLSRV.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS]XKBKILLSRV.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XORGXKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XKBKILLSRV "$(XF86COMMON_CFLAGS)" XORGXKB "$(XORGXKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XORGXKB.OLB : $(XORGXKB_OBJECTS), $(XORGXKB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XORGXKB_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]XORGXKB_LIBRARY.LIS $(MMS$TARGET)

! Upstream dixmods/libfb: the coherent framebuffer library plus Xorg colormaps
! and its module descriptor. Keep the generic FB and XSERVER_CORE targets intact.
XORGFB_BUILD_RULES = $(FB_BUILD_RULES), $(XVFB_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]ARCHIVE.COM
XORGFB_HEADERS = $(PCIACCESS_HEADERS), $(FB_HEADERS), $(FB_PRIVATE_HEADERS), $(XVFB_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VERSION.H
XORGFB_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4, -
    GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT,XKB_IN_SERVER,_XOPEN_SOURCE=600, -
    ""XFree86Server"",XORG_VERSION_CURRENT=10501000,XSERVER_LIBPCIACCESS=1)
XORGFB_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBCMAP_MI.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBMODULE.OBJ

XORGFB : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBCMAP_MI.OBJ : -
    [.XSERVER.XORG-SERVER.FB]FBCMAP_MI.C, -
    $(XORGFB_HEADERS), $(XORGFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBCMAP_MI "$(FB_CFLAGS)" XORGFB "$(XORGFB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBMODULE.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DIXMODS]FBMODULE.C, -
    $(XORGFB_HEADERS), $(XORGFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBMODULE "$(FB_CFLAGS)" XORGFB "$(XORGFB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FB.OLB : -
    $(XVFB_OUT).FB]FB.OLB, $(XORGFB_OBJECTS), $(XORGFB_BUILD_RULES)
	@[.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]ARCHIVE.COM $(XVFB_OUT).FB]FB.OLB $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBCMAP_MI.OBJ $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FBMODULE.OBJ $(OUT).PROGRAMS.XSERVER.HW.XFREE86.DIXMODS]FB_LIBRARY.LIS
