! Complete ordinary static Xpm library from lib/Xpm/Imakefile.
! Native snprintf and plain-file IO; upstream compressed-file pipes excluded.
XPM_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XPM.H
XPM_PRIVATE_HEADERS = [.EXTRAS.XPM.LIB]XPMI.H, [.EXTRAS.XPM.LIB]XPM.H
XPM_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XPM]DESCRIP.MMS
XPM_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Same-buffer differences retain the upstream unsigned-int length limits.
XPM_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
! HashAtomData/HashColorIndex round-trip color indices, not memory addresses.
XPM_INDEX_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
XPM_COUNT_INDEX_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3,POINTERINTCAST))
XPM_CPPFLAGS = /DEFINE=(HAS_SNPRINTF,NO_ZPIPE,_XOPEN_SOURCE=600,NEED_STRDUP,NEED_STRCASECMP)
XPM_OBJECTS = $(OUT).LIB.XPM]DATA.OBJ, -
    $(OUT).LIB.XPM]CREATE.OBJ, -
    $(OUT).LIB.XPM]MISC.OBJ, -
    $(OUT).LIB.XPM]RGB.OBJ, -
    $(OUT).LIB.XPM]SCAN.OBJ, -
    $(OUT).LIB.XPM]PARSE.OBJ, -
    $(OUT).LIB.XPM]HASHTAB.OBJ, -
    $(OUT).LIB.XPM]CRBUFFRI.OBJ, -
    $(OUT).LIB.XPM]CRDATFRP.OBJ, -
    $(OUT).LIB.XPM]CRPFRBUF.OBJ, -
    $(OUT).LIB.XPM]RDFTOI.OBJ, -
    $(OUT).LIB.XPM]WRFFRI.OBJ, -
    $(OUT).LIB.XPM]CRBUFFRP.OBJ, -
    $(OUT).LIB.XPM]CRIFRBUF.OBJ, -
    $(OUT).LIB.XPM]CRPFRDAT.OBJ, -
    $(OUT).LIB.XPM]RDFTOP.OBJ, -
    $(OUT).LIB.XPM]WRFFRP.OBJ, -
    $(OUT).LIB.XPM]CRDATFRI.OBJ, -
    $(OUT).LIB.XPM]CRIFRDAT.OBJ, -
    $(OUT).LIB.XPM]RDFTODAT.OBJ, -
    $(OUT).LIB.XPM]WRFFRDAT.OBJ, -
    $(OUT).LIB.XPM]ATTRIB.OBJ, -
    $(OUT).LIB.XPM]CRIFRP.OBJ, -
    $(OUT).LIB.XPM]CRPFRI.OBJ, -
    $(OUT).LIB.XPM]IMAGE.OBJ, -
    $(OUT).LIB.XPM]INFO.OBJ, -
    $(OUT).LIB.XPM]RDFTOBUF.OBJ, -
    $(OUT).LIB.XPM]WRFFRBUF.OBJ

XPM : $(OUT).LIB.XPM]XPM.OLB
	CONTINUE

$(OUT).LIB.XPM]DATA.OBJ : [.EXTRAS.XPM.LIB]DATA.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]DATA "$(XPM_COUNT_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]CREATE.OBJ : [.EXTRAS.XPM.LIB]CREATE.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CREATE "$(XPM_INDEX_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]MISC.OBJ : [.EXTRAS.XPM.LIB]MISC.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]MISC "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]RGB.OBJ : [.EXTRAS.XPM.LIB]RGB.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]RGB "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]SCAN.OBJ : [.EXTRAS.XPM.LIB]SCAN.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]SCAN "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]PARSE.OBJ : [.EXTRAS.XPM.LIB]PARSE.C, -
