! Complete ordinary static rootless library from the upstream Imakefile.
! Generic no-acceleration profile; no platform alpha protection or safeAlpha hooks.
ROOTLESS_HEADERS = $(RENDER_HEADERS)
ROOTLESS_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESS.H, -
    [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSCONFIG.H, -
    [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSCOMMON.H, -
    [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSWINDOW.H, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.ROOTLESS]VMS_ROOTLESS_CONFIG.H
ROOTLESS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.ROOTLESS]DESCRIP.MMS
ROOTLESS_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Upstream's abs macro is unused with its fixed ROOTLESS_CHANGED_AREA=1 profile.
ROOTLESS_GC_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF))
ROOTLESS_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,SHAPE,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

ROOTLESS_OBJECTS = $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSCOMMON.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSSCREEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSWINDOW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSGC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSVALTREE.OBJ

ROOTLESS : $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESS.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSCOMMON.OBJ : [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSCOMMON.C, -
    $(ROOTLESS_HEADERS), $(ROOTLESS_PRIVATE_HEADERS), $(ROOTLESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSCOMMON "$(ROOTLESS_CFLAGS)" ROOTLESS "$(ROOTLESS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSSCREEN.OBJ : [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSSCREEN.C, -
    $(ROOTLESS_HEADERS), $(ROOTLESS_PRIVATE_HEADERS), $(ROOTLESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSSCREEN "$(ROOTLESS_CFLAGS)" ROOTLESS "$(ROOTLESS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSWINDOW.OBJ : [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSWINDOW.C, -
    $(ROOTLESS_HEADERS), $(ROOTLESS_PRIVATE_HEADERS), $(ROOTLESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSWINDOW "$(ROOTLESS_CFLAGS)" ROOTLESS "$(ROOTLESS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSGC.OBJ : [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSGC.C, -
    $(ROOTLESS_HEADERS), $(ROOTLESS_PRIVATE_HEADERS), $(ROOTLESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSGC "$(ROOTLESS_GC_CFLAGS)" ROOTLESS "$(ROOTLESS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSVALTREE.OBJ : [.XSERVER.XORG-SERVER.MIEXT.ROOTLESS]ROOTLESSVALTREE.C, -
    $(ROOTLESS_HEADERS), $(ROOTLESS_PRIVATE_HEADERS), $(ROOTLESS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSVALTREE "$(ROOTLESS_CFLAGS)" ROOTLESS "$(ROOTLESS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESS.OLB : $(ROOTLESS_OBJECTS), $(ROOTLESS_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSCOMMON.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSSCREEN.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSWINDOW.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSGC.OBJ
	LIBRARY/REPLACE $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESSVALTREE.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.ROOTLESS]ROOTLESS_LIBRARY.LIS $(MMS$TARGET)
