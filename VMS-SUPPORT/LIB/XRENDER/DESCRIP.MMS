! Complete ordinary static Xrender library from lib/Xrender/Imakefile.
XRENDER_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDERPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRENDER.H
XRENDER_PRIVATE_HEADERS = [.LIB.LIBXRENDER.SRC]XRENDERINT.H, -
    $(OUT).LIB.XRENDER]CONFIG.H, [.LIB.LIBXRENDER.INCLUDE.X11.EXTENSIONS]XRENDER.H, [.LIB.LIBX11.INCLUDE.X11]XREGION.H
XRENDER_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XRENDER]DESCRIP.MMS
XRENDER_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Only same-buffer distances at FillRect:65 and Filter:117 use int byte counts.
XRENDER_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XRENDER_OBJECTS = $(OUT).LIB.XRENDER]XRENDER.OBJ, -
    $(OUT).LIB.XRENDER]ADDTRAP.OBJ, -
    $(OUT).LIB.XRENDER]COLOR.OBJ, -
    $(OUT).LIB.XRENDER]COMPOSITE.OBJ, -
    $(OUT).LIB.XRENDER]CURSOR.OBJ, -
    $(OUT).LIB.XRENDER]GLYPH.OBJ, -
    $(OUT).LIB.XRENDER]PICTURE.OBJ, -
    $(OUT).LIB.XRENDER]FILLRECT.OBJ, -
    $(OUT).LIB.XRENDER]FILLRECTS.OBJ, -
    $(OUT).LIB.XRENDER]FILTER.OBJ, -
    $(OUT).LIB.XRENDER]POLY.OBJ, -
    $(OUT).LIB.XRENDER]TRAP.OBJ, -
    $(OUT).LIB.XRENDER]TRI.OBJ

XRENDER : $(OUT).LIB.XRENDER]XRENDER.OLB
	CONTINUE

$(OUT).LIB.XRENDER]CONFIG.H : [.LIB.LIBXRENDER]CONFIG^.H.IN
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.XRENDER]XRENDER.OBJ : [.LIB.LIBXRENDER.SRC]XRENDER.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]XRENDER "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]ADDTRAP.OBJ : [.LIB.LIBXRENDER.SRC]ADDTRAP.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]ADDTRAP "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]COLOR.OBJ : [.LIB.LIBXRENDER.SRC]COLOR.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]COLOR "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]COMPOSITE.OBJ : [.LIB.LIBXRENDER.SRC]COMPOSITE.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]COMPOSITE "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]CURSOR.OBJ : [.LIB.LIBXRENDER.SRC]CURSOR.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]CURSOR "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]GLYPH.OBJ : [.LIB.LIBXRENDER.SRC]GLYPH.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]GLYPH "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]PICTURE.OBJ : [.LIB.LIBXRENDER.SRC]PICTURE.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]PICTURE "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]FILLRECT.OBJ : [.LIB.LIBXRENDER.SRC]FILLRECT.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]FILLRECT "$(XRENDER_COUNT_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]FILLRECTS.OBJ : [.LIB.LIBXRENDER.SRC]FILLRECTS.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]FILLRECTS "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]FILTER.OBJ : [.LIB.LIBXRENDER.SRC]FILTER.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]FILTER "$(XRENDER_COUNT_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]POLY.OBJ : [.LIB.LIBXRENDER.SRC]POLY.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]POLY "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]TRAP.OBJ : [.LIB.LIBXRENDER.SRC]TRAP.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]TRAP "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]TRI.OBJ : [.LIB.LIBXRENDER.SRC]TRI.C, -
    $(XRENDER_HEADERS), $(XRENDER_PRIVATE_HEADERS), $(XRENDER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XRENDER]TRI "$(XRENDER_CFLAGS)" XRENDER

$(OUT).LIB.XRENDER]XRENDER.OLB : $(XRENDER_OBJECTS), $(XRENDER_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]XRENDER.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]ADDTRAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]COLOR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]COMPOSITE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]CURSOR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]GLYPH.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]PICTURE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]FILLRECT.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]FILLRECTS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]FILTER.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]POLY.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]TRAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XRENDER]TRI.OBJ
	LIBRARY/LIST=$(OUT).LIB.XRENDER]XRENDER_LIBRARY.LIS $(MMS$TARGET)
