! Mirrors lib/font/include/Imakefile's X11/fonts header exports.
FONT_INCLUDE_HEADERS = $(OUT).INCLUDE.X11.FONTS]BITMAP.H, -
    $(OUT).INCLUDE.X11.FONTS]BUFIO.H, $(OUT).INCLUDE.X11.FONTS]FNTFIL.H, -
    $(OUT).INCLUDE.X11.FONTS]FNTFILIO.H, $(OUT).INCLUDE.X11.FONTS]FNTFILST.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTENC.H, $(OUT).INCLUDE.X11.FONTS]FONTENCC.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTMISC.H, $(OUT).INCLUDE.X11.FONTS]FONTMOD.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTSHOW.H, $(OUT).INCLUDE.X11.FONTS]FONTUTIL.H, -
    $(OUT).INCLUDE.X11.FONTS]FONTXLFD.H

$(OUT).INCLUDE.X11.FONTS]BITMAP.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BITMAP.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]BUFIO.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]BUFIO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FNTFIL.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFIL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FNTFILIO.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILIO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FNTFILST.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FNTFILST.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTENCC.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTENCC.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTMISC.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTMISC.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTMOD.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTMOD.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTSHOW.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTSHOW.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTUTIL.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTUTIL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.FONTS]FONTXLFD.H : [.LIB.LIBXFONT.INCLUDE.X11.FONTS]FONTXLFD.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
