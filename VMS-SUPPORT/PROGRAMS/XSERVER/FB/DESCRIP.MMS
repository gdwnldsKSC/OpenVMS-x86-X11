! Complete ordinary static framebuffer library; Render enabled, loadable/MMX disabled.
! Object membership follows upstream OBJS, including fbarc and fbpseudocolor.
FB_HEADERS = $(DAMAGE_HEADERS)
FB_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.FB]FB.H, -
    [.PROGRAMS.XSERVER.FB]FB24_32.H, -
    [.PROGRAMS.XSERVER.FB]FBBITS.H, -
    [.PROGRAMS.XSERVER.FB]FBEDGEIMP.H, -
    [.PROGRAMS.XSERVER.FB]FBMMX.H, -
    [.PROGRAMS.XSERVER.FB]FBOVERLAY.H, -
    [.PROGRAMS.XSERVER.FB]FBPICT.H, -
    [.PROGRAMS.XSERVER.FB]FBPSEUDOCOLOR.H, -
    [.PROGRAMS.XSERVER.FB]FBROP.H, -
    [.PROGRAMS.XSERVER.RENDER]GLYPHSTR.H, -
    [.PROGRAMS.XSERVER.RENDER]MIPICT.H, -
    [.PROGRAMS.XSERVER.RENDER]PICTURE.H, -
    [.PROGRAMS.XSERVER.RENDER]PICTURESTR.H, -
    [.PROGRAMS.XSERVER.RENDER]RENDEREDGE.H
FB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS
! Retain native long32 and 32-bit framebuffer words with P64 pointers.
FB_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Selected casts test only address alignment bits; accesses retain full pointers.
FB_ALIGN_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
! Bitmap-region offsets retain the upstream long32/int32 rectangle-count model.
FB_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
FB_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

FB_OBJECTS = $(OUT).PROGRAMS.XSERVER.FB]FBARC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBALLPRIV.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBBITS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBBLT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBBLTONE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBBSTORE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBCMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBCOMPOSE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBCOPY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBEDGE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBFILL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBFILLRECT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBFILLSP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBGC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBGETSP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBGLYPH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBIMAGE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBLINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBOVERLAY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBPIXMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBPOINT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBPUSH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBSCREEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBSEG.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBSETSP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBSOLID.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBSTIPPLE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBTILE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBTRAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBUTIL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBWINDOW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FB24_32.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBPICT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBMMX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.FB]FBPSEUDOCOLOR.OBJ

FB : $(OUT).PROGRAMS.XSERVER.FB]FB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.FB]FBARC.OBJ : [.PROGRAMS.XSERVER.FB]FBARC.C, -
    $(FB_HEADERS), $(FB_PRIVATE_HEADERS), $(FB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.FB]FBARC "$(FB_CFLAGS)" FB "$(FB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.FB]FBALLPRIV.OBJ : [.PROGRAMS.XSERVER.FB]FBALLPRIV.C, -
    $(FB_HEADERS), $(FB_PRIVATE_HEADERS), $(FB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.FB]FBALLPRIV "$(FB_CFLAGS)" FB "$(FB_CPPFLAGS)"

