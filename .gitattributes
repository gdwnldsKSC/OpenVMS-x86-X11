# Auto detect text files and perform LF normalization
* text=auto

# Preserve independently acquired modular upstream source bytes on every host.
app/** -text
data/** -text
deprecated/** -text
doc/** -text
driver/** -text
extras/** -text
font/** -text
lib/** -text
proto/** -text
util/** -text
xserver/** -text

# Keep XCB text exports usable as native Stream_LF source files.
xcb/** text=auto eol=lf

# Preserve the independently acquired GNU Bison distribution byte-for-byte.
extras/bison/** -text

# Native DCL stream-LF procedures must not acquire trailing carriage returns.
VMS-SUPPORT/**/*.COM text eol=lf
VMS-SUPPORT/**/*.MMS text eol=lf
VMS-SUPPORT/**/*.H text eol=lf
VMS-SUPPORT/**/*.OPT text eol=lf
