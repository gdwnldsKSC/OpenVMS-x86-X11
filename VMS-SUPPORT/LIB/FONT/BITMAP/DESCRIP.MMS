! Internal bitmap objects needed by bdftopcf; not the complete Xfont library.
FONT_BITMAP_HEADERS = $(FONTUTIL_HEADERS)
FONT_BITMAP_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
                               [.LIB.FONT.INCLUDE]FONTUTIL.H, -
                               [.LIB.FONT.INCLUDE]FONTXLFD.H, -
                               [.LIB.FONT.INCLUDE]FNTFILST.H, -
                               [.LIB.FONT.INCLUDE]FNTFIL.H, -
                               [.LIB.FONT.INCLUDE]BUFIO.H, -
                               [.LIB.FONT.INCLUDE]FNTFILIO.H, -
                               [.LIB.FONT.INCLUDE]BITMAP.H, -
                               [.LIB.FONT.BITMAP]BDFINT.H, [.LIB.FONT.BITMAP]PCF.H
FONT_BITMAP_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                          [.VMS-SUPPORT]HEADERS.MMS, -
                          [.VMS-SUPPORT.LIB.FONT.BITMAP]DESCRIP.MMS
! Preserve upstream int-sized line/glyph counts and PCF indices with P64 pointers.
FONT_BITMAP_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONT_BITMAP_OBJECTS = $(OUT).LIB.FONT.BITMAP]BDFREAD.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BDFUTILS.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BITMAP.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]BITMAPUTIL.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]FONTINK.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]PCFREAD.OBJ, -
                       $(OUT).LIB.FONT.BITMAP]PCFWRITE.OBJ

$(OUT).LIB.FONT.BITMAP]BDFREAD.OBJ : [.LIB.FONT.BITMAP]BDFREAD.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BDFREAD "$(CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BDFUTILS.OBJ : [.LIB.FONT.BITMAP]BDFUTILS.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BDFUTILS "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BITMAP.OBJ : [.LIB.FONT.BITMAP]BITMAP.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BITMAP "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]BITMAPUTIL.OBJ : [.LIB.FONT.BITMAP]BITMAPUTIL.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]BITMAPUTIL "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]FONTINK.OBJ : [.LIB.FONT.BITMAP]FONTINK.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]FONTINK "$(CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]PCFREAD.OBJ : [.LIB.FONT.BITMAP]PCFREAD.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]PCFREAD "$(CFLAGS)" FONT_BITMAP

$(OUT).LIB.FONT.BITMAP]PCFWRITE.OBJ : [.LIB.FONT.BITMAP]PCFWRITE.C, -
    $(FONT_BITMAP_HEADERS), $(FONT_BITMAP_PRIVATE_HEADERS), $(FONT_BITMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONT.BITMAP]PCFWRITE "$(FONT_BITMAP_COUNT_CFLAGS)" FONT_BITMAP
