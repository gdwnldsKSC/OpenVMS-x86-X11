$(OUT).PROGRAMS.XSERVER.FB]FB.OLB : $(FB_OBJECTS), $(FB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.FB]FBARC.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBALLPRIV.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBBITS.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBBLT.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBBLTONE.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBBSTORE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.FB]FBCMAP.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBCOMPOSE.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBCOPY.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBEDGE.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBFILL.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBFILLRECT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.FB]FBFILLSP.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBGC.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBGETSP.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBGLYPH.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBIMAGE.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBLINE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.FB]FBOVERLAY.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBPIXMAP.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBPOINT.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBPUSH.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBSCREEN.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBSEG.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.FB]FBSETSP.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBSOLID.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBSTIPPLE.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBTILE.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBTRAP.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBUTIL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.FB]FBWINDOW.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FB24_32.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBPICT.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBMMX.OBJ,$(OUT).PROGRAMS.XSERVER.FB]FBPSEUDOCOLOR.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.FB]FB_LIBRARY.LIS $(MMS$TARGET)
