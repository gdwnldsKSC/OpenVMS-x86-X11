$(OUT).LIB.XMU]XMU.OLB : $(XMU_OBJECTS), [.VMS-SUPPORT.LIB.XMU]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]ALLCMAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]ATOMS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CLIENTWIN.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CLIP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CLOSEHOOK.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CMAPALLOC.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CRCMAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CRPIXFBIT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CURSORNAME.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CVTCACHE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]CVTSTDSEL.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]DEFERRMSG.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]DELCMAP.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]DISPLAYQUE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]DISTINCT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]DRAWLOGO.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]DRRNDRECT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]EDITRESCOM.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).LIB.XMU]EXTAGENT.OBJ
