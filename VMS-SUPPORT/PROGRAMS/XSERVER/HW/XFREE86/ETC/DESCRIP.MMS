! programs/Xserver/hw/xfree86/etc/Imakefile's complete GTF utility target.
GTF_HEADERS = $(RTL)
GTF_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                  [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.ETC]DESCRIP.MMS
! Retain the upstream ConfigDefines server name; expose native RTL rint.
GTF_CFLAGS = $(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT -
    /DEFINE=(_XOPEN_SOURCE=600,__XSERVERNAME__=""""""Xorg"""""")

GTF : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.ETC]GTF.EXE
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.ETC]GTF.OBJ : [.XSERVER.XORG-SERVER.HW.XFREE86.UTILS.GTF]GTF.C, -
    $(GTF_HEADERS), $(GTF_BUILD_RULES)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.ETC]GTF "$(GTF_CFLAGS)" GTF

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.ETC]GTF.EXE : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.ETC]GTF.OBJ, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.ETC]LINK_GTF.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.ETC]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.ETC]LINK_GTF.COM
