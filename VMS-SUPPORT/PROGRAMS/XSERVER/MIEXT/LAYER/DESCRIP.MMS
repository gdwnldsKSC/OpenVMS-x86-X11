! Complete ordinary static Render-enabled layer library; laymodule is excluded.
! Native P64 pointers and long32 match the existing framebuffer storage profile.
LAYER_HEADERS = $(RENDER_HEADERS)
LAYER_PRIVATE_HEADERS = $(SHADOW_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.MIEXT.LAYER]LAYER.H, -
    [.PROGRAMS.XSERVER.MIEXT.LAYER]LAYERSTR.H
LAYER_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.SHADOW]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.LAYER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.LAYER]VMS_LAYER_NAMES.H
LAYER_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Existing layer-kind positions retain the upstream int array-index contract.
LAYER_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
LAYER_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

LAYER_OBJECTS = $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERGC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERPICT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERWIN.OBJ

LAYER : $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYER.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERGC.OBJ : [.PROGRAMS.XSERVER.MIEXT.LAYER]LAYERGC.C, -
    $(LAYER_HEADERS), $(LAYER_PRIVATE_HEADERS), $(LAYER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERGC "$(LAYER_CFLAGS)" LAYER "$(LAYER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERINIT.OBJ : [.PROGRAMS.XSERVER.MIEXT.LAYER]LAYERINIT.C, -
    $(LAYER_HEADERS), $(LAYER_PRIVATE_HEADERS), $(LAYER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERINIT "$(LAYER_COUNT_CFLAGS)" LAYER "$(LAYER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERPICT.OBJ : [.PROGRAMS.XSERVER.MIEXT.LAYER]LAYERPICT.C, -
    $(LAYER_HEADERS), $(LAYER_PRIVATE_HEADERS), $(LAYER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERPICT "$(LAYER_CFLAGS)" LAYER "$(LAYER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERWIN.OBJ : [.PROGRAMS.XSERVER.MIEXT.LAYER]LAYERWIN.C, -
    $(LAYER_HEADERS), $(LAYER_PRIVATE_HEADERS), $(LAYER_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERWIN "$(LAYER_CFLAGS)" LAYER "$(LAYER_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYER.OLB : $(LAYER_OBJECTS), $(LAYER_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERGC.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERINIT.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERPICT.OBJ,$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYERWIN.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.LAYER]LAYER_LIBRARY.LIS $(MMS$TARGET)
