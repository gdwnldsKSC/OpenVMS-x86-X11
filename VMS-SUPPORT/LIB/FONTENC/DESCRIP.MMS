! libfontenc 1.1.9 library sources and upstream reallocarray fallback.
FONTENC_HEADERS = $(OUT).INCLUDE.X11.FONTS]FONTENC.H, -
                  $(OUT).INCLUDE.X11]XFUNCPROTO.H
FONTENC_PRIVATE_HEADERS = [.LIB.LIBFONTENC.SRC]FONTENCI.H, -
                          [.LIB.LIBFONTENC.SRC]REALLOCARRAY.H
FONTENC_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                     [.VMS-SUPPORT]HEADERS.MMS, -
                     [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS
! Full index filename; upstream also accepts FONT_ENCODINGS_DIRECTORY at runtime.
FONTENC_INDEX = encodings.dir
FONTENC_CFLAGS = $(CFLAGS) -
    /DEFINE=(_XOPEN_SOURCE_EXTENDED=1,FONT_ENCODINGS_DIRECTORY=""""""$(FONTENC_INDEX)"""""")
! FontEncFromXLFD narrows an offset in an input bounded to 1023 bytes.
FONTENC_COUNT_CFLAGS = $(FONTENC_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
FONTENC_OBJECTS = $(OUT).LIB.FONTENC]FONTENC.OBJ, $(OUT).LIB.FONTENC]ENCPARSE.OBJ, -
                  $(OUT).LIB.FONTENC]REALLOCARRAY.OBJ

FONTENC : $(OUT).LIB.FONTENC]FONTENC.OLB, $(OUT).LIB.ZLIB]Z.OLB
	CONTINUE

$(OUT).INCLUDE.X11.FONTS]FONTENC.H : [.LIB.LIBFONTENC.INCLUDE.X11.FONTS]FONTENC.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.FONTENC]FONTENC.OBJ : [.LIB.LIBFONTENC.SRC]FONTENC.C, $(FONTENC_HEADERS), -
    $(FONTENC_PRIVATE_HEADERS), $(FONTENC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTENC]FONTENC "$(FONTENC_COUNT_CFLAGS)" FONTENC
$(OUT).LIB.FONTENC]ENCPARSE.OBJ : [.LIB.LIBFONTENC.SRC]ENCPARSE.C, $(FONTENC_HEADERS), -
    $(FONTENC_PRIVATE_HEADERS), $(ZLIB_HEADERS), $(FONTENC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTENC]ENCPARSE "$(FONTENC_CFLAGS)" FONTENC
$(OUT).LIB.FONTENC]REALLOCARRAY.OBJ : [.LIB.LIBFONTENC.SRC]REALLOCARRAY.C, $(FONTENC_HEADERS), -
    $(FONTENC_PRIVATE_HEADERS), $(FONTENC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTENC]REALLOCARRAY "$(FONTENC_CFLAGS)" FONTENC

$(OUT).LIB.FONTENC]FONTENC.OLB : $(FONTENC_OBJECTS), [.VMS-SUPPORT.LIB.FONTENC]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FONTENC_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FONTENC]FONTENC_LIBRARY.LIS $(MMS$TARGET)
