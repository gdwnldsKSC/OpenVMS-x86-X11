! Complete static X11 profile from lib/X11/Imakefile.
! Native P64; XKB, static locales and TCP client transports; no optional crypto,
! shared-memory, threads, dynamic locale modules or dynamic cursor loading.
X11_HEADERS = $(OUT).INCLUDE.X11.EXTENSIONS]BIGREQSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XCMISCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XI.H, -
