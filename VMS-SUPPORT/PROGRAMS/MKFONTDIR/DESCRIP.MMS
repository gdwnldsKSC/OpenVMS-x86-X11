! programs/mkfontdir is the upstream mkfontscale -b -s -l launcher.
MKFONTDIR : $(OUT).PROGRAMS.MKFONTDIR]MKFONTDIR.COM
	CONTINUE

$(OUT).PROGRAMS.MKFONTDIR]MKFONTDIR.COM : -
    [.VMS-SUPPORT.PROGRAMS.MKFONTDIR]MKFONTDIR.COM, -
    [.VMS-SUPPORT.PROGRAMS.MKFONTDIR]DESCRIP.MMS, -
    $(OUT).PROGRAMS.MKFONTSCALE]MKFONTSCALE.EXE
	COPY/NOLOG [.VMS-SUPPORT.PROGRAMS.MKFONTDIR]MKFONTDIR.COM $(MMS$TARGET)
