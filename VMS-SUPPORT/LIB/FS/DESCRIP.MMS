	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FS]FSFLUSH "$(FS_CFLAGS)" FS

$(OUT).LIB.FS]FSFONTINFO.OBJ : [.LIB.LIBFS.SRC]FSFONTINFO.C, -
