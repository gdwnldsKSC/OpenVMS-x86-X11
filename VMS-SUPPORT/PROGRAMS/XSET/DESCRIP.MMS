! Complete xset program from programs/xset/Imakefile.
XSET_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]KEYSYM.H, -
    $(OUT).INCLUDE.X11]KEYSYMDEF.H, $(OUT).INCLUDE.X11]XKBLIB.H, -
    $(OUT).INCLUDE.X11.XMU]ERROR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MITMISC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86MISC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XF86MSCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]FONTCACHEP.H, $(XKBFILE_HEADERS)
XSET_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XSET]DESCRIP.MMS
XSET_CFLAGS = $(CFLAGS)/MAIN=POSIX_EXIT/DEFINE=(MITMISC,DPMSExtension,XKB,XF86MISC,FONTCACHE)
XSET_MAIN_CFLAGS = $(XSET_CFLAGS)/POINTER_SIZE=64=ARGV
XSET_OBJECTS = $(OUT).PROGRAMS.XSET]XSET.OBJ

XSET : $(OUT).PROGRAMS.XSET]XSET.EXE
	CONTINUE

$(OUT).PROGRAMS.XSET]XSET.OBJ : [.PROGRAMS.XSET]XSET.C, -
    $(XSET_HEADERS), $(XSET_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSET]XSET "$(XSET_MAIN_CFLAGS)" XSET

$(OUT).PROGRAMS.XSET]XSET.EXE : $(XSET_OBJECTS), -
    $(OUT).LIB.XMUU]XMUU.OLB, -
    $(OUT).LIB.XXF86MISC]XXF86MISC.OLB, -
    $(OUT).LIB.XFONTCACHE]XFONTCACHE.OLB, -
    $(OUT).LIB.XEXT]XEXT.OLB, -
    $(OUT).LIB.X11]X11.OLB, [.VMS-SUPPORT.PROGRAMS.XSET]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.XSET]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.XSET]LINK.COM
