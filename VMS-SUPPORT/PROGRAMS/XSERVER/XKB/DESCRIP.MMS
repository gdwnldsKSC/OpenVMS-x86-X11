	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBMISC "$(XKB_COUNT_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

