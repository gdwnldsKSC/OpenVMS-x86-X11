! Complete static Xfixes client library from lib/Xfixes/Imakefile.
! XFIXESLIB keeps the existing XFIXES server target distinct.
XFIXESLIB_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XFIXES.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XFIXESWIRE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XFIXESPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H
XFIXESLIB_PRIVATE_HEADERS = [.LIB.XFIXES]XFIXESINT.H, [.LIB.XFIXES]XFIXES.H
XFIXESLIB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XFIXES]DESCRIP.MMS
XFIXESLIB_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XFIXESLIB_OBJECTS = $(OUT).LIB.XFIXES]CURSOR.OBJ, -
    $(OUT).LIB.XFIXES]REGION.OBJ, -
    $(OUT).LIB.XFIXES]SAVESET.OBJ, -
    $(OUT).LIB.XFIXES]SELECTION.OBJ, -
    $(OUT).LIB.XFIXES]XFIXES.OBJ

XFIXESLIB : $(OUT).LIB.XFIXES]XFIXES.OLB
	CONTINUE

$(OUT).LIB.XFIXES]CURSOR.OBJ : [.LIB.XFIXES]CURSOR.C, -
    $(XFIXESLIB_HEADERS), $(XFIXESLIB_PRIVATE_HEADERS), $(XFIXESLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFIXES]CURSOR "$(XFIXESLIB_CFLAGS)" XFIXESLIB

$(OUT).LIB.XFIXES]REGION.OBJ : [.LIB.XFIXES]REGION.C, -
    $(XFIXESLIB_HEADERS), $(XFIXESLIB_PRIVATE_HEADERS), $(XFIXESLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFIXES]REGION "$(XFIXESLIB_CFLAGS)" XFIXESLIB

$(OUT).LIB.XFIXES]SAVESET.OBJ : [.LIB.XFIXES]SAVESET.C, -
    $(XFIXESLIB_HEADERS), $(XFIXESLIB_PRIVATE_HEADERS), $(XFIXESLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFIXES]SAVESET "$(XFIXESLIB_CFLAGS)" XFIXESLIB

$(OUT).LIB.XFIXES]SELECTION.OBJ : [.LIB.XFIXES]SELECTION.C, -
    $(XFIXESLIB_HEADERS), $(XFIXESLIB_PRIVATE_HEADERS), $(XFIXESLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFIXES]SELECTION "$(XFIXESLIB_CFLAGS)" XFIXESLIB

$(OUT).LIB.XFIXES]XFIXES.OBJ : [.LIB.XFIXES]XFIXES.C, -
    $(XFIXESLIB_HEADERS), $(XFIXESLIB_PRIVATE_HEADERS), $(XFIXESLIB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XFIXES]XFIXES "$(XFIXESLIB_CFLAGS)" XFIXESLIB

$(OUT).LIB.XFIXES]XFIXES.OLB : $(XFIXESLIB_OBJECTS), $(XFIXESLIB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XFIXES]CURSOR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XFIXES]REGION.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XFIXES]SAVESET.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XFIXES]SELECTION.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XFIXES]XFIXES.OBJ
	LIBRARY/LIST=$(OUT).LIB.XFIXES]XFIXES_LIBRARY.LIS $(MMS$TARGET)
