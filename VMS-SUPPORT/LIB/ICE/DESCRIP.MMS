! Mirrors lib/ICE/Imakefile's normal library with TCP client/server transport.
ICE_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]X.H, -
              $(OUT).INCLUDE.X11]XMD.H, $(OUT).INCLUDE.X11]XDEFS.H, -
              $(OUT).INCLUDE.X11]XLIB.H, $(XTRANS_HEADERS), -
              $(OUT).INCLUDE.X11]XPOLL.H, $(OUT).INCLUDE.X11]XOS_R.H, -
              $(OUT).INCLUDE.X11.ICE]ICE.H, -
              $(OUT).INCLUDE.X11.ICE]ICECONN.H, -
              $(OUT).INCLUDE.X11.ICE]ICEPROTO.H, -
              $(OUT).INCLUDE.X11.ICE]ICELIB.H, -
              $(OUT).INCLUDE.X11.ICE]ICEMSG.H, -
              $(OUT).INCLUDE.X11.ICE]ICEUTIL.H
ICE_PRIVATE_HEADERS = [.LIB.ICE]ICELIBINT.H, [.LIB.ICE]GLOBALS.H
ICE_TRANSPORT_HEADERS = [.LIB.XTRANS]XTRANS.H, [.LIB.XTRANS]XTRANSINT.H
ICE_TRANSPORT_SOURCES = [.LIB.XTRANS]XTRANSSOCK.C, -
                       [.LIB.XTRANS]XTRANS.C, [.LIB.XTRANS]XTRANSUTIL.C
ICE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                  [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.ICE]DESCRIP.MMS
! Double quotes preserve the lowercase t through COMPILE.COM's argument string.
ICE_CONN_CFLAGS = $(CFLAGS)/DEFINE=(""ICE_t"",TRANS_CLIENT,TRANS_SERVER,TCPCONN,OPEN_MAX=256)
! Relative pointer differences feed upstream's int string/message counts.
ICE_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
ICE_CONN_COUNT_CFLAGS = $(ICE_CONN_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! Select the existing gettimeofday cookie branch; no interval-timer API is used.
! Relaxed mode exposes timeval and gettimeofday; Xfuncs replaces RTL macros.
ICE_AUTH_CFLAGS = $(CFLAGS)/STANDARD=RELAXED_ANSI89/DEFINE=ITIMER_REAL/WARNINGS=(ENABLE=LEVEL4,DISABLE=MACROREDEF)
! Installed P64 iovec layouts agree; their SDK structure tags differ.
! Xfuncs replaces equivalent RTL bcopy/bzero macros in relaxed mode.
ICE_TRANSPORT_CFLAGS = $(ICE_CONN_CFLAGS)/STANDARD=RELAXED_ANSI89/WARNINGS=(ENABLE=LEVEL4,DISABLE=(PTRMISMATCH,MACROREDEF))
ICE_OBJECTS = $(OUT).LIB.ICE]ACCEPT.OBJ, -
              $(OUT).LIB.ICE]AUTHUTIL.OBJ, -
              $(OUT).LIB.ICE]CONNECT.OBJ, -
              $(OUT).LIB.ICE]ERROR.OBJ, -
              $(OUT).LIB.ICE]GETAUTH.OBJ, -
              $(OUT).LIB.ICE]ICEAUTH.OBJ, -
              $(OUT).LIB.ICE]LISTEN.OBJ, -
              $(OUT).LIB.ICE]LISTENWK.OBJ, -
              $(OUT).LIB.ICE]LOCKING.OBJ, -
              $(OUT).LIB.ICE]MISC.OBJ, -
              $(OUT).LIB.ICE]PING.OBJ, -
              $(OUT).LIB.ICE]PROCESS.OBJ, -
              $(OUT).LIB.ICE]PROTOSETUP.OBJ, -
              $(OUT).LIB.ICE]REGISTER.OBJ, -
              $(OUT).LIB.ICE]REPLYWAIT.OBJ, -
              $(OUT).LIB.ICE]SETAUTH.OBJ, -
              $(OUT).LIB.ICE]SHUTDOWN.OBJ, -
              $(OUT).LIB.ICE]TRANSPORT.OBJ, -
              $(OUT).LIB.ICE]WATCH.OBJ

ICE : $(OUT).LIB.ICE]ICE.OLB
	CONTINUE

$(OUT).LIB.ICE]ACCEPT.OBJ : [.LIB.ICE]ACCEPT.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]ACCEPT "$(ICE_CONN_CFLAGS)" ICE

$(OUT).LIB.ICE]AUTHUTIL.OBJ : [.LIB.ICE]AUTHUTIL.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]AUTHUTIL "$(CFLAGS)" ICE

$(OUT).LIB.ICE]CONNECT.OBJ : [.LIB.ICE]CONNECT.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]CONNECT "$(ICE_CONN_COUNT_CFLAGS)" ICE

$(OUT).LIB.ICE]ERROR.OBJ : [.LIB.ICE]ERROR.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]ERROR "$(CFLAGS)" ICE

$(OUT).LIB.ICE]GETAUTH.OBJ : [.LIB.ICE]GETAUTH.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]GETAUTH "$(CFLAGS)" ICE

$(OUT).LIB.ICE]ICEAUTH.OBJ : [.LIB.ICE]ICEAUTH.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]ICEAUTH "$(ICE_AUTH_CFLAGS)" ICE

$(OUT).LIB.ICE]LISTEN.OBJ : [.LIB.ICE]LISTEN.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]LISTEN "$(ICE_CONN_CFLAGS)" ICE

$(OUT).LIB.ICE]LISTENWK.OBJ : [.LIB.ICE]LISTENWK.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]LISTENWK "$(ICE_CONN_CFLAGS)" ICE

$(OUT).LIB.ICE]LOCKING.OBJ : [.LIB.ICE]LOCKING.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]LOCKING "$(CFLAGS)" ICE

$(OUT).LIB.ICE]MISC.OBJ : [.LIB.ICE]MISC.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]MISC "$(ICE_CONN_COUNT_CFLAGS)" ICE

$(OUT).LIB.ICE]PING.OBJ : [.LIB.ICE]PING.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]PING "$(CFLAGS)" ICE

$(OUT).LIB.ICE]PROCESS.OBJ : [.LIB.ICE]PROCESS.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]PROCESS "$(ICE_COUNT_CFLAGS)" ICE

$(OUT).LIB.ICE]PROTOSETUP.OBJ : [.LIB.ICE]PROTOSETUP.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]PROTOSETUP "$(CFLAGS)" ICE

$(OUT).LIB.ICE]REGISTER.OBJ : [.LIB.ICE]REGISTER.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]REGISTER "$(CFLAGS)" ICE

$(OUT).LIB.ICE]REPLYWAIT.OBJ : [.LIB.ICE]REPLYWAIT.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]REPLYWAIT "$(CFLAGS)" ICE

$(OUT).LIB.ICE]SETAUTH.OBJ : [.LIB.ICE]SETAUTH.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]SETAUTH "$(CFLAGS)" ICE

$(OUT).LIB.ICE]SHUTDOWN.OBJ : [.LIB.ICE]SHUTDOWN.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]SHUTDOWN "$(ICE_CONN_CFLAGS)" ICE

$(OUT).LIB.ICE]TRANSPORT.OBJ : [.LIB.XTRANS]TRANSPORT.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_TRANSPORT_HEADERS), $(ICE_TRANSPORT_SOURCES), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]TRANSPORT "$(ICE_TRANSPORT_CFLAGS)" ICE

$(OUT).LIB.ICE]WATCH.OBJ : [.LIB.ICE]WATCH.C, -
    $(ICE_HEADERS), $(ICE_PRIVATE_HEADERS), -
    $(ICE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.ICE]WATCH "$(CFLAGS)" ICE

$(OUT).LIB.ICE]ICE.OLB : $(ICE_OBJECTS), [.VMS-SUPPORT.LIB.ICE]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(ICE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.ICE]ICE_LIBRARY.LIS $(MMS$TARGET)

$(OUT).INCLUDE.X11.ICE]ICE.H : [.LIB.ICE]ICE.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.ICE]ICECONN.H : [.LIB.ICE]ICECONN.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.ICE]ICEPROTO.H : [.LIB.ICE]ICEPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.ICE]ICELIB.H : [.LIB.ICE]ICELIB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.ICE]ICEMSG.H : [.LIB.ICE]ICEMSG.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.ICE]ICEUTIL.H : [.LIB.ICE]ICEUTIL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
