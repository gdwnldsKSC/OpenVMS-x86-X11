! Image-codec objects and generated table for the full lbxutil library.
LBXUTIL_IMAGE_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]LBXIMAGE.H
LBXUTIL_IMAGE_PRIVATE_HEADERS = [.LIB.LBXUTIL.IMAGE]LBXFAX.H, [.LIB.LBXUTIL.IMAGE]LBXBWCODES.H
LBXUTIL_IMAGE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                           [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.LBXUTIL.IMAGE]DESCRIP.MMS
! Preserve the codecs' int-sized byte-count API when narrowing P64 buffer offsets.
LBXUTIL_IMAGE_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
LBXUTIL_IMAGE_OBJECTS = $(OUT).LIB.LBXUTIL.IMAGE]DFAXG42D.OBJ, -
                        $(OUT).LIB.LBXUTIL.IMAGE]DPACKBITS.OBJ, -
                        $(OUT).LIB.LBXUTIL.IMAGE]EFAXG42D.OBJ, -
                        $(OUT).LIB.LBXUTIL.IMAGE]EPACKBITS.OBJ, -
                        $(OUT).LIB.LBXUTIL.IMAGE]MISC.OBJ

$(OUT).INCLUDE.X11.EXTENSIONS]LBXIMAGE.H : [.INCLUDE.EXTENSIONS]LBXIMAGE.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.LBXUTIL.IMAGE]MKG3STATES.OBJ : [.LIB.LBXUTIL.IMAGE]MKG3STATES.C, -
    $(LBXUTIL_IMAGE_HEADERS), $(LBXUTIL_IMAGE_PRIVATE_HEADERS), $(LBXUTIL_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL.IMAGE]MKG3STATES "$(CFLAGS)/MAIN=POSIX_EXIT" LBXUTIL_IMAGE

$(OUT).LIB.LBXUTIL.IMAGE]G3STATES.H : $(OUT).LIB.LBXUTIL.IMAGE]MKG3STATES.OBJ, -
    [.VMS-SUPPORT.LIB.LBXUTIL.IMAGE]G3STATES.COM
	@[.VMS-SUPPORT.LIB.LBXUTIL.IMAGE]G3STATES.COM

$(OUT).LIB.LBXUTIL.IMAGE]DFAXG42D.OBJ : [.LIB.LBXUTIL.IMAGE]DFAXG42D.C, -
    $(LBXUTIL_IMAGE_HEADERS), $(LBXUTIL_IMAGE_PRIVATE_HEADERS), $(LBXUTIL_IMAGE_BUILD_RULES), -
    $(OUT).LIB.LBXUTIL.IMAGE]G3STATES.H, $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL.IMAGE]DFAXG42D "$(LBXUTIL_IMAGE_COUNT_CFLAGS)" LBXUTIL_IMAGE
$(OUT).LIB.LBXUTIL.IMAGE]DPACKBITS.OBJ : [.LIB.LBXUTIL.IMAGE]DPACKBITS.C, -
    $(LBXUTIL_IMAGE_HEADERS), $(LBXUTIL_IMAGE_PRIVATE_HEADERS), $(LBXUTIL_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL.IMAGE]DPACKBITS "$(LBXUTIL_IMAGE_COUNT_CFLAGS)" LBXUTIL_IMAGE
$(OUT).LIB.LBXUTIL.IMAGE]EFAXG42D.OBJ : [.LIB.LBXUTIL.IMAGE]EFAXG42D.C, -
    $(LBXUTIL_IMAGE_HEADERS), $(LBXUTIL_IMAGE_PRIVATE_HEADERS), $(LBXUTIL_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL.IMAGE]EFAXG42D "$(LBXUTIL_IMAGE_COUNT_CFLAGS)" LBXUTIL_IMAGE
$(OUT).LIB.LBXUTIL.IMAGE]EPACKBITS.OBJ : [.LIB.LBXUTIL.IMAGE]EPACKBITS.C, -
    $(LBXUTIL_IMAGE_HEADERS), $(LBXUTIL_IMAGE_PRIVATE_HEADERS), $(LBXUTIL_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL.IMAGE]EPACKBITS "$(LBXUTIL_IMAGE_COUNT_CFLAGS)" LBXUTIL_IMAGE
$(OUT).LIB.LBXUTIL.IMAGE]MISC.OBJ : [.LIB.LBXUTIL.IMAGE]MISC.C, -
    $(LBXUTIL_IMAGE_HEADERS), $(LBXUTIL_IMAGE_PRIVATE_HEADERS), $(LBXUTIL_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBXUTIL.IMAGE]MISC "$(CFLAGS)" LBXUTIL_IMAGE
