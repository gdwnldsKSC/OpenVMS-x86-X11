! Ordinary upstream os library with TCP, XDMCP, MIT cookies and built-in RGB.
OS_HEADERS = $(RENDER_HEADERS), $(XFONT2_HEADERS), $(XAU_HEADERS), $(XDMCP_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRESENTPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PRESENTTOKENS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DRI3PROTO.H, -
    $(XTRANS_HEADERS), $(OUT).INCLUDE.X11]XPOLL.H, -
    $(OUT).INCLUDE.X11]XOS_R.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]BIGREQSPROTO.H
OS_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), [.XSERVER.XORG-SERVER.OS]OSDEP.H, -
    [.XSERVER.XORG-SERVER.PRESENT]PRESENT.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]CLIENT.H, -
    [.LIB.XTRANS]XTRANS.H, -
    [.LIB.XTRANS]XTRANSINT.H
OS_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.OS]DESCRIP.MMS
! Xfuncs replaces equivalent RTL bcopy/bzero macros in the socket namespace.
OS_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF))
! The upstream allocation-formatting helpers require C99 va_copy and vsnprintf.
OS_PRINTF_CFLAGS = $(OS_CFLAGS)/STANDARD=C99
! Same-buffer differences retain the upstream int/size_t count limits.
OS_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF,MAYLOSEDATA3))
! Native P64 iovec layouts agree; the RTL uses its separate __iovec64 tag.
OS_TRANSPORT_CFLAGS = $(CFLAGS)/UNDEFINE=__HIDE_FORBIDDEN_NAMES/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MACROREDEF,PTRMISMATCH))
OS_CPP_DEFINES = HAVE_STRNDUP,XKB_IN_SERVER,""XSERV_t"",TRANS_SERVER,TCPCONN,OPEN_MAX=256,XDMCP, -
    PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1
OS_CPPFLAGS = /DEFINE=($(XSERVER_CRTL_DEFINES),$(OS_CPP_DEFINES))
OS_COLOR_CPPFLAGS = /DEFINE=($(XSERVER_CRTL_DEFINES),$(OS_CPP_DEFINES))
! Upstream connection.c supplies its transport role before including Xtrans.h.
OS_CONNECTION_CPPFLAGS = /DEFINE=($(XSERVER_CRTL_DEFINES),HAVE_STRNDUP,XKB_IN_SERVER,TCPCONN,OPEN_MAX=256,XDMCP, -
    PIXPRIV,RENDER,NO_ALLOCA,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1)

OS_OBJECTS = $(OUT).PROGRAMS.XSERVER.OS]WAITFOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]ACCESS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]AUTH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]BACKTRACE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]CLIENT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]CONNECTION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]INPUTTHREAD.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]IO.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]MITAUTH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]OSCOLOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]OSINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]OSPOLL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]UTILS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]XDMAUTH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]XSHA1.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]XSTRANS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]XPRINTF.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]LOG.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]XDMCP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]REALLOCARRAY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]STRCASESTR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]STRLCAT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]STRLCPY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]TIMINGSAFE_MEMCMP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS.OBJ

OS : $(OUT).PROGRAMS.XSERVER.OS]OS.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.OS]WAITFOR.OBJ : [.XSERVER.XORG-SERVER.OS]WAITFOR.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]WAITFOR "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]ACCESS.OBJ : [.XSERVER.XORG-SERVER.OS]ACCESS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]ACCESS "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]AUTH.OBJ : [.XSERVER.XORG-SERVER.OS]AUTH.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]AUTH "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]BACKTRACE.OBJ : [.XSERVER.XORG-SERVER.OS]BACKTRACE.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]BACKTRACE "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]CLIENT.OBJ : [.XSERVER.XORG-SERVER.OS]CLIENT.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]CLIENT "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]CONNECTION.OBJ : [.XSERVER.XORG-SERVER.OS]CONNECTION.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]CONNECTION "$(OS_CFLAGS)" OS "$(OS_CONNECTION_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]INPUTTHREAD.OBJ : [.XSERVER.XORG-SERVER.OS]INPUTTHREAD.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]INPUTTHREAD "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]IO.OBJ : [.XSERVER.XORG-SERVER.OS]IO.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]IO "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]MITAUTH.OBJ : [.XSERVER.XORG-SERVER.OS]MITAUTH.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]MITAUTH "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OSCOLOR.OBJ : [.XSERVER.XORG-SERVER.OS]OSCOLOR.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]OSCOLOR "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OSINIT.OBJ : [.XSERVER.XORG-SERVER.OS]OSINIT.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]OSINIT "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OSPOLL.OBJ : [.XSERVER.XORG-SERVER.OS]OSPOLL.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]OSPOLL "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]UTILS.OBJ : [.XSERVER.XORG-SERVER.OS]UTILS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]UTILS "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]XDMAUTH.OBJ : [.XSERVER.XORG-SERVER.OS]XDMAUTH.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]XDMAUTH "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]XSHA1.OBJ : [.XSERVER.XORG-SERVER.OS]XSHA1.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]XSHA1 "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]XSTRANS.OBJ : [.XSERVER.XORG-SERVER.OS]XSTRANS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]XSTRANS "$(OS_TRANSPORT_CFLAGS)" OS "$(OS_CONNECTION_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]XPRINTF.OBJ : [.XSERVER.XORG-SERVER.OS]XPRINTF.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]XPRINTF "$(OS_PRINTF_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]LOG.OBJ : [.XSERVER.XORG-SERVER.OS]LOG.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]LOG "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]XDMCP.OBJ : [.XSERVER.XORG-SERVER.OS]XDMCP.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]XDMCP "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]REALLOCARRAY.OBJ : [.XSERVER.XORG-SERVER.OS]REALLOCARRAY.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]REALLOCARRAY "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]STRCASESTR.OBJ : [.XSERVER.XORG-SERVER.OS]STRCASESTR.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]STRCASESTR "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]STRLCAT.OBJ : [.XSERVER.XORG-SERVER.OS]STRLCAT.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]STRLCAT "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]STRLCPY.OBJ : [.XSERVER.XORG-SERVER.OS]STRLCPY.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]STRLCPY "$(OS_COUNT_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]TIMINGSAFE_MEMCMP.OBJ : [.XSERVER.XORG-SERVER.OS]TIMINGSAFE_MEMCMP.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]TIMINGSAFE_MEMCMP "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS.OBJ : [.VMS-SUPPORT.PROGRAMS.XSERVER.OS]VMS_PROCESS.C, -
    $(OS_HEADERS), $(OS_PRIVATE_HEADERS), $(OS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS "$(OS_CFLAGS)" OS "$(OS_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.OS]OS.OLB : $(OS_OBJECTS), $(OS_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]WAITFOR.OBJ,$(OUT).PROGRAMS.XSERVER.OS]ACCESS.OBJ,$(OUT).PROGRAMS.XSERVER.OS]AUTH.OBJ,$(OUT).PROGRAMS.XSERVER.OS]BACKTRACE.OBJ,$(OUT).PROGRAMS.XSERVER.OS]CLIENT.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]CONNECTION.OBJ,$(OUT).PROGRAMS.XSERVER.OS]INPUTTHREAD.OBJ,$(OUT).PROGRAMS.XSERVER.OS]IO.OBJ,$(OUT).PROGRAMS.XSERVER.OS]MITAUTH.OBJ,$(OUT).PROGRAMS.XSERVER.OS]OSCOLOR.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]OSINIT.OBJ,$(OUT).PROGRAMS.XSERVER.OS]OSPOLL.OBJ,$(OUT).PROGRAMS.XSERVER.OS]UTILS.OBJ,$(OUT).PROGRAMS.XSERVER.OS]XDMAUTH.OBJ,$(OUT).PROGRAMS.XSERVER.OS]XSHA1.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]XSTRANS.OBJ,$(OUT).PROGRAMS.XSERVER.OS]XPRINTF.OBJ,$(OUT).PROGRAMS.XSERVER.OS]LOG.OBJ,$(OUT).PROGRAMS.XSERVER.OS]XDMCP.OBJ,$(OUT).PROGRAMS.XSERVER.OS]REALLOCARRAY.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.OS]STRCASESTR.OBJ,$(OUT).PROGRAMS.XSERVER.OS]STRLCAT.OBJ,$(OUT).PROGRAMS.XSERVER.OS]STRLCPY.OBJ,$(OUT).PROGRAMS.XSERVER.OS]TIMINGSAFE_MEMCMP.OBJ,$(OUT).PROGRAMS.XSERVER.OS]VMS_PROCESS.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.OS]OS_LIBRARY.LIS $(MMS$TARGET)
