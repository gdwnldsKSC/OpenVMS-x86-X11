! Native Xorg using the ordinary upstream loader and video/input drivers.
! BUILD XORG selects P64_XORG, separate from standalone library/Xvfb objects.
XORG_NATIVE_SOURCE = [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.OPENVMS]
XORG_NATIVE_OUT = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.OPENVMS]
XORG_BUILD_SOURCE = [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OPENVMS]
XORG_RULES = $(XORG_BUILD_SOURCE)DESCRIP.MMS, $(XORG_BUILD_SOURCE)SERVER_PROFILE.H, -
    $(XORG_BUILD_SOURCE)DRIVER_PROFILE.H, $(XORG_BUILD_SOURCE)LINK_XORG.COM, -
    $(XORG_BUILD_SOURCE)XORG_LINK_OPTIONS.C, $(XORG_BUILD_SOURCE)XORG_OBJECTS.DAT
XORG_NATIVE_HEADERS = $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), -
    $(XORG_NATIVE_SOURCE)OPENVMS_DLOPEN.H, $(XORG_NATIVE_SOURCE)OPENVMS_LOADER.H, -
    $(XORG_NATIVE_SOURCE)OPENVMS_INPUT.H, $(XORG_NATIVE_SOURCE)OPENVMS_SERIAL.H, -
    $(XORG_NATIVE_SOURCE)OPENVMS_I8042.H
XORG_NATIVE_OBJECTS = $(XORG_NATIVE_OUT)OPENVMS_INIT.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_IO.OBJ, $(XORG_NATIVE_OUT)OPENVMS_DLOPEN.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_INPUT.OBJ, $(XORG_NATIVE_OUT)OPENVMS_SERIAL.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_I8042.OBJ, $(XORG_NATIVE_OUT)OPENVMS_I8042_CONTROLLER.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_I8042_PIO.OBJ, $(XORG_NATIVE_OUT)OPENVMS_CLOCK.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_INPUT_BACKEND.OBJ, -
    $(XORG_NATIVE_OUT)OPENVMS_MAIN.OBJ

XORG : XSERVER_CORE, XF86CONFIG, COMMON, XF86MODES, DDC, I2C, RAMDAC, BUS, MISC, -
    STUB, XORGXKB, LOADER, PCIACCESS, REGEX, XCVT, VGAHW, SHADOWFB, XF86_VIDEO_VMWARE, -
    XF86_INPUT_KEYBOARD, XF86_INPUT_MOUSE, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMAIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVDISP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XEXT]XVMC.OBJ, $(XORG_NATIVE_OBJECTS), $(XORG_RULES)
	@$(XORG_BUILD_SOURCE)LINK_XORG.COM "$(XORG_BUILD_SOURCE)XORG_OBJECTS.DAT" "$(OUT).LINK]"

! All selected loadable modules depend on the same core export/image identity.
XORG_MODULES : XORG
	CONTINUE

! BUILD XORG scopes DDXBEFORERESET to DIX through the existing MMS macro.
! Recompile its caller when that build-time selection changes.
$(OUT).PROGRAMS.XSERVER.HW.VFB.SERVER.DIX]DISPATCH.OBJ : [.VMS-SUPPORT]BUILD.COM, $(XORG_RULES)

$(XORG_NATIVE_OUT)OPENVMS_INIT.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_INIT.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_INIT "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_IO.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_IO.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_IO "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_DLOPEN.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_DLOPEN.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_DLOPEN "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_INPUT.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_INPUT.C, -
    $(XORG_NATIVE_HEADERS), $(KBD_PRIVATE_HEADERS), $(MOUSE_PRIVATE_HEADERS), -
    $(OUT).INCLUDE]XORG-SERVER.H, $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_INPUT "$(XF86COMMON_CFLAGS)" COMMON "$(KBD_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_SERIAL.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_SERIAL.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_SERIAL "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

$(XORG_NATIVE_OUT)OPENVMS_I8042.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_I8042.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_I8042 "$(CFLAGS)" RTL_LOCAL

$(XORG_NATIVE_OUT)OPENVMS_I8042_CONTROLLER.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_I8042_CONTROLLER.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_I8042_CONTROLLER "$(CFLAGS)" RTL_LOCAL

! This leaf executes on a kernel stack; the x86-64 red zone must be disabled.
$(XORG_NATIVE_OUT)OPENVMS_I8042_PIO.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_I8042_PIO.C, -
    $(XORG_NATIVE_SOURCE)OPENVMS_I8042.H, $(XORG_RULES)
	MCR CLANG "-x" "c" "-c" "-mno-red-zone" "-o" "$(MMS$TARGET)" "$(MMS$SOURCE)"

$(XORG_NATIVE_OUT)OPENVMS_CLOCK.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_CLOCK.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_CLOCK "$(CFLAGS)" RTL_LOCAL

$(XORG_NATIVE_OUT)OPENVMS_INPUT_BACKEND.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_INPUT_BACKEND.C, -
    $(XORG_NATIVE_HEADERS), $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_INPUT_BACKEND "$(CFLAGS)" RTL_LOCAL

$(XORG_NATIVE_OUT)OPENVMS_MAIN.OBJ : $(XORG_NATIVE_SOURCE)OPENVMS_MAIN.C, -
    $(XORG_NATIVE_SOURCE)OPENVMS_DLOPEN.H, $(XORG_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(XORG_NATIVE_OUT)OPENVMS_MAIN "$(CFLAGS)/POINTER_SIZE=64=ARGV/MAIN=POSIX_EXIT" RTL_LOCAL
