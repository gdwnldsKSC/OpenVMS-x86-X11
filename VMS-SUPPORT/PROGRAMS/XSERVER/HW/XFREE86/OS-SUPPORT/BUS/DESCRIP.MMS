! Generic upstream libbus; native PCI access is supplied by the consuming OS.
! No ix86 port transactions or assumed domain/mapping implementation selected.
XF86BUS_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]DESCRIP.MMS
XF86BUS_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]PCI.OBJ

BUS : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]BUS.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]PCI.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]PCI.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86BUS_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]PCI "$(XF86COMMON_CFLAGS)" BUS "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]BUS.OLB : $(XF86BUS_OBJECTS), $(XF86BUS_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XF86BUS_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.BUS]BUS_LIBRARY.LIS $(MMS$TARGET)
