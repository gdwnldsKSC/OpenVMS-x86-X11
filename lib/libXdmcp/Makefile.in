pkgconfigDATA_INSTALL = $(INSTALL_DATA)
install-pkgconfigDATA: $(pkgconfig_DATA)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(pkgconfigdir)
	@list='$(pkgconfig_DATA)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " $(pkgconfigDATA_INSTALL) $$d$$p $(DESTDIR)$(pkgconfigdir)/$$f"; \
	  $(pkgconfigDATA_INSTALL) $$d$$p $(DESTDIR)$(pkgconfigdir)/$$f; \
	done

uninstall-pkgconfigDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(pkgconfig_DATA)'; for p in $$list; do \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f $(DESTDIR)$(pkgconfigdir)/$$f"; \
	  rm -f $(DESTDIR)$(pkgconfigdir)/$$f; \
	done
xdmcpincludeHEADERS_INSTALL = $(INSTALL_HEADER)
install-xdmcpincludeHEADERS: $(xdmcpinclude_HEADERS)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(xdmcpincludedir)
	@list='$(xdmcpinclude_HEADERS)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " $(xdmcpincludeHEADERS_INSTALL) $$d$$p $(DESTDIR)$(xdmcpincludedir)/$$f"; \
	  $(xdmcpincludeHEADERS_INSTALL) $$d$$p $(DESTDIR)$(xdmcpincludedir)/$$f; \
	done

uninstall-xdmcpincludeHEADERS:
	@$(NORMAL_UNINSTALL)
	@list='$(xdmcpinclude_HEADERS)'; for p in $$list; do \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f $(DESTDIR)$(xdmcpincludedir)/$$f"; \
	  rm -f $(DESTDIR)$(xdmcpincludedir)/$$f; \
	done

