! programs/iceauth/Imakefile's two objects plus native permission entry setup.
ICEAUTH_HEADERS = $(ICE_HEADERS)
ICEAUTH_PRIVATE_HEADERS = [.PROGRAMS.ICEAUTH]ICEAUTH.H
ICEAUTH_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                     [.VMS-SUPPORT]HEADERS.MMS, -
                     [.VMS-SUPPORT.PROGRAMS.ICEAUTH]DESCRIP.MMS
! Expose the installed RTL's fileno, isascii and link declarations in C99.
ICEAUTH_CFLAGS = $(CFLAGS)/DEFINE=_XOPEN_SOURCE=600/MAIN=POSIX_EXIT
! Rename upstream main so native permission setup runs before file operations.
! Every path in the renamed upstream main terminates through exit.
ICEAUTH_MAIN_CFLAGS = $(ICEAUTH_CFLAGS)/DEFINE=(_XOPEN_SOURCE=600,""main""=VMS_ICEAUTH_MAIN) -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=MISSINGRETURN)
! Pass the actual main's argv onward as an ordinary 64-bit pointer array.
ICEAUTH_ENTRY_CFLAGS = $(ICEAUTH_CFLAGS)/POINTER_SIZE=64=ARGV

ICEAUTH : $(OUT).PROGRAMS.ICEAUTH]ICEAUTH.EXE
	CONTINUE

$(OUT).PROGRAMS.ICEAUTH]ENTRY.OBJ : [.VMS-SUPPORT.PROGRAMS.ICEAUTH]ENTRY.C, -
    $(ICEAUTH_HEADERS), $(ICEAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.ICEAUTH]ENTRY "$(ICEAUTH_ENTRY_CFLAGS)" ICEAUTH

$(OUT).PROGRAMS.ICEAUTH]ICEAUTH.OBJ : [.PROGRAMS.ICEAUTH]ICEAUTH.C, -
    $(ICEAUTH_HEADERS), $(ICEAUTH_PRIVATE_HEADERS), $(ICEAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.ICEAUTH]ICEAUTH "$(ICEAUTH_MAIN_CFLAGS)" ICEAUTH

$(OUT).PROGRAMS.ICEAUTH]PROCESS.OBJ : [.PROGRAMS.ICEAUTH]PROCESS.C, -
    $(ICEAUTH_HEADERS), $(ICEAUTH_PRIVATE_HEADERS), $(ICEAUTH_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.ICEAUTH]PROCESS "$(ICEAUTH_CFLAGS)" ICEAUTH

$(OUT).PROGRAMS.ICEAUTH]ICEAUTH.EXE : $(OUT).PROGRAMS.ICEAUTH]ENTRY.OBJ, -
    $(OUT).PROGRAMS.ICEAUTH]ICEAUTH.OBJ, -
    $(OUT).PROGRAMS.ICEAUTH]PROCESS.OBJ, $(OUT).LIB.ICE]ICE.OLB, -
    [.VMS-SUPPORT.PROGRAMS.ICEAUTH]LINK.COM, -
    [.VMS-SUPPORT.PROGRAMS.ICEAUTH]DESCRIP.MMS
	@[.VMS-SUPPORT.PROGRAMS.ICEAUTH]LINK.COM
