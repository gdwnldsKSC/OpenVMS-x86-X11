! Image-codec subdirectory of lbxutil; not the complete LBX utility library.
LBX_IMAGE_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]LBXIMAGE.H
LBX_IMAGE_PRIVATE_HEADERS = [.LIB.LBXUTIL.IMAGE]LBXFAX.H, [.LIB.LBXUTIL.IMAGE]LBXBWCODES.H
LBX_IMAGE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                       [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.LBX_IMAGE]DESCRIP.MMS
! Preserve the codecs' int-sized byte-count API when narrowing P64 buffer offsets.
LBX_IMAGE_COUNT_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
LBX_IMAGE_OBJECTS = $(OUT).LIB.LBX_IMAGE]DFAXG42D.OBJ, -
                    $(OUT).LIB.LBX_IMAGE]DPACKBITS.OBJ, -
                    $(OUT).LIB.LBX_IMAGE]EFAXG42D.OBJ, -
                    $(OUT).LIB.LBX_IMAGE]EPACKBITS.OBJ, -
                    $(OUT).LIB.LBX_IMAGE]MISC.OBJ

LBX_IMAGE : $(OUT).LIB.LBX_IMAGE]LBX_IMAGE.OLB
	CONTINUE

$(OUT).INCLUDE.X11.EXTENSIONS]LBXIMAGE.H : [.INCLUDE.EXTENSIONS]LBXIMAGE.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).LIB.LBX_IMAGE]MKG3STATES.OBJ : [.LIB.LBXUTIL.IMAGE]MKG3STATES.C, -
    $(LBX_IMAGE_HEADERS), $(LBX_IMAGE_PRIVATE_HEADERS), $(LBX_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBX_IMAGE]MKG3STATES "$(CFLAGS)/MAIN=POSIX_EXIT" LBX_IMAGE

$(OUT).LIB.LBX_IMAGE]G3STATES.H : $(OUT).LIB.LBX_IMAGE]MKG3STATES.OBJ, -
    [.VMS-SUPPORT.LIB.LBX_IMAGE]G3STATES.COM
	@[.VMS-SUPPORT.LIB.LBX_IMAGE]G3STATES.COM

$(OUT).LIB.LBX_IMAGE]DFAXG42D.OBJ : [.LIB.LBXUTIL.IMAGE]DFAXG42D.C, -
    $(LBX_IMAGE_HEADERS), $(LBX_IMAGE_PRIVATE_HEADERS), $(LBX_IMAGE_BUILD_RULES), -
    $(OUT).LIB.LBX_IMAGE]G3STATES.H, $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBX_IMAGE]DFAXG42D "$(LBX_IMAGE_COUNT_CFLAGS)" LBX_IMAGE
$(OUT).LIB.LBX_IMAGE]DPACKBITS.OBJ : [.LIB.LBXUTIL.IMAGE]DPACKBITS.C, -
    $(LBX_IMAGE_HEADERS), $(LBX_IMAGE_PRIVATE_HEADERS), $(LBX_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBX_IMAGE]DPACKBITS "$(LBX_IMAGE_COUNT_CFLAGS)" LBX_IMAGE
$(OUT).LIB.LBX_IMAGE]EFAXG42D.OBJ : [.LIB.LBXUTIL.IMAGE]EFAXG42D.C, -
    $(LBX_IMAGE_HEADERS), $(LBX_IMAGE_PRIVATE_HEADERS), $(LBX_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBX_IMAGE]EFAXG42D "$(LBX_IMAGE_COUNT_CFLAGS)" LBX_IMAGE
$(OUT).LIB.LBX_IMAGE]EPACKBITS.OBJ : [.LIB.LBXUTIL.IMAGE]EPACKBITS.C, -
    $(LBX_IMAGE_HEADERS), $(LBX_IMAGE_PRIVATE_HEADERS), $(LBX_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBX_IMAGE]EPACKBITS "$(LBX_IMAGE_COUNT_CFLAGS)" LBX_IMAGE
$(OUT).LIB.LBX_IMAGE]MISC.OBJ : [.LIB.LBXUTIL.IMAGE]MISC.C, -
    $(LBX_IMAGE_HEADERS), $(LBX_IMAGE_PRIVATE_HEADERS), $(LBX_IMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.LBX_IMAGE]MISC "$(CFLAGS)" LBX_IMAGE

$(OUT).LIB.LBX_IMAGE]LBX_IMAGE.OLB : $(LBX_IMAGE_OBJECTS), [.VMS-SUPPORT.LIB.LBX_IMAGE]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(LBX_IMAGE_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.LBX_IMAGE]LBX_IMAGE_LIBRARY.LIS $(MMS$TARGET)
