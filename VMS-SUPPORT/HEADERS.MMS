! Export upstream headers and generate their configured native variants.
COMMON_HEADERS = $(OUT).INCLUDE.X11]XFUNCPROTO.H, -
                 $(OUT).INCLUDE.X11]XFUNCS.H, -
                 $(OUT).INCLUDE.X11]XOSDEFS.H, -
                 $(OUT).INCLUDE.X11]XOS.H, -
                 $(OUT).INCLUDE.X11]XARCH.H

XCLIENT_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.X11]X.H, -
                  $(OUT).INCLUDE.X11]XMD.H, $(OUT).INCLUDE.X11]XPROTO.H, -
                  $(OUT).INCLUDE.X11]XPROTOSTR.H, $(OUT).INCLUDE.X11]XLIB.H, -
                  $(OUT).INCLUDE.X11]XLIBINT.H, $(OUT).INCLUDE.X11]XLIBCONF.H, -
                  $(OUT).INCLUDE.X11]XUTIL.H, $(OUT).INCLUDE.X11]XREGION.H, -
                  $(OUT).INCLUDE.X11]IMUTIL.H

! lib/xtrans/Imakefile exports included C sources as well as public headers.
XTRANS_HEADERS = $(OUT).INCLUDE.X11.XTRANS]XTRANS.H, -
    $(OUT).INCLUDE.X11.XTRANS]XTRANS.C, $(OUT).INCLUDE.X11.XTRANS]XTRANSDNET.C, -
    $(OUT).INCLUDE.X11.XTRANS]XTRANSINT.H, $(OUT).INCLUDE.X11.XTRANS]XTRANSLCL.C, -
    $(OUT).INCLUDE.X11.XTRANS]XTRANSOS2.C, $(OUT).INCLUDE.X11.XTRANS]XTRANSSOCK.C, -
    $(OUT).INCLUDE.X11.XTRANS]XTRANSTLI.C, $(OUT).INCLUDE.X11.XTRANS]XTRANSUTIL.C, -
    $(OUT).INCLUDE.X11.XTRANS]TRANSPORT.C

