! Complete static XFree86 shadowfb library; sfbmodule.c is loader-only metadata.
! This is separate from miext/shadow and uses the P64/long32 XFree86 profile.
SHADOWFB_HEADERS = $(MI_HEADERS)
SHADOWFB_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SHADOWFB]SHADOWFB.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86VERSION.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H
SHADOWFB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]DESCRIP.MMS
SHADOWFB_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
SHADOWFB_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT, -
    NO_INLINE,XORG_VERSION_CURRENT=70100000,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0, -
    IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)
SHADOWFB_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]SHADOW.OBJ

SHADOWFB : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]SHADOWFB.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]SHADOW.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.SHADOWFB]SHADOW.C, -
    $(SHADOWFB_HEADERS), $(SHADOWFB_PRIVATE_HEADERS), $(SHADOWFB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]SHADOW "$(SHADOWFB_CFLAGS)" SHADOWFB "$(SHADOWFB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]SHADOWFB.OLB : $(SHADOWFB_OBJECTS), $(SHADOWFB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(SHADOWFB_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.SHADOWFB]SHADOWFB_LIBRARY.LIS $(MMS$TARGET)
