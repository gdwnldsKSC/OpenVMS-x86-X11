! Complete lib/psres/Imakefile library, using the unchanged public DPS interface.
PSRES_HEADERS = $(COMMON_HEADERS), $(OUT).INCLUDE.DPS]PSRES.H
PSRES_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                    [.VMS-SUPPORT]HEADERS.MMS, -
                    [.VMS-SUPPORT.LIB.PSRES]DESCRIP.MMS
PSRES_CFLAGS = $(CFLAGS)/DEFINE=(XENVIRONMENT)
PSRES_OBJECTS = $(OUT).LIB.PSRES]PSRES.OBJ

PSRES : $(OUT).LIB.PSRES]PSRES.OLB
	CONTINUE

$(OUT).LIB.PSRES]PSRES.OBJ : [.LIB.PSRES]PSRES.C, $(PSRES_HEADERS), -
    $(PSRES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PSRES]PSRES "$(PSRES_CFLAGS)" PSRES

$(OUT).LIB.PSRES]PSRES.OLB : $(PSRES_OBJECTS), [.VMS-SUPPORT.LIB.PSRES]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(PSRES_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.PSRES]PSRES_LIBRARY.LIS $(MMS$TARGET)
