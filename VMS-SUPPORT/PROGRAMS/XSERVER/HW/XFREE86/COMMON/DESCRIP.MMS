    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86COMMON_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.COMMON]XF86CONFIGURE "$(XF86COMMON_CFLAGS)" COMMON "$(XF86COMMON_CPPFLAGS)"

