! Buffered font-file I/O subset of lib/font/fontfile/Imakefile.
FONTIO_HEADERS = $(COMMON_HEADERS), $(ZLIB_HEADERS), $(OUT).INCLUDE.X11]XDEFS.H
FONTIO_PRIVATE_HEADERS = [.LIB.FONT.INCLUDE]FONTMISC.H, -
                         [.LIB.FONT.INCLUDE]BUFIO.H, [.LIB.FONT.INCLUDE]FNTFILIO.H
FONTIO_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
                    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.FONTIO]DESCRIP.MMS
FONTIO_CFLAGS = $(CFLAGS)/DEFINE=(X_GZIP_FONT_COMPRESSION)
! Buffer differences are bounded by BUFFILESIZE; preserve upstream int counts.
FONTIO_COUNT_CFLAGS = $(FONTIO_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=MAYLOSEDATA3)
! BUFIO's private field encodes an int fd, not a dereferenceable pointer.
FONTIO_BUF_CFLAGS = $(FONTIO_CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=(MAYLOSEDATA3,POINTERINTCAST))
FONTIO_OBJECTS = $(OUT).LIB.FONTIO]BUFIO.OBJ, -
                 $(OUT).LIB.FONTIO]FILEIO.OBJ, -
                 $(OUT).LIB.FONTIO]FILEWR.OBJ, -
                 $(OUT).LIB.FONTIO]DECOMPRESS.OBJ, -
                 $(OUT).LIB.FONTIO]GUNZIP.OBJ

FONTIO : $(OUT).LIB.FONTIO]FONTIO.OLB, $(OUT).LIB.FONTUTIL]FONTUTIL.OLB, -
         $(OUT).LIB.ZLIB]Z.OLB
	CONTINUE

$(OUT).LIB.FONTIO]BUFIO.OBJ : [.LIB.FONT.FONTFILE]BUFIO.C, -
    $(FONTIO_HEADERS), $(FONTIO_PRIVATE_HEADERS), $(FONTIO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTIO]BUFIO "$(FONTIO_BUF_CFLAGS)" FONTIO

$(OUT).LIB.FONTIO]FILEIO.OBJ : [.LIB.FONT.FONTFILE]FILEIO.C, -
    $(FONTIO_HEADERS), $(FONTIO_PRIVATE_HEADERS), $(FONTIO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTIO]FILEIO "$(FONTIO_CFLAGS)" FONTIO

$(OUT).LIB.FONTIO]FILEWR.OBJ : [.LIB.FONT.FONTFILE]FILEWR.C, -
    $(FONTIO_HEADERS), $(FONTIO_PRIVATE_HEADERS), $(FONTIO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTIO]FILEWR "$(FONTIO_CFLAGS)" FONTIO

$(OUT).LIB.FONTIO]DECOMPRESS.OBJ : [.LIB.FONT.FONTFILE]DECOMPRESS.C, -
    $(FONTIO_HEADERS), $(FONTIO_PRIVATE_HEADERS), $(FONTIO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTIO]DECOMPRESS "$(FONTIO_COUNT_CFLAGS)" FONTIO

$(OUT).LIB.FONTIO]GUNZIP.OBJ : [.LIB.FONT.FONTFILE]GUNZIP.C, -
    $(FONTIO_HEADERS), $(FONTIO_PRIVATE_HEADERS), $(FONTIO_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.FONTIO]GUNZIP "$(FONTIO_CFLAGS)" FONTIO

$(OUT).LIB.FONTIO]FONTIO.OLB : $(FONTIO_OBJECTS), [.VMS-SUPPORT.LIB.FONTIO]DESCRIP.MMS
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FONTIO_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.FONTIO]FONTIO_LIBRARY.LIS $(MMS$TARGET)
