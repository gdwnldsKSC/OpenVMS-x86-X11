! Complete ordinary static XFixes library from the upstream Imakefile.
! Native P64 pointers and long32; Render enabled, optional extension hooks excluded.
XFIXES_HEADERS = $(RENDER_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XFIXESPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XFIXESWIRE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H
XFIXES_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.XFIXES]XFIXES.H, -
    [.PROGRAMS.XSERVER.XFIXES]XFIXESINT.H
XFIXES_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.XFIXES]DESCRIP.MMS
XFIXES_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Cursor-name closures encode scalar Atom IDs, not addresses to dereference.
XFIXES_CURSOR_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,POINTERINTCAST))
XFIXES_CPPFLAGS = /DEFINE=(XFIXES,PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

XFIXES_OBJECTS = $(OUT).PROGRAMS.XSERVER.XFIXES]CURSOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XFIXES]REGION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XFIXES]SAVESET.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XFIXES]SELECT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES.OBJ

XFIXES : $(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.XFIXES]CURSOR.OBJ : [.PROGRAMS.XSERVER.XFIXES]CURSOR.C, -
    $(XFIXES_HEADERS), $(XFIXES_PRIVATE_HEADERS), $(XFIXES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XFIXES]CURSOR "$(XFIXES_CURSOR_CFLAGS)" XFIXES "$(XFIXES_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XFIXES]REGION.OBJ : [.PROGRAMS.XSERVER.XFIXES]REGION.C, -
    $(XFIXES_HEADERS), $(XFIXES_PRIVATE_HEADERS), $(XFIXES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XFIXES]REGION "$(XFIXES_CFLAGS)" XFIXES "$(XFIXES_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XFIXES]SAVESET.OBJ : [.PROGRAMS.XSERVER.XFIXES]SAVESET.C, -
    $(XFIXES_HEADERS), $(XFIXES_PRIVATE_HEADERS), $(XFIXES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XFIXES]SAVESET "$(XFIXES_CFLAGS)" XFIXES "$(XFIXES_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XFIXES]SELECT.OBJ : [.PROGRAMS.XSERVER.XFIXES]SELECT.C, -
    $(XFIXES_HEADERS), $(XFIXES_PRIVATE_HEADERS), $(XFIXES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XFIXES]SELECT "$(XFIXES_CFLAGS)" XFIXES "$(XFIXES_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES.OBJ : [.PROGRAMS.XSERVER.XFIXES]XFIXES.C, -
    $(XFIXES_HEADERS), $(XFIXES_PRIVATE_HEADERS), $(XFIXES_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES "$(XFIXES_CFLAGS)" XFIXES "$(XFIXES_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES.OLB : $(XFIXES_OBJECTS), $(XFIXES_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XFIXES]CURSOR.OBJ,$(OUT).PROGRAMS.XSERVER.XFIXES]REGION.OBJ,$(OUT).PROGRAMS.XSERVER.XFIXES]SAVESET.OBJ,$(OUT).PROGRAMS.XSERVER.XFIXES]SELECT.OBJ,$(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XFIXES]XFIXES_LIBRARY.LIS $(MMS$TARGET)
