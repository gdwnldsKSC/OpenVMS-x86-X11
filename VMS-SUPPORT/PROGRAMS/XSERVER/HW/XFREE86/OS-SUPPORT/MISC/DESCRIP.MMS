! Complete upstream os-support/misc libmisc, using its portable C sources.
! P64/long32 and the shared static XFree86 profile; OS hooks remain unresolved.
XF86MISC_BUILD_RULES = $(XF86COMMON_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]ARCHIVE.COM
XF86MISC_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]XF86_UTIL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]DELAY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]BUSMEMCPY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]IODELAY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]SLOWBCOPY.OBJ

MISC : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]MISC.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]XF86_UTIL.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.MISC]XF86_UTIL.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86MISC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]XF86_UTIL "$(XF86COMMON_CFLAGS)" MISC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]DELAY.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.MISC]DELAY.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86MISC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]DELAY "$(XF86COMMON_CFLAGS)" MISC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]BUSMEMCPY.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.MISC]BUSMEMCPY.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86MISC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]BUSMEMCPY "$(XF86COMMON_CFLAGS)" MISC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]IODELAY.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.MISC]IODELAY.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86MISC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]IODELAY "$(XF86COMMON_CFLAGS)" MISC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]SLOWBCOPY.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.MISC]SLOWBCOPY.C, -
    $(XF86COMMON_HEADERS), $(XF86COMMON_PRIVATE_HEADERS), $(XF86MISC_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]SLOWBCOPY "$(XF86COMMON_CFLAGS)" MISC "$(XF86COMMON_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]MISC.OLB : $(XF86MISC_OBJECTS), $(XF86MISC_BUILD_RULES)
	@[.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]ARCHIVE.COM $(OUT).PROGRAMS.XSERVER.HW.XFREE86.OS-SUPPORT.MISC]
