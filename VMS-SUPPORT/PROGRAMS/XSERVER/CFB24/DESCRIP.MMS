! Complete static upstream cfb24 library; PSZ=24, no optional platform/loadable hooks.
! Native P64 pointers with upstream CARD32 pixel groups and 32-bit long values.
CFB24_HEADERS = $(MFB_HEADERS)
CFB24_PRIVATE_HEADERS = $(MFB_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.CFB]CFB.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB16.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB24.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB32.H, -
    [.XSERVER.XORG-SERVER.CFB]CFB8BIT.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBMAP.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBMSKBITS.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBRROP.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBTAB.H, -
    [.XSERVER.XORG-SERVER.CFB]CFBUNMAP.H, -
    [.XSERVER.XORG-SERVER.CFB24]CFBRROP24.H, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB]VMS_CFB_NATIVE.H
CFB24_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MFB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.CFB24]DESCRIP.MMS
CFB24_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Preserve upstream int-sized clipped-box/input counts and pixel-word indices with P64 pointers.
CFB24_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
CFB24_CPP_DEFINES = PIXPRIV,PSZ=24,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1
CFB24_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES))

CFB24_CFBSOLIDC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB24_CFBSOLIDX_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB24_CFBSOLIDG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXset"")
CFB24_CFBTILEODDC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB24_CFBTILEODDG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=0"")
CFB24_CFBTILE32C_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB24_CFBTILE32G_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=0"")
CFB24_CFBZERARCC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB24_CFBZERARCX_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB24_CFBZERARCG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXset"")
CFB24_CFBFILLARCC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB24_CFBFILLARCG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXset"")
CFB24_CFBSEG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""POLYSEGMENT"")
CFB24_CFB8LINECO_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB24_CFB8LINEX_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXxor"")
CFB24_CFB8LINEG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXset"")
CFB24_CFB8LINECP_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""PREVIOUS"")
CFB24_CFB8SEGCS_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"", -
    ""WIDTH_SHIFT"")
CFB24_CFB8SEGX_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXxor"", -
    ""POLYSEGMENT"")
CFB24_CFB8SEGG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXset"", -
    ""POLYSEGMENT"")
CFB24_CFB8SEGC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"", -
    ""POLYSEGMENT"")
CFB24_CFBBLTC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=Mcopy"")
CFB24_CFBBLTX_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=Mxor"")
CFB24_CFBBLTO_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=Mor"")
CFB24_CFBBLTG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""MROP=0"")
CFB24_CFBPLY1RCTC_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXcopy"")
CFB24_CFBPLY1RCTG_CPPFLAGS = /DEFINE=($(CFB24_CPP_DEFINES), -
    ""RROP=GXset"")

! Exact-byte aliases retain distinct native object module names for Unix variants.
$(OUT).PROGRAMS.XSERVER.CFB24]CFBSOLIDC.C : [.XSERVER.XORG-SERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.CFB24]CFBSOLIDX.C : [.XSERVER.XORG-SERVER.CFB]CFBSOLID.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

