! Complete XFree86 vgahw library, including the upstream module descriptor.
! P64/long32 with external port-I/O and XFree86 services supplied by the consumer.
VGAHW_HEADERS = $(PCIACCESS_HEADERS), $(MI_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]DPMS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMSCONST.H
VGAHW_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VGAHW]VGAHW.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]COMPILER.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86STR.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86MODULE.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86OPT.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.COMMON]XF86CMAP.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT]XF86_OSPROC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.OS-SUPPORT.BUS]XF86PCI.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]XF86DDC.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.DDC]EDID.H, -
    [.XSERVER.XORG-SERVER.HW.XFREE86.I2C]XF86I2C.H
VGAHW_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.XFREE86.VGAHW]DESCRIP.MMS
VGAHW_CFLAGS = $(CFLAGS)/WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
VGAHW_CPPFLAGS = /DEFINE=(FUNCPROTO=15,ANSICPP,X_BYTE_ORDER=1234,PIXPRIV,RENDER,XKB,XINPUT,XKB_IN_SERVER, -
    NO_INLINE,XORG_VERSION_CURRENT=10903000,XSERVER_LIBPCIACCESS=1,ARCH_PCI_INIT=vmsPciInit,GLYPHPADBYTES=4, -
    GETLEFTBITS_ALIGNMENT=1)
VGAHW_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHWMODULE.OBJ

VGAHW : $(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHW.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHW.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VGAHW]VGAHW.C, -
    $(VGAHW_HEADERS), $(VGAHW_PRIVATE_HEADERS), $(VGAHW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHW "$(VGAHW_CFLAGS)" VGAHW "$(VGAHW_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHW.OLB : $(VGAHW_OBJECTS), $(VGAHW_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(VGAHW_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHW_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHWMODULE.OBJ : -
    [.XSERVER.XORG-SERVER.HW.XFREE86.VGAHW]VGAHWMODULE.C, -
    $(VGAHW_HEADERS), $(VGAHW_PRIVATE_HEADERS), $(VGAHW_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.XFREE86.VGAHW]VGAHWMODULE "$(VGAHW_CFLAGS)" VGAHW "$(VGAHW_CPPFLAGS)"
