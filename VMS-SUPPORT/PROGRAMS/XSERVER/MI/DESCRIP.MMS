! Complete ordinary static mi library and separate upstream cbrt auxiliary target.
! Native cbrt is selected; optional extensions, Render and loadable hooks are excluded.
MI_HEADERS = $(DAMAGE_HEADERS)
MI_PRIVATE_HEADERS = $(DAMAGE_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.MI]MI.H, -
    [.PROGRAMS.XSERVER.MI]MIBANK.H, -
    [.PROGRAMS.XSERVER.MI]MIBSTORE.H, -
    [.PROGRAMS.XSERVER.MI]MIBSTOREST.H, -
    [.PROGRAMS.XSERVER.MI]MICMAP.H, -
    [.PROGRAMS.XSERVER.MI]MICOORD.H, -
    [.PROGRAMS.XSERVER.MI]MIFILLARC.H, -
    [.PROGRAMS.XSERVER.MI]MIFPOLY.H, -
    [.PROGRAMS.XSERVER.MI]MIGC.H, -
    [.PROGRAMS.XSERVER.MI]MILINE.H, -
    [.PROGRAMS.XSERVER.MI]MIOVERLAY.H, -
    [.PROGRAMS.XSERVER.MI]MIPOINTER.H, -
    [.PROGRAMS.XSERVER.MI]MIPOINTRST.H, -
    [.PROGRAMS.XSERVER.MI]MIPOLY.H, -
    [.PROGRAMS.XSERVER.MI]MISCANFILL.H, -
    [.PROGRAMS.XSERVER.MI]MISPANS.H, -
    [.PROGRAMS.XSERVER.MI]MISPRITE.H, -
    [.PROGRAMS.XSERVER.MI]MISPRITEST.H, -
    [.PROGRAMS.XSERVER.MI]MISTRUCT.H, -
    [.PROGRAMS.XSERVER.MI]MIVALIDATE.H, -
    [.PROGRAMS.XSERVER.MI]MIWIDELINE.H, -
    [.PROGRAMS.XSERVER.MI]MIZERARC.H, -
    [.PROGRAMS.XSERVER.INCLUDE]BSTORE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]BSTORESTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]CLOSESTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]CLOSURE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]COLORMAP.H, -
    [.PROGRAMS.XSERVER.INCLUDE]COLORMAPST.H, -
    [.PROGRAMS.XSERVER.INCLUDE]CURSOR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]CURSORSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIX.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIXEVENTS.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIXFONT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIXFONTSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIXGRABS.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIXSTRUCT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]EXEVENTS.H, -
    [.PROGRAMS.XSERVER.INCLUDE]EXTENSION.H, -
    [.PROGRAMS.XSERVER.INCLUDE]EXTINIT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]EXTNSIONST.H, -
    [.PROGRAMS.XSERVER.INCLUDE]GC.H, -
    [.PROGRAMS.XSERVER.INCLUDE]GCSTRUCT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]GLOBALS.H, -
    [.PROGRAMS.XSERVER.INCLUDE]INPUT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]INPUTSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]MISC.H, -
    [.PROGRAMS.XSERVER.INCLUDE]MISCSTRUCT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]OPAQUE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]OS.H, -
    [.PROGRAMS.XSERVER.INCLUDE]PIXMAP.H, -
    [.PROGRAMS.XSERVER.INCLUDE]PIXMAPSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]PROPERTY.H, -
    [.PROGRAMS.XSERVER.INCLUDE]PROPERTYST.H, -
    [.PROGRAMS.XSERVER.INCLUDE]REGION.H, -
    [.PROGRAMS.XSERVER.INCLUDE]REGIONSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]RESOURCE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]RGB.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SCREENINT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SCRNINTSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SELECTION.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SERVERMD.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SITE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SWAPREP.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SWAPREQ.H, -
    [.PROGRAMS.XSERVER.INCLUDE]VALIDATE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]WINDOW.H, -
    [.PROGRAMS.XSERVER.INCLUDE]WINDOWSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]XISTUBS.H, -
    [.PROGRAMS.XSERVER.MFB]MFB.H, -
    [.PROGRAMS.XSERVER.MFB]MASKBITS.H
MI_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS
! Storage order preserves VMS long32 with P64.
MI_DEFINES = /DEFINE=(PIXPRIV,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,_XOPEN_SOURCE=600)
MI_CFLAGS = $(CFLAGS)$(MI_DEFINES)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Selected units retain upstream int-sized counts, indices and coordinates.
! mibank also retains its inherited int-sized bank-separation restriction.
MI_COUNT_CFLAGS = $(CFLAGS)$(MI_DEFINES)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
CBRT_CFLAGS = $(CFLAGS)

MI_OBJECTS = $(OUT).PROGRAMS.XSERVER.MI]MIVALTREE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYSEG.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYRECT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYCON.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYGEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYUTIL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIFILLRCT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIWIDELINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MISPANS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIARC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIZERARC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIFILLARC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIWINDOW.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MICURSOR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIREGION.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYTEXT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIBITBLT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOLYPNT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPUSHPXL.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIEXPOSE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIGLBLT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIZERLINE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIZERCLIP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIFPOLYCON.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIDASH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIBSTORE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIBANK.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIINITEXT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIEQ.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIPOINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MISPRITE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIDISPCUR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MISCRINIT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MICLIPN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIGC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MICMAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.MI]MIOVERLAY.OBJ

MI : $(OUT).PROGRAMS.XSERVER.MI]MI.OLB
	CONTINUE
CBRT : $(OUT).PROGRAMS.XSERVER.MI]CBRT.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.MI]MIVALTREE.OBJ : [.PROGRAMS.XSERVER.MI]MIVALTREE.C, -
    $(MI_HEADERS), $(MI_PRIVATE_HEADERS), $(MI_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MI]MIVALTREE "$(MI_CFLAGS)" MI

