    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]RDFTOI "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]WRFFRI.OBJ : [.EXTRAS.XPM.LIB]WRFFRI.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]WRFFRI "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]CRBUFFRP.OBJ : [.EXTRAS.XPM.LIB]CRBUFFRP.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRBUFFRP "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]CRIFRBUF.OBJ : [.EXTRAS.XPM.LIB]CRIFRBUF.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRIFRBUF "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]CRPFRDAT.OBJ : [.EXTRAS.XPM.LIB]CRPFRDAT.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]CRPFRDAT "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

$(OUT).LIB.XPM]RDFTOP.OBJ : [.EXTRAS.XPM.LIB]RDFTOP.C, -
    $(XPM_HEADERS), $(XPM_PRIVATE_HEADERS), $(XPM_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XPM]RDFTOP "$(XPM_CFLAGS)" XPM "$(XPM_CPPFLAGS)"

