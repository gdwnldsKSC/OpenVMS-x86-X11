! Complete ordinary static lbx library from the upstream Imakefile.
LBX_HEADERS = $(DIX_HEADERS), $(LBXUTIL_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]LBXIMAGE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]LBXOPTS.H
LBX_PRIVATE_HEADERS = $(DIX_PRIVATE_HEADERS), -
    [.XSERVER.XORG-SERVER.LBX]LBXSERVE.H, [.XSERVER.XORG-SERVER.LBX]LBXTAGS.H, -
    [.XSERVER.XORG-SERVER.LBX]LBXDATA.H, [.XSERVER.XORG-SERVER.LBX]LBXSRVOPTS.H, -
    [.XSERVER.XORG-SERVER.INCLUDE]SWAPREP.H
LBX_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.LBXUTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.LBXUTIL.IMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.DIX]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.LBX]DESCRIP.MMS
LBX_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Same-buffer lengths and array indices retain upstream int-sized counts.
LBX_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
LBX_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,LBX,NO_ALLOCA, -
    GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1)

LBX_OBJECTS = $(OUT).PROGRAMS.XSERVER.LBX]LBXMAIN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXDIX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXTAGS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXPROP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXGFX.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXTABLES.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXSWAP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXSQUISH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXEXTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXOPTS.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXZEROREP.OBJ, -
    $(OUT).PROGRAMS.XSERVER.LBX]LBXCMAP.OBJ

LBX : $(OUT).PROGRAMS.XSERVER.LBX]LBX.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.LBX]LBXMAIN.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXMAIN.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXMAIN "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXDIX.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXDIX.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXDIX "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXTAGS.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXTAGS.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXTAGS "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXPROP.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXPROP.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXPROP "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXGFX.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXGFX.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXGFX "$(LBX_COUNT_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXTABLES.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXTABLES.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXTABLES "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXSWAP.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXSWAP.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXSWAP "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXSQUISH.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXSQUISH.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXSQUISH "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXEXTS.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXEXTS.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXEXTS "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXOPTS.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXOPTS.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXOPTS "$(LBX_COUNT_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXZEROREP.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXZEROREP.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXZEROREP "$(LBX_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBXCMAP.OBJ : [.XSERVER.XORG-SERVER.LBX]LBXCMAP.C, -
    $(LBX_HEADERS), $(LBX_PRIVATE_HEADERS), $(LBX_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.LBX]LBXCMAP "$(LBX_COUNT_CFLAGS)" LBX "$(LBX_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.LBX]LBX.OLB : $(LBX_OBJECTS), $(LBX_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXMAIN.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXDIX.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXTAGS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXPROP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXGFX.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXTABLES.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXSWAP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXSQUISH.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXEXTS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXOPTS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXZEROREP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.LBX]LBXCMAP.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.LBX]LBX_LIBRARY.LIS $(MMS$TARGET)
