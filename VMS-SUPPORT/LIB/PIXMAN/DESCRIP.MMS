	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.PIXMAN]PIXMAN-PPC "$(PIXMAN_CFLAGS)" PIXMAN "$(PIXMAN_CPPFLAGS)"

$(OUT).LIB.PIXMAN]PIXMAN-REGION64F.OBJ : [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION64F.C, -
    [.EXTRAS.PIXMAN.PIXMAN]PIXMAN-REGION.C, -
