! Complete lib/freetype2/Imakefile normal library: 15 base and 19 aggregate objects.
! Keep upstream generic system/configuration, embedded gzip/LZW and default modules.
! The Imakefile does not compile cache implementation or enable TrueType bytecode.
FREETYPE2_HEADERS = $(OUT).INCLUDE]FT2BUILD.H, -
    $(OUT).INCLUDE.FREETYPE2.FREETYPE]FREETYPE.H, -
    $(OUT).INCLUDE.FREETYPE2.FREETYPE]FTBBOX.H, -
    $(OUT).INCLUDE.FREETYPE2.FREETYPE]FTBDF.H, -
