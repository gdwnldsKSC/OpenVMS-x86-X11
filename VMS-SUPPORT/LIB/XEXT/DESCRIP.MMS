! Complete ordinary static Xext library; upstream SHM sources are not selected.
XEXT_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XDEFS.H, -
    $(OUT).INCLUDE.X11]XAUTH.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MULTIBUFST.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MULTIBUF.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPESTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SHAPE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MITMISC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]MITMISCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XTESTEXT1.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNC.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SYNCSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XDBE.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XDBEPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XLBX.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]LBXSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SECURSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]SECURITY.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XAGSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XAG.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XCUPSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XCUP.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMS.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]DPMSSTR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEVI.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEVISTR.H
XEXT_PRIVATE_HEADERS = [.LIB.X11]XREGION.H
XEXT_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XAU]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.LBXUTIL]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XEXT]DESCRIP.MMS
XEXT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XEXT_OBJECTS = $(OUT).LIB.XEXT]GLOBALS.OBJ, -
    $(OUT).LIB.XEXT]EXTUTIL.OBJ, -
    $(OUT).LIB.XEXT]XMULTIBUF.OBJ, -
    $(OUT).LIB.XEXT]XSHAPE.OBJ, -
    $(OUT).LIB.XEXT]MITMISC.OBJ, -
    $(OUT).LIB.XEXT]XTESTEXT1.OBJ, -
    $(OUT).LIB.XEXT]XSYNC.OBJ, -
    $(OUT).LIB.XEXT]XDBE.OBJ, -
    $(OUT).LIB.XEXT]XLBX.OBJ, -
    $(OUT).LIB.XEXT]XSECURITY.OBJ, -
    $(OUT).LIB.XEXT]XAPPGROUP.OBJ, -
    $(OUT).LIB.XEXT]XCUP.OBJ, -
    $(OUT).LIB.XEXT]DPMS.OBJ, -
    $(OUT).LIB.XEXT]XEVI.OBJ

XEXT : $(OUT).LIB.XEXT]XEXT.OLB
	CONTINUE

$(OUT).LIB.XEXT]GLOBALS.OBJ : [.LIB.XEXT]GLOBALS.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]GLOBALS "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]EXTUTIL.OBJ : [.LIB.XEXT]EXTUTIL.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]EXTUTIL "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XMULTIBUF.OBJ : [.LIB.XEXT]XMULTIBUF.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XMULTIBUF "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XSHAPE.OBJ : [.LIB.XEXT]XSHAPE.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XSHAPE "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]MITMISC.OBJ : [.LIB.XEXT]MITMISC.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]MITMISC "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XTESTEXT1.OBJ : [.LIB.XEXT]XTESTEXT1.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XTESTEXT1 "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XSYNC.OBJ : [.LIB.XEXT]XSYNC.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XSYNC "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XDBE.OBJ : [.LIB.XEXT]XDBE.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XDBE "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XLBX.OBJ : [.LIB.XEXT]XLBX.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XLBX "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XSECURITY.OBJ : [.LIB.XEXT]XSECURITY.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XSECURITY "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XAPPGROUP.OBJ : [.LIB.XEXT]XAPPGROUP.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XAPPGROUP "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XCUP.OBJ : [.LIB.XEXT]XCUP.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XCUP "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]DPMS.OBJ : [.LIB.XEXT]DPMS.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]DPMS "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XEVI.OBJ : [.LIB.XEXT]XEVI.C, -
    $(XEXT_HEADERS), $(XEXT_PRIVATE_HEADERS), $(XEXT_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XEXT]XEVI "$(XEXT_CFLAGS)" XEXT

$(OUT).LIB.XEXT]XEXT.OLB : $(XEXT_OBJECTS), $(XEXT_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]GLOBALS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]EXTUTIL.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XMULTIBUF.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XSHAPE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]MITMISC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XTESTEXT1.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XSYNC.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XDBE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XLBX.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XSECURITY.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XAPPGROUP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XCUP.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]DPMS.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XEXT]XEVI.OBJ
	LIBRARY/LIST=$(OUT).LIB.XEXT]XEXT_LIBRARY.LIS $(MMS$TARGET)
