! Export unchanged upstream headers shared by native component builds.
COMMON_HEADERS = $(OUT).INCLUDE.X11]XFUNCPROTO.H, -
                 $(OUT).INCLUDE.X11]XFUNCS.H, -
                 $(OUT).INCLUDE.X11]XOSDEFS.H, -
                 $(OUT).INCLUDE.X11]XOS.H, -
                 $(OUT).INCLUDE.X11]XARCH.H

$(OUT).INCLUDE.X11]XFUNCPROTO.H : [.INCLUDE]XFUNCPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XFUNCS.H : [.INCLUDE]XFUNCS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XOSDEFS.H : [.INCLUDE]XOSDEFS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XOS.H : [.INCLUDE]XOS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XARCH.H : [.INCLUDE]XARCH.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]X.H : [.INCLUDE]X.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XATOM.H : [.INCLUDE]XATOM.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.EXTENSIONS]XIPROTO.H : [.INCLUDE.EXTENSIONS]XIPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XMD.H : [.INCLUDE]XMD.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XPROTO.H : [.INCLUDE]XPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XPROTOSTR.H : [.INCLUDE]XPROTOSTR.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XDEFS.H : [.INCLUDE]XDEFS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XALLOCA.H : [.INCLUDE]XALLOCA.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]KEYSYM.H : [.INCLUDE]KEYSYM.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XTRANS.H : [.LIB.XTRANS]XTRANS.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XPOLL.H : [.INCLUDE]XPOLL.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11]XOS_R.H : [.INCLUDE]XOS_R.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11.FONTS]FSLIB.H : [.LIB.FS]FSLIB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.DPS]PSRES.H : [.INCLUDE.DPS]PSRES.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).INCLUDE.X11]XLIB.H : [.LIB.X11]XLIB.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
