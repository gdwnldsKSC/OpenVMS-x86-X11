! Complete ordinary static Xcursor library from lib/Xcursor/Imakefile.
! The upstream Imake profile leaves optional HAVE_XFIXES hooks disabled.
XCURSOR_HEADERS = $(XCLIENT_HEADERS), $(OUT).INCLUDE.X11]XATOM.H, -
    $(OUT).INCLUDE.X11]CURSORFONT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XRENDER.H, -
    $(OUT).INCLUDE.X11.XCURSOR]XCURSOR.H
XCURSOR_PRIVATE_HEADERS = [.LIB.XCURSOR]XCURSORINT.H, -
    [.LIB.XCURSOR]CONFIG.H, [.LIB.XCURSOR]XCURSOR.H
XCURSOR_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.LIB.XCURSOR]DESCRIP.MMS
XCURSOR_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Same-array element count at cursor:282 and path lengths at library:87,93 use int.
XCURSOR_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
XCURSOR_OBJECTS = $(OUT).LIB.XCURSOR]CURSOR.OBJ, -
    $(OUT).LIB.XCURSOR]DISPLAY.OBJ, -
    $(OUT).LIB.XCURSOR]FILE.OBJ, -
    $(OUT).LIB.XCURSOR]LIBRARY.OBJ, -
    $(OUT).LIB.XCURSOR]XLIB.OBJ

XCURSOR : $(OUT).LIB.XCURSOR]XCURSOR.OLB
	CONTINUE

$(OUT).LIB.XCURSOR]CURSOR.OBJ : [.LIB.XCURSOR]CURSOR.C, -
    $(XCURSOR_HEADERS), $(XCURSOR_PRIVATE_HEADERS), $(XCURSOR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCURSOR]CURSOR "$(XCURSOR_COUNT_CFLAGS)" XCURSOR

$(OUT).LIB.XCURSOR]DISPLAY.OBJ : [.LIB.XCURSOR]DISPLAY.C, -
    $(XCURSOR_HEADERS), $(XCURSOR_PRIVATE_HEADERS), $(XCURSOR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCURSOR]DISPLAY "$(XCURSOR_CFLAGS)" XCURSOR

$(OUT).LIB.XCURSOR]FILE.OBJ : [.LIB.XCURSOR]FILE.C, -
    $(XCURSOR_HEADERS), $(XCURSOR_PRIVATE_HEADERS), $(XCURSOR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCURSOR]FILE "$(XCURSOR_CFLAGS)" XCURSOR

$(OUT).LIB.XCURSOR]LIBRARY.OBJ : [.LIB.XCURSOR]LIBRARY.C, -
    $(XCURSOR_HEADERS), $(XCURSOR_PRIVATE_HEADERS), $(XCURSOR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCURSOR]LIBRARY "$(XCURSOR_COUNT_CFLAGS)" XCURSOR

$(OUT).LIB.XCURSOR]XLIB.OBJ : [.LIB.XCURSOR]XLIB.C, -
    $(XCURSOR_HEADERS), $(XCURSOR_PRIVATE_HEADERS), $(XCURSOR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XCURSOR]XLIB "$(XCURSOR_CFLAGS)" XCURSOR

$(OUT).LIB.XCURSOR]XCURSOR.OLB : $(XCURSOR_OBJECTS), $(XCURSOR_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCURSOR]CURSOR.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCURSOR]DISPLAY.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCURSOR]FILE.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCURSOR]LIBRARY.OBJ
	LIBRARY/REPLACE/OBJECT $(MMS$TARGET) $(OUT).LIB.XCURSOR]XLIB.OBJ
	LIBRARY/LIST=$(OUT).LIB.XCURSOR]XCURSOR_LIBRARY.LIS $(MMS$TARGET)
