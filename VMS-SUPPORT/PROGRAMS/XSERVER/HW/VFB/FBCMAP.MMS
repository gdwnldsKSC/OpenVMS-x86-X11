! Upstream hw/vfb libfbcmap.a: the MI-based framebuffer colormap provider.
FBCMAP_HEADERS = $(FB_HEADERS)
FBCMAP_PRIVATE_HEADERS = $(FB_PRIVATE_HEADERS)
FBCMAP_BUILD_RULES = $(FB_BUILD_RULES), -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.HW.VFB]FBCMAP.MMS
FBCMAP_CPPFLAGS = /DEFINE=(PIXPRIV,RENDER,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1,XKB,XINPUT,_XOPEN_SOURCE=600)
FBCMAP_OBJECTS = $(OUT).PROGRAMS.XSERVER.HW.VFB]FBCMAP_MI.OBJ

FBCMAP : $(OUT).PROGRAMS.XSERVER.HW.VFB]FBCMAP.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.HW.VFB]FBCMAP_MI.OBJ : [.XSERVER.XORG-SERVER.FB]FBCMAP_MI.C, -
    $(FBCMAP_HEADERS), $(FBCMAP_PRIVATE_HEADERS), $(FBCMAP_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.HW.VFB]FBCMAP_MI "$(FB_CFLAGS)" FB "$(FBCMAP_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.HW.VFB]FBCMAP.OLB : $(FBCMAP_OBJECTS), $(FBCMAP_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(FBCMAP_OBJECTS)
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.HW.VFB]FBCMAP_LIBRARY.LIS $(MMS$TARGET)
