! Complete internal damage library from programs/Xserver/miext/damage/Imakefile.
! Static server profile; Render, Composite and rootless hooks are excluded.
DAMAGE_HEADERS = $(FONT_UTIL_HEADERS), $(OUT).INCLUDE.X11]XALLOCA.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RENDERPROTO.H
DAMAGE_PRIVATE_HEADERS = [.PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.H, -
    [.PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGESTR.H, -
    [.PROGRAMS.XSERVER.MI]MI.H, -
    [.PROGRAMS.XSERVER.RENDER]GLYPHSTR.H, -
    [.PROGRAMS.XSERVER.RENDER]PICTURE.H, -
    [.PROGRAMS.XSERVER.RENDER]PICTURESTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]BSTORE.H, [.PROGRAMS.XSERVER.INCLUDE]BSTORESTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]CLOSURE.H, [.PROGRAMS.XSERVER.INCLUDE]COLORMAP.H, -
    [.PROGRAMS.XSERVER.INCLUDE]CURSOR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIX.H, [.PROGRAMS.XSERVER.INCLUDE]DIXFONT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]DIXFONTSTR.H, [.PROGRAMS.XSERVER.INCLUDE]GC.H, -
    [.PROGRAMS.XSERVER.INCLUDE]GCSTRUCT.H, [.PROGRAMS.XSERVER.INCLUDE]GLOBALS.H, -
    [.PROGRAMS.XSERVER.INCLUDE]INPUT.H, [.PROGRAMS.XSERVER.INCLUDE]MISC.H, -
    [.PROGRAMS.XSERVER.INCLUDE]MISCSTRUCT.H, [.PROGRAMS.XSERVER.INCLUDE]OPAQUE.H, -
    [.PROGRAMS.XSERVER.INCLUDE]OS.H, [.PROGRAMS.XSERVER.INCLUDE]PIXMAP.H, -
    [.PROGRAMS.XSERVER.INCLUDE]PIXMAPSTR.H, [.PROGRAMS.XSERVER.INCLUDE]PROPERTY.H, -
    [.PROGRAMS.XSERVER.INCLUDE]REGION.H, [.PROGRAMS.XSERVER.INCLUDE]REGIONSTR.H, -
    [.PROGRAMS.XSERVER.INCLUDE]RESOURCE.H, [.PROGRAMS.XSERVER.INCLUDE]SCREENINT.H, -
    [.PROGRAMS.XSERVER.INCLUDE]SCRNINTSTR.H, [.PROGRAMS.XSERVER.INCLUDE]SERVERMD.H, -
    [.PROGRAMS.XSERVER.INCLUDE]VALIDATE.H, [.PROGRAMS.XSERVER.INCLUDE]WINDOW.H, -
    [.PROGRAMS.XSERVER.INCLUDE]WINDOWSTR.H
DAMAGE_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS
! Explicit storage order avoids claiming Unix LP64 on the VMS P64 data model.
! Preserve upstream comments embedded between prototype tokens.
DAMAGE_CFLAGS = $(CFLAGS)/DEFINE=(FUNCPROTO=15,PIXPRIV,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0) -
    /WARNINGS=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)

DAMAGE : $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OLB
	CONTINUE

$(OUT).INCLUDE.X11.EXTENSIONS]RENDER.H : [.INCLUDE.EXTENSIONS]RENDER.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)
$(OUT).INCLUDE.X11.EXTENSIONS]RENDERPROTO.H : [.INCLUDE.EXTENSIONS]RENDERPROTO.H
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OBJ : [.PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.C, -
    $(DAMAGE_HEADERS), $(DAMAGE_PRIVATE_HEADERS), $(DAMAGE_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE "$(DAMAGE_CFLAGS)" DAMAGE

$(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OLB : -
    $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OBJ, $(DAMAGE_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.MIEXT.DAMAGE]DAMAGE_LIBRARY.LIS $(MMS$TARGET)
