! Complete ordinary static RandR library with Render subpixel-order support.
! The upstream MI fallback advertises one size and does not perform modesetting.
RANDR_HEADERS = $(RENDER_HEADERS), $(OUT).INCLUDE.X11.EXTENSIONS]RANDR.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]RANDRPROTO.H
RANDR_PRIVATE_HEADERS = $(RENDER_PRIVATE_HEADERS), [.XSERVER.XORG-SERVER.RANDR]RANDRSTR.H, [.XSERVER.XORG-SERVER.RANDR]RRTRANSFORM.H
RANDR_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.FB]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RENDER]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.RANDR]DESCRIP.MMS
RANDR_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Request/reply-buffer offsets and same-array size indices retain upstream int counts.
RANDR_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
RANDR_CPPFLAGS = /DEFINE=(XKB_IN_SERVER,PIXPRIV,RENDER,RANDR,GLYPHPADBYTES=4,GETLEFTBITS_ALIGNMENT=1)

RANDR_OBJECTS = $(OUT).PROGRAMS.XSERVER.RANDR]RANDR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]MIRANDR.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRCRTC.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRDISPATCH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRINFO.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRMODE.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RROUTPUT.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRPOINTER.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRPROPERTY.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRSCREEN.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRSDISPATCH.OBJ, -
    $(OUT).PROGRAMS.XSERVER.RANDR]RRTRANSFORM.OBJ

RANDR : $(OUT).PROGRAMS.XSERVER.RANDR]RANDR.OLB
	CONTINUE

$(OUT).PROGRAMS.XSERVER.RANDR]RANDR.OBJ : [.XSERVER.XORG-SERVER.RANDR]RANDR.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RANDR "$(RANDR_COUNT_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]MIRANDR.OBJ : [.XSERVER.XORG-SERVER.RANDR]MIRANDR.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]MIRANDR "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRCRTC.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRCRTC.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRCRTC "$(RANDR_COUNT_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRDISPATCH.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRDISPATCH.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRDISPATCH "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRINFO.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRINFO.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRINFO "$(RANDR_COUNT_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRMODE.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRMODE.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRMODE "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RROUTPUT.OBJ : [.XSERVER.XORG-SERVER.RANDR]RROUTPUT.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RROUTPUT "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRPOINTER.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRPOINTER.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRPOINTER "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRPROPERTY.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRPROPERTY.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRPROPERTY "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRSCREEN.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRSCREEN.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRSCREEN "$(RANDR_COUNT_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RRSDISPATCH.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRSDISPATCH.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRSDISPATCH "$(RANDR_COUNT_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.RANDR]RANDR.OLB : $(RANDR_OBJECTS), $(RANDR_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.RANDR]RANDR.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]MIRANDR.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRCRTC.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRDISPATCH.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRINFO.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRMODE.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.RANDR]RROUTPUT.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRPOINTER.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRPROPERTY.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRSCREEN.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRSDISPATCH.OBJ,$(OUT).PROGRAMS.XSERVER.RANDR]RRTRANSFORM.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.RANDR]RANDR_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.RANDR]RRTRANSFORM.OBJ : [.XSERVER.XORG-SERVER.RANDR]RRTRANSFORM.C, -
    $(RANDR_HEADERS), $(RANDR_PRIVATE_HEADERS), $(RANDR_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.RANDR]RRTRANSFORM "$(RANDR_CFLAGS)" RANDR "$(RANDR_CPPFLAGS)"
