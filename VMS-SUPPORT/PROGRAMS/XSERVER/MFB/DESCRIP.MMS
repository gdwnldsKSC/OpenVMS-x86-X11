! Complete ordinary static monochrome framebuffer library from the upstream Imakefile.
! Native P64 pointers and CARD32 framebuffer words; no loadable or banked hooks.
MFB_HEADERS = $(MI_HEADERS)
MFB_PRIVATE_HEADERS = $(MI_PRIVATE_HEADERS), -
    [.PROGRAMS.XSERVER.MFB]FASTBLT.H, -
    [.PROGRAMS.XSERVER.MFB]MERGEROP.H
MFB_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MIEXT.DAMAGE]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MI]DESCRIP.MMS, -
    [.VMS-SUPPORT.PROGRAMS.XSERVER.MFB]DESCRIP.MMS
MFB_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
! Preserve upstream int-sized array counts, indices and span coordinates with P64 pointers.
MFB_COUNT_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=(EMBEDCOMMENT,MAYLOSEDATA3))
MFB_CPP_DEFINES = PIXPRIV,GLYPHPADBYTES=4,BITMAP_BIT_ORDER=0,IMAGE_BYTE_ORDER=0,GETLEFTBITS_ALIGNMENT=1
MFB_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES))

MFB_MFBSEG_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""POLYSEGMENT"")
MFB_MFBBLTC_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=Mcopy"")
MFB_MFBBLTX_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=Mxor"")
MFB_MFBBLTCI_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=McopyInverted"")
MFB_MFBBLTO_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=Mor"")
MFB_MFBBLTG_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=0"")
MFB_MFBPGBWHT_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBPOLYGLYPHBLT=mfbPolyGlyphBltWhite"", -
    ""OPEQ=MFB_OPEQ_WHITE"")
MFB_MFBPGBBLAK_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBPOLYGLYPHBLT=mfbPolyGlyphBltBlack"", -
    ""OPEQ=MFB_OPEQ_BLACK"")
MFB_MFBPGBINV_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBPOLYGLYPHBLT=mfbPolyGlyphBltInvert"", -
    ""OPEQ=MFB_OPEQ_INVERT"")
MFB_MFBIGBWHT_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBIMAGEGLYPHBLT=mfbImageGlyphBltWhite"", -
    ""OPEQ=MFB_OPEQ_WHITE"")
MFB_MFBIGBBLAK_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBIMAGEGLYPHBLT=mfbImageGlyphBltBlack"", -
    ""OPEQ=MFB_OPEQ_BLACK"")
MFB_MFBPAWHITE_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBSOLIDFILLAREA=mfbSolidWhiteArea"", -
    ""MFBSTIPPLEFILLAREA=mfbStippleWhiteArea"", -
    ""OPEQ=MFB_OPEQ_WHITE"", -
    ""EQWHOLEWORD=MFB_EQWHOLEWORD_WHITE"")
MFB_MFBPABLACK_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBSOLIDFILLAREA=mfbSolidBlackArea"", -
    ""MFBSTIPPLEFILLAREA=mfbStippleBlackArea"", -
    ""OPEQ=MFB_OPEQ_BLACK"", -
    ""EQWHOLEWORD=MFB_EQWHOLEWORD_BLACK"")
MFB_MFBPAINV_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBSOLIDFILLAREA=mfbSolidInvertArea"", -
    ""MFBSTIPPLEFILLAREA=mfbStippleInvertArea"", -
    ""OPEQ=MFB_OPEQ_INVERT"", -
    ""EQWHOLEWORD=MFB_EQWHOLEWORD_INVERT"")
MFB_MFBTILEC_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=Mcopy"")
MFB_MFBTILEG_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MROP=0"")
MFB_MFBTEWHITE_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBTEGLYPHBLT=mfbTEGlyphBltWhite"", -
    ""OP=MFB_OP_WHITE"", -
    ""CLIPTETEXT=mfbImageGlyphBltWhite"")
MFB_MFBTEBLACK_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBTEGLYPHBLT=mfbTEGlyphBltBlack"", -
    ""OP=MFB_OP_BLACK"", -
    ""CLIPTETEXT=mfbImageGlyphBltBlack"")
MFB_MFBPLYWHITE_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBFILLPOLY1RECT=mfbFillPolyWhite"", -
    ""OPEQ=MFB_OPEQ_WHITE"", -
    ""EQWHOLEWORD=MFB_EQWHOLEWORD_WHITE"")
MFB_MFBPLYBLACK_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBFILLPOLY1RECT=mfbFillPolyBlack"", -
    ""OPEQ=MFB_OPEQ_BLACK"", -
    ""EQWHOLEWORD=MFB_EQWHOLEWORD_BLACK"")
MFB_MFBPLYINV_CPPFLAGS = /DEFINE=($(MFB_CPP_DEFINES), -
    ""MFBFILLPOLY1RECT=mfbFillPolyInvert"", -
    ""OPEQ=MFB_OPEQ_INVERT"", -
    ""EQWHOLEWORD=MFB_EQWHOLEWORD_INVERT"")

! Exact-byte aliases retain distinct native object module names for Unix variants.
$(OUT).PROGRAMS.XSERVER.MFB]MFBSEG.C : [.PROGRAMS.XSERVER.MFB]MFBLINE.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MFB]MFBPGBWHT.C : [.PROGRAMS.XSERVER.MFB]MFBPLYGBLT.C
	COPY/NOLOG $(MMS$SOURCE) $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.MFB]MFBPGBBLAK.C : [.PROGRAMS.XSERVER.MFB]MFBPLYGBLT.C
