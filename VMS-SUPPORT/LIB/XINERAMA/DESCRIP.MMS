! Complete static Xinerama client library from lib/Xinerama/Imakefile.
XINERAMA_HEADERS = $(XCLIENT_HEADERS), -
    $(OUT).INCLUDE.X11.EXTENSIONS]XEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]EXTUTIL.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PANORAMIXEXT.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]PANORAMIXPROTO.H, -
    $(OUT).INCLUDE.X11.EXTENSIONS]XINERAMA.H
XINERAMA_BUILD_RULES = [.VMS-SUPPORT]CONFIG.MMS, [.VMS-SUPPORT]COMPILE.COM, -
    [.VMS-SUPPORT]HEADERS.MMS, [.VMS-SUPPORT.LIB.XINERAMA]DESCRIP.MMS
XINERAMA_CFLAGS = $(CFLAGS)/WARN=(ENABLE=LEVEL4,DISABLE=EMBEDCOMMENT)
XINERAMA_OBJECTS = $(OUT).LIB.XINERAMA]XINERAMA.OBJ

XINERAMA : $(OUT).LIB.XINERAMA]XINERAMA.OLB
	CONTINUE

$(OUT).LIB.XINERAMA]XINERAMA.OBJ : [.LIB.XINERAMA]XINERAMA.C, -
    $(XINERAMA_HEADERS), $(XINERAMA_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).LIB.XINERAMA]XINERAMA "$(XINERAMA_CFLAGS)" XINERAMA

$(OUT).LIB.XINERAMA]XINERAMA.OLB : $(XINERAMA_OBJECTS), $(XINERAMA_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(XINERAMA_OBJECTS)
	LIBRARY/LIST=$(OUT).LIB.XINERAMA]XINERAMA_LIBRARY.LIS $(MMS$TARGET)
