	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXLIST "$(XKB_COUNT_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXDEVBTN.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXDEVBTN.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXDEVBTN "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]DDXPRIVATE.OBJ : [.XSERVER.XORG-SERVER.XKB]DDXPRIVATE.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]DDXPRIVATE "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

$(OUT).PROGRAMS.XSERVER.XKB]XKB.OLB : $(XKB_OBJECTS), $(XKB_BUILD_RULES)
	LIBRARY/CREATE/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKB.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBUTILS.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBEVENTS.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBACCESSX.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBSWAP.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBLEDS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBINIT.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBACTIONS.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBPRKEYEV.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKMREAD.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBFMISC.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]MAPRULES.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]XKBMISC.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBMALLOC.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBALLOC.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBGALLOC.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXBEEP.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXCTRLS.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXFAKEMTN.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXKILLSRV.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXLEDS.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXVT.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXLOAD.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXLIST.OBJ
	LIBRARY/INSERT/OBJECT $(MMS$TARGET) $(OUT).PROGRAMS.XSERVER.XKB]DDXDEVBTN.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]DDXPRIVATE.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBOUT.OBJ,$(OUT).PROGRAMS.XSERVER.XKB]XKBTEXT.OBJ
	LIBRARY/LIST=$(OUT).PROGRAMS.XSERVER.XKB]XKB_LIBRARY.LIS $(MMS$TARGET)

$(OUT).PROGRAMS.XSERVER.XKB]XKBOUT.OBJ : [.XSERVER.XORG-SERVER.XKB]XKBOUT.C, -
    $(XKB_HEADERS), $(XKB_PRIVATE_HEADERS), $(XKB_BUILD_RULES), $(RTL)
	@[.VMS-SUPPORT]COMPILE.COM $(MMS$SOURCE) $(OUT).PROGRAMS.XSERVER.XKB]XKBOUT "$(XKB_CFLAGS)" XKB "$(XKB_CPPFLAGS)"

